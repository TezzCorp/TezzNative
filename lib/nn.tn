// ============================================================
// nn.tn  -  TezzAI Neural Network Library  v7.0
// ============================================================
// STRUCT-FREE ARCHITECTURE: The TezzNative compiler has severe
// bugs with structs (field offsets, pass-by-value corruption).
// Therefore, we use NO STRUCTS. A "NeuralNet" is simply a 
// single *float slab pointer.
//
// SLAB slots (each slot = 8 bytes):
//   [0]     magic
//   [1]     n_layers
//   [2]     total_w
//   [3]     total_b
//   [4..11] l_in_n[8]
//  [12..19] l_out_n[8]
//  [20..27] l_act[8]
//  [28..35] l_w_off[8]
//  [36..43] l_b_off[8]
//  [44..]   weights[total_w]
//  [44+tw..] biases[total_b]
//  [...+tb]  outputs[total_b]
//  [...+tb]  deltas[total_b]
//  [...+tb]  grad_w[total_w]
//  [...+tw]  grad_b[total_b]
// ============================================================

import "math"

let ACT_SIGMOID:int = 0
let ACT_RELU:int    = 1
let ACT_TANH:int    = 2
let ACT_LINEAR:int  = 3
let _NN_HDR:int     = 44
let _NN_MAGIC:int   = 1414676301

// ── Safe slot accessors ──────────────────────────────────────

fn _sf(s:*float, i:int) -> float:
  v:float = 0.0
  unsafe:
    sc:*char = s as *char
    p:*float = (sc + i * 8) as *float
    v = p[0]
  ret v

fn _sw(s:*float, i:int, v:float) -> int:
  unsafe:
    sc:*char = s as *char
    p:*float = (sc + i * 8) as *float
    p[0] = v
  ret 0

fn _si(s:*float, i:int) -> int:
  ret _sf(s, i) as int

fn _wi(s:*float, i:int, v:int) -> int:
  _sw(s, i, v as float)
  ret 0

// ── Slab region base slots ───────────────────────────────────

fn _wb(tw:int) -> int:
  ret _NN_HDR

fn _bb(tw:int) -> int:
  ret _NN_HDR + tw

fn _ob(tw:int, tb:int) -> int:
  ret _NN_HDR + tw + tb

fn _db(tw:int, tb:int) -> int:
  ret _NN_HDR + tw + tb * 2

fn _gwb(tw:int, tb:int) -> int:
  ret _NN_HDR + tw + tb * 3

fn _gbb(tw:int, tb:int) -> int:
  ret _NN_HDR + tw * 2 + tb * 3

// ── Activation ───────────────────────────────────────────────

fn _sigmoid(x:float) -> float:
  ret 1.0 / (1.0 + math.exp(0.0 - x))

fn _act(x:float, a:int) -> float:
  if a == ACT_RELU:
    if x > 0.0:
      ret x
    ret 0.0
  if a == ACT_TANH:
    ret math.tanh(x)
  if a == ACT_LINEAR:
    ret x
  ret _sigmoid(x)

fn _dact(y:float, a:int) -> float:
  if a == ACT_RELU:
    if y > 0.0:
      ret 1.0
    ret 0.0
  if a == ACT_TANH:
    ret 1.0 - y * y
  if a == ACT_LINEAR:
    ret 1.0
  ret y * (1.0 - y)

// ── PRNG ─────────────────────────────────────────────────────

static let _seed:int = 42

fn _randf() -> float:
  _seed = _seed * 1664525 + 1013904223
  bits:int = (_seed >> 8) & 16777215
  ret (bits as float) / 16777216.0 - 0.5

fn nn_set_seed(s:int) -> int:
  _seed = s
  ret 0

// ── nn_new_custom ────────────────────────────────────────────
//   sizes_slab: *float holding [n_layers+1] ints via _wi
//   acts_slab:  *float holding [n_layers] ints via _wi
//   returns:    *float slab
fn nn_new_custom(sizes_slab:*float, acts_slab:*float, n_layers:int) -> *float:
  tw:int = 0
  tb:int = 0
  i:int = 0
  while i < n_layers:
    in_i:int  = _si(sizes_slab, i)
    out_i:int = _si(sizes_slab, i + 1)
    tw = tw + in_i * out_i
    tb = tb + out_i
    i = i + 1

  total_slots:int = _NN_HDR + tw * 2 + tb * 4
  raw:*char
  unsafe:
    raw = malloc(total_slots * 8)
  net:*float
  unsafe:
    net = raw as *float

  // Write slab header
  _wi(net, 0, _NN_MAGIC)
  _wi(net, 1, n_layers)
  _wi(net, 2, tw)
  _wi(net, 3, tb)

  // Layer metadata + compute offsets
  w_off:int = 0
  b_off:int = 0
  i = 0
  while i < n_layers:
    in_i:int  = _si(sizes_slab, i)
    out_i:int = _si(sizes_slab, i + 1)
    act_i:int = _si(acts_slab,  i)
    _wi(net, 4  + i, in_i)
    _wi(net, 12 + i, out_i)
    _wi(net, 20 + i, act_i)
    _wi(net, 28 + i, w_off)
    _wi(net, 36 + i, b_off)
    w_off = w_off + in_i * out_i
    b_off = b_off + out_i
    i = i + 1

  // Zero all data slots
  j:int = _NN_HDR
  while j < total_slots:
    _sw(net, j, 0.0)
    j = j + 1

  // Xavier weight init
  wb:int = _wb(tw)
  i = 0
  while i < n_layers:
    in_i:int  = _si(net, 4  + i)
    out_i:int = _si(net, 12 + i)
    woff:int  = _si(net, 28 + i)
    fan:float = (in_i + out_i) as float
    sc:float  = math.sqrt(6.0 / fan)
    cnt:int   = in_i * out_i
    j = 0
    while j < cnt:
      _sw(net, wb + woff + j, _randf() * 2.0 * sc)
      j = j + 1
    i = i + 1

  ret net

// ── nn_new: 2-layer MLP shortcut ────────────────────────────
fn nn_new(in_n:int, hidden_n:int, out_n:int) -> *float:
  sz_raw:*char
  act_raw:*char
  unsafe:
    sz_raw  = malloc(3 * 8)
    act_raw = malloc(2 * 8)
  sz:*float
  actslab:*float
  unsafe:
    sz      = sz_raw  as *float
    actslab = act_raw as *float
  _wi(sz,      0, in_n)
  _wi(sz,      1, hidden_n)
  _wi(sz,      2, out_n)
  _wi(actslab, 0, ACT_SIGMOID)
  _wi(actslab, 1, ACT_SIGMOID)
  net:*float = nn_new_custom(sz, actslab, 2)
  unsafe:
    free(sz_raw)
    free(act_raw)
  ret net

// ── nn_free ──────────────────────────────────────────────────
fn nn_free(net:*float) -> int:
  unsafe:
    sc:*char = net as *char
    free(sc)
  ret 0

// ── nn_forward ───────────────────────────────────────────────
fn nn_forward(net:*float, input_slab:*float, output_slab:*float) -> int:
  nl:int = _si(net, 1)
  tw:int = _si(net, 2)
  tb:int = _si(net, 3)
  wb:int = _wb(tw)
  bb:int = _bb(tw)
  ob:int = _ob(tw, tb)

  use_inp:int   = 1
  prev_boff:int = 0

  i:int = 0
  while i < nl:
    in_n:int  = _si(net, 4  + i)
    out_n:int = _si(net, 12 + i)
    act_t:int = _si(net, 20 + i)
    woff:int  = _si(net, 28 + i)
    boff:int  = _si(net, 36 + i)

    j:int = 0
    while j < out_n:
      bv:float = _sf(net, bb + boff + j)
      sum:float = bv
      k:int = 0
      while k < in_n:
        pv:float = 0.0
        if use_inp == 1:
          pv = _sf(input_slab, k)
        else:
          pv = _sf(net, ob + prev_boff + k)
        wv:float = _sf(net, wb + woff + j * in_n + k)
        sum = sum + wv * pv
        k = k + 1
      av:float = _act(sum, act_t)
      _sw(net, ob + boff + j, av)
      j = j + 1

    use_inp   = 0
    prev_boff = boff
    i = i + 1

  last_i:int    = nl - 1
  last_boff:int = _si(net, 36 + last_i)
  last_n:int    = _si(net, 12 + last_i)
  j:int = 0
  while j < last_n:
    v:float = _sf(net, ob + last_boff + j)
    _sw(output_slab, j, v)
    j = j + 1
  ret 0

// ── nn_backward ──────────────────────────────────────────────
fn nn_backward(net:*float, input_slab:*float, target_slab:*float, lr:float) -> float:
  nl:int = _si(net, 1)
  tw:int = _si(net, 2)
  tb:int = _si(net, 3)
  wb:int  = _wb(tw)
  bb:int  = _bb(tw)
  ob:int  = _ob(tw, tb)
  db:int  = _db(tw, tb)

  last_i:int    = nl - 1
  last_boff:int = _si(net, 36 + last_i)
  last_n:int    = _si(net, 12 + last_i)
  last_act:int  = _si(net, 20 + last_i)

  loss:float = 0.0
  j:int = 0
  while j < last_n:
    y:float   = _sf(net, ob + last_boff + j)
    t:float   = _sf(target_slab, j)
    err:float = t - y
    loss = loss + err * err
    // Cross-entropy gradient for output layer to prevent saturation
    dv:float  = err
    _sw(net, db + last_boff + j, dv)
    j = j + 1

  i:int = nl - 2
  while i >= 0:
    b0:int    = _si(net, 36 + i)
    b1:int    = _si(net, 36 + i + 1)
    n0:int    = _si(net, 12 + i)
    n1:int    = _si(net, 12 + i + 1)
    w1off:int = _si(net, 28 + i + 1)
    act0:int  = _si(net, 20 + i)
    j = 0
    while j < n0:
      grad:float = 0.0
      k:int = 0
      while k < n1:
        dv:float = _sf(net, db + b1 + k)
        wv:float = _sf(net, wb + w1off + k * n0 + j)
        grad = grad + dv * wv
        k = k + 1
      y2:float  = _sf(net, ob + b0 + j)
      dv2:float = grad * _dact(y2, act0)
      _sw(net, db + b0 + j, dv2)
      j = j + 1
    i = i - 1

  use_inp:int   = 1
  prev_boff:int = 0
  i = 0
  while i < nl:
    in_n:int  = _si(net, 4  + i)
    out_n:int = _si(net, 12 + i)
    woff:int  = _si(net, 28 + i)
    boff:int  = _si(net, 36 + i)
    j = 0
    while j < out_n:
      d:float = _sf(net, db + boff + j)
      k:int = 0
      while k < in_n:
        pv:float = 0.0
        if use_inp == 1:
          pv = _sf(input_slab, k)
        else:
          pv = _sf(net, ob + prev_boff + k)
        idx:int     = wb + woff + j * in_n + k
        old_w:float = _sf(net, idx)
        _sw(net, idx, old_w + lr * d * pv)
        k = k + 1
      bidx:int    = bb + boff + j
      old_b:float = _sf(net, bidx)
      _sw(net, bidx, old_b + lr * d)
      j = j + 1
    use_inp   = 0
    prev_boff = boff
    i = i + 1

  ret loss * 0.5

fn nn_predict(net:*float, inp:*float, out:*float) -> int:
  ret nn_forward(net, inp, out)

// ── nn_info ──────────────────────────────────────────────────
fn nn_info(net:*float) -> int:
  nl:int = _si(net, 1)
  tw:int = _si(net, 2)
  tb:int = _si(net, 3)
  say "[NeuralNet] layers=", nl, " weights=", tw, " neurons=", tb
  i:int = 0
  while i < nl:
    in_i:int  = _si(net, 4  + i)
    out_i:int = _si(net, 12 + i)
    act_i:int = _si(net, 20 + i)
    say "  Layer ", i, ": ", in_i, " -> ", out_i
    i = i + 1
  ret 0

// ── File I/O ──────────────────────────────────────────────────
fn _fw_i(f:*char, v:int) -> int:
  b:*char
  unsafe:
    b = malloc(8)
    p:*int = b as *int
    p[0] = v
    fwrite(b, 8, 1, f)
    free(b)
  ret 0

fn _fw_f(f:*char, v:float) -> int:
  b:*char
  unsafe:
    b = malloc(8)
    p:*float = b as *float
    p[0] = v
    fwrite(b, 8, 1, f)
    free(b)
  ret 0

fn _fr_i(f:*char) -> int:
  v:int = 0
  b:*char
  unsafe:
    b = malloc(8)
    fread(b, 8, 1, f)
    p:*int = b as *int
    v = p[0]
    free(b)
  ret v

fn _fr_f(f:*char) -> float:
  v:float = 0.0
  b:*char
  unsafe:
    b = malloc(8)
    fread(b, 8, 1, f)
    p:*float = b as *float
    v = p[0]
    free(b)
  ret v

// ── nn_save ───────────────────────────────────────────────────
fn nn_save(net:*float, path:str) -> int:
  f:*char = fopen(path, "wb")
  unsafe:
    if f == 0 as *char:
      ret 0 - 1

  nl:int = _si(net, 1)
  tw:int = _si(net, 2)
  tb:int = _si(net, 3)

  _fw_i(f, _NN_MAGIC)
  _fw_i(f, 2)   // version
  _fw_i(f, nl)
  _fw_i(f, tw)
  _fw_i(f, tb)

  i:int = 0
  while i < nl:
    _fw_i(f, _si(net, 4  + i))
    _fw_i(f, _si(net, 12 + i))
    _fw_i(f, _si(net, 20 + i))
    i = i + 1

  wb:int = _wb(tw)
  bb:int = _bb(tw)
  i = 0
  while i < tw:
    v:float = _sf(net, wb + i)
    _fw_f(f, v)
    i = i + 1
  i = 0
  while i < tb:
    v:float = _sf(net, bb + i)
    _fw_f(f, v)
    i = i + 1

  unsafe:
    fclose(f)
  ret 0

// ── nn_load ───────────────────────────────────────────────────
fn nn_load(path:str) -> *float:
  null_f:*float
  unsafe:
    nc:*char = 0 as *char
    null_f = nc as *float

  f:*char = fopen(path, "rb")
  unsafe:
    if f == 0 as *char:
      ret null_f

  magic:int = _fr_i(f)
  if magic != _NN_MAGIC:
    unsafe:
      fclose(f)
    ret null_f

  _fr_i(f)
  nl:int = _fr_i(f)
  tw:int = _fr_i(f)
  tb:int = _fr_i(f)

  sz_raw:*char
  act_raw:*char
  unsafe:
    sz_raw  = malloc((nl + 1) * 8)
    act_raw = malloc(nl * 8)
  sz:*float
  actslab:*float
  unsafe:
    sz      = sz_raw  as *float
    actslab = act_raw as *float

  i:int = 0
  while i < nl:
    in_i:int  = _fr_i(f)
    out_i:int = _fr_i(f)
    act_i:int = _fr_i(f)
    _wi(sz,      i,     in_i)
    _wi(sz,      i + 1, out_i)
    _wi(actslab, i,     act_i)
    i = i + 1

  net:*float = nn_new_custom(sz, actslab, nl)
  unsafe:
    free(sz_raw)
    free(act_raw)

  wb:int = _wb(tw)
  bb:int = _bb(tw)
  i = 0
  while i < tw:
    v:float = _fr_f(f)
    _sw(net, wb + i, v)
    i = i + 1
  i = 0
  while i < tb:
    v:float = _fr_f(f)
    _sw(net, bb + i, v)
    i = i + 1

  unsafe:
    fclose(f)
  ret net

// ── Transformer layers: Embedding, LayerNorm, Attention ───────

// Embed raw token IDs into a continuous vector space
// token_ids: *int of length seq_len
// out: *float output of shape [seq_len, dim] (slab output)
// embed_table: *float of shape [vocab_sz, dim] (flattened)
fn nn_embed(token_ids:*int, out:*float, embed_table:*float, seq_len:int, dim:int) -> int:
  i:int = 0
  while i < seq_len:
    tok:int = token_ids[i]
    // Copy dim elements
    j:int = 0
    while j < dim:
      v:float = _sf(embed_table, tok * dim + j)
      _sw(out, i * dim + j, v)
      j = j + 1
    i = i + 1
  ret 0

// Apply Layer Normalization along the embedding dimension
// x: *float input of shape [seq_len, dim]
// out: *float output of shape [seq_len, dim]
// gamma: *float gain vector of length dim
// beta: *float bias vector of length dim
fn nn_layernorm(x:*float, out:*float, gamma:*float, beta:*float, seq_len:int, dim:int) -> int:
  eps:float = 1.0e-05
  i:int = 0
  while i < seq_len:
    // Compute mean
    sum:float = 0.0
    j:int = 0
    while j < dim:
      sum = sum + _sf(x, i * dim + j)
      j = j + 1
    mean:float = sum / (dim as float)

    // Compute variance
    var_sum:float = 0.0
    j = 0
    while j < dim:
      diff:float = _sf(x, i * dim + j) - mean
      var_sum = var_sum + diff * diff
      j = j + 1
    variance:float = var_sum / (dim as float)
    inv_std:float = 1.0 / math.sqrt(variance + eps)

    // Normalize and scale/shift
    j = 0
    while j < dim:
      xv:float = _sf(x, i * dim + j)
      g:float = 1.0
      b:float = 0.0
      if gamma != 0 as *float: g = _sf(gamma, j)
      if beta != 0 as *float:  b = _sf(beta, j)
      norm:float = (xv - mean) * inv_std * g + b
      _sw(out, i * dim + j, norm)
      j = j + 1
    i = i + 1
  ret 0

// Multi-Head Attention (SDPA with optional causal mask)
// q: *float query matrix [seq_len, dim]
// k: *float key matrix [seq_len, dim]
// v: *float value matrix [seq_len, dim]
// out: *float output matrix [seq_len, dim]
// seq_len: sequence length
// dim: embedding dimension
// heads: number of attention heads
// causal: 1 to apply causal autoregressive masking, 0 otherwise
fn nn_attention(q:*float, k:*float, v:*float, out:*float, seq_len:int, dim:int, heads:int, causal:int) -> int:
  d:int = dim / heads
  scale:float = 1.0 / math.sqrt(d as float)
  
  // scores buffer to hold attention weights for one row
  scores_raw:*char
  unsafe:
    scores_raw = malloc(seq_len * 8)
  scores:*float
  unsafe:
    scores = scores_raw as *float

  i:int = 0
  while i < seq_len:
    h:int = 0
    while h < heads:
      // Step 1: Compute attention scores QK^T / sqrt(d)
      max_score:float = 0.0 - 1.0e+09
      j:int = 0
      while j < seq_len:
        if causal != 0 && j > i:
          _sw(scores, j, 0.0 - 1.0e+09)
        else:
          // Dot product for head h
          sum:float = 0.0
          c:int = 0
          while c < d:
            qv:float = _sf(q, i * dim + h * d + c)
            kv:float = _sf(k, j * dim + h * d + c)
            sum = sum + qv * kv
            c = c + 1
          score:float = sum * scale
          _sw(scores, j, score)
          if score > max_score:
            max_score = score
        j = j + 1

      // Step 2: Compute Softmax
      exp_sum:float = 0.0
      j = 0
      while j < seq_len:
        if causal != 0 && j > i:
          _sw(scores, j, 0.0)
        else:
          s:float = _sf(scores, j)
          ev:float = math.exp(s - max_score)
          _sw(scores, j, ev)
          exp_sum = exp_sum + ev
        j = j + 1

      if exp_sum > 0.0:
        j = 0
        while j < seq_len:
          ev:float = _sf(scores, j)
          _sw(scores, j, ev / exp_sum)
          j = j + 1

      // Step 3: Compute weighted sum of values Attention * V
      c = 0
      while c < d:
        sum_v:float = 0.0
        j = 0
        while j < seq_len:
          attn:float = _sf(scores, j)
          vv:float = _sf(v, j * dim + h * d + c)
          sum_v = sum_v + attn * vv
          j = j + 1
        _sw(out, i * dim + h * d + c, sum_v)
        c = c + 1

      h = h + 1
    i = i + 1

  unsafe:
    free(scores_raw)
  ret 0

// ── Dropout ─────────────────────────────────────────────────
// Applies Bernoulli dropout mask during training.
// x:        [n] float input/output (in-place)
// n:        number of elements
// rate:     dropout probability (e.g. 0.1 = 10% zeroed)
// training: 1 = apply dropout, 0 = pass through (inference)
// seed:     PRNG seed (updated in-place)
fn nn_dropout(x:*float, n:int, rate:float, training:int, seed:*int) -> int:
  if x == 0 as *float || n <= 0 || rate <= 0.0 || training == 0:
    ret 0
  scale:float = 1.0 / (1.0 - rate)
  i:int = 0
  while i < n:
    (*seed) = (*seed) * 1664525 + 1013904223
    bits:int = ((*seed) >> 8) & 16777215
    r:float = (bits as float) / 16777216.0
    if r < rate:
      unsafe:
        x[i] = 0.0
    else:
      unsafe:
        x[i] = _sf(x, i) * scale
    i = i + 1
  ret 0

// ── BatchNorm ────────────────────────────────────────────────
// Applies batch normalization along the last dimension.
// x:        [seq_len, dim] input
// out:      [seq_len, dim] output
// gamma:    [dim] learnable scale (pass 0 for identity)
// beta:     [dim] learnable bias  (pass 0 for zero bias)
// run_mean: [dim] running mean (updated when training=1)
// run_var:  [dim] running variance (updated when training=1)
// momentum: exponential moving average factor (e.g. 0.1)
// eps:      numerical stability (e.g. 1e-5)
// training: 1 = update running stats, 0 = use them
fn nn_batchnorm(x:*float, out:*float, gamma:*float, beta:*float, run_mean:*float, run_var:*float, seq_len:int, dim:int, momentum:float, eps:float, training:int) -> int:
  if x == 0 as *float || out == 0 as *float || seq_len <= 0 || dim <= 0:
    ret 0 - 1
  if eps <= 0.0:
    eps = 1.0e-5
  if momentum <= 0.0:
    momentum = 0.1

  if training != 0:
    // Compute batch mean and variance over seq_len for each dimension
    j:int = 0
    while j < dim:
      mean_val:float = 0.0
      i:int = 0
      while i < seq_len:
        mean_val = mean_val + _sf(x, i * dim + j)
        i = i + 1
      mean_val = mean_val / (seq_len as float)
      var_val:float = 0.0
      i = 0
      while i < seq_len:
        d:float = _sf(x, i * dim + j) - mean_val
        var_val = var_val + d * d
        i = i + 1
      var_val = var_val / (seq_len as float)
      // Update running stats
      if run_mean != 0 as *float:
        _sw(run_mean, j, (1.0 - momentum) * _sf(run_mean, j) + momentum * mean_val)
      if run_var != 0 as *float:
        _sw(run_var, j, (1.0 - momentum) * _sf(run_var, j) + momentum * var_val)
      // Normalize
      inv_std:float = 1.0 / math.sqrt(var_val + eps)
      i = 0
      while i < seq_len:
        xv:float = _sf(x, i * dim + j)
        g:float = 1.0
        b:float = 0.0
        if gamma != 0 as *float: g = _sf(gamma, j)
        if beta != 0 as *float:  b = _sf(beta, j)
        _sw(out, i * dim + j, (xv - mean_val) * inv_std * g + b)
        i = i + 1
      j = j + 1
  else:
    // Inference: use running stats
    j:int = 0
    while j < dim:
      rm:float = 0.0
      rv:float = 1.0
      if run_mean != 0 as *float: rm = _sf(run_mean, j)
      if run_var  != 0 as *float: rv = _sf(run_var, j)
      inv_std:float = 1.0 / math.sqrt(rv + eps)
      i:int = 0
      while i < seq_len:
        xv:float = _sf(x, i * dim + j)
        g:float = 1.0
        b:float = 0.0
        if gamma != 0 as *float: g = _sf(gamma, j)
        if beta != 0 as *float:  b = _sf(beta, j)
        _sw(out, i * dim + j, (xv - rm) * inv_std * g + b)
        i = i + 1
      j = j + 1
  ret 0

// ── Conv1D ──────────────────────────────────────────────────
// 1D convolution for audio, text, and time-series data.
// input:   [in_len x in_ch] input (row = time step, col = channel)
// kernel:  [kernel_size x in_ch x out_ch] weight tensor (flattened)
// bias:    [out_ch] bias vector (pass 0 for no bias)
// output:  [out_len x out_ch] output (out_len = in_len - kernel_size + 1)
// stride:  convolution stride (1 = dense, 2 = strided)
// padding: 0 = valid, 1 = same (zero-pad each side by kernel_size/2)
fn nn_conv1d(input:*float, kern:*float, bias:*float, output:*float, in_len:int, in_ch:int, out_ch:int, kernel_size:int, stride:int, padding:int) -> int:
  if input == 0 as *float || kern == 0 as *float || output == 0 as *float:
    ret 0 - 1
  if in_len <= 0 || in_ch <= 0 || out_ch <= 0 || kernel_size <= 0:
    ret 0 - 1
  if stride <= 0:
    stride = 1

  pad:int = 0
  if padding != 0:
    pad = kernel_size / 2

  out_len:int = (in_len + 2 * pad - kernel_size) / stride + 1
  if out_len <= 0:
    ret 0 - 1

  // Zeroth output
  oi:int = 0
  while oi < out_len * out_ch:
    unsafe:
      output[oi] = 0.0
    oi = oi + 1

  // Convolution
  o:int = 0
  while o < out_ch:
    t:int = 0
    while t < out_len:
      acc:float = 0.0
      k:int = 0
      while k < kernel_size:
        src_t:int = t * stride + k - pad
        if src_t >= 0 && src_t < in_len:
          c:int = 0
          while c < in_ch:
            iv:float = _sf(input, src_t * in_ch + c)
            kv:float = _sf(kern, (k * in_ch + c) * out_ch + o)
            acc = acc + iv * kv
            c = c + 1
        k = k + 1
      bv:float = 0.0
      if bias != 0 as *float:
        bv = _sf(bias, o)
      _sw(output, t * out_ch + o, acc + bv)
      t = t + 1
    o = o + 1
  ret 0

// ── GELU (Gaussian Error Linear Unit) ───────────────────────
// In-place GELU: x[i] = x[i] * 0.5 * (1 + tanh(sqrt(2/π) * (x + 0.044715 * x³)))
// Commonly used in GPT/BERT. Uses the fast tanh approximation.
fn nn_gelu(x:*float, n:int) -> int:
  if x == 0 as *float || n <= 0:
    ret 0 - 1
  sqrt2_over_pi:float = 0.7978845608  // sqrt(2/pi)
  i:int = 0
  while i < n:
    v:float = _sf(x, i)
    inner:float = sqrt2_over_pi * (v + 0.044715 * v * v * v)
    // Fast tanh via Padé approximation
    t2:float = inner * inner
    tanh_val:float = inner * (27.0 + t2) / (27.0 + 9.0 * t2)
    if tanh_val > 1.0:  tanh_val = 1.0
    if tanh_val < 0.0 - 1.0: tanh_val = 0.0 - 1.0
    _sw(x, i, 0.5 * v * (1.0 + tanh_val))
    i = i + 1
  ret 0

// ── SiLU (Sigmoid Linear Unit / Swish) ──────────────────────
// In-place SiLU: x[i] = x[i] * sigmoid(x[i])
// Default activation in LLaMA/Mistral FFN layers.
fn nn_silu(x:*float, n:int) -> int:
  if x == 0 as *float || n <= 0:
    ret 0 - 1
  i:int = 0
  while i < n:
    v:float = _sf(x, i)
    ax:float = v
    if ax < 0.0: ax = 0.0 - ax
    sig:float = 0.5 * (v / (1.0 + ax)) + 0.5  // fast sigmoid
    _sw(x, i, v * sig)
    i = i + 1
  ret 0

// ── GLU (Gated Linear Unit) ─────────────────────────────────
// in[2*n] → out[n]: out[i] = in[i] * sigmoid(in[n+i])
// Used in MoE and gated MLP transformer variants.
fn nn_glu(in:*float, out:*float, n:int) -> int:
  if in == 0 as *float || out == 0 as *float || n <= 0:
    ret 0 - 1
  i:int = 0
  while i < n:
    v:float = _sf(in, i)
    g:float = _sf(in, n + i)
    ag:float = g
    if ag < 0.0: ag = 0.0 - ag
    sig:float = 0.5 * (g / (1.0 + ag)) + 0.5
    _sw(out, i, v * sig)
    i = i + 1
  ret 0

// ── RMSNorm (faster alternative to LayerNorm, used in LLaMA) ─
// x:     [seq_len x dim] input
// out:   [seq_len x dim] output
// gamma: [dim] scale weights (pass 0 for identity)
// eps:   numerical stability
fn nn_rmsnorm(x:*float, out:*float, gamma:*float, seq_len:int, dim:int, eps:float) -> int:
  if x == 0 as *float || out == 0 as *float || seq_len <= 0 || dim <= 0:
    ret 0 - 1
  if eps <= 0.0:
    eps = 1.0e-5
  i:int = 0
  while i < seq_len:
    sum_sq:float = 0.0
    j:int = 0
    while j < dim:
      v:float = _sf(x, i * dim + j)
      sum_sq = sum_sq + v * v
      j = j + 1
    rms_inv:float = 1.0 / math.sqrt(sum_sq / (dim as float) + eps)
    j = 0
    while j < dim:
      xv:float = _sf(x, i * dim + j)
      g:float = 1.0
      if gamma != 0 as *float: g = _sf(gamma, j)
      _sw(out, i * dim + j, xv * rms_inv * g)
      j = j + 1
    i = i + 1
  ret 0

// ── Softmax ─────────────────────────────────────────────────
// In-place row-wise softmax: x[i][j] = exp(x[i][j]) / sum(exp(x[i][*]))
// x: [seq_len x n_classes]
fn nn_softmax(x:*float, seq_len:int, n_classes:int) -> int:
  if x == 0 as *float || seq_len <= 0 || n_classes <= 0:
    ret 0 - 1
  i:int = 0
  while i < seq_len:
    // Numerically stable softmax
    max_v:float = _sf(x, i * n_classes)
    j:int = 1
    while j < n_classes:
      v:float = _sf(x, i * n_classes + j)
      if v > max_v:
        max_v = v
      j = j + 1
    sum_exp:float = 0.0
    j = 0
    while j < n_classes:
      ev:float = math.exp(_sf(x, i * n_classes + j) - max_v)
      _sw(x, i * n_classes + j, ev)
      sum_exp = sum_exp + ev
      j = j + 1
    if sum_exp > 0.0:
      inv_sum:float = 1.0 / sum_exp
      j = 0
      while j < n_classes:
        _sw(x, i * n_classes + j, _sf(x, i * n_classes + j) * inv_sum)
        j = j + 1
    i = i + 1
  ret 0

// ── Argmax ──────────────────────────────────────────────────
// Returns the index of the maximum value in a [n] float array.
fn nn_argmax(x:*float, n:int) -> int:
  if x == 0 as *float || n <= 0:
    ret 0
  best:int = 0
  best_v:float = _sf(x, 0)
  i:int = 1
  while i < n:
    v:float = _sf(x, i)
    if v > best_v:
      best_v = v
      best = i
    i = i + 1
  ret best

// ── Adam optimizer for nn slab ───────────────────────────────
// Standalone Adam training step for a network slab.
// Uses external m1/m2 moment buffers (same size as weight slab).
fn nn_adam_step(net:*float, m1:*float, m2:*float, grads:*float, n_weights:int, lr:float, step:int, beta1:float, beta2:float, eps:float) -> int:
  if net == 0 as *float || m1 == 0 as *float || m2 == 0 as *float || grads == 0 as *float:
    ret 0 - 1
  if n_weights <= 0 || lr <= 0.0 || step <= 0:
    ret 0 - 1

  tw:int = _si(net, 2)
  wb:int = _wb(tw)

  bc1:float = 1.0 - math.pow(beta1, step as float)
  bc2:float = 1.0 - math.pow(beta2, step as float)
  if bc1 < 1.0e-10: bc1 = 1.0e-10
  if bc2 < 1.0e-10: bc2 = 1.0e-10

  i:int = 0
  while i < n_weights:
    g:float = _sf(grads, i)
    p:float = _sf(net, wb + i)
    new_m1:float = beta1 * _sf(m1, i) + (1.0 - beta1) * g
    _sw(m1, i, new_m1)
    new_m2:float = beta2 * _sf(m2, i) + (1.0 - beta2) * g * g
    _sw(m2, i, new_m2)
    m1h:float = new_m1 / bc1
    m2h:float = new_m2 / bc2
    _sw(net, wb + i, p - lr * m1h / (math.sqrt(m2h) + eps))
    i = i + 1
  ret 0

// ── SwiGLU (Swish-Gated Linear Unit) ────────────────────────
// SwiGLU: out[i] = gate[i] * silu(up[i])
// gate: [n] float — gating path (from W_gate * x)
// up:   [n] float — up projection  (from W_up * x)
// out:  [n] float — output
// Used in LLaMA2/Mistral/Phi-3 style FFN blocks.
fn nn_swiglu(gate:*float, up:*float, out:*float, n:int) -> int:
  if gate == 0 as *float || up == 0 as *float || out == 0 as *float || n <= 0:
    ret 0 - 1
  i:int = 0
  while i < n:
    g:float = _sf(gate, i)
    u:float = _sf(up,   i)
    // silu(g) = g * sigmoid(g)  (fast approximation)
    ag:float = g
    if ag < 0.0: ag = 0.0 - ag
    sig_g:float = 0.5 * (g / (1.0 + ag)) + 0.5
    _sw(out, i, sig_g * g * u)
    i = i + 1
  ret 0

// ── Grouped Query Attention (GQA) ────────────────────────────
// Efficient attention where q_heads > kv_heads.
// Each KV head is shared by (q_heads/kv_heads) query heads.
//
// q:        [seq_len, q_heads * head_dim]
// k:        [seq_len, kv_heads * head_dim]
// v:        [seq_len, kv_heads * head_dim]
// out:      [seq_len, q_heads * head_dim]
// causal:   1 = autoregressive mask, 0 = bidirectional
fn nn_gqa_attention(q:*float, k:*float, v:*float, out:*float, seq_len:int, q_heads:int, kv_heads:int, head_dim:int, causal:int) -> int:
  if q == 0 as *float || k == 0 as *float || v == 0 as *float || out == 0 as *float:
    ret 0 - 1
  if q_heads <= 0 || kv_heads <= 0 || head_dim <= 0 || seq_len <= 0:
    ret 0 - 1
  if kv_heads > q_heads:
    ret 0 - 1

  groups:int = q_heads / kv_heads   // how many Q heads share each KV head
  scale:float = 1.0 / math.sqrt(head_dim as float)

  // Temporary scores buffer (per head, for one query position)
  sc_raw:*char
  unsafe:
    sc_raw = malloc(seq_len * 8)
  scores:*float
  unsafe:
    scores = sc_raw as *float

  q_dim:int  = q_heads  * head_dim
  kv_dim:int = kv_heads * head_dim

  i:int = 0
  while i < seq_len:
    qh:int = 0
    while qh < q_heads:
      kvh:int = qh / groups   // which KV head this Q head maps to

      // Compute scaled dot product scores
      max_sc:float = 0.0 - 1.0e+09
      j:int = 0
      while j < seq_len:
        if causal != 0 && j > i:
          _sw(scores, j, 0.0 - 1.0e+09)
        else:
          dot:float = 0.0
          c:int = 0
          while c < head_dim:
            qv:float = _sf(q, i * q_dim  + qh  * head_dim + c)
            kv:float = _sf(k, j * kv_dim + kvh * head_dim + c)
            dot = dot + qv * kv
            c = c + 1
          sc:float = dot * scale
          _sw(scores, j, sc)
          if sc > max_sc:
            max_sc = sc
        j = j + 1

      // Softmax
      exp_sum:float = 0.0
      j = 0
      while j < seq_len:
        if causal != 0 && j > i:
          _sw(scores, j, 0.0)
        else:
          ev:float = math.exp(_sf(scores, j) - max_sc)
          _sw(scores, j, ev)
          exp_sum = exp_sum + ev
        j = j + 1
      if exp_sum > 0.0:
        j = 0
        while j < seq_len:
          _sw(scores, j, _sf(scores, j) / exp_sum)
          j = j + 1

      // Weighted sum of values
      c:int = 0
      while c < head_dim:
        acc:float = 0.0
        j = 0
        while j < seq_len:
          attn:float = _sf(scores, j)
          vv:float   = _sf(v, j * kv_dim + kvh * head_dim + c)
          acc = acc + attn * vv
          j = j + 1
        _sw(out, i * q_dim + qh * head_dim + c, acc)
        c = c + 1

      qh = qh + 1
    i = i + 1

  unsafe:
    free(sc_raw)
  ret 0

// ── RoPE (Rotary Position Embedding) apply ───────────────────
// Apply rotary position embeddings to a matrix of Q or K vectors.
// x:        [seq_len, n_heads * head_dim]
// n_heads:  number of heads in x
// head_dim: dimension per head (must be even)
// base:     RoPE base frequency (10000.0 for standard)
// Note: modifies x in-place.
fn nn_rope_apply(x:*float, seq_len:int, n_heads:int, head_dim:int, base:float) -> int:
  if x == 0 as *float || seq_len <= 0 || n_heads <= 0 || head_dim <= 0:
    ret 0 - 1
  if (head_dim & 1) != 0:
    ret 0 - 1  // head_dim must be even
  if base <= 0.0:
    base = 10000.0

  dim:int = n_heads * head_dim
  log_base:float = math.log(base)

  pos:int = 0
  while pos < seq_len:
    h:int = 0
    while h < n_heads:
      i:int = 0
      while i < head_dim:
        // Compute rotation frequency for this pair
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = (pos as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = pos * dim + h * head_dim + i
        idx1:int = idx0 + 1
        x0:float = _sf(x, idx0)
        x1:float = _sf(x, idx1)
        _sw(x, idx0, x0 * cc - x1 * ss)
        _sw(x, idx1, x0 * ss + x1 * cc)
        i = i + 2
      h = h + 1
    pos = pos + 1
  ret 0

// ── Cross-Entropy Loss ───────────────────────────────────────
// Computes cross-entropy loss and softmax gradient in one pass.
// logits:    [vocab_size] raw unnormalized scores
// target_id: correct class index
// grad_out:  [vocab_size] output gradient buffer (d_loss/d_logit)
// Returns:   cross-entropy loss = -log(softmax[target_id])
fn nn_cross_entropy(logits:*float, target_id:int, grad_out:*float, vocab_size:int) -> float:
  if logits == 0 as *float || vocab_size <= 0 || target_id < 0 || target_id >= vocab_size:
    ret 0.0

  // Numerically stable softmax
  maxv:float = _sf(logits, 0)
  i:int = 1
  while i < vocab_size:
    v:float = _sf(logits, i)
    if v > maxv:
      maxv = v
    i = i + 1

  sum_exp:float = 0.0
  i = 0
  while i < vocab_size:
    ev:float = math.exp(_sf(logits, i) - maxv)
    if grad_out != 0 as *float:
      _sw(grad_out, i, ev)
    sum_exp = sum_exp + ev
    i = i + 1

  if sum_exp <= 0.0:
    ret 999.0  // very large loss

  // Normalize and compute loss
  target_prob:float = 0.0
  i = 0
  while i < vocab_size:
    p:float = _sf(grad_out, i) / sum_exp
    if grad_out != 0 as *float:
      _sw(grad_out, i, p)
    if i == target_id:
      target_prob = p
    i = i + 1

  // Gradient: d_loss/d_logit_i = softmax_i - 1(i==target)
  if grad_out != 0 as *float:
    old:float = _sf(grad_out, target_id)
    _sw(grad_out, target_id, old - 1.0)

  loss:float = 0.0 - math.log(target_prob + 1.0e-10)
  ret loss

// ── Top-K / Temperature Sampler ─────────────────────────────
// Sample from logits with temperature scaling and top-k filtering.
// logits:  [vocab_size] raw logits
// Returns: sampled token index
fn nn_sample_topk(logits:*float, vocab_size:int, temp:float, top_k:int, seed:*int) -> int:
  if logits == 0 as *float || vocab_size <= 0:
    ret 0
  if temp <= 0.001:
    // Greedy decode
    ret nn_argmax(logits, vocab_size)

  // Temperature scale
  i:int = 0
  while i < vocab_size:
    _sw(logits, i, _sf(logits, i) / temp)
    i = i + 1

  // Top-K filter: zero out everything below top_k
  if top_k > 0 && top_k < vocab_size:
    // Simple: find k-th largest threshold
    // We sort indices by value (insertion sort, k passes)
    threshold:float = 0.0 - 1.0e+30
    k_found:int = 0
    while k_found < top_k:
      best_v:float = 0.0 - 1.0e+30
      j:int = 0
      while j < vocab_size:
        v:float = _sf(logits, j)
        if v > best_v && v < threshold + 1.0e-10:
          best_v = v
        j = j + 1
      threshold = best_v
      k_found = k_found + 1
    // Zero below threshold
    i = 0
    while i < vocab_size:
      if _sf(logits, i) < threshold:
        _sw(logits, i, 0.0 - 1.0e+30)
      i = i + 1

  // Softmax
  maxv:float = _sf(logits, 0)
  i = 1
  while i < vocab_size:
    v:float = _sf(logits, i)
    if v > maxv:
      maxv = v
    i = i + 1

  sum_e:float = 0.0
  i = 0
  while i < vocab_size:
    ev:float = math.exp(_sf(logits, i) - maxv)
    _sw(logits, i, ev)
    sum_e = sum_e + ev
    i = i + 1

  if sum_e <= 0.0:
    ret 0

  // Sample
  if seed != 0 as *int:
    (*seed) = (*seed) * 1664525 + 1013904223
    bits:int = ((*seed) >> 8) & 16777215
    r:float = (bits as float) / 16777216.0
    cdf:float = 0.0
    i = 0
    while i < vocab_size:
      cdf = cdf + _sf(logits, i) / sum_e
      if r < cdf:
        ret i
      i = i + 1
  ret nn_argmax(logits, vocab_size)

// ── AdamW weight update step (decoupled weight decay) ────────
// Applies AdamW: param = param * (1 - lr * wd) - lr * adam_update
// params: weight slab
// grads:  gradient slab (same size)
// m1/m2:  Adam moment buffers (same size)
// n:      number of parameters
// lr:     learning rate
// step:   current training step (1-indexed)
// beta1:  0.9 typical
// beta2:  0.999 typical
// eps:    1e-8 typical
// wd:     weight decay (0.01 typical)
fn nn_adamw_step(params:*float, grads:*float, m1:*float, m2:*float, n:int, lr:float, step:int, beta1:float, beta2:float, eps:float, wd:float) -> int:
  if params == 0 as *float || grads == 0 as *float || m1 == 0 as *float || m2 == 0 as *float:
    ret 0 - 1
  if n <= 0 || step <= 0:
    ret 0 - 1

  bc1:float = 1.0 - math.pow(beta1, step as float)
  bc2:float = 1.0 - math.pow(beta2, step as float)
  if bc1 < 1.0e-10: bc1 = 1.0e-10
  if bc2 < 1.0e-10: bc2 = 1.0e-10

  i:int = 0
  while i < n:
    g:float = _sf(grads, i)
    p:float = _sf(params, i)
    new_m1:float = beta1 * _sf(m1, i) + (1.0 - beta1) * g
    _sw(m1, i, new_m1)
    new_m2:float = beta2 * _sf(m2, i) + (1.0 - beta2) * g * g
    _sw(m2, i, new_m2)
    m1h:float = new_m1 / bc1
    m2h:float = new_m2 / bc2
    // AdamW: decouple weight decay from gradient
    new_p:float = p * (1.0 - lr * wd) - lr * m1h / (math.sqrt(m2h) + eps)
    _sw(params, i, new_p)
    i = i + 1
  ret 0

// ── Gradient Clipping (max-norm) ─────────────────────────────
// Clips gradient vector to max L2 norm.
// grads:    [n] float gradient slab
// max_norm: maximum allowed L2 norm (e.g. 1.0)
// Returns:  gradient norm before clipping
fn nn_clip_grad_norm(grads:*float, n:int, max_norm:float) -> float:
  if grads == 0 as *float || n <= 0 || max_norm <= 0.0:
    ret 0.0
  sq_sum:float = 0.0
  i:int = 0
  while i < n:
    g:float = _sf(grads, i)
    sq_sum = sq_sum + g * g
    i = i + 1
  norm:float = math.sqrt(sq_sum)
  if norm > max_norm:
    scale:float = max_norm / (norm + 1.0e-10)
    i = 0
    while i < n:
      _sw(grads, i, _sf(grads, i) * scale)
      i = i + 1
  ret norm

// ── Zero gradients ───────────────────────────────────────────
fn nn_zero_grad(grads:*float, n:int) -> int:
  if grads == 0 as *float || n <= 0:
    ret 0 - 1
  i:int = 0
  while i < n:
    _sw(grads, i, 0.0)
    i = i + 1
  ret 0
