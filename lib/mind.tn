// ============================================================
// mind.tn  â€”  TezzMind Core GQA Transformer Model Library  v3.0
// ============================================================

import "math"
import "str"
import "nn"

extern fn nn_matmul_avx2(x:*float, w:*float, out:*float, T:int, in_dim:int, out_dim:int) -> int

let MIND_MAGIC:int = 1296385348  // TezzMind v1 checkpoint magic
let MIND_LEGACY_NN_MAGIC:int = 1414676301

// Header slot indices
let _MH_MAGIC:int   = 0
let _MH_VOCAB:int   = 1
let _MH_DIM:int     = 2
let _MH_QH:int      = 3
let _MH_KVH:int     = 4
let _MH_LAYERS:int  = 5
let _MH_SEQLEN:int  = 6
let _MH_FFN:int     = 7
let _MH_HDIM:int    = 8
let _MH_NW:int      = 9
let _MH_KVOFF:int   = 10
let _MH_WOFF:int    = 11
let _MH_HDR:int     = 16

// â”€â”€ Slab accessors â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn _mf(s:*float, i:int) -> float:
  v:float = 0.0
  unsafe:
    v = s[i]
  ret v

fn _mw(s:*float, i:int, v:float) -> int:
  unsafe:
    s[i] = v
  ret 0

fn _mi(s:*float, i:int) -> int:
  ret _mf(s, i) as int

fn _mwi(s:*float, i:int, v:int) -> int:
  _mw(s, i, v as float)
  ret 0

// â”€â”€ PRNG â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

static let _mind_seed:int = 31337

fn _mrand() -> float:
  _mind_seed = _mind_seed * 1664525 + 1013904223
  bits:int = (_mind_seed >> 8) & 16777215
  ret (bits as float) / 16777216.0 - 0.5

fn mind_set_seed(s:int) -> int:
  _mind_seed = s
  ret 0

// â”€â”€ Compute weight counts â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn _mind_layer_weights(dim:int, q_heads:int, kv_heads:int, head_dim:int, ffn:int) -> int:
  w_q_sz:int = dim * q_heads * head_dim
  w_k_sz:int = dim * kv_heads * head_dim
  w_v_sz:int = dim * kv_heads * head_dim
  w_o_sz:int = q_heads * head_dim * dim
  w_gate_sz:int = dim * ffn
  w_up_sz:int = dim * ffn
  w_down_sz:int = ffn * dim

  sum1:int = dim + w_q_sz
  sum2:int = sum1 + w_k_sz
  sum3:int = sum2 + w_v_sz
  sum4:int = sum3 + w_o_sz
  sum5:int = sum4 + dim
  sum6:int = sum5 + w_gate_sz
  sum7:int = sum6 + w_up_sz
  sum8:int = sum7 + w_down_sz
  ret sum8

fn _mind_total_weights(vocab:int, dim:int, q_heads:int, kv_heads:int, layers:int, head_dim:int, ffn:int) -> int:
  lw:int = _mind_layer_weights(dim, q_heads, kv_heads, head_dim, ffn)
  embed_sz:int = vocab * dim
  layers_sz:int = layers * lw
  final_ln_sz:int = dim
  lm_head_sz:int = dim * vocab

  sum1:int = embed_sz + layers_sz
  sum2:int = sum1 + final_ln_sz
  sum3:int = sum2 + lm_head_sz
  ret sum3

fn _mind_kv_size(layers:int, max_seq:int, kv_heads:int, head_dim:int) -> int:
  ret layers * 2 * max_seq * kv_heads * head_dim

// â”€â”€ Layer offsets â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn _layer_weights_start(vocab:int, dim:int, q_heads:int, kv_heads:int, head_dim:int, ffn:int, l:int) -> int:
  w_start:int = vocab * dim
  lw_sz:int = _mind_layer_weights(dim, q_heads, kv_heads, head_dim, ffn)
  ret w_start + l * lw_sz

// â”€â”€ mind_new: allocate and init a TezzMind model â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn mind_new(vocab:int, dim:int, q_heads:int, kv_heads:int, layers:int, ffn:int, max_seq:int) -> *float:
  if vocab <= 0 || dim <= 0 || q_heads <= 0 || kv_heads <= 0 || layers <= 0 || ffn <= 0 || max_seq <= 0:
    ret 0 as *float
  if q_heads % kv_heads != 0:
    ret 0 as *float

  head_dim:int = dim / q_heads
  if head_dim <= 0 || dim % q_heads != 0 || (head_dim & 1) != 0:
    ret 0 as *float

  nw:int     = _mind_total_weights(vocab, dim, q_heads, kv_heads, layers, head_dim, ffn)
  kv_sz:int  = _mind_kv_size(layers, max_seq, kv_heads, head_dim)
  kv_off:int = _MH_HDR
  w_off:int  = kv_off + kv_sz
  total:int  = w_off + nw

  raw:*char
  unsafe:
    raw = malloc(total * 8)
  if raw == 0:
    ret 0 as *float

  model:*float
  unsafe:
    model = raw as *float

  // Zero the entire slab
  i:int = 0
  while i < total:
    _mw(model, i, 0.0)
    i = i + 1

  // Write header
  _mwi(model, _MH_MAGIC,  MIND_MAGIC)
  _mwi(model, _MH_VOCAB,  vocab)
  _mwi(model, _MH_DIM,    dim)
  _mwi(model, _MH_QH,     q_heads)
  _mwi(model, _MH_KVH,    kv_heads)
  _mwi(model, _MH_LAYERS, layers)
  _mwi(model, _MH_SEQLEN, max_seq)
  _mwi(model, _MH_FFN,    ffn)
  _mwi(model, _MH_HDIM,   head_dim)
  _mwi(model, _MH_NW,     nw)
  _mwi(model, _MH_KVOFF,  kv_off)
  _mwi(model, _MH_WOFF,   w_off)

  // Xavier/Glorot weight init
  wi:int = w_off

  // Token embedding: vocab * dim
  fan_e:float = (vocab + dim) as float
  sc_e:float = math.sqrt(6.0 / fan_e)
  j:int = 0
  while j < vocab * dim:
    _mw(model, wi + j, _mrand() * 2.0 * sc_e)
    j = j + 1
  wi = wi + vocab * dim

  // Per-layer weights
  l:int = 0
  while l < layers:
    // RMSNorm 1: ones
    j = 0
    while j < dim:
      _mw(model, wi + j, 1.0)
      j = j + 1
    wi = wi + dim

    // w_q: dim Ã— q_dim
    q_out:int = q_heads * head_dim
    fan_q:float = (dim + q_out) as float
    sc_q:float = math.sqrt(6.0 / fan_q)
    j = 0
    while j < dim * q_out:
      _mw(model, wi + j, _mrand() * 2.0 * sc_q)
      j = j + 1
    wi = wi + dim * q_out

    // w_k: dim Ã— kv_dim
    kv_out:int = kv_heads * head_dim
    fan_k:float = (dim + kv_out) as float
    sc_k:float = math.sqrt(6.0 / fan_k)
    j = 0
    while j < dim * kv_out:
      _mw(model, wi + j, _mrand() * 2.0 * sc_k)
      j = j + 1
    wi = wi + dim * kv_out

    // w_v: dim Ã— kv_dim
    j = 0
    while j < dim * kv_out:
      _mw(model, wi + j, _mrand() * 2.0 * sc_k)
      j = j + 1
    wi = wi + dim * kv_out

    // w_o: q_dim Ã— dim
    fan_o:float = (q_out + dim) as float
    sc_o:float = math.sqrt(6.0 / fan_o)
    j = 0
    while j < q_out * dim:
      _mw(model, wi + j, _mrand() * 2.0 * sc_o)
      j = j + 1
    wi = wi + q_out * dim

    // RMSNorm 2: ones
    j = 0
    while j < dim:
      _mw(model, wi + j, 1.0)
      j = j + 1
    wi = wi + dim

    // w_gate: dim Ã— ffn
    fan_g:float = (dim + ffn) as float
    sc_g:float = math.sqrt(6.0 / fan_g)
    j = 0
    while j < dim * ffn:
      _mw(model, wi + j, _mrand() * 2.0 * sc_g)
      j = j + 1
    wi = wi + dim * ffn

    // w_up: dim Ã— ffn
    j = 0
    while j < dim * ffn:
      _mw(model, wi + j, _mrand() * 2.0 * sc_g)
      j = j + 1
    wi = wi + dim * ffn

    // w_down: ffn Ã— dim
    fan_d:float = (ffn + dim) as float
    sc_d:float = math.sqrt(6.0 / fan_d)
    j = 0
    while j < ffn * dim:
      _mw(model, wi + j, _mrand() * 2.0 * sc_d)
      j = j + 1
    wi = wi + ffn * dim

    l = l + 1

  // Final RMSNorm: ones
  j = 0
  while j < dim:
    _mw(model, wi + j, 1.0)
    j = j + 1
  wi = wi + dim

  // lm_head: dim Ã— vocab (small init)
  fan_lm:float = (dim + vocab) as float
  sc_lm:float = math.sqrt(6.0 / fan_lm) * 0.1
  j = 0
  while j < dim * vocab:
    _mw(model, wi + j, _mrand() * 2.0 * sc_lm)
    j = j + 1

  ret model

// â”€â”€ mind_free â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn mind_free(model:*float) -> int:
  if model == 0 as *float: ret 0
  unsafe:
    free(model as *char)
  ret 0

// â”€â”€ mind_info â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn mind_info(model:*float) -> int:
  if model == 0 as *float: ret 0 - 1
  vocab:int  = _mi(model, _MH_VOCAB)
  dim:int    = _mi(model, _MH_DIM)
  qh:int     = _mi(model, _MH_QH)
  kvh:int    = _mi(model, _MH_KVH)
  layers:int = _mi(model, _MH_LAYERS)
  seqlen:int = _mi(model, _MH_SEQLEN)
  ffn:int    = _mi(model, _MH_FFN)
  hdim:int   = _mi(model, _MH_HDIM)
  nw:int     = _mi(model, _MH_NW)
  say "+------------------------------------------+"
  say "|       TezzMind Model Architecture        |"
  say "+------------------------------------------+"
  say "| vocab_size:  ", vocab
  say "| embed_dim:   ", dim
  say "| q_heads:     ", qh, "  kv_heads: ", kvh, " (GQA ratio: ", qh / kvh, ":1)"
  say "| head_dim:    ", hdim
  say "| layers:      ", layers
  say "| ffn_hidden:  ", ffn
  say "| max_seq_len: ", seqlen
  say "| parameters:  ", nw, " (~", nw / 1000000, "M)"
  say "| RAM (f64):   ~", (nw * 8) / (1024 * 1024), " MB"
  say "+------------------------------------------+"
  ret 0

fn mind_get_nw(model:*float) -> int:
  if model == 0 as *float: ret 0
  ret _mi(model, _MH_NW)

fn mind_is_valid(model:*float) -> int:
  if model == 0 as *float:
    ret 0
  if _mi(model, _MH_MAGIC) != MIND_MAGIC:
    ret 0
  vocab:int = _mi(model, _MH_VOCAB)
  dim:int = _mi(model, _MH_DIM)
  q_heads:int = _mi(model, _MH_QH)
  kv_heads:int = _mi(model, _MH_KVH)
  layers:int = _mi(model, _MH_LAYERS)
  max_seq:int = _mi(model, _MH_SEQLEN)
  ffn:int = _mi(model, _MH_FFN)
  ret _mind_header_valid(vocab, dim, q_heads, kv_heads, layers, max_seq, ffn)

fn _mind_hash_float(acc:int, v:float, salt:int) -> int:
  if v != v:
    ret 0 - 1
  x:float = v
  sign:int = 0
  if x < 0.0:
    sign = 1
    x = 0.0 - x
  scaled:int = (x * 1000000.0) as int
  mixed:int = (acc * 131 + scaled + salt * 17 + sign * 8191) & 2147483647
  ret mixed

fn mind_weight_checksum(model:*float, max_weights:int) -> int:
  if mind_is_valid(model) == 0:
    ret 0
  nw:int = _mi(model, _MH_NW)
  w_off:int = _mi(model, _MH_WOFF)
  lim:int = max_weights
  if lim <= 0 || lim > nw:
    lim = nw
  acc:int = 17
  acc = (acc * 131 + _mi(model, _MH_VOCAB)) & 2147483647
  acc = (acc * 131 + _mi(model, _MH_DIM)) & 2147483647
  acc = (acc * 131 + _mi(model, _MH_LAYERS)) & 2147483647
  i:int = 0
  while i < lim:
    acc = _mind_hash_float(acc, _mf(model, w_off + i), i)
    if acc < 0:
      ret 0
    i = i + 1
  ret acc

fn mind_logits_checksum(logits:*float, n:int) -> int:
  if logits == 0 as *float || n <= 0:
    ret 0
  acc:int = 23
  i:int = 0
  while i < n:
    acc = _mind_hash_float(acc, _mf(logits, i), i)
    if acc < 0:
      ret 0
    i = i + 1
  ret acc

fn mind_argmax(logits:*float, n:int) -> int:
  if logits == 0 as *float || n <= 0:
    ret 0 - 1
  best:int = 0
  best_v:float = _mf(logits, 0)
  i:int = 1
  while i < n:
    v:float = _mf(logits, i)
    if v > best_v:
      best_v = v
      best = i
    i = i + 1
  ret best

fn mind_eval_next_token_accuracy(model:*float, text:str, max_steps:int) -> int:
  if mind_is_valid(model) == 0 || text == 0 || max_steps <= 0:
    ret 0 - 1
  vocab:int = _mi(model, _MH_VOCAB)
  max_seq:int = _mi(model, _MH_SEQLEN)
  text_len:int = len(text)
  if text_len < 2:
    ret 0 - 1
  steps:int = max_steps
  if steps > text_len - 1:
    steps = text_len - 1
  if steps > max_seq:
    steps = max_seq
  logits_raw:*char
  unsafe:
    logits_raw = malloc(vocab * 8)
  if logits_raw == 0:
    ret 0 - 1
  logits:*float
  unsafe:
    logits = logits_raw as *float
  correct:int = 0
  i:int = 0
  while i < steps:
    tok:int = (text as *char)[i] as int & 255
    target:int = (text as *char)[i + 1] as int & 255
    if tok >= vocab:
      tok = tok % vocab
    if target >= vocab:
      target = target % vocab
    if mind_forward(model, tok, i, logits) != 0:
      unsafe:
        free(logits_raw)
      ret 0 - 1
    if mind_argmax(logits, vocab) == target:
      correct = correct + 1
    i = i + 1
  unsafe:
    free(logits_raw)
  ret correct

// â”€â”€ Mathematical Primitives â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn _rmsnorm_forward(x:*float, out:*float, gamma:*float, T:int, dim:int) -> int:
  eps:float = 1.0e-05
  t:int = 0
  while t < T:
    sq_sum:float = 0.0
    j:int = 0
    while j < dim:
      v:float = _mf(x, t * dim + j)
      sq_sum = sq_sum + v * v
      j = j + 1
    rms_inv:float = 1.0 / math.sqrt(sq_sum / (dim as float) + eps)
    j = 0
    while j < dim:
      xv:float = _mf(x, t * dim + j)
      g:float = 1.0
      if gamma != 0 as *float:
        g = _mf(gamma, j)
      _mw(out, t * dim + j, xv * rms_inv * g)
      j = j + 1
    t = t + 1
  ret 0

fn _rmsnorm_backward(dx_norm:*float, x:*float, gamma:*float, dx:*float, dgamma:*float, T:int, dim:int) -> int:
  eps:float = 1.0e-05
  t:int = 0
  while t < T:
    sq_sum:float = 0.0
    j:int = 0
    while j < dim:
      v:float = _mf(x, t * dim + j)
      sq_sum = sq_sum + v * v
      j = j + 1
    rms:float = math.sqrt(sq_sum / (dim as float) + eps)
    rms_inv:float = 1.0 / rms

    sum_dy_x_gamma:float = 0.0
    j = 0
    while j < dim:
      xv:float = _mf(x, t * dim + j)
      dyn:float = _mf(dx_norm, t * dim + j)
      g:float = 1.0
      if gamma != 0 as *float:
        g = _mf(gamma, j)
      sum_dy_x_gamma = sum_dy_x_gamma + dyn * xv * g
      j = j + 1

    j = 0
    while j < dim:
      xv = _mf(x, t * dim + j)
      dyn = _mf(dx_norm, t * dim + j)
      g = 1.0
      if gamma != 0 as *float:
        g = _mf(gamma, j)

      term1:float = (g * dyn) * rms_inv
      term2:float = (xv * rms_inv * rms_inv * rms_inv / (dim as float)) * sum_dy_x_gamma
      _mw(dx, t * dim + j, _mf(dx, t * dim + j) + term1 - term2)

      if dgamma != 0 as *float:
        _mw(dgamma, j, _mf(dgamma, j) + dyn * xv * rms_inv)
      j = j + 1
    t = t + 1
  ret 0

fn _matmul_forward_scalar(x:*float, w:*float, out:*float, T:int, in_dim:int, out_dim:int) -> int:
  if x == 0 as *float || w == 0 as *float || out == 0 as *float:
    ret 0 - 1
  if T <= 0 || in_dim <= 0 || out_dim <= 0:
    ret 0 - 1
  t:int = 0
  while t < T:
    j:int = 0
    while j < out_dim:
      acc:float = 0.0
      k:int = 0
      while k < in_dim:
        acc = acc + _mf(x, t * in_dim + k) * _mf(w, k * out_dim + j)
        k = k + 1
      _mw(out, t * out_dim + j, acc)
      j = j + 1
    t = t + 1
  ret 0

fn _matmul_forward(x:*float, w:*float, out:*float, T:int, in_dim:int, out_dim:int) -> int:
  if out == x || out == w:
    slots:int = T * out_dim
    tmp_raw:*char
    unsafe:
      tmp_raw = malloc(slots * 8)
    if tmp_raw == 0:
      ret 0 - 1
    tmp:*float = tmp_raw as *float
    rc_alias:int = _matmul_forward_scalar(x, w, tmp, T, in_dim, out_dim)
    i:int = 0
    while i < slots:
      _mw(out, i, _mf(tmp, i))
      i = i + 1
    unsafe:
      free(tmp_raw)
    ret rc_alias
  rc:int = nn_matmul_avx2(x, w, out, T, in_dim, out_dim)
  if rc == 0:
    ret 0
  ret _matmul_forward_scalar(x, w, out, T, in_dim, out_dim)

fn _matmul_backward_inputs(dy:*float, w:*float, dx:*float, T:int, in_dim:int, out_dim:int) -> int:
  t:int = 0
  while t < T:
    k:int = 0
    while k < in_dim:
      acc:float = 0.0
      j:int = 0
      while j < out_dim:
        acc = acc + _mf(dy, t * out_dim + j) * _mf(w, k * out_dim + j)
        j = j + 1
      _mw(dx, t * in_dim + k, _mf(dx, t * in_dim + k) + acc)
      k = k + 1
    t = t + 1
  ret 0

fn _matmul_backward_weights(x:*float, dy:*float, dw:*float, T:int, in_dim:int, out_dim:int) -> int:
  k:int = 0
  while k < in_dim:
    j:int = 0
    while j < out_dim:
      acc:float = 0.0
      t:int = 0
      while t < T:
        acc = acc + _mf(x, t * in_dim + k) * _mf(dy, t * out_dim + j)
        t = t + 1
      _mw(dw, k * out_dim + j, _mf(dw, k * out_dim + j) + acc)
      j = j + 1
    k = k + 1
  ret 0

fn _rope_forward(q:*float, k:*float, T:int, q_heads:int, kv_heads:int, head_dim:int, pos_offset:int) -> int:
  eps_base:float = 10000.0
  log_base:float = math.log(eps_base)
  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * q_heads * head_dim + qh * head_dim + i
        idx1:int = idx0 + 1
        q0:float = _mf(q, idx0)
        q1:float = _mf(q, idx1)
        _mw(q, idx0, q0 * cc - q1 * ss)
        _mw(q, idx1, q0 * ss + q1 * cc)
        i = i + 2
      qh = qh + 1

    kvh:int = 0
    while kvh < kv_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * kv_heads * head_dim + kvh * head_dim + i
        idx1:int = idx0 + 1
        k0:float = _mf(k, idx0)
        k1:float = _mf(k, idx1)
        _mw(k, idx0, k0 * cc - k1 * ss)
        _mw(k, idx1, k0 * ss + k1 * cc)
        i = i + 2
      kvh = kvh + 1
    t = t + 1
  ret 0

fn _rope_backward(dq:*float, dk:*float, T:int, q_heads:int, kv_heads:int, head_dim:int, pos_offset:int) -> int:
  eps_base:float = 10000.0
  log_base:float = math.log(eps_base)
  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * q_heads * head_dim + qh * head_dim + i
        idx1:int = idx0 + 1
        dq0:float = _mf(dq, idx0)
        dq1:float = _mf(dq, idx1)
        _mw(dq, idx0, dq0 * cc + dq1 * ss)
        _mw(dq, idx1, (0.0 - dq0) * ss + dq1 * cc)
        i = i + 2
      qh = qh + 1

    kvh:int = 0
    while kvh < kv_heads:
      i:int = 0
      while i < head_dim:
        freq:float = math.exp((0.0 - log_base) * ((i as float) / (head_dim as float)))
        angle:float = ((t + pos_offset) as float) * freq
        cc:float = math.cos(angle)
        ss:float = math.sin(angle)
        idx0:int = t * kv_heads * head_dim + kvh * head_dim + i
        idx1:int = idx0 + 1
        dk0:float = _mf(dk, idx0)
        dk1:float = _mf(dk, idx1)
        _mw(dk, idx0, dk0 * cc + dk1 * ss)
        _mw(dk, idx1, (0.0 - dk0) * ss + dk1 * cc)
        i = i + 2
      kvh = kvh + 1
    t = t + 1
  ret 0

fn _gqa_forward(q:*float, k:*float, v:*float, out:*float, probs_buf:*float, T:int, q_heads:int, kv_heads:int, head_dim:int) -> int:
  groups:int = q_heads / kv_heads
  scale:float = 1.0 / math.sqrt(head_dim as float)

  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      kvh:int = qh / groups

      max_score:float = 0.0 - 1.0e+09
      p:int = 0
      while p <= t:
        dot:float = 0.0
        c:int = 0
        while c < head_dim:
          qv:float = _mf(q, t * q_heads * head_dim + qh * head_dim + c)
          kv:float = _mf(k, p * kv_heads * head_dim + kvh * head_dim + c)
          dot = dot + qv * kv
          c = c + 1
        score:float = dot * scale
        _mw(probs_buf, t * q_heads * T + qh * T + p, score)
        if score > max_score:
          max_score = score
        p = p + 1

      exp_sum:float = 0.0
      p = 0
      while p <= t:
        sc:float = _mf(probs_buf, t * q_heads * T + qh * T + p)
        ev:float = math.exp(sc - max_score)
        _mw(probs_buf, t * q_heads * T + qh * T + p, ev)
        exp_sum = exp_sum + ev
        p = p + 1

      if exp_sum > 0.0:
        p = 0
        while p <= t:
          ev:float = _mf(probs_buf, t * q_heads * T + qh * T + p)
          _mw(probs_buf, t * q_heads * T + qh * T + p, ev / exp_sum)
          p = p + 1

      c = 0
      while c < head_dim:
        acc:float = 0.0
        p = 0
        while p <= t:
          attn:float = _mf(probs_buf, t * q_heads * T + qh * T + p)
          vv:float = _mf(v, p * kv_heads * head_dim + kvh * head_dim + c)
          acc = acc + attn * vv
          p = p + 1
        _mw(out, t * q_heads * head_dim + qh * head_dim + c, acc)
        c = c + 1

      qh = qh + 1
    t = t + 1
  ret 0

fn _gqa_backward(dq:*float, dk:*float, dv:*float, q:*float, k:*float, v:*float, probs_buf:*float, d_out:*float, d_probs_temp:*float, T:int, q_heads:int, kv_heads:int, head_dim:int) -> int:
  groups:int = q_heads / kv_heads
  scale:float = 1.0 / math.sqrt(head_dim as float)

  t:int = 0
  while t < T:
    qh:int = 0
    while qh < q_heads:
      kvh:int = qh / groups

      p:int = 0
      while p <= t:
        d_pr:float = 0.0
        c:int = 0
        while c < head_dim:
          do:float = _mf(d_out, t * q_heads * head_dim + qh * head_dim + c)
          vv:float = _mf(v, p * kv_heads * head_dim + kvh * head_dim + c)
          d_pr = d_pr + do * vv
          c = c + 1
        _mw(d_probs_temp, p, d_pr)

        pr:float = _mf(probs_buf, t * q_heads * T + qh * T + p)
        c = 0
        while c < head_dim:
          do = _mf(d_out, t * q_heads * head_dim + qh * head_dim + c)
          idx:int = p * kv_heads * head_dim + kvh * head_dim + c
          _mw(dv, idx, _mf(dv, idx) + pr * do)
          c = c + 1
        p = p + 1

      sum_dpr_pr:float = 0.0
      p = 0
      while p <= t:
        d_pr:float = _mf(d_probs_temp, p)
        pr:float = _mf(probs_buf, t * q_heads * T + qh * T + p)
        sum_dpr_pr = sum_dpr_pr + d_pr * pr
        p = p + 1

      p = 0
      while p <= t:
        d_pr = _mf(d_probs_temp, p)
        pr = _mf(probs_buf, t * q_heads * T + qh * T + p)
        d_sc:float = pr * (d_pr - sum_dpr_pr)

        c = 0
        while c < head_dim:
          qv:float = _mf(q, t * q_heads * head_dim + qh * head_dim + c)
          kv:float = _mf(k, p * kv_heads * head_dim + kvh * head_dim + c)

          q_idx:int = t * q_heads * head_dim + qh * head_dim + c
          k_idx:int = p * kv_heads * head_dim + kvh * head_dim + c

          _mw(dq, q_idx, _mf(dq, q_idx) + d_sc * kv * scale)
          _mw(dk, k_idx, _mf(dk, k_idx) + d_sc * qv * scale)
          c = c + 1
        p = p + 1

      qh = qh + 1
    t = t + 1
  ret 0

fn _swiglu_forward(gate:*float, up:*float, out:*float, T:int, ffn:int) -> int:
  t:int = 0
  while t < T:
    i:int = 0
    while i < ffn:
      g:float = _mf(gate, t * ffn + i)
      u:float = _mf(up, t * ffn + i)
      ag:float = g
      if ag < 0.0:
        ag = 0.0 - ag
      sig_g:float = 0.5 * (g / (1.0 + ag)) + 0.5
      _mw(out, t * ffn + i, sig_g * g * u)
      i = i + 1
    t = t + 1
  ret 0

fn _swiglu_backward(d_out:*float, gate:*float, up:*float, d_gate:*float, d_up:*float, T:int, ffn:int) -> int:
  t:int = 0
  while t < T:
    i:int = 0
    while i < ffn:
      g:float = _mf(gate, t * ffn + i)
      u:float = _mf(up, t * ffn + i)
      do:float = _mf(d_out, t * ffn + i)

      ag:float = g
      if ag < 0.0:
        ag = 0.0 - ag
      sig_g:float = 0.5 * (g / (1.0 + ag)) + 0.5

      dsilu:float = sig_g * (1.0 + g * (1.0 - sig_g))

      _mw(d_up, t * ffn + i, _mf(d_up, t * ffn + i) + do * (sig_g * g))
      _mw(d_gate, t * ffn + i, _mf(d_gate, t * ffn + i) + do * u * dsilu)
      i = i + 1
    t = t + 1
  ret 0

// â”€â”€ mind_forward: single token forward pass (inference) â”€â”€â”€â”€â”€â”€â”€

fn mind_forward(model:*float, token_id:int, pos:int, logits:*float) -> int:
  if model == 0 as *float || logits == 0 as *float: ret 0 - 1
  if mind_is_valid(model) == 0: ret 0 - 1

  vocab:int   = _mi(model, _MH_VOCAB)
  dim:int     = _mi(model, _MH_DIM)
  q_heads:int = _mi(model, _MH_QH)
  kv_heads:int = _mi(model, _MH_KVH)
  layers:int  = _mi(model, _MH_LAYERS)
  max_seq:int = _mi(model, _MH_SEQLEN)
  ffn:int     = _mi(model, _MH_FFN)
  head_dim:int = _mi(model, _MH_HDIM)
  kv_off:int  = _mi(model, _MH_KVOFF)
  w_off:int   = _mi(model, _MH_WOFF)

  q_dim:int  = q_heads  * head_dim
  kv_dim:int = kv_heads * head_dim

  if token_id < 0 || token_id >= vocab: ret 0 - 1
  if pos < 0 || pos >= max_seq: ret 0 - 1

  ws_raw:*char
  unsafe:
    ws_raw = malloc((dim * 8 + ffn) * 8)
  if ws_raw == 0:
    ret 0 - 1
  x:*float; x_res:*float; x_norm:*float; q:*float; k:*float; v:*float; attn_out:*float; ffn_out:*float; ffn_down:*float
  unsafe:
    x       = (ws_raw + dim * 8 * 0) as *float
    x_res   = (ws_raw + dim * 8 * 1) as *float
    x_norm  = (ws_raw + dim * 8 * 2) as *float
    q       = (ws_raw + dim * 8 * 3) as *float
    k       = (ws_raw + dim * 8 * 4) as *float
    v       = (ws_raw + dim * 8 * 5) as *float
    attn_out = (ws_raw + dim * 8 * 6) as *float
    ffn_out  = (ws_raw + dim * 8 * 7) as *float
    ffn_down = (ws_raw + (dim * 7 + ffn) * 8) as *float

  // Token embedding lookup
  wi:int = w_off + token_id * dim
  j:int = 0
  while j < dim:
    _mw(x, j, _mf(model, wi + j))
    j = j + 1

  lw:int = w_off + vocab * dim

  l:int = 0
  while l < layers:
    j = 0
    while j < dim:
      _mw(x_res, j, _mf(x, j))
      j = j + 1

    // RMSNorm 1
    ln1_off:int = lw
    ln1_w:*float
    unsafe:
      ln1_w = (model as *char + ln1_off * 8) as *float
    _rmsnorm_forward(x, x_norm, ln1_w, 1, dim)
    lw = lw + dim

    // Projections Q, K, V
    w_q_off:int = lw; lw = lw + dim * q_dim
    w_k_off:int = lw; lw = lw + dim * kv_dim
    w_v_off:int = lw; lw = lw + dim * kv_dim
    w_o_off:int = lw; lw = lw + q_dim * dim

    w_q:*float; w_k:*float; w_v:*float; w_o:*float
    unsafe:
      w_q = (model as *char + w_q_off * 8) as *float
      w_k = (model as *char + w_k_off * 8) as *float
      w_v = (model as *char + w_v_off * 8) as *float
      w_o = (model as *char + w_o_off * 8) as *float

    _matmul_forward(x_norm, w_q, q, 1, dim, q_dim)
    _matmul_forward(x_norm, w_k, k, 1, dim, kv_dim)
    _matmul_forward(x_norm, w_v, v, 1, dim, kv_dim)

    // RoPE
    _rope_forward(q, k, 1, q_heads, kv_heads, head_dim, pos)

    // Write K, V to Cache
    kv_layer_sz:int = 2 * max_seq * kv_dim
    kv_k_off:int = kv_off + l * kv_layer_sz + pos * kv_dim
    kv_v_off:int = kv_off + l * kv_layer_sz + max_seq * kv_dim + pos * kv_dim
    j = 0
    while j < kv_dim:
      _mw(model, kv_k_off + j, _mf(k, j))
      _mw(model, kv_v_off + j, _mf(v, j))
      j = j + 1

    // GQA Attention
    groups:int = q_heads / kv_heads
    scale:float = 1.0 / math.sqrt(head_dim as float)

    sc_raw:*char
    unsafe:
      sc_raw = malloc((pos + 1) * 8)
    if sc_raw == 0:
      unsafe:
        free(ws_raw)
      ret 0 - 1
    scores:*float
    unsafe:
      scores = sc_raw as *float

    qhh:int = 0
    while qhh < q_heads:
      kvhh:int = qhh / groups

      max_sc:float = 0.0 - 1.0e+09
      p_idx:int = 0
      while p_idx <= pos:
        dot:float = 0.0
        c:int = 0
        while c < head_dim:
          qv:float = _mf(q, qhh * head_dim + c)
          kv:float = _mf(model, kv_off + l * kv_layer_sz + p_idx * kv_dim + kvhh * head_dim + c)
          dot = dot + qv * kv
          c = c + 1
        sc:float = dot * scale
        _mw(scores, p_idx, sc)
        if sc > max_sc:
          max_sc = sc
        p_idx = p_idx + 1

      exp_sum:float = 0.0
      p_idx = 0
      while p_idx <= pos:
        ev:float = math.exp(_mf(scores, p_idx) - max_sc)
        _mw(scores, p_idx, ev)
        exp_sum = exp_sum + ev
        p_idx = p_idx + 1
      if exp_sum > 0.0:
        p_idx = 0
        while p_idx <= pos:
          _mw(scores, p_idx, _mf(scores, p_idx) / exp_sum)
          p_idx = p_idx + 1

      c:int = 0
      while c < head_dim:
        acc:float = 0.0
        p_idx = 0
        while p_idx <= pos:
          attn:float = _mf(scores, p_idx)
          vv:float   = _mf(model, kv_off + l * kv_layer_sz + max_seq * kv_dim + p_idx * kv_dim + kvhh * head_dim + c)
          acc = acc + attn * vv
          p_idx = p_idx + 1
        _mw(attn_out, qhh * head_dim + c, acc)
        c = c + 1

      qhh = qhh + 1

    unsafe:
      free(sc_raw)

    _matmul_forward(attn_out, w_o, ffn_out, 1, q_dim, dim)

    j = 0
    while j < dim:
      _mw(x, j, _mf(x_res, j) + _mf(ffn_out, j))
      j = j + 1

    j = 0
    while j < dim:
      _mw(x_res, j, _mf(x, j))
      j = j + 1

    // RMSNorm 2
    ln2_off:int = lw
    ln2_w:*float
    unsafe:
      ln2_w = (model as *char + ln2_off * 8) as *float
    _rmsnorm_forward(x, x_norm, ln2_w, 1, dim)
    lw = lw + dim

    // SwiGLU FFN
    w_gate_off:int = lw; lw = lw + dim * ffn
    w_up_off:int = lw; lw = lw + dim * ffn
    w_down_off:int = lw; lw = lw + ffn * dim

    w_gate_p:*float; w_up_p:*float; w_down_p:*float
    unsafe:
      w_gate_p = (model as *char + w_gate_off * 8) as *float
      w_up_p   = (model as *char + w_up_off * 8) as *float
      w_down_p = (model as *char + w_down_off * 8) as *float

    gate_raw:*char
    up_raw:*char
    unsafe:
      gate_raw = malloc(ffn * 8)
      up_raw   = malloc(ffn * 8)
    if gate_raw == 0 || up_raw == 0:
      unsafe:
        if gate_raw != 0: free(gate_raw)
        if up_raw != 0: free(up_raw)
        free(ws_raw)
      ret 0 - 1
    gate:*float = gate_raw as *float
    up:*float = up_raw as *float

    _matmul_forward(x_norm, w_gate_p, gate, 1, dim, ffn)
    _matmul_forward(x_norm, w_up_p, up, 1, dim, ffn)
    _swiglu_forward(gate, up, ffn_out, 1, ffn)
    _matmul_forward(ffn_out, w_down_p, ffn_down, 1, ffn, dim)

    unsafe:
      free(gate_raw)
      free(up_raw)

    j = 0
    while j < dim:
      _mw(x, j, _mf(x_res, j) + _mf(ffn_down, j))
      j = j + 1

    l = l + 1

  // Final RMSNorm
  final_ln_off:int = lw
  final_ln_w:*float
  unsafe:
    final_ln_w = (model as *char + final_ln_off * 8) as *float
  _rmsnorm_forward(x, x_norm, final_ln_w, 1, dim)
  lw = lw + dim

  // LM Head
  lm_head_off:int = lw
  lm_head_w:*float
  unsafe:
    lm_head_w = (model as *char + lm_head_off * 8) as *float
  _matmul_forward(x_norm, lm_head_w, logits, 1, dim, vocab)

  unsafe:
    free(ws_raw)
  ret 0

// â”€â”€ mind_backward: GQA Transformer backward pass (training) â”€â”€â”€â”€

fn mind_backward(model:*float, tokens:*int, targets:*int, seq_len:int, grads:*float) -> float:
  if model == 0 as *float || tokens == 0 as *int || targets == 0 as *int || grads == 0 as *float || seq_len <= 0:
    ret 0.0 - 1.0

  vocab:int   = _mi(model, _MH_VOCAB)
  dim:int     = _mi(model, _MH_DIM)
  q_heads:int = _mi(model, _MH_QH)
  kv_heads:int = _mi(model, _MH_KVH)
  layers:int  = _mi(model, _MH_LAYERS)
  ffn:int     = _mi(model, _MH_FFN)
  head_dim:int = _mi(model, _MH_HDIM)
  w_off:int   = _mi(model, _MH_WOFF)
  nw:int      = _mi(model, _MH_NW)

  q_dim:int  = q_heads  * head_dim
  kv_dim:int = kv_heads * head_dim

  // Zero the output grads slab
  i:int = 0
  while i < nw:
    _mw(grads, w_off + i, 0.0)
    i = i + 1

  // Allocate contiguous activation and gradient slabs
  L_SZ:int = seq_len * (dim * 5 + q_dim * 2 + kv_dim * 2 + ffn * 3)
  act_sz:int = layers * L_SZ + seq_len * dim + seq_len * vocab
  probs_sz:int = seq_len * q_heads * seq_len

  act_raw:*char
  d_act_raw:*char
  probs_raw:*char
  d_probs_temp_raw:*char
  unsafe:
    act_raw = malloc(act_sz * 8)
    d_act_raw = malloc(act_sz * 8)
    probs_raw = malloc(probs_sz * 8)
    d_probs_temp_raw = malloc(seq_len * 8)

  if act_raw == 0 || d_act_raw == 0 || probs_raw == 0 || d_probs_temp_raw == 0:
    unsafe:
      if act_raw != 0: free(act_raw)
      if d_act_raw != 0: free(d_act_raw)
      if probs_raw != 0: free(probs_raw)
      if d_probs_temp_raw != 0: free(d_probs_temp_raw)
    ret 0.0 - 1.0

  act:*float; d_act:*float; probs:*float; d_probs_temp:*float
  unsafe:
    act = act_raw as *float
    d_act = d_act_raw as *float
    probs = probs_raw as *float
    d_probs_temp = d_probs_temp_raw as *float

  // Zero activation gradients
  i = 0
  while i < act_sz:
    _mw(d_act, i, 0.0)
    i = i + 1

  // â”€â”€ 1. Forward Pass â”€â”€

  // Calculate layer indices/offsets
  final_norm_off:int = layers * L_SZ
  logits_off:int = final_norm_off + seq_len * dim

  // Embeddings
  unsafe:
    nn.nn_embed(tokens, act, model + w_off, seq_len, dim)

  l:int = 0
  while l < layers:
    lw:int = w_off + _layer_weights_start(vocab, dim, q_heads, kv_heads, head_dim, ffn, l)

    // Layer bounds
    off_x_in:int = l * L_SZ
    off_x_norm1:int = off_x_in + seq_len * dim
    off_q:int = off_x_norm1 + seq_len * dim
    off_k:int = off_q + seq_len * q_dim
    off_v:int = off_k + seq_len * kv_dim
    off_attn_out:int = off_v + seq_len * kv_dim
    off_attn_proj:int = off_attn_out + seq_len * q_dim
    off_x_norm2:int = off_attn_proj + seq_len * dim
    off_gate:int = off_x_norm2 + seq_len * dim
    off_up:int = off_gate + seq_len * ffn
    off_ffn_mid:int = off_up + seq_len * ffn
    off_ffn_out:int = off_ffn_mid + seq_len * ffn

    // Set residual in
    if l > 0:
      prev_ffn:int = (l - 1) * L_SZ + (L_SZ - seq_len * dim)
      prev_xin:int = (l - 1) * L_SZ
      j:int = 0
      while j < seq_len * dim:
        _mw(act, off_x_in + j, _mf(act, prev_xin + j) + _mf(act, prev_ffn + j))
        j = j + 1

    // RMSNorm 1
    ln1_off:int = lw
    ln1_w:*float
    unsafe:
      ln1_w = (model as *char + ln1_off * 8) as *float
    _rmsnorm_forward(act + off_x_in, act + off_x_norm1, ln1_w, seq_len, dim)
    lw = lw + dim

    // Projections Q, K, V
    w_q_off:int = lw; lw = lw + dim * q_dim
    w_k_off:int = lw; lw = lw + dim * kv_dim
    w_v_off:int = lw; lw = lw + dim * kv_dim
    w_o_off:int = lw; lw = lw + q_dim * dim

    w_q:*float; w_k:*float; w_v:*float
    unsafe:
      w_q = (model as *char + w_q_off * 8) as *float
      w_k = (model as *char + w_k_off * 8) as *float
      w_v = (model as *char + w_v_off * 8) as *float

    _matmul_forward(act + off_x_norm1, w_q, act + off_q, seq_len, dim, q_dim)
    _matmul_forward(act + off_x_norm1, w_k, act + off_k, seq_len, dim, kv_dim)
    _matmul_forward(act + off_x_norm1, w_v, act + off_v, seq_len, dim, kv_dim)

    // RoPE
    _rope_forward(act + off_q, act + off_k, seq_len, q_heads, kv_heads, head_dim, 0)

    // GQA Attention
    _gqa_forward(act + off_q, act + off_k, act + off_v, act + off_attn_out, probs + l * probs_sz, seq_len, q_heads, kv_heads, head_dim)

    // Output projection
    w_o:*float
    unsafe:
      w_o = (model as *char + w_o_off * 8) as *float
    _matmul_forward(act + off_attn_out, w_o, act + off_attn_proj, seq_len, q_dim, dim)

    // RMSNorm 2
    ln2_off:int = lw
    ln2_w:*float
    unsafe:
      ln2_w = (model as *char + ln2_off * 8) as *float
    j:int = 0
    while j < seq_len * dim:
      _mw(act, off_x_norm2 + j, _mf(act, off_x_in + j) + _mf(act, off_attn_proj + j))
      j = j + 1
    _rmsnorm_forward(act + off_x_norm2, act + off_x_norm2, ln2_w, seq_len, dim)
    lw = lw + dim

    // SwiGLU FFN
    w_gate_off:int = lw; lw = lw + dim * ffn
    w_up_off:int = lw; lw = lw + dim * ffn
    w_down_off:int = lw; lw = lw + ffn * dim

    w_gate_p:*float; w_up_p:*float; w_down_p:*float
    unsafe:
      w_gate_p = (model as *char + w_gate_off * 8) as *float
      w_up_p   = (model as *char + w_up_off * 8) as *float
      w_down_p = (model as *char + w_down_off * 8) as *float

    _matmul_forward(act + off_x_norm2, w_gate_p, act + off_gate, seq_len, dim, ffn)
    _matmul_forward(act + off_x_norm2, w_up_p, act + off_up, seq_len, dim, ffn)
    _swiglu_forward(act + off_gate, act + off_up, act + off_ffn_mid, seq_len, ffn)
    _matmul_forward(act + off_ffn_mid, w_down_p, act + off_ffn_out, seq_len, ffn, dim)

    l = l + 1

  // Final Norm
  last_ffn:int = (layers - 1) * L_SZ + (L_SZ - seq_len * dim)
  last_xin:int = (layers - 1) * L_SZ
  last_xout_raw:*char
  unsafe:
    last_xout_raw = malloc(seq_len * dim * 8)
  last_xout:*float = last_xout_raw as *float
  j:int = 0
  while j < seq_len * dim:
    _mw(last_xout, j, _mf(act, last_xin + j) + _mf(act, last_ffn + j))
    j = j + 1

  lw_final:int = w_off + vocab * dim + layers * _mind_layer_weights(dim, q_heads, kv_heads, head_dim, ffn)
  final_ln_w:*float
  unsafe:
    final_ln_w = (model as *char + lw_final * 8) as *float
  _rmsnorm_forward(last_xout, act + final_norm_off, final_ln_w, seq_len, dim)
  lw_final = lw_final + dim

  // LM Head
  lm_head_w:*float
  unsafe:
    lm_head_w = (model as *char + lw_final * 8) as *float
  _matmul_forward(act + final_norm_off, lm_head_w, act + logits_off, seq_len, dim, vocab)

  // Loss and d_logits calculation
  loss_total:float = 0.0
  d_logits_raw:*char
  unsafe:
    d_logits_raw = malloc(vocab * 8)
  d_logits:*float = d_logits_raw as *float

  t:int = 0
  while t < seq_len:
    target:int = targets[t]
    // Get logits for this t
    loss_total = loss_total + nn.nn_cross_entropy(act + logits_off + t * vocab, target, d_logits, vocab)
    // Copy computed gradients to d_act slab
    j = 0
    while j < vocab:
      _mw(d_act, logits_off + t * vocab + j, _mf(d_logits, j))
      j = j + 1
    t = t + 1
  loss_avg:float = loss_total / (seq_len as float)

  unsafe:
    free(d_logits_raw)

  // â”€â”€ 2. Backward Pass â”€â”€

  // Grad to LM Head
  // dW_lm += final_norm^T @ d_logits
  dw_lm:*float
  unsafe:
    dw_lm = (grads as *char + lw_final * 8) as *float
  _matmul_backward_weights(act + final_norm_off, d_act + logits_off, dw_lm, seq_len, dim, vocab)

  // dfinal_norm = d_logits @ W_lm^T
  dfinal_norm:*float
  unsafe:
    dfinal_norm = (d_act as *char + final_norm_off * 8) as *float
  _matmul_backward_inputs(d_act + logits_off, lm_head_w, dfinal_norm, seq_len, dim, vocab)

  // Backprop Final Norm
  d_last_xout_raw:*char
  unsafe:
    d_last_xout_raw = malloc(seq_len * dim * 8)
  d_last_xout:*float = d_last_xout_raw as *float
  i = 0
  while i < seq_len * dim:
    _mw(d_last_xout, i, 0.0)
    i = i + 1

  dgamma_final:*float
  unsafe:
    dgamma_final = (grads as *char + (lw_final - dim) * 8) as *float
  _rmsnorm_backward(dfinal_norm, last_xout, final_ln_w, d_last_xout, dgamma_final, seq_len, dim)

  // Initialize gradient for the residual stream (backprop down the layers)
  d_xstream_raw:*char
  unsafe:
    d_xstream_raw = malloc(seq_len * dim * 8)
  d_xstream:*float = d_xstream_raw as *float
  j = 0
  while j < seq_len * dim:
    _mw(d_xstream, j, _mf(d_last_xout, j))
    j = j + 1

  l = layers - 1
  while l >= 0:
    lw = w_off + _layer_weights_start(vocab, dim, q_heads, kv_heads, head_dim, ffn, l)

    // Layer bounds
    off_x_in = l * L_SZ
    off_x_norm1 = off_x_in + seq_len * dim
    off_q = off_x_norm1 + seq_len * dim
    off_k = off_q + seq_len * q_dim
    off_v = off_k + seq_len * kv_dim
    off_attn_out = off_v + seq_len * kv_dim
    off_attn_proj = off_attn_out + seq_len * q_dim
    off_x_norm2 = off_attn_proj + seq_len * dim
    off_gate = off_x_norm2 + seq_len * dim
    off_up = off_gate + seq_len * ffn
    off_ffn_mid = off_up + seq_len * ffn
    off_ffn_out = off_ffn_mid + seq_len * ffn

    // Layer weight pointers
    ln1_off = lw
    w_q_off = ln1_off + dim
    w_k_off = w_q_off + dim * q_dim
    w_v_off = w_k_off + dim * kv_dim
    w_o_off = w_v_off + dim * kv_dim
    ln2_off = w_o_off + q_dim * dim
    w_gate_off = ln2_off + dim
    w_up_off = w_gate_off + dim * ffn
    w_down_off = w_up_off + dim * ffn

    dw_down:*float; dw_gate:*float; dw_up:*float; dw_o:*float; dw_q:*float; dw_k:*float; dw_v:*float
    dgamma1:*float; dgamma2:*float
    w_gate_p:*float; w_up_p:*float; w_down_p:*float
    w_q:*float; w_k:*float; w_v:*float; w_o:*float
    unsafe:
      dw_down = (grads as *char + w_down_off * 8) as *float
      dw_up   = (grads as *char + w_up_off * 8) as *float
      dw_gate = (grads as *char + w_gate_off * 8) as *float
      dgamma2 = (grads as *char + ln2_off * 8) as *float
      dw_o    = (grads as *char + w_o_off * 8) as *float
      dw_v    = (grads as *char + w_v_off * 8) as *float
      dw_k    = (grads as *char + w_k_off * 8) as *float
      dw_q    = (grads as *char + w_q_off * 8) as *float
      dgamma1 = (grads as *char + ln1_off * 8) as *float
      w_gate_p = (model as *char + w_gate_off * 8) as *float
      w_up_p   = (model as *char + w_up_off * 8) as *float
      w_down_p = (model as *char + w_down_off * 8) as *float
      w_q = (model as *char + w_q_off * 8) as *float
      w_k = (model as *char + w_k_off * 8) as *float
      w_v = (model as *char + w_v_off * 8) as *float
      w_o = (model as *char + w_o_off * 8) as *float

    // Backprop SwiGLU FFN weights
    // dW_down += ffn_mid^T @ d_ffn_out
    // d_xstream is also d_ffn_out because ffn_out adds directly to the residual stream
    _matmul_backward_weights(act + off_ffn_mid, d_xstream, dw_down, seq_len, ffn, dim)

    // d_ffn_mid = d_ffn_out @ W_down^T
    d_ffn_mid_raw:*char
    unsafe:
      d_ffn_mid_raw = malloc(seq_len * ffn * 8)
    d_ffn_mid:*float = d_ffn_mid_raw as *float
    i = 0
    while i < seq_len * ffn:
      _mw(d_ffn_mid, i, 0.0)
      i = i + 1
    _matmul_backward_inputs(d_xstream, w_down_p, d_ffn_mid, seq_len, ffn, dim)

    // Backprop SwiGLU FFN activations (d_gate, d_up)
    d_gate_p_raw:*char
    d_up_p_raw:*char
    unsafe:
      d_gate_p_raw = malloc(seq_len * ffn * 8)
      d_up_p_raw   = malloc(seq_len * ffn * 8)
    d_gate_p:*float = d_gate_p_raw as *float
    d_up_p:*float   = d_up_p_raw   as *float
    i = 0
    while i < seq_len * ffn:
      _mw(d_gate_p, i, 0.0)
      _mw(d_up_p,   i, 0.0)
      i = i + 1

    _swiglu_backward(d_ffn_mid, act + off_gate, act + off_up, d_gate_p, d_up_p, seq_len, ffn)

    // dW_gate += x_norm2^T @ d_gate
    _matmul_backward_weights(act + off_x_norm2, d_gate_p, dw_gate, seq_len, dim, ffn)
    // dW_up += x_norm2^T @ d_up
    _matmul_backward_weights(act + off_x_norm2, d_up_p, dw_up, seq_len, dim, ffn)

    // dx_norm2 = d_gate @ W_gate^T + d_up @ W_up^T
    d_x_norm2_raw:*char
    unsafe:
      d_x_norm2_raw = malloc(seq_len * dim * 8)
    d_x_norm2:*float = d_x_norm2_raw as *float
    i = 0
    while i < seq_len * dim:
      _mw(d_x_norm2, i, 0.0)
      i = i + 1
    _matmul_backward_inputs(d_gate_p, w_gate_p, d_x_norm2, seq_len, dim, ffn)
    _matmul_backward_inputs(d_up_p, w_up_p, d_x_norm2, seq_len, dim, ffn)

    unsafe:
      free(d_gate_p_raw)
      free(d_up_p_raw)
      free(d_ffn_mid_raw)

    // Backprop RMSNorm 2
    d_x2_raw:*char
    unsafe:
      d_x2_raw = malloc(seq_len * dim * 8)
    d_x2:*float = d_x2_raw as *float
    i = 0
    while i < seq_len * dim:
      _mw(d_x2, i, 0.0)
      i = i + 1

    ln2_w:*float
    unsafe:
      ln2_w = (model as *char + ln2_off * 8) as *float
    // Input to norm2 is x_in + attn_proj
    x2_temp_raw:*char
    unsafe:
      x2_temp_raw = malloc(seq_len * dim * 8)
    x2_temp:*float = x2_temp_raw as *float
    j = 0
    while j < seq_len * dim:
      _mw(x2_temp, j, _mf(act, off_x_in + j) + _mf(act, off_attn_proj + j))
      j = j + 1

    _rmsnorm_backward(d_x_norm2, x2_temp, ln2_w, d_x2, dgamma2, seq_len, dim)
    unsafe:
      free(x2_temp_raw)
      free(d_x_norm2_raw)

    // Add to d_xstream (which will backprop to the previous layer's residual stream)
    j = 0
    while j < seq_len * dim:
      _mw(d_xstream, j, _mf(d_xstream, j) + _mf(d_x2, j))
      j = j + 1

    // Backprop attention output projection
    // dW_o += attn_out^T @ d_x2
    _matmul_backward_weights(act + off_attn_out, d_x2, dw_o, seq_len, q_dim, dim)

    // d_attn_out = d_x2 @ W_o^T
    d_attn_out_raw:*char
    unsafe:
      d_attn_out_raw = malloc(seq_len * q_dim * 8)
    d_attn_out:*float = d_attn_out_raw as *float
    i = 0
    while i < seq_len * q_dim:
      _mw(d_attn_out, i, 0.0)
      i = i + 1
    _matmul_backward_inputs(d_x2, w_o, d_attn_out, seq_len, q_dim, dim)
    unsafe:
      free(d_x2_raw)

    // GQA Attention Backward
    dq_raw:*char
    dk_raw:*char
    dv_raw:*char
    unsafe:
      dq_raw = malloc(seq_len * q_dim * 8)
      dk_raw = malloc(seq_len * kv_dim * 8)
      dv_raw = malloc(seq_len * kv_dim * 8)
    dq:*float = dq_raw as *float
    dk:*float = dk_raw as *float
    dv:*float = dv_raw as *float
    i = 0
    while i < seq_len * q_dim:
      _mw(dq, i, 0.0)
      i = i + 1
    i = 0
    while i < seq_len * kv_dim:
      _mw(dk, i, 0.0)
      _mw(dv, i, 0.0)
      i = i + 1

    _gqa_backward(dq, dk, dv, act + off_q, act + off_k, act + off_v, probs + l * probs_sz, d_attn_out, d_probs_temp, seq_len, q_heads, kv_heads, head_dim)
    unsafe:
      free(d_attn_out_raw)

    // RoPE Backward (inverse rotation)
    _rope_backward(dq, dk, seq_len, q_heads, kv_heads, head_dim, 0)

    // Backprop Q, K, V projections
    // dW_q += x_norm1^T @ dq, etc.
    _matmul_backward_weights(act + off_x_norm1, dq, dw_q, seq_len, dim, q_dim)
    _matmul_backward_weights(act + off_x_norm1, dk, dw_k, seq_len, dim, kv_dim)
    _matmul_backward_weights(act + off_x_norm1, dv, dw_v, seq_len, dim, kv_dim)

    // dx_norm1 = dq @ W_q^T + dk @ W_k^T + dv @ W_v^T
    d_x_norm1_raw:*char
    unsafe:
      d_x_norm1_raw = malloc(seq_len * dim * 8)
    d_x_norm1:*float = d_x_norm1_raw as *float
    i = 0
    while i < seq_len * dim:
      _mw(d_x_norm1, i, 0.0)
      i = i + 1
    _matmul_backward_inputs(dq, w_q, d_x_norm1, seq_len, dim, q_dim)
    _matmul_backward_inputs(dk, w_k, d_x_norm1, seq_len, dim, kv_dim)
    _matmul_backward_inputs(dv, w_v, d_x_norm1, seq_len, dim, kv_dim)

    unsafe:
      free(dq_raw)
      free(dk_raw)
      free(dv_raw)

    // Backprop RMSNorm 1
    d_xin_temp_raw:*char
    unsafe:
      d_xin_temp_raw = malloc(seq_len * dim * 8)
    d_xin_temp:*float = d_xin_temp_raw as *float
    i = 0
    while i < seq_len * dim:
      _mw(d_xin_temp, i, 0.0)
      i = i + 1

    ln1_w:*float
    unsafe:
      ln1_w = (model as *char + ln1_off * 8) as *float
    _rmsnorm_backward(d_x_norm1, act + off_x_in, ln1_w, d_xin_temp, dgamma1, seq_len, dim)
    unsafe:
      free(d_x_norm1_raw)

    // Accumulate to the residual stream gradient d_xstream
    j = 0
    while j < seq_len * dim:
      _mw(d_xstream, j, _mf(d_xstream, j) + _mf(d_xin_temp, j))
      j = j + 1
    unsafe:
      free(d_xin_temp_raw)

    l = l - 1

  // Embedding layer backward (accumulate gradients into embedding table)
  // dembed_table[X[t]] += d_xstream[t]
  // Embed table is at offset w_off
  t = 0
  while t < seq_len:
    tok_id:int = tokens[t]
    j = 0
    while j < dim:
      gv:float = _mf(d_xstream, t * dim + j)
      idx:int = w_off + tok_id * dim + j
      _mw(grads, idx, _mf(grads, idx) + gv)
      j = j + 1
    t = t + 1

  // Clean up workspaces
  unsafe:
    free(d_xstream_raw)
    free(d_last_xout_raw)
    free(last_xout_raw)
    free(act_raw)
    free(d_act_raw)
    free(probs_raw)
    free(d_probs_temp_raw)

  ret loss_avg

// â”€â”€ mind_save: write weights to file â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn _mfw_i(f:*char, v:int) -> int:
  b:*char
  unsafe:
    b = malloc(8)
    p:*int = b as *int
    p[0] = v
    fwrite(b, 8, 1, f)
    free(b)
  ret 0

fn _mfw_f(f:*char, v:float) -> int:
  b:*char
  unsafe:
    b = malloc(8)
    p:*float = b as *float
    p[0] = v
    fwrite(b, 8, 1, f)
    free(b)
  ret 0

fn _mfr_i(f:*char) -> int:
  v:int = 0
  b:*char
  unsafe:
    b = malloc(8)
    fread(b, 8, 1, f)
    p:*int = b as *int
    v = p[0]
    free(b)
  ret v

fn _mfr_f(f:*char) -> float:
  v:float = 0.0
  b:*char
  unsafe:
    b = malloc(8)
    fread(b, 8, 1, f)
    p:*float = b as *float
    v = p[0]
    free(b)
  ret v

fn _mind_header_valid(vocab:int, dim:int, q_heads:int, kv_heads:int, layers:int, max_seq:int, ffn:int) -> int:
  if vocab <= 0 || dim <= 0 || q_heads <= 0 || kv_heads <= 0 || layers <= 0 || max_seq <= 0 || ffn <= 0:
    ret 0
  if q_heads % kv_heads != 0:
    ret 0
  head_dim:int = dim / q_heads
  if head_dim <= 0 || (head_dim & 1) != 0:
    ret 0
  ret 1

fn mind_file_matches(path:str, vocab:int, dim:int, q_heads:int, kv_heads:int, layers:int, ffn:int, max_seq:int) -> int:
  if path == 0:
    ret 0
  f:*char = fopen(path, "rb")
  unsafe:
    if f == 0 as *char: ret 0

  magic:int = _mfr_i(f)
  if magic != MIND_MAGIC:
    unsafe:
      fclose(f)
    ret 0

  fvocab:int  = _mfr_i(f)
  fdim:int    = _mfr_i(f)
  fq_heads:int = _mfr_i(f)
  fkv_heads:int = _mfr_i(f)
  flayers:int = _mfr_i(f)
  fmax_seq:int = _mfr_i(f)
  fffn:int    = _mfr_i(f)

  unsafe:
    fclose(f)

  if _mind_header_valid(fvocab, fdim, fq_heads, fkv_heads, flayers, fmax_seq, fffn) == 0:
    ret 0
  if fvocab != vocab || fdim != dim || fq_heads != q_heads || fkv_heads != kv_heads:
    ret 0
  if flayers != layers || fffn != ffn || fmax_seq != max_seq:
    ret 0
  ret 1

fn mind_save(model:*float, path:str) -> int:
  if model == 0 as *float || path == 0: ret 0 - 1
  f:*char = fopen(path, "wb")
  unsafe:
    if f == 0 as *char: ret 0 - 1

  _mfw_i(f, MIND_MAGIC)
  _mfw_i(f, _mi(model, _MH_VOCAB))
  _mfw_i(f, _mi(model, _MH_DIM))
  _mfw_i(f, _mi(model, _MH_QH))
  _mfw_i(f, _mi(model, _MH_KVH))
  _mfw_i(f, _mi(model, _MH_LAYERS))
  _mfw_i(f, _mi(model, _MH_SEQLEN))
  _mfw_i(f, _mi(model, _MH_FFN))

  nw:int   = _mi(model, _MH_NW)
  w_off:int = _mi(model, _MH_WOFF)
  i:int = 0
  while i < nw:
    _mfw_f(f, _mf(model, w_off + i))
    i = i + 1

  unsafe:
    fclose(f)
  ret 0

// â”€â”€ mind_load: load weights from file â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn mind_load(path:str) -> *float:
  if path == 0: ret 0 as *float
  f:*char = fopen(path, "rb")
  unsafe:
    if f == 0 as *char: ret 0 as *float

  magic:int = _mfr_i(f)
  if magic != MIND_MAGIC:
    unsafe:
      fclose(f)
    ret 0 as *float

  vocab:int  = _mfr_i(f)
  dim:int    = _mfr_i(f)
  q_heads:int = _mfr_i(f)
  kv_heads:int = _mfr_i(f)
  layers:int = _mfr_i(f)
  max_seq:int = _mfr_i(f)
  ffn:int    = _mfr_i(f)

  if _mind_header_valid(vocab, dim, q_heads, kv_heads, layers, max_seq, ffn) == 0:
    unsafe:
      fclose(f)
    ret 0 as *float

  model:*float = mind_new(vocab, dim, q_heads, kv_heads, layers, ffn, max_seq)
  if model == 0 as *float:
    unsafe:
      fclose(f)
    ret 0 as *float

  nw:int    = _mi(model, _MH_NW)
  w_off:int = _mi(model, _MH_WOFF)
  i:int = 0
  while i < nw:
    _mw(model, w_off + i, _mfr_f(f))
    i = i + 1

  unsafe:
    fclose(f)
  ret model

// â”€â”€ mind_generate: autoregressive text generation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

fn mind_generate(model:*float, prompt:str, max_tokens:int, temp:float, seed:int) -> str:
  if mind_is_valid(model) == 0 || max_tokens <= 0: ret 0 as str
  vocab:int   = _mi(model, _MH_VOCAB)
  max_seq:int = _mi(model, _MH_SEQLEN)

  out_cap:int = max_tokens + max_seq + 2
  out_buf:*char = malloc(out_cap)
  if out_buf == 0: ret 0 as str
  out_len:int = 0

  logits_raw:*char
  unsafe:
    logits_raw = malloc(vocab * 8)
  if logits_raw == 0:
    unsafe:
      free(out_buf)
    ret 0 as str
  logits:*float
  unsafe:
    logits = logits_raw as *float

  pos:int = 0
  rng:int = seed
  if rng == 0: rng = 42

  pi:int = 0
  prompt_len:int = 0
  if prompt != 0:
    prompt_len = len(prompt)
  while pi < prompt_len && pos < max_seq - 1:
    tok:int = (prompt as *char)[pi] as int & 255
    if tok >= vocab:
      tok = tok % vocab
    if mind_forward(model, tok, pos, logits) != 0:
      unsafe:
        free(logits_raw)
        free(out_buf)
      ret 0 as str
    if out_len < out_cap - 2:
      out_buf[out_len] = (prompt as *char)[pi]
      out_len = out_len + 1
    pos = pos + 1
    pi = pi + 1

  if pos == 0:
    seed_tok:int = 32
    if seed_tok >= vocab:
      seed_tok = 0
    if mind_forward(model, seed_tok, pos, logits) != 0:
      unsafe:
        free(logits_raw)
        free(out_buf)
      ret 0 as str
    pos = pos + 1

  gen:int = 0
  while gen < max_tokens && pos < max_seq:
    next_tok:int = 0
    if temp <= 0.001:
      best_v:float = _mf(logits, 0)
      best_i:int = 0
      j:int = 1
      while j < vocab:
        v:float = _mf(logits, j)
        if v > best_v:
          best_v = v
          best_i = j
        j = j + 1
      next_tok = best_i
    else:
      j:int = 0
      while j < vocab:
        _mw(logits, j, _mf(logits, j) / temp)
        j = j + 1
      maxv:float = _mf(logits, 0)
      j = 1
      while j < vocab:
        v:float = _mf(logits, j)
        if v > maxv: maxv = v
        j = j + 1
      sum_e:float = 0.0
      j = 0
      while j < vocab:
        ev:float = math.exp(_mf(logits, j) - maxv)
        _mw(logits, j, ev)
        sum_e = sum_e + ev
        j = j + 1
      if sum_e <= 0.0:
        unsafe:
          free(logits_raw)
          free(out_buf)
        ret 0 as str
      rng = rng * 1664525 + 1013904223
      bits:int = (rng >> 8) & 16777215
      r:float = (bits as float) / 16777216.0
      cdf:float = 0.0
      j = 0
      while j < vocab:
        cdf = cdf + _mf(logits, j) / sum_e
        if r < cdf:
          next_tok = j
          break
        j = j + 1

    if next_tok == 0: break

    if next_tok > 0 && next_tok < 256:
      if out_len < out_cap - 2:
        out_buf[out_len] = next_tok as char
        out_len = out_len + 1

    if mind_forward(model, next_tok, pos, logits) != 0:
      unsafe:
        free(logits_raw)
        free(out_buf)
      ret 0 as str
    pos = pos + 1
    gen = gen + 1

  out_buf[out_len] = 0 as char

  unsafe:
    free(logits_raw)
  ret out_buf as str
