# Force VS Code extension and config files to be treated as vendored (excluded from stats)
tezznative-vscode/** linguist-vendored=true
version.json linguist-vendored=true
tezz.mod linguist-vendored=true
tezz.lock linguist-vendored=true

# Treat TezzNative files as TezzNative directly
*.tn linguist-language=TezzNative

# Keep POSIX launchers and test runners executable by Linux shells.
*.sh text eol=lf
tezz text eol=lf
