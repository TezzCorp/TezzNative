  own_base:int = 0
  if base == 0:
    reg = mod_get_value(mod, "registry")
    if reg != 0:
      base = url_dir(reg)
      own_base = 1
  if base == 0:
    base = "https://tn.tezzcorp.com/lib/"
    own_base = 0

  out_path:str = "build/registry.tnx"
  if user_args_count() >= 2:
    out_path = arg(1)

  names:[str;64]
  vers:[str;64]
  dep_n:int = 0

  i:int = 0
  line:int = 0
  while 1:
    c:int = mod[i] as int
    if c == 0 || c == 10:
      end:int = i
      s:int = line
      while s < end && (mod[s] == 32 || mod[s] == 9):
        s = s + 1
      if starts_with_at(mod, s, "dep.") != 0:
        s = s + 4
        ns:int = s
        while s < end && mod[s] != 32 && mod[s] != 9 && mod[s] != 61:
          s = s + 1
        ne:int = s
        while s < end && mod[s] != 61:
          s = s + 1
        if s < end && mod[s] == 61:
          s = s + 1
          while s < end && (mod[s] == 32 || mod[s] == 9):
            s = s + 1
          vs:int = s
          ve:int = end
          while ve > vs && (mod[ve-1] == 32 || mod[ve-1] == 9 || mod[ve-1] == 13):
            ve = ve - 1
          if dep_n < 64:
            names[dep_n] = substr_dup(mod, ns, ne)
            vers[dep_n] = substr_dup(mod, vs, ve)
            dep_n = dep_n + 1
      if c == 0:
        break
      line = i + 1
    i = i + 1

  lines:[str;128]
  line_n:int = 0

  i = 0
  while i < dep_n:
    dep_path:str = dep_module_path(root, names[i])
    crc:int = crc32_source_file(dep_path)
    crc_hex:str = hex8(crc)

    base2:str = base
    own_base2:int = 0
    bl:int = len(base)
    if bl > 0 && base[bl-1] != 47:
      base2 = str_join2(base, "/")
      own_base2 = 1
    url1:str = str_join2(base2, names[i])
    url2:str = str_join2(url1, ".tn")

    nv:str = str_join3(names[i], "@", vers[i])
    line1:str = str_join2(nv, " ")
    line2:str = str_join2(line1, url2)
    line3:str = str_join2(line2, " ")
    line4:str = str_join2(line3, crc_hex)
    lines[line_n] = line4
