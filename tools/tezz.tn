    bad = 1
  if policy_file_has("tests/gui_check_manifest.tnx", "examples/gui_first_app.tn") == 0:
    say "release-policy-check: missing examples/gui_first_app.tn in tests/gui_check_manifest.tnx"
    bad = 1

  if bad == 0:
    say "release-policy-check: OK"
    ret 0
  say "release-policy-check: FAILED"
  ret 0 - 1

fn cmd_release() -> int:
  // V1 gate: strict conformance + stdlib/tooling + lint + runtime lanes + verify
  // M6 gate: signed release artifacts + reproducible compiler build check.
  // TZNUM gate: native parity + matmul/rmsnorm benchmark blockers.
  osn:str = os_name()
  runner:str = "tezz"
  if streq(osn, "windows"):
    if path_exists(".\\tezz.cmd") != 0:
      runner = ".\\tezz.cmd"
    else:
      runner = "tezz.cmd"
  else:
    if path_exists("./tezz") != 0:
      runner = "./tezz"

  failed:int = 0
  cmd_tc:str = str_join3(runner, " ", "test --conformance --conformance-strict")
  if proc_run(cmd_tc) != 0:
    failed = 1
  free(cmd_tc)

  cmd_ts:str = str_join3(runner, " ", "test --stdlib-v1")
  if proc_run(cmd_ts) != 0:
    failed = 1
  free(cmd_ts)

  cmd_tl:str = str_join3(runner, " ", "test --tooling")
  if proc_run(cmd_tl) != 0:
    failed = 1
  free(cmd_tl)

  cmd_tg:str = str_join3(runner, " ", "test --gui")
  if proc_run(cmd_tg) != 0:
    failed = 1
  free(cmd_tg)

  // Lint smoke gate (run early before long runtime lanes).
  cmd1:str = str_join3(runner, " ", "lint tests/lint_smoke.tn")
  if proc_run(cmd1) != 0:
    failed = 1
  free(cmd1)

  cmd2:str = str_join3(runner, " ", "lint tests/lint_suppress.tn")
  if proc_run(cmd2) != 0:
    failed = 1
  free(cmd2)

  // Runtime IO stability gate (release blocker).
  cmd_io:str = str_join3(runner, " ", "test --io-smoke")
  if proc_run(cmd_io) != 0:
    failed = 1
  free(cmd_io)

  cmd_sm:str = str_join3(runner, " ", "test --simple-smoke")
  if proc_run(cmd_sm) != 0:
    failed = 1
  free(cmd_sm)

  cmd_rh:str = str_join3(runner, " ", "test --runtime-hardening")
  if proc_run(cmd_rh) != 0:
    failed = 1
  free(cmd_rh)

  cmd_rf:str = str_join3(runner, " ", "test --runtime-fuzz --fuzz-rounds 2 --fuzz-iters 256")
  if proc_run(cmd_rf) != 0:
    failed = 1
  free(cmd_rf)

  cmd_v:str = str_join3(runner, " ", "verify --strict")
  if proc_run(cmd_v) != 0:
    failed = 1
  free(cmd_v)

  rel_sign_key:str = release_sign_key()
  has_rel_sign_key:int = 0
  if rel_sign_key != 0:
    if rel_sign_key[0] != 0:
      has_rel_sign_key = 1
  if has_rel_sign_key == 0:
    say "release: missing signing key for signed artifacts"
    say "set TEZZ_RELEASE_SIGN_KEY (or TEZZ_SIGN_KEY) or create build/release_sign.key"
    failed = 1
  else:
    ensure_dir("build")
    io.write_all("build/release_sign.key", rel_sign_key)
    cmd_ra:str = str_join3(runner, " ", "release-artifacts --verify-repro --require-sign --sign-key-file build/release_sign.key")
    if proc_run(cmd_ra) != 0:
      failed = 1
    free(cmd_ra)
  if rel_sign_key != 0:
    free(rel_sign_key)

  cmd_rc:str = str_join3(runner, " ", "reprocheck")
  if proc_run(cmd_rc) != 0:
    failed = 1
  free(cmd_rc)

  cmd_rp:str = str_join3(runner, " ", "release-policy-check")
  if proc_run(cmd_rp) != 0:
    failed = 1
  free(cmd_rp)

  if path_exists("tools/m6_perf_gate.sh") == 0:
    say "release: missing tools/m6_perf_gate.sh"
    failed = 1
  else:
    cmd_pg:str = str_join2("bash tools/m6_perf_gate.sh", "")
    if proc_run(cmd_pg) != 0:
      failed = 1
    free(cmd_pg)

  if path_exists("tools/tznum_perf_gate.sh") == 0:
    say "release: missing tools/tznum_perf_gate.sh"
    failed = 1
  else:
    cmd_tzpg:str = str_join2("bash tools/tznum_perf_gate.sh", "")
    if proc_run(cmd_tzpg) != 0:
      failed = 1
    free(cmd_tzpg)

  if failed == 0:
    say "release: OK"
    ret 0
  say "release: FAILED"
  ret 0 - 1

fn cmd_fmt() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_fmt()
      ret 0
  if user_args_count() < 2:
    print_usage_fmt()
    ret 0 - 1
  path:str = arg(1)
  os:str = os_name()
  exe_suffix:str = ""
  if streq(os, "windows"):
    exe_suffix = ".exe"
  tezzc:str = tezzc_path()
  cmd1:str = str_join3(tezzc, " fmt ", path)
  r:int = proc_run(cmd1)
  free(cmd1)
  ret r

fn cmd_lint() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_lint()
      ret 0
  if user_args_count() < 2:
    print_usage_lint()
    ret 0 - 1
  path:str = arg(1)
  os:str = os_name()
  exe_suffix:str = ""
  if streq(os, "windows"):
    exe_suffix = ".exe"
  tezzc:str = tezzc_path()
  cmd1:str = str_join3(tezzc, " lint ", path)
  r:int = proc_run(cmd1)
  free(cmd1)
  ret r

fn cmd_manifest() -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    say "missing tezz.mod"
    ret 0 - 1

  name:str = mod_get_value(mod, "name")
  ver:str = mod_get_value(mod, "version")
  root:str = project_module_root(mod)

  names:[str;64]
  vers:[str;64]
  dep_n:int = 0

  i:int = 0
  line:int = 0
  while 1:
    c:int = mod[i] as int
    if c == 0 || c == 10:
      end:int = i
      s:int = line
      while s < end && (mod[s] == 32 || mod[s] == 9):
        s = s + 1
      if starts_with_at(mod, s, "dep.") != 0:
        s = s + 4
        ns:int = s
        while s < end && mod[s] != 32 && mod[s] != 9 && mod[s] != 61:
          s = s + 1
        ne:int = s
        while s < end && mod[s] != 61:
          s = s + 1
        if s < end && mod[s] == 61:
          s = s + 1
          while s < end && (mod[s] == 32 || mod[s] == 9):
            s = s + 1
          vs:int = s
          ve:int = end
          while ve > vs && (mod[ve-1] == 32 || mod[ve-1] == 9 || mod[ve-1] == 13):
            ve = ve - 1
          if dep_n < 64:
            names[dep_n] = substr_dup(mod, ns, ne)
            vers[dep_n] = substr_dup(mod, vs, ve)
            dep_n = dep_n + 1
      if c == 0:
        break
      line = i + 1
    i = i + 1

  lines:[str;128]
  line_n:int = 0
  j:int = 0

  i = 0
  while i < dep_n:
    dep_path:str = dep_module_path(root, names[i])
    data:str = io.read_all(dep_path)
    if data == 0:
      say "missing lib file: "
      say dep_path
      free(dep_path)
      ret 0 - 1
    free(data)
    nv:str = str_join3(names[i], "@", vers[i])
    lines[line_n] = nv
    line_n = line_n + 1
    free(dep_path)
    i = i + 1

  // sort lines for determinism
  a:int = 0
  while a < line_n:
    b:int = a + 1
    while b < line_n:
      if strcmp(lines[a], lines[b]) > 0:
        tmp:str = lines[a]
        lines[a] = lines[b]
        lines[b] = tmp
      b = b + 1
    a = a + 1

  ensure_dir("build")

  total:int = 0
  if name != 0:
    total = total + len("name = ") + len(name) + 1
  if ver != 0:
    total = total + len("version = ") + len(ver) + 1
  if root != 0:
    total = total + len("module_root = ") + len(root) + 1

  i = 0
  while i < line_n:
    total = total + len(lines[i]) + 1
    i = i + 1

  out:*char = (*char)malloc(total + 1)
  w:int = 0
  if name != 0:
    pre:str = "name = "
    j = 0
    while pre[j] != 0:
      out[w] = pre[j]
      w = w + 1
      j = j + 1
    j = 0
    while name[j] != 0:
      out[w] = name[j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1
  if ver != 0:
    pre2:str = "version = "
    j = 0
    while pre2[j] != 0:
      out[w] = pre2[j]
      w = w + 1
      j = j + 1
    j = 0
    while ver[j] != 0:
      out[w] = ver[j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1
  if root != 0:
    pre3:str = "module_root = "
    j = 0
    while pre3[j] != 0:
      out[w] = pre3[j]
      w = w + 1
      j = j + 1
    j = 0
    while root[j] != 0:
      out[w] = root[j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1

  i = 0
  while i < line_n:
    j = 0
    while lines[i][j] != 0:
      out[w] = lines[i][j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1
    i = i + 1

  out[w] = 0 as char
  io.write_all("build/tezz.manifest", out)

  free(out)
  i = 0
  while i < line_n:
    free(lines[i])
    i = i + 1
  if name != 0:
    free(name)
  if ver != 0:
    free(ver)
  if root != 0:
    free(root)
  i = 0
  while i < dep_n:
    free(names[i])
    free(vers[i])
    i = i + 1
  free(mod)
  ret 0

fn cmd_lock() -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    say "missing tezz.mod"
    ret 0 - 1

  root:str = project_module_root(mod)
  reglib:str = mod_get_value(mod, "registry_lib")
  reg:str = 0 as str
  base:str = reglib
  own_base:int = 0
  if base == 0:
    reg = mod_get_value(mod, "registry")
    if reg != 0:
      base = url_dir(reg)
      own_base = 1
  if base == 0:
    base = "https://tn.tezzcorp.com/lib/"
    own_base = 0

  names:[str;64]
  vers:[str;64]
  dep_n:int = 0

  i:int = 0
  line:int = 0
  while 1:
    c:int = mod[i] as int
    if c == 0 || c == 10:
      end:int = i
      s:int = line
      while s < end && (mod[s] == 32 || mod[s] == 9):
        s = s + 1
      if starts_with_at(mod, s, "dep.") != 0:
        s = s + 4
        ns:int = s
        while s < end && mod[s] != 32 && mod[s] != 9 && mod[s] != 61:
          s = s + 1
        ne:int = s
        while s < end && mod[s] != 61:
          s = s + 1
        if s < end && mod[s] == 61:
          s = s + 1
          while s < end && (mod[s] == 32 || mod[s] == 9):
            s = s + 1
          vs:int = s
          ve:int = end
          while ve > vs && (mod[ve-1] == 32 || mod[ve-1] == 9 || mod[ve-1] == 13):
            ve = ve - 1
          if dep_n < 64:
            names[dep_n] = substr_dup(mod, ns, ne)
            vers[dep_n] = substr_dup(mod, vs, ve)
            dep_n = dep_n + 1
      if c == 0:
        break
      line = i + 1
    i = i + 1

  lines:[str;128]
  line_n:int = 0

  i = 0
  while i < dep_n:
    dep_path:str = dep_module_path(root, names[i])
    data:str = io.read_all(dep_path)
    if data == 0:
      say "missing lib file: "
      say dep_path
      free(dep_path)
      ret 0 - 1
    free(data)
    crc:int = crc32_source_file(dep_path)
    crc_hex:str = hex8(crc)
    crc_owned:int = 1
    if crc_hex == 0:
      crc_hex = "00000000"
      crc_owned = 0

    base2:str = base
    own_base2:int = 0
    bl:int = len(base)
    if bl > 0 && base[bl-1] != 47:
      base2 = str_join2(base, "/")
      own_base2 = 1
    url1:str = str_join2(base2, names[i])
    url2:str = str_join2(url1, ".tn")

    nv:str = str_join3(names[i], "@", vers[i])
    line1:str = str_join2(nv, " ")
    line2:str = str_join2(line1, crc_hex)
    line3:str = str_join2(line2, " ")
    line4:str = str_join2(line3, url2)
    lines[line_n] = line4
    line_n = line_n + 1

    free(dep_path)
    if crc_owned != 0:
      free(crc_hex)
    free(url1)
    free(url2)
    free(nv)
    free(line1)
    free(line2)
    free(line3)
    if own_base2 != 0:
      free(base2)
    i = i + 1

  // sort lines for determinism
  a:int = 0
  while a < line_n:
    b:int = a + 1
    while b < line_n:
      if strcmp(lines[a], lines[b]) > 0:
        tmp:str = lines[a]
        lines[a] = lines[b]
        lines[b] = tmp
      b = b + 1
    a = a + 1

  total:int = 0
  i = 0
  while i < line_n:
    total = total + len(lines[i]) + 1
    i = i + 1
  out:*char = (*char)malloc(total + 1)
  w:int = 0
  i = 0
  while i < line_n:
    j:int = 0
    while lines[i][j] != 0:
      out[w] = lines[i][j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1
    i = i + 1
  out[w] = 0 as char

  meta:str = provenance_meta_line("lock-meta", out, line_n)
  full:str = str_join3(meta, "\n", out)
  io.write_all("tezz.lock", full)
  free(full)
  free(meta)
  free(out)
  i = 0
  while i < line_n:
    free(lines[i])
    i = i + 1
  i = 0
  while i < dep_n:
    free(names[i])
    free(vers[i])
    i = i + 1
  if own_base != 0 && base != 0:
    free(base)
  if reglib != 0:
    free(reglib)
  if reg != 0:
    free(reg)
  if root != 0:
    free(root)
  free(mod)
  ret 0

fn cmd_registry() -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    say "missing tezz.mod"
    ret 0 - 1

  root:str = project_module_root(mod)
  reglib:str = mod_get_value(mod, "registry_lib")
  reg:str = 0 as str
