                  say start
                  failed = failed + 1
                free(out_arm)
            remove(out_arm_path)
            free(out_arm_path)
        free(out1)
        free(out2)
        free(cmd1)
        free(cmd2)
        free(cmd3)
        if out_vm != 0:
          free(out_vm)
        free(base)
        free(start)
      free(arm_list3)

  // macOS host-run for Mach-O tests (optional)
  if streq(os, "macos") && host_macos != 0:
    macho_list2:str = io.read_all("tests/buildexe_macho_manifest.tnx")
    if macho_list2 != 0:
      ensure_dir("build")
