// TezzNative tool (self-hosting scaffolding)
import "io"
import "net"
import "time"

// Unique suffix counter for Windows builds (avoid locked object collisions).
static let g_obj_uid:int = 1
static let g_startup_profile_path:str = ""
static let g_startup_profile_lane:str = ""
static let g_startup_profile_source:str = ""
static let g_startup_profile_platform:str = ""
static let g_startup_profile_vectorize:int = 0
static let g_startup_profile_pre_ms:int = 0
static let g_startup_profile_exec_ms:int = 0
static let g_startup_profile_total_ms:int = 0
static let g_startup_profile_rc:int = 0

fn streq(a:str, b:str) -> int:
  if a == 0 && b == 0:
    ret 1
  if a == 0 || b == 0:
    ret 0
  an:int = len(a)
  bn:int = len(b)
  if an != bn:
    ret 0
  i:int = 0
  while i < an:
    if a[i] != b[i]:
      ret 0
    i = i + 1
  ret 1

fn str_len(s:str) -> int:
  ret len(s)

fn str_contains(hay:str, needle:str) -> int:
  if hay == 0 || needle == 0:
    ret 0
  n:int = len(needle)
  if n == 0:
    ret 1
  i:int = 0
  while hay[i] != 0:
    j:int = 0
    while needle[j] != 0 && hay[i + j] == needle[j]:
      j = j + 1
    if needle[j] == 0:
      ret 1
    i = i + 1
  ret 0

fn str_join2(a:str, b:str) -> str:
  if a == 0:
    a = ""
  if b == 0:
    b = ""
  al:int = len(a)
  bl:int = len(b)
  out:*char = (*char)malloc(al + bl + 1)
  i:int = 0
  while i < al:
    out[i] = a[i]
    i = i + 1
  j:int = 0
  while j < bl:
    out[i + j] = b[j]
    j = j + 1
  out[al + bl] = 0 as char
  ret out

fn str_join3(a:str, b:str, c:str) -> str:
  if a == 0:
    a = ""
  if b == 0:
    b = ""
  if c == 0:
    c = ""
  al:int = len(a)
  bl:int = len(b)
  cl:int = len(c)
  out:*char = (*char)malloc(al + bl + cl + 1)
  i:int = 0
  while i < al:
    out[i] = a[i]
    i = i + 1
  j:int = 0
  while j < bl:
    out[i + j] = b[j]
    j = j + 1
  k:int = 0
  while k < cl:
    out[i + j + k] = c[k]
    k = k + 1
  out[al + bl + cl] = 0 as char
  ret out

fn maybe_free(s:str) -> int:
  if s != 0:
    free(s)
  ret 0

fn quote_cmd_path(p:str) -> str:
  if p == 0:
    ret 0 as str
  // already quoted
  if p[0] == (34 as char):
    ret str_join2("", p)
  i:int = 0
  while p[i] != 0:
    c:int = p[i] as int
    if c == 32 || c == 9:
      q1:str = str_join2("\"", p)
      q2:str = str_join2(q1, "\"")
      free(q1)
      ret q2
    i = i + 1
  ret str_join2("", p)

fn tezzc_override_arg() -> str:
  i:int = 0
  while i < args_count():
    a:str = arg(i)
    if streq(a, "--tezzc") && (i + 1) < args_count():
      ret arg(i + 1)
    if starts_with(a, "--tezzc=") != 0:
      ret a + 8
    i = i + 1
  ret 0 as str

fn sdk_root_arg() -> str:
  i:int = 0
  while i < args_count():
    a:str = arg(i)
    if streq(a, "--sdk-root") && (i + 1) < args_count():
      ret arg(i + 1)
    if starts_with(a, "--sdk-root=") != 0:
      ret a + 11
    i = i + 1
  ret 0 as str

fn path_join(root:str, rel:str) -> str:
  if root == 0:
    ret str_join2("", rel)
  if rel == 0:
    ret str_join2("", root)
  n:int = len(root)
  if n > 0:
    c:int = root[n - 1] as int
    if c == 47 || c == 92:
      ret str_join2(root, rel)
  ret str_join3(root, "/", rel)

fn hidden_arg_key(a:str) -> int:
  if a == 0:
    ret 0
  if streq(a, "--tezzc") != 0 || starts_with(a, "--tezzc=") != 0:
    ret 1
  if streq(a, "--sdk-root") != 0 || starts_with(a, "--sdk-root=") != 0:
    ret 1
  ret 0

fn user_args_count() -> int:
  i:int = 0
  n:int = args_count()
  while i < n:
    a:str = arg(i)
    if hidden_arg_key(a) != 0:
      ret i
    i = i + 1
  ret n

fn dup_lit(s:str) -> str:
  if s == 0:
    ret 0 as str
  ret str_join2("", s)

fn win_fix_cmd_slash(cmd:str) -> str:
  if cmd == 0:
    ret 0 as str
  n:int = len(cmd)
  out:*char = (*char)malloc(n + 1)
  i:int = 0
  while i < n:
    c:int = cmd[i] as int
    if c == 47:
      out[i] = 92 as char
    else:
      out[i] = cmd[i]
    i = i + 1
  out[n] = 0 as char
  ret out

fn url_dir(u:str) -> str:
  if u == 0:
    ret 0 as str
  n:int = len(u)
  if n == 0:
    ret str_join2(u, "/")
  i:int = n - 1
  while i >= 0:
    if u[i] == 47:
      ret substr_dup(u, 0, i + 1)
    i = i - 1
  // no slash
  ret str_join2(u, "/")

fn is_space(c:int) -> int:
  ret c == 32 || c == 9 || c == 13 || c == 10

fn starts_with(s:str, pre:str) -> int:
  if s == 0 || pre == 0:
    ret 0
  sn:int = len(s)
  pn:int = len(pre)
  if pn > sn:
    ret 0
  i:int = 0
  while i < pn:
    if s[i] != pre[i]:
      ret 0
    i = i + 1
  ret 1

fn starts_with_at(s:str, off:int, pre:str) -> int:
  if s == 0 || pre == 0:
    ret 0
  if off < 0:
    ret 0
  sn:int = len(s)
  pn:int = len(pre)
  if off > sn:
    ret 0
  if (off + pn) > sn:
    ret 0
  seg:str = substr_dup(s, off, off + pn)
  ok:int = 0
  if seg != 0:
    if strcmp(seg, pre) == 0:
      ok = 1
  free(seg)
  ret ok

fn substr_dup(s:str, a:int, b:int) -> str:
  if s == 0:
    ret 0 as str
  slen:int = len(s)
  st:int = a
  en:int = b
  if st < 0:
    st = 0
  if st > slen:
    st = slen
  if en < st:
    en = st
  if en > slen:
    en = slen
  n:int = en - st
  out:*char = malloc(n + 1)
  if out == 0:
    ret 0 as str
  if n > 0:
    unsafe:
      memcpy(out, (s as *char) + st, n)
  out[n] = 0 as char
  ret out as str

fn path_basename_no_ext(p:str) -> str:
  if p == 0:
    ret 0 as str
  n:int = len(p)
  if n == 0:
    ret substr_dup(p, 0, 0)
  i:int = n - 1
  while i >= 0:
    c:int = p[i] as int
    if c == 47 || c == 92:
      break
    i = i - 1
  start:int = i + 1
  end:int = n
  if n >= 3:
    if p[n-3] == 46 && p[n-2] == 116 && p[n-1] == 110:
      end = n - 3
  if end < start:
    end = start
  ret substr_dup(p, start, end)

fn ensure_dir(path:str) -> int:
  if path == 0:
    ret 0 - 1
  if path_exists(path) != 0:
    if path_is_dir(path) != 0:
      ret 0
    ret 0 - 1
  ret mkdir(path)

fn mod_get_value(mod:str, key:str) -> str:
  if mod == 0 || key == 0:
    ret 0 as str
  scan:str = str_join2("", mod)
  key2:str = str_join2("", key)
  if scan == 0 || key2 == 0:
    if scan != 0:
      free(scan)
    if key2 != 0:
      free(key2)
    ret 0 as str
  i:int = 0
  line:int = 0
  while 1:
    c:int = scan[i] as int
    if c == 0 || c == 10:
      end:int = i
      s:int = line
      while s < end && (scan[s] == 32 || scan[s] == 9):
        s = s + 1
      if starts_with_at(scan, s, key2) != 0:
        k:int = len(key2)
        t:int = s + k
        while t < end && (scan[t] == 32 || scan[t] == 9):
          t = t + 1
        if t < end && scan[t] == 61:
          t = t + 1
          while t < end && (scan[t] == 32 || scan[t] == 9):
            t = t + 1
          u:int = end
          while u > t && (scan[u-1] == 32 || scan[u-1] == 9 || scan[u-1] == 13):
            u = u - 1
          if u > t:
            outv:str = substr_dup(scan, t, u)
            free(key2)
            free(scan)
            ret outv
      if c == 0:
        break
      line = i + 1
    i = i + 1
  free(key2)
  free(scan)
  ret 0 as str

fn crc32_bytes(buf:*char, n:int) -> int:
  if buf == 0 || n <= 0:
    ret 0
  // Stable 32-bit hash for lock/check metadata.
  // Uses a djb2-style mixer to avoid wide unsigned constant portability issues.
  h:int = 5381
  i:int = 0
  while i < n:
    b:int = 0
    unsafe:
      b = buf[i] as int
    b = b & 255
    h = ((h << 5) + h + b) & 2147483647
    i = i + 1
  ret h

fn crc32_str(s:str) -> int:
  if s == 0:
    ret 0
  s2:str = str_join2("", s)
  if s2 == 0:
    ret 0
  n:int = len(s2)
  h:int = 5381
  i:int = 0
  while i < n:
    b:int = s2[i] as int
    b = b & 255
    h = ((h << 5) + h + b) & 2147483647
    i = i + 1
  free(s2)
  ret h

fn hex8(x:int) -> str:
  u:int = x
  if u < 0:
    u = u + 4294967296
  out:*char = (*char)malloc(9)
  i:int = 0
  while i < 8:
    sh:int = (7 - i) * 4
    nib:int = (u >> sh) & 15
    c:int = 0
    if nib < 10:
      c = 48 + nib
    else:
      c = 55 + nib
    out[i] = c as char
    i = i + 1
  out[8] = 0 as char
  ret out

fn hex64_pair(hi:int, lo:int) -> str:
  s1:str = hex8(hi)
  s2:str = hex8(lo)
  out:str = str_join2(s1, s2)
  free(s1); free(s2)
  ret out

fn rd_u16(buf:*char, off:int) -> int:
  if buf == 0:
    ret 0
  b0:int = 0
  b1:int = 0
  unsafe:
    b0 = buf[off] as int
    b1 = buf[off + 1] as int
  if b0 < 0:
    b0 = b0 + 256
  if b1 < 0:
    b1 = b1 + 256
  ret b0 | (b1 << 8)

fn rd_u32(buf:*char, off:int) -> int:
  if buf == 0:
    ret 0
  b0:int = 0
  b1:int = 0
  b2:int = 0
  b3:int = 0
  unsafe:
    b0 = buf[off] as int
    b1 = buf[off + 1] as int
    b2 = buf[off + 2] as int
    b3 = buf[off + 3] as int
  if b0 < 0:
    b0 = b0 + 256
  if b1 < 0:
    b1 = b1 + 256
  if b2 < 0:
    b2 = b2 + 256
  if b3 < 0:
    b3 = b3 + 256
  ret b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

fn dbg_elf_kernel(path:str):
  if path == 0:
    ret
  buf:*char = read_file(path)
  if buf == 0:
    ret
  magic0:int = 0
  magic1:int = 0
  magic2:int = 0
  magic3:int = 0
  unsafe:
    magic0 = buf[0] as int
    magic1 = buf[1] as int
    magic2 = buf[2] as int
    magic3 = buf[3] as int
  if magic0 < 0:
    magic0 = magic0 + 256
  if magic1 < 0:
    magic1 = magic1 + 256
  if magic2 < 0:
    magic2 = magic2 + 256
  if magic3 < 0:
    magic3 = magic3 + 256
  if magic0 != 127:
    say "elf: bad magic"
    free(buf)
    ret
  if magic1 != 69:
    say "elf: bad magic"
    free(buf)
    ret
  if magic2 != 76:
    say "elf: bad magic"
    free(buf)
    ret
  if magic3 != 70:
    say "elf: bad magic"
    free(buf)
    ret
  entry_lo:int = rd_u32(buf, 24)
  entry_hi:int = rd_u32(buf, 28)
  phoff_lo:int = rd_u32(buf, 32)
  phoff_hi:int = rd_u32(buf, 36)
  phentsz:int = rd_u16(buf, 54)
  phnum:int = rd_u16(buf, 56)
  entry_hex:str = hex64_pair(entry_hi, entry_lo)
  phoff_hex:str = hex64_pair(phoff_hi, phoff_lo)
  msg1:str = str_join3("elf: entry=0x", entry_hex, " phoff=0x")
  msg2:str = str_join3(msg1, phoff_hex, " phnum=")
  pns:str = int_to_str(phnum)
  msg3:str = str_join2(msg2, pns)
  say msg3
  io.write_all("build/boot/elf_dbg.txt", msg3)
  free(entry_hex); free(phoff_hex); free(pns); free(msg1); free(msg2); free(msg3)
  if phnum > 0:
    if phentsz >= 56:
    // Dump first program header (ELF64).
      ph0:int = phoff_lo
      p_type:int = rd_u32(buf, ph0 + 0)
      p_flags:int = rd_u32(buf, ph0 + 4)
      p_off_lo:int = rd_u32(buf, ph0 + 8)
      p_off_hi:int = rd_u32(buf, ph0 + 12)
      p_vaddr_lo:int = rd_u32(buf, ph0 + 16)
      p_vaddr_hi:int = rd_u32(buf, ph0 + 20)
      p_paddr_lo:int = rd_u32(buf, ph0 + 24)
      p_paddr_hi:int = rd_u32(buf, ph0 + 28)
      p_filesz_lo:int = rd_u32(buf, ph0 + 32)
      p_filesz_hi:int = rd_u32(buf, ph0 + 36)
      p_memsz_lo:int = rd_u32(buf, ph0 + 40)
      p_memsz_hi:int = rd_u32(buf, ph0 + 44)
      tstr:str = int_to_str(p_type)
      off_hex:str = hex64_pair(p_off_hi, p_off_lo)
      v_hex:str = hex64_pair(p_vaddr_hi, p_vaddr_lo)
      pa_hex:str = hex64_pair(p_paddr_hi, p_paddr_lo)
      fs_hex:str = hex64_pair(p_filesz_hi, p_filesz_lo)
      ms_hex:str = hex64_pair(p_memsz_hi, p_memsz_lo)
      msga:str = str_join3("elf: ph0 type=", tstr, " off=0x")
      msgb:str = str_join3(msga, off_hex, " vaddr=0x")
      msgc:str = str_join3(msgb, v_hex, " paddr=0x")
      msgd:str = str_join3(msgc, pa_hex, " filesz=0x")
      msge:str = str_join3(msgd, fs_hex, " memsz=0x")
      msgf:str = str_join2(msge, ms_hex)
      say msgf
      prev:str = io.read_all("build/boot/elf_dbg.txt")
      if prev != 0:
        tmp:str = str_join3(prev, "\n", msgf)
        io.write_all("build/boot/elf_dbg.txt", tmp)
        free(tmp)
        free(prev)
      else:
        io.write_all("build/boot/elf_dbg.txt", msgf)
      free(tstr); free(off_hex); free(v_hex); free(pa_hex); free(fs_hex); free(ms_hex)
      free(msga); free(msgb); free(msgc); free(msgd); free(msge); free(msgf)
  free(buf)

fn parse_hex(s:str) -> int:
  if s == 0:
    ret 0
  i:int = 0
  v:int = 0
  while s[i] != 0:
    c:int = s[i] as int
    d:int = 0 - 1
    if c >= 48 && c <= 57:
      d = c - 48
    else:
      if c >= 65 && c <= 70:
        d = c - 65 + 10
      else:
        if c >= 97 && c <= 102:
          d = c - 97 + 10
    if d < 0:
      break
    v = (v << 4) | d
    v = v & 4294967295
    i = i + 1
  ret v

fn is_hex_digit(c:int) -> int:
  if c >= 48 && c <= 57:
    ret 1
  if c >= 65 && c <= 70:
    ret 1
  if c >= 97 && c <= 102:
    ret 1
  ret 0

fn is_hex8(s:str) -> int:
  if s == 0:
    ret 0
  i:int = 0
  while s[i] != 0:
    if is_hex_digit(s[i] as int) == 0:
      ret 0
    i = i + 1
  ret i == 8

fn parse_i64(s:str) -> int:
  if s == 0:
    ret 0
  s2:str = str_join2("", s)
  if s2 == 0:
    ret 0
  i:int = 0
  sign:int = 1
  if s2[0] == 45:
    sign = 0 - 1
    i = 1
  v:int = 0
  while s2[i] != 0:
    c:int = s2[i] as int
    if c < 48 || c > 57:
      break
    v = v * 10 + (c - 48)
    i = i + 1
  free(s2)
  ret v * sign

fn int_to_str(x:int) -> str:
  neg:int = 0
  v:int = x
  if v < 0:
    neg = 1
    v = 0 - v
  buf:[char;32]
  i:int = 0
  if v == 0:
    buf[i] = 48 as char
    i = i + 1
  while v > 0:
    d:int = v % 10
    buf[i] = (48 + d) as char
    i = i + 1
    v = v / 10
  if neg != 0:
    buf[i] = 45 as char
    i = i + 1
  out:*char = (*char)malloc(i + 1)
  j:int = 0
  while j < i:
    out[j] = buf[i - 1 - j]
    j = j + 1
  out[i] = 0 as char
  ret out

fn meta_find_value(line:str, key:str) -> str:
  if line == 0 || key == 0:
    ret 0 as str
  line2:str = str_join2("", line)
  key2:str = str_join2("", key)
  if line2 == 0 || key2 == 0:
    if line2 != 0:
      free(line2)
    if key2 != 0:
      free(key2)
    ret 0 as str
  kn:int = len(key2)
  i:int = 0
  while line2[i] != 0:
    if (i == 0 || is_space(line2[i - 1] as int) != 0) && starts_with_at(line2, i, key2) != 0:
      j:int = i + kn
      while line2[j] != 0 && is_space(line2[j] as int) == 0:
        j = j + 1
      outv:str = substr_dup(line2, i + kn, j)
      free(line2)
      free(key2)
      ret outv
    i = i + 1
  free(line2)
  free(key2)
  ret 0 as str

fn meta_signature_hex(payload_hex:str, line_n:int, sign_key:str) -> str:
  has_key:int = 0
  if sign_key != 0:
    if sign_key[0] != 0:
      has_key = 1
  if has_key == 0:
    ret substr_dup("none", 0, 4)
  ln:str = int_to_str(line_n)
  p0:str = str_join3(payload_hex, "|", ln)
  p1:str = str_join3(p0, "|", sign_key)
  sig:str = hex8(crc32_str(p1))
  free(ln)
  free(p0)
  free(p1)
  ret sig

fn provenance_meta_line(kind:str, payload:str, line_n:int) -> str:
  crc:int = crc32_str(payload)
  payload_hex:str = hex8(crc)
  sign_key:str = env_value("TEZZ_SIGN_KEY")
  key_id:str = substr_dup("none", 0, 4)
  has_key:int = 0
  if sign_key != 0:
    if sign_key[0] != 0:
      has_key = 1
  if has_key != 0:
    free(key_id)
    key_id = hex8(crc32_str(sign_key))
  sig:str = meta_signature_hex(payload_hex, line_n, sign_key)
  ln:str = int_to_str(line_n)
  p0:str = str_join3("# ", kind, " v1 ")
  p1:str = str_join3(p0, "lines=", ln)
  p2:str = str_join3(p1, " payload=", payload_hex)
  p3:str = str_join3(p2, " key=", key_id)
  out:str = str_join3(p3, " sig=", sig)
  free(payload_hex)
  free(key_id)
  free(sig)
  free(ln)
  free(p0)
  free(p1)
  free(p2)
  free(p3)
  if sign_key != 0:
    free(sign_key)
  ret out

fn release_sign_key() -> str:
  k1:str = env_value("TEZZ_RELEASE_SIGN_KEY")
  if k1 != 0:
    if k1[0] != 0:
      ret k1
    free(k1)
  k2:str = env_value("TEZZ_SIGN_KEY")
  if k2 != 0:
    if k2[0] != 0:
      ret k2
    free(k2)
  if path_exists("build/release_sign.key") != 0:
    k3raw:str = io.read_all("build/release_sign.key")
    if k3raw != 0:
      k3:str = trim_line(k3raw)
      if k3[0] != 0:
        ret str_join2(k3, "")
  ret 0 as str

fn release_meta_line(payload:str, line_n:int, sign_key:str) -> str:
  payload_hex:str = hex8(crc32_str(payload))
  key_id:str = substr_dup("none", 0, 4)
  has_key:int = 0
  if sign_key != 0:
    if sign_key[0] != 0:
      has_key = 1
  if has_key != 0:
    free(key_id)
    key_id = hex8(crc32_str(sign_key))
  sig:str = meta_signature_hex(payload_hex, line_n, sign_key)
  ln:str = int_to_str(line_n)
  p0:str = str_join3("# ", "release-meta", " v1 ")
  p1:str = str_join3(p0, "lines=", ln)
  p2:str = str_join3(p1, " payload=", payload_hex)
  p3:str = str_join3(p2, " key=", key_id)
  out:str = str_join3(p3, " sig=", sig)
  free(payload_hex)
  free(key_id)
  free(sig)
  free(ln)
  free(p0)
  free(p1)
  free(p2)
  free(p3)
  ret out

fn release_append_artifact(payload:*str, line_n:*int, path:str) -> int:
  if path == 0:
    ret 0
  if path[0] == 0:
    ret 0
  if path_exists(path) == 0:
    ret 0
  sz:int = file_size(path)
  crc:int = crc32_file(path)
  szs:str = int_to_str(sz)
  csum:str = hex8(crc)
  p0:str = str_join3(path, " ", szs)
  line:str = str_join3(p0, " ", csum)
  p1:str = 0 as str
  if *payload == 0:
    p1 = str_join3(line, "\n", "")
  else:
    p1 = str_join3(*payload, line, "\n")
    free(*payload)
  *payload = p1
  *line_n = *line_n + 1
  free(szs)
  free(csum)
  free(p0)
  free(line)
  ret 0

fn release_write_manifest(out_path:str, require_sign:int, quiet:int, sign_key_override:str) -> int:
  if out_path == 0 || out_path[0] == 0:
    say "release-artifacts: missing output path"
    ret 0 - 1
  dbg:int = 0
  dbg_v:str = env_value("TEZZ_RELEASE_ARTIFACTS_TRACE")
  if dbg_v != 0:
    if dbg_v[0] != 0 && dbg_v[0] != 48:
      dbg = 1
    free(dbg_v)
  if dbg != 0:
    say "ra: begin"
  payload:str = 0 as str
  line_n:int = 0

  release_append_artifact(&payload, &line_n, "tezz")
  release_append_artifact(&payload, &line_n, "tezz.cmd")
  release_append_artifact(&payload, &line_n, "tezz.ps1")
  release_append_artifact(&payload, &line_n, "tools/tezz.tn")
  release_append_artifact(&payload, &line_n, "CMakeLists.txt")
  release_append_artifact(&payload, &line_n, "tezz.mod")
  release_append_artifact(&payload, &line_n, "tezz.lock")
  release_append_artifact(&payload, &line_n, "docs/LANGUAGE_SPEC.md")
  release_append_artifact(&payload, &line_n, "docs/v1_release.md")
  release_append_artifact(&payload, &line_n, "docs/native_exe_plan.md")
  release_append_artifact(&payload, &line_n, "docs/security_response_policy.md")
  release_append_artifact(&payload, &line_n, "docs/release_candidate_runbook.md")
  release_append_artifact(&payload, &line_n, "docs/m8_platform_ga_runbook.md")
  release_append_artifact(&payload, &line_n, "docs/m8_platform_ga_signoff.md")
  release_append_artifact(&payload, &line_n, "docs/lts_compatibility_policy.md")
  release_append_artifact(&payload, &line_n, "tests/gui_manifest.tnx")
  release_append_artifact(&payload, &line_n, "tests/gui_check_manifest.tnx")
  release_append_artifact(&payload, &line_n, "tests/gui_event_bridge.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_tree_lifecycle.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_caps_host.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_window_smoke.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_ime_state.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_wm_runtime.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_compile_contract.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_tzui_compile.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_tnui_controls_compile.tn")
  release_append_artifact(&payload, &line_n, "tests/gui_wm_compile_contract.tn")
  release_append_artifact(&payload, &line_n, "examples/gui_first_app.tn")
  release_append_artifact(&payload, &line_n, "tests/runtime_call_multiarg.tn")
  release_append_artifact(&payload, &line_n, "bench/perf_baseline_m6.tnx")
  release_append_artifact(&payload, &line_n, "bench/perf_baseline_tznum.tnx")
  release_append_artifact(&payload, &line_n, "bench/perf_compare_matrix.tnx")
  release_append_artifact(&payload, &line_n, "bench/tezz_bench_sum.tn")
  release_append_artifact(&payload, &line_n, "bench/tezz_bench_fib.tn")
  release_append_artifact(&payload, &line_n, "bench/external_manifest.tnx")
  release_append_artifact(&payload, &line_n, "bench/external/bench_sum.py")
  release_append_artifact(&payload, &line_n, "bench/external/bench_fib.py")
  release_append_artifact(&payload, &line_n, "bench/external/bench_sum.c")
  release_append_artifact(&payload, &line_n, "bench/external/bench_fib.c")
  release_append_artifact(&payload, &line_n, "bench/external/run_c_bench_sum.sh")
  release_append_artifact(&payload, &line_n, "bench/external/run_c_bench_fib.sh")
  release_append_artifact(&payload, &line_n, "bench/micro_tznum_matmul_nn.tn")
  release_append_artifact(&payload, &line_n, "bench/micro_tznum_rmsnorm_nn.tn")
  release_append_artifact(&payload, &line_n, "bench/c/tznum_native_parity.c")
  release_append_artifact(&payload, &line_n, "tools/m6_perf_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/tznum_native_parity_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/tznum_perf_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/m8_platform_ga_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/runtime_io_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/simple_mode_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/startup_latency_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/tier1_perf_gate.sh")
  release_append_artifact(&payload, &line_n, "tools/build_core_strict.sh")
  release_append_artifact(&payload, &line_n, "tools/build_core_strict.ps1")
  release_append_artifact(&payload, &line_n, "tools/package_sdk.sh")
  release_append_artifact(&payload, &line_n, "tools/package_sdk.ps1")
  release_append_artifact(&payload, &line_n, "tools/publish_download_bundle.sh")
  release_append_artifact(&payload, &line_n, "tools/publish_download_bundle.ps1")
  release_append_artifact(&payload, &line_n, "tools/deploy_tezzcorp.sh")
  release_append_artifact(&payload, &line_n, "tools/deploy_tezzcorp_rollback.sh")
  release_append_artifact(&payload, &line_n, "bin/tezz")
  release_append_artifact(&payload, &line_n, "bin/tezz.cmd")
  release_append_artifact(&payload, &line_n, "bin/tezz.ps1")
  release_append_artifact(&payload, &line_n, "bin/tezzc")
  release_append_artifact(&payload, &line_n, "bin/tezzc.exe")
  release_append_artifact(&payload, &line_n, "build/tezzc")
  release_append_artifact(&payload, &line_n, "build/tezzc.exe")
  release_append_artifact(&payload, &line_n, "bin/tezzc-linux-x64")
  release_append_artifact(&payload, &line_n, "bin/tezzc-windows-x64.exe")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/index.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/assets/site.css")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/assets/site.js")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/download/install.sh")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/download/install.ps1")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/download/install_gui.ps1")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/download/install_gui.cmd")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/index.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/tezzapi.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/tezzserve.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/tsm.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/tezzui.php")
  release_append_artifact(&payload, &line_n, "web/tn_site/public/frameworks/tezzdb.php")
  release_append_artifact(&payload, &line_n, "build/tezznative-sdk-linux.tar.gz")
  release_append_artifact(&payload, &line_n, "build/tezznative-sdk-macos.tar.gz")
  release_append_artifact(&payload, &line_n, "build/tezznative-sdk.zip")

  if line_n == 0:
    say "release-artifacts: no artifact files found"
    if payload != 0:
      free(payload)
    ret 0 - 1
  if dbg != 0:
    ln_dbg0:str = int_to_str(line_n)
    say "ra: collected lines"
    say ln_dbg0
    free(ln_dbg0)

  sign_key:str = 0 as str
  has_sign:int = 0
  if sign_key_override != 0:
    if sign_key_override[0] != 0:
      sign_key = str_join2(sign_key_override, "")
      has_sign = 1
  if has_sign == 0 && require_sign != 0:
    sign_key = release_sign_key()
    if sign_key != 0:
      if sign_key[0] != 0:
        has_sign = 1
      else:
        free(sign_key)
        sign_key = 0 as str
  if require_sign != 0 && has_sign == 0:
    say "release-artifacts: missing signing key"
    say "set TEZZ_RELEASE_SIGN_KEY (or TEZZ_SIGN_KEY) and retry"
    if payload != 0:
      free(payload)
    if sign_key != 0:
      free(sign_key)
    ret 0 - 1
  if dbg != 0:
    say "ra: signing ready"

  if dbg != 0:
    say "ra: before meta"
  meta:str = release_meta_line(payload, line_n, sign_key)
  if dbg != 0:
    say "ra: after meta"
  out:str = str_join3(meta, "\n", payload)
  if dbg != 0:
    say "ra: after join"
  if starts_with(out_path, "build/") != 0:
    ensure_dir("build")
  io.write_all(out_path, out)
  if dbg != 0:
    say "ra: after write"

  if quiet == 0:
    say "release-artifacts: wrote"
    say out_path
    say "release-artifacts: signed entries"
    ln_say:str = int_to_str(line_n)
    say ln_say
    free(ln_say)
  if sign_key != 0:
    free(sign_key)
  free(meta)
  if payload != 0:
    free(payload)
  free(out)
  if dbg != 0:
    say "ra: done"
  ret 0

fn stats_min(buf:*int, n:int) -> int:
  if n <= 0:
    ret 0
  m:int = buf[0]
  i:int = 1
  while i < n:
    if buf[i] < m:
      m = buf[i]
    i = i + 1
  ret m

fn stats_avg(buf:*int, n:int) -> int:
  if n <= 0:
    ret 0
  sum:int = 0
  i:int = 0
  while i < n:
    sum = sum + buf[i]
    i = i + 1
  ret sum / n

fn stats_median(buf:*int, n:int) -> int:
  if n <= 0:
    ret 0
  tmp:[int;64]
  i:int = 0
  while i < n:
    tmp[i] = buf[i]
    i = i + 1
  i = 0
  while i < n:
    j:int = i + 1
    while j < n:
      if tmp[j] < tmp[i]:
        t:int = tmp[i]
        tmp[i] = tmp[j]
        tmp[j] = t
      j = j + 1
    i = i + 1
  if (n % 2) != 0:
    ret tmp[n / 2]
  a:int = tmp[(n / 2) - 1]
  b:int = tmp[n / 2]
  ret (a + b) / 2

fn stats_p95(buf:*int, n:int) -> int:
  if n <= 0:
    ret 0
  tmp:[int;64]
  i:int = 0
  while i < n:
    tmp[i] = buf[i]
    i = i + 1
  i = 0
  while i < n:
    j:int = i + 1
    while j < n:
      if tmp[j] < tmp[i]:
        t:int = tmp[i]
        tmp[i] = tmp[j]
        tmp[j] = t
      j = j + 1
    i = i + 1
  idx:int = ((n * 95) + 99) / 100
  if idx <= 0:
    idx = 1
  idx = idx - 1
  if idx >= n:
    idx = n - 1
  ret tmp[idx]

fn sqrtf(x:float) -> float:
  if x <= 0.0:
    ret 0.0
  r:float = x
  i:int = 0
  while i < 8:
    r = 0.5 * (r + (x / r))
    i = i + 1
  ret r

fn stats_stddev(buf:*int, n:int) -> int:
  if n <= 1:
    ret 0
  sum:float = 0.0
  i:int = 0
  while i < n:
    sum = sum + (buf[i] as float)
    i = i + 1
  mean:float = sum / (n as float)
  var:float = 0.0
  i = 0
  while i < n:
    d:float = (buf[i] as float) - mean
    var = var + (d * d)
    i = i + 1
  var = var / (n as float)
  sd:float = sqrtf(var)
  ret sd as int

fn csv_field(line:str, idx:int) -> str:
  if line == 0:
    ret 0 as str
  i:int = 0
  field:int = 0
  start:int = 0
  while line[i] != 0:
    if line[i] == 44:
      if field == idx:
        ret substr_dup(line, start, i)
      field = field + 1
      start = i + 1
    i = i + 1
  if field == idx:
    ret substr_dup(line, start, i)
  ret 0 as str

fn bench_find_p95(log:str, name:str, mode:str) -> int:
  if log == 0 || name == 0 || mode == 0:
    ret 0 - 1
  idx:int = 0
  while 1:
    line:str = next_manifest_line(log, &idx)
    if line == 0:
      break
    if starts_with(line, "name,") != 0:
      free(line)
      continue
    f0:str = csv_field(line, 0)
    f1:str = csv_field(line, 1)
    if f0 != 0 && f1 != 0 && streq(f0, name) != 0 && streq(f1, mode) != 0:
      f6:str = csv_field(line, 6)
      p:int = 0 - 1
      if f6 != 0:
        p = parse_i64(f6)
        free(f6)
      free(f0)
      free(f1)
      free(line)
      ret p
    if f0 != 0:
      free(f0)
    if f1 != 0:
      free(f1)
    free(line)
  ret 0 - 1

fn crc32_file(path:str) -> int:
  if path == 0 || path[0] == 0:
    ret 0
  // Use a streaming byte hash so we can checksum binaries (io.read_all is text-oriented).
  f:*char = fopen(path, "rb")
  if f == 0:
    ret 0
  cap:int = 65536
  buf:*char = (*char)malloc(cap)
  if buf == 0:
    fclose(f)
    ret 0
  h:int = 5381
  for ;;:
    n:int = fread(buf, 1, cap, f)
    if n <= 0:
      break
    i:int = 0
    while i < n:
      b:int = 0
      unsafe:
        b = buf[i] as int
      b = b & 255
      h = ((h << 5) + h + b) & 2147483647
      i = i + 1
  free(buf)
  fclose(f)
  ret h

fn crc32_source_file(path:str) -> int:
  if path == 0 || path[0] == 0:
    ret 0
  data:str = io.read_all(path)
  if data == 0:
    ret 0
  // Canonicalize source package newlines so lockfiles are stable on Windows/Linux.
  h:int = 5381
  pending_cr:int = 0
  n:int = len(data)
  i:int = 0
  while i < n:
    b:int = 0
    unsafe:
      b = data[i] as int
    b = b & 255
    consumed:int = 0
    if pending_cr != 0:
      if b == 10:
        h = ((h << 5) + h + 10) & 2147483647
        pending_cr = 0
        consumed = 1
      else:
        h = ((h << 5) + h + 13) & 2147483647
        pending_cr = 0
    if consumed == 0:
      if b == 13:
        pending_cr = 1
      else:
        h = ((h << 5) + h + b) & 2147483647
    i = i + 1
  if pending_cr != 0:
    h = ((h << 5) + h + 13) & 2147483647
  free(data)
  ret h

fn print_usage() -> int:
  say "tezz <cmd> [args]"
  say "  --version | -V | version"
  say "  init [name] [--name <project_name>] [--template cli|api|lib|script|gui]"
  say "  <file.tn>            (run)"
  say "  run <file.tn> [--mode simple|systems] [--platform linux|windows|macos|android|native] [--vectorize|--no-vectorize] [--startup-profile]"
  say "  build <file.tn> [--platform linux|windows|macos|android] [--vectorize|--no-vectorize] [--dxil] [--dxil-entry <name>] [--dxc <path>]"
  say "  repl [--mode simple|systems] (interactive REPL)"
  say "  install <name@ver> [url] [checksum]   (alias: get)"
  say "  add <name@ver> [url] [checksum]       (dependency install)"
  say "  remove <name>                         (remove dependency)"
  say "  update [--check|--install|--reinstall|--uninstall]"
  say "  get <name@ver> [url] [checksum]"
  say "  lock"
  say "  publish [out_path]                    (validate + write registry metadata)"
  say "  registry [out_path]"
  say "  manifest"
  say "  verify [--strict]"
  say "  release-artifacts [--out <path>] [--verify-repro] [--require-sign] [--sign-key <key>|--sign-key-file <path>]"
  say "  reprocheck"
  say "  release-policy-check"
  say "  test [--smoke] [--conformance] [--conformance-strict] [--stdlib-v1] [--tooling] [--gui] [--parity] [--accel] [--accel-onnx] [--cross] [--runtime-hardening] [--runtime-fuzz --fuzz-rounds N --fuzz-iters N] [--runtime-soak --soak-hours N|--soak-minutes N|--soak-fast] [--io-smoke] [--simple-smoke] [--legacy-unstable] [--kernel-perf]"
  say "  bench [--all|--bc|--native] [--profile [N]] [--gate --baseline <path> --perf-max-pct <n>]"
  say "  benchext"
  say "  doctor"
  say "  lsp"
  say "  ai|tsm|boot            (not available in tezz core CLI)"
  say "  clean"
  say "  fmt <path>"
  say "  lint <path>"
  say "  release"
  ret 0

