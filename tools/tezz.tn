fn norm_os(os:str) -> str:
  if os == 0:
    ret 0 as str
  if streq(os, "posix") != 0:
    free(os)
    ret str_join2("linux", "")
  ret os

fn ends_with_tn(p:str) -> int:
  if p == 0:
    ret 0
  n:int = len(p)
  if n < 3:
    ret 0
  if p[n-3] == 46 && p[n-2] == 116 && p[n-1] == 110:
    ret 1
  ret 0

fn parse_name_ver(nv:str, out_name:*char, out_ver:*char) -> int:
  ret parse_namever_token(nv, out_name, out_ver)

fn str_has_char(s:str, ch:int) -> int:
  if s == 0:
    ret 0
  i:int = 0
  while s[i] != 0:
    if (s[i] as int) == ch:
      ret 1
    i = i + 1
  ret 0

fn copy_into_buf(dst:*char, src:str, max_len:int) -> int:
  if dst == 0 || src == 0 || max_len <= 0:
    ret 0
  i:int = 0
  lim:int = max_len - 1
  while src[i] != 0 && i < lim:
    dst[i] = src[i]
    i = i + 1
  dst[i] = 0 as char
  ret 1

fn parse_namever_token(tok:str, out_name:*char, out_ver:*char) -> int:
  if tok == 0 || out_name == 0 || out_ver == 0:
    ret 0
  tok2:str = str_join2("", tok)
  if tok2 == 0:
    ret 0
  i:int = 0
  at:int = 0 - 1
  while tok2[i] != 0:
    if (tok2[i] as int) == 64:
      at = i
      break
    i = i + 1
  if at <= 0:
    free(tok2)
    ret 0
  j:int = 0
  while j < at:
    out_name[j] = tok2[j]
    j = j + 1
  out_name[j] = 0 as char
  i = at + 1
  j = 0
  while tok2[i] != 0:
    out_ver[j] = tok2[i]
    j = j + 1
    i = i + 1
  out_ver[j] = 0 as char
  if out_ver[0] == 0:
    free(tok2)
    ret 0
  free(tok2)
  ret 1

fn parse_ver_seg(v:str, idx:*int) -> int:
  if v == 0 || idx == 0:
    ret 0
  i:int = 0
  unsafe:
    i = *idx
  n:int = 0
  seen:int = 0
  while v[i] != 0 && v[i] != 46:
    c:int = v[i] as int
    if c >= 48 && c <= 57:
      n = (n * 10) + (c - 48)
      seen = 1
    else:
      break
    i = i + 1
  while v[i] != 0 && v[i] != 46:
    i = i + 1
  if v[i] == 46:
    i = i + 1
  unsafe:
    *idx = i
  if seen == 0:
    ret 0
  ret n

fn version_cmp(a:str, b:str) -> int:
  if a == 0 && b == 0:
    ret 0
  if a == 0:
    ret 0 - 1
  if b == 0:
    ret 1
  ai:int = 0
  bi:int = 0
  while 1:
    av:int = parse_ver_seg(a, &ai)
    bv:int = parse_ver_seg(b, &bi)
    if av > bv:
      ret 1
    if av < bv:
      ret 0 - 1
    if a[ai] == 0 && b[bi] == 0:
      break
  c:int = strcmp(a, b)
  if c > 0:
    ret 1
  if c < 0:
    ret 0 - 1
  ret 0

fn update_tezz_mod(dep_name:str, dep_ver:str) -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    ret 0 - 1

  key:str = str_join3("dep.", dep_name, " = ")
  if str_contains(mod, key):
    free(mod)
    free(key)
    ret 0

  line:str = str_join3("dep.", dep_name, " = ")
  line2:str = str_join2(line, dep_ver)
  line3:str = str_join2(line2, "\n")
  newmod:str = str_join2(mod, line3)

  io.write_all("tezz.mod", newmod)

  free(mod)
  free(key)
  free(line)
  free(line2)
  free(line3)
  free(newmod)
  ret 0

fn line_is_dep(line:str, name:str, ver:str) -> int:
  if line == 0 || name == 0 || ver == 0:
    ret 0
  line2:str = str_join2("", line)
  name2:str = str_join2("", name)
  ver2:str = str_join2("", ver)
  if line2 == 0 || name2 == 0 || ver2 == 0:
    if line2 != 0:
      free(line2)
    if name2 != 0:
      free(name2)
    if ver2 != 0:
      free(ver2)
    ret 0
  i:int = 0
  while name2[i] != 0:
    if line2[i] != name2[i]:
      free(line2)
      free(name2)
      free(ver2)
      ret 0
    i = i + 1
  if line2[i] != 64:
    free(line2)
    free(name2)
    free(ver2)
    ret 0
  i = i + 1
  j:int = 0
  while ver2[j] != 0:
    if line2[i + j] != ver2[j]:
      free(line2)
      free(name2)
      free(ver2)
      ret 0
    j = j + 1
  c:int = line2[i + j] as int
  free(line2)
  free(name2)
  free(ver2)
  if c == 0 || c == 32 || c == 9:
    ret 1
  ret 0

fn update_tezz_lock(dep_name:str, dep_ver:str, url:str, checksum:str) -> int:
  nv:str = str_join3(dep_name, "@", dep_ver)
  line1:str = str_join2(nv, " ")
  line2:str = str_join2(line1, checksum)
  line3:str = str_join2(line2, " ")
  newline:str = str_join2(line3, url)

  lock:str = io.read_all("tezz.lock")
  if lock == 0:
    out:str = str_join2(newline, "\n")
    meta0:str = provenance_meta_line("lock-meta", out, 1)
    full0:str = str_join3(meta0, "\n", out)
    io.write_all("tezz.lock", full0)
    free(full0)
    free(meta0)
    free(out)
    free(nv)
    free(line1)
    free(line2)
    free(line3)
    free(newline)
    ret 0

  lines:[str;128]
  n:int = 0

  i:int = 0
  start:*char = lock
  while 1:
    c:int = lock[i] as int
    if c == 0 || c == 10:
      lock[i] = 0 as char
      if start[0] != 0 && (start[0] as int) != 35:
        if line_is_dep(start, dep_name, dep_ver) == 0:
          lines[n] = start
          n = n + 1
      if c == 0:
        break
      start = lock + i + 1
    i = i + 1

  lines[n] = newline
  n = n + 1

  // simple sort for determinism
  a:int = 0
  while a < n:
    b:int = a + 1
    while b < n:
      if strcmp(lines[a], lines[b]) > 0:
        tmp:str = lines[a]
        lines[a] = lines[b]
        lines[b] = tmp
      b = b + 1
    a = a + 1

  total:int = 0
  i = 0
  while i < n:
    total = total + len(lines[i]) + 1
    i = i + 1

  out:*char = (*char)malloc(total + 1)
  w:int = 0
  i = 0
  while i < n:
    j:int = 0
    while lines[i][j] != 0:
      out[w] = lines[i][j]
      w = w + 1
      j = j + 1
    out[w] = 10 as char
    w = w + 1
    i = i + 1
  out[w] = 0 as char

  meta:str = provenance_meta_line("lock-meta", out, n)
  full:str = str_join3(meta, "\n", out)
  io.write_all("tezz.lock", full)
  free(full)
  free(meta)
  free(out)
  free(lock)
  free(nv)
  free(line1)
  free(line2)
  free(line3)
  free(newline)
  ret 0

fn mod_line_is_dep_name(line:str, dep_name:str) -> int:
  if line == 0 || dep_name == 0:
    ret 0
  i:int = 0
  while line[i] == 32 || line[i] == 9:
    i = i + 1
  if starts_with_at(line, i, "dep.") == 0:
    ret 0
  i = i + 4
  ns:int = i
  while line[i] != 0 && line[i] != 32 && line[i] != 9 && line[i] != 61:
    i = i + 1
  name_tok:str = substr_dup(line, ns, i)
  ok:int = 0
  if name_tok != 0:
    if strcmp(name_tok, dep_name) == 0:
      ok = 1
    free(name_tok)
  ret ok

fn lock_line_is_dep_name(line:str, dep_name:str) -> int:
  if line == 0 || dep_name == 0:
    ret 0
  i:int = 0
  while line[i] == 32 || line[i] == 9:
    i = i + 1
  ns:int = i
  while line[i] != 0 && line[i] != 64 && line[i] != 32 && line[i] != 9:
    i = i + 1
  name_tok:str = substr_dup(line, ns, i)
  ok:int = 0
  if name_tok != 0:
    if strcmp(name_tok, dep_name) == 0:
      ok = 1
    free(name_tok)
  ret ok

fn rewrite_tezz_mod_without_dep(dep_name:str) -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    say "remove: missing tezz.mod"
    ret 0 - 1
  key:str = str_join3("dep.", dep_name, " = ")
  out:*char = (*char)malloc(len(mod) + 1)
  w:int = 0
  changed:int = 0
  i:int = 0
  line_start:int = 0
  while 1:
    c:int = mod[i] as int
    if c == 0 || c == 10:
      s:int = line_start
      while s < i && (mod[s] == 32 || mod[s] == 9):
        s = s + 1
      skip:int = 0
      if starts_with_at(mod, s, key) != 0:
        skip = 1
      if skip != 0:
        changed = 1
      else:
        j:int = line_start
        while j < i:
          out[w] = mod[j]
          w = w + 1
          j = j + 1
        if c == 10:
          out[w] = 10 as char
          w = w + 1
      if c == 0:
        break
      line_start = i + 1
    i = i + 1
  out[w] = 0 as char
  if changed != 0:
    io.write_all("tezz.mod", out)
  free(out)
  free(key)
  free(mod)
  ret 0

fn rewrite_tezz_lock_without_dep(dep_name:str) -> int:
  lock:str = io.read_all("tezz.lock")
  if lock == 0:
    ret 0
  key:str = str_join2(dep_name, "@")
  out:*char = (*char)malloc(len(lock) + 1)
  w:int = 0
  n:int = 0
  changed:int = 0
  i:int = 0
  line_start:int = 0
  while 1:
    c:int = lock[i] as int
    if c == 0 || c == 10:
      s:int = line_start
      while s < i && (lock[s] == 32 || lock[s] == 9):
        s = s + 1
      skip:int = 0
      is_comment:int = 0
      if s < i && (lock[s] as int) == 35:
        is_comment = 1
      if is_comment == 0 && starts_with_at(lock, s, key) != 0:
        skip = 1
      if skip != 0:
        changed = 1
      else:
        if is_comment == 0 && s < i:
          n = n + 1
          j:int = line_start
          while j < i:
            out[w] = lock[j]
            w = w + 1
            j = j + 1
          if c == 10:
            out[w] = 10 as char
            w = w + 1
      if c == 0:
        break
      line_start = i + 1
    i = i + 1
  out[w] = 0 as char
  if changed != 0:
    meta:str = provenance_meta_line("lock-meta", out, n)
    full:str = str_join3(meta, "\n", out)
    io.write_all("tezz.lock", full)
    free(full)
    free(meta)
  free(out)
  free(key)
  free(lock)
  ret 0

fn cmd_add() -> int:
  if user_args_count() < 2:
    say "tezz add <name@ver> [url] [checksum]"
    ret 0 - 1
  ret cmd_get()

fn cmd_remove() -> int:
  if user_args_count() < 2:
    say "tezz remove <name>"
    ret 0 - 1
  raw:str = arg(1)
  namebuf:[char;128]
  verbuf:[char;64]
  dep_name:str = raw
  if str_has_char(raw, 64) != 0:
    if parse_namever_token(raw, namebuf, verbuf) == 0:
      say "remove: expected <name> or <name@version>"
      ret 0 - 1
    dep_name = namebuf
  else:
    copy_into_buf(namebuf, raw, 128)
  if dep_name == 0 || dep_name[0] == 0:
    say "remove: empty package name"
    ret 0 - 1
  if rewrite_tezz_mod_without_dep(dep_name) != 0:
    ret 0 - 1
  if rewrite_tezz_lock_without_dep(dep_name) != 0:
    ret 0 - 1
  lib0:str = str_join3("lib/", dep_name, "")
  libp:str = str_join2(lib0, ".tn")
  if path_exists(libp) != 0:
    remove(libp)
  free(lib0)
  free(libp)
  say "ok"
  ret 0

fn cmd_get() -> int:
  ucnt:int = user_args_count()
  if ucnt < 2:
    say "tezz get <name@ver> [url] [checksum]"
    ret 0 - 1

  nv:str = arg(1)
  url:str = 0 as str
  checksum:str = 0 as str
  own_checksum:int = 0
  if ucnt >= 3:
    url = arg(2)
  if ucnt >= 4:
    checksum = arg(3)

  namebuf:[char;128]
  verbuf:[char;64]
  if parse_name_ver(nv, namebuf, verbuf) == 0:
    ret 0 - 1
  explicit_version:int = str_has_char(nv, 64)
  if explicit_version == 0 && url != 0:
    say "tezz get/install with explicit url requires <name@version>"
    ret 0 - 1

  sdk_root:str = sdk_root_arg()
  project_mode:int = 0
  if path_exists("tezz.mod") != 0:
    project_mode = 1

  mod_path:str = "tezz.mod"
  mod_path_owned:int = 0
  if project_mode == 0 && sdk_root != 0 && sdk_root[0] != 0:
    mod_path2:str = path_join(sdk_root, "tezz.mod")
    if path_exists(mod_path2) != 0:
      mod_path = mod_path2
      mod_path_owned = 1
    else:
      free(mod_path2)

  ensure_dir(".tezz")
  ensure_dir(".tezz/cache")

  if url == 0:
    mod:str = io.read_all(mod_path)
    if mod == 0:
      say "missing tezz.mod"
      if mod_path_owned != 0:
        free(mod_path)
      ret 0 - 1
    reg_url:str = mod_get_value(mod, "registry")
    if reg_url == 0:
      say "missing registry in tezz.mod"
      free(mod)
      if mod_path_owned != 0:
        free(mod_path)
      ret 0 - 1
    reg_path:str = ".tezz/cache/registry.tnx"
    reg_ok:int = 0
    reg:str = 0 as str
    // prefer SDK-bundled registry first for stable installs.
    if sdk_root != 0 && sdk_root[0] != 0:
      sdk_reg1:str = path_join(sdk_root, "registry.tnx")
      reg = io.read_all(sdk_reg1)
      if reg == 0:
        free(sdk_reg1)
        sdk_reg2:str = path_join(sdk_root, "download/sdk/registry.tnx")
        reg = io.read_all(sdk_reg2)
        free(sdk_reg2)
      else:
        free(sdk_reg1)
    if reg == 0:
      if net.download(reg_url, reg_path) == 0:
        reg_ok = 1
      reg = io.read_all(reg_path)
    if reg == 0:
      if reg_ok == 0:
        say "registry download failed"
      else:
        say "missing registry cache"
      free(mod)
      free(reg_url)
      if mod_path_owned != 0:
        free(mod_path)
      ret 0 - 1

    urlbuf:[char;512]
    ckbuf:[char;128]
    urlbuf[0] = 0 as char
    ckbuf[0] = 0 as char

    if explicit_version == 0:
      reg_scan:str = str_join2("", reg)
      if reg_scan == 0:
        say "registry parse failed"
        free(reg)
        free(mod)
        free(reg_url)
        if mod_path_owned != 0:
          free(mod_path)
        ret 0 - 1
      i0:int = 0
      st0:*char = reg_scan
      best_ver:[char;64]
      best_ver[0] = 0 as char
      while 1:
        c0:int = reg_scan[i0] as int
        if c0 == 0 || c0 == 10:
          reg_scan[i0] = 0 as char
          if st0[0] != 0 && (st0[0] as int) != 35:
            tok:[char;192]
            tj:int = 0
            tk:int = 0
            while st0[tk] != 0 && st0[tk] != 32 && st0[tk] != 9:
              if tj < 191:
                tok[tj] = st0[tk]
                tj = tj + 1
              tk = tk + 1
            tok[tj] = 0 as char
            if tok[0] != 0:
              pname:[char;128]
              pver:[char;64]
              if parse_namever_token(tok, pname, pver) != 0:
                if streq(namebuf, pname) != 0:
                  if best_ver[0] == 0 || version_cmp(pver, best_ver) > 0:
                    copy_into_buf(best_ver, pver, 64)
          if c0 == 0:
            break
          st0 = reg_scan + i0 + 1
        i0 = i0 + 1
      if best_ver[0] == 0:
        free(reg_scan)
        say "package not found in registry"
        free(reg)
        free(mod)
        free(reg_url)
        if mod_path_owned != 0:
          free(mod_path)
        ret 0 - 1
      free(reg_scan)
      copy_into_buf(verbuf, best_ver, 64)

    // second pass: exact package@version fields
    i:int = 0
    start:*char = reg
    found:int = 0
    while 1:
      c:int = reg[i] as int
      if c == 0 || c == 10:
        reg[i] = 0 as char
        if start[0] != 0 && (start[0] as int) != 35:
          if line_is_dep(start, namebuf, verbuf) != 0:
            // parse fields: name@ver url checksum
            j:int = 0
            while start[j] != 0 && start[j] != 32 && start[j] != 9:
              j = j + 1
            while start[j] == 32 || start[j] == 9:
              j = j + 1
            k:int = 0
            while start[j] != 0 && start[j] != 32 && start[j] != 9:
              if k < 511:
                urlbuf[k] = start[j]
                k = k + 1
              j = j + 1
            urlbuf[k] = 0 as char
            while start[j] == 32 || start[j] == 9:
              j = j + 1
            k = 0
            while start[j] != 0 && start[j] != 32 && start[j] != 9:
              if k < 127:
                ckbuf[k] = start[j]
                k = k + 1
              j = j + 1
            ckbuf[k] = 0 as char
            found = 1
        if c == 0:
          break
        start = reg + i + 1
      i = i + 1

    if found == 0 || urlbuf[0] == 0:
      say "package not found in registry"
      free(reg)
      free(mod)
      free(reg_url)
      if mod_path_owned != 0:
        free(mod_path)
      ret 0 - 1

    url = urlbuf
    if checksum == 0 && ckbuf[0] != 0:
      checksum = ckbuf
    free(reg)
    free(mod)
    free(reg_url)
    if mod_path_owned != 0:
      free(mod_path)
      mod_path_owned = 0

  if checksum != 0 && is_hex8(checksum) == 0:
    say "invalid checksum format (expected 8 hex chars)"
    if mod_path_owned != 0:
      free(mod_path)
    ret 0 - 1

  base1:str = str_join3(".tezz/cache/", namebuf, "-")
  base2:str = str_join2(base1, verbuf)
  cache:str = str_join2(base2, ".tn")
  tmp:str = str_join2(cache, ".tmp")

  use_cache:int = 0
  if path_exists(cache) != 0:
    if checksum == 0:
      use_cache = 1
    else:
      want:int = parse_hex(checksum)
      have:int = crc32_source_file(cache)
      if have == want:
        use_cache = 1

  if use_cache == 0:
    dl_ok:int = 0
    if net.download(url, tmp) == 0:
      dl_ok = 1
    else:
      // fallback: for SDK-core modules, source directly from SDK lib.
      if sdk_root != 0 && sdk_root[0] != 0:
        lib_dir0:str = path_join(sdk_root, "lib")
        tn_name0:str = str_join2(namebuf, ".tn")
        src_lib0:str = path_join(lib_dir0, tn_name0)
        src_data0:str = io.read_all(src_lib0)
        if src_data0 != 0:
          if io.write_all(tmp, src_data0) != (0 - 1):
            dl_ok = 1
          free(src_data0)
        free(lib_dir0)
        free(tn_name0)
        free(src_lib0)
    if dl_ok == 0:
      say "download failed"
      free(base1)
      free(base2)
      free(cache)
      free(tmp)
      ret 0 - 1
    if checksum != 0:
      want2:int = parse_hex(checksum)
      have2:int = crc32_source_file(tmp)
      if have2 != want2:
        say "checksum mismatch"
        remove(tmp)
        free(base1)
        free(base2)
        free(cache)
        free(tmp)
        ret 0 - 1
    if path_exists(cache) != 0:
      remove(cache)
    io.move_file(tmp, cache)

  dest_lib:str = "lib"
  dest_lib_owned:int = 0
  if project_mode != 0:
    ensure_dir("lib")
  else if sdk_root != 0 && sdk_root[0] != 0:
    sdk_lib2:str = path_join(sdk_root, "lib")
    if path_exists(sdk_lib2) == 0:
      ensure_dir(sdk_lib2)
    dest_lib = sdk_lib2
    dest_lib_owned = 1
  else:
    ensure_dir("lib")

  out0:str = path_join(dest_lib, namebuf)
  out_path:str = str_join2(out0, ".tn")
  copy_ok:int = io.copy_file(cache, out_path)
  if copy_ok < 0:
    // If SDK path is read-only (common in Program Files), keep cache usable.
    if project_mode != 0:
      ensure_dir("lib")
      out_local0:str = str_join3("lib/", namebuf, "")
      out_local:str = str_join2(out_local0, ".tn")
      if io.copy_file(cache, out_local) < 0:
        warn_copy:str = str_join3("warning: install target not writable: ", out_path, "")
        say warn_copy
        free(warn_copy)
        say "warning: package kept in .tezz/cache and will resolve via lock/cache fallback"
      free(out_local0)
      free(out_local)
    else:
      warn_copy2:str = str_join3("warning: install target not writable: ", out_path, "")
      say warn_copy2
      free(warn_copy2)
      say "warning: package kept in .tezz/cache"
  free(out0)

  // compute checksum if missing
  if checksum == 0:
    have3:int = crc32_source_file(cache)
    checksum = hex8(have3)
    own_checksum = 1

  if project_mode != 0:
    update_tezz_mod(namebuf, verbuf)
    update_tezz_lock(namebuf, verbuf, url, checksum)

  free(base1)
  free(base2)
  free(cache)
  free(tmp)
  free(out_path)
  if dest_lib_owned != 0:
    free(dest_lib)
  if mod_path_owned != 0:
    free(mod_path)
  if own_checksum != 0 && checksum != 0:
    free(checksum)
  say "ok"
  ret 0

fn copy_module_file(src_root:str, dst_root:str, name:str) -> int:
  if src_root == 0 || dst_root == 0 || name == 0:
    ret 0
  s0:str = path_join(src_root, name)
  src:str = str_join2(s0, ".tn")
  d0:str = path_join(dst_root, name)
  dst:str = str_join2(d0, ".tn")
  ok:int = 0
  if path_exists(src) != 0 && path_exists(dst) == 0:
    io.copy_file(src, dst)
    ok = 1
  free(s0)
  free(src)
  free(d0)
  free(dst)
  ret ok

fn copy_core_modules_from_sdk(sdk_lib:str, dst_lib:str) -> int:
  if sdk_lib == 0 || dst_lib == 0:
    ret 0
  copied:int = 0
  copied = copied + copy_module_file(sdk_lib, dst_lib, "std")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "io")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "time")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "net")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tls")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "event")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "frame")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tzgui")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tzui")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tnui")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tezzsetup")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "math")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tzimage")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tnauto")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "simd")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "intrin")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "data")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "task")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tezzapi")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tezzserve")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "tnx")
  copied = copied + copy_module_file(sdk_lib, dst_lib, "sys")
  ret copied

fn refresh_compat_intrin_from_sdk(sdk_lib:str) -> int:
  if sdk_lib == 0:
    ret 0
  if path_exists("lib/intrin.tn") == 0:
    ret 0

  s0:str = path_join(sdk_lib, "intrin")
  src:str = str_join2(s0, ".tn")
  ok:int = 0
  if path_exists(src) != 0:
    io.copy_file(src, "lib/intrin.tn")
    ok = 1
  free(s0)
  free(src)
  ret ok

fn sync_local_lib_from_sdk() -> int:
  // Compatibility lane: if local lib/std.tn is missing, seed lib/ from SDK.
  // Works for both project mode (with tezz.mod) and single-file script mode.
  if path_exists("lib/std.tn") != 0:
    ret 0

  sdk_root_raw:str = sdk_root_arg()
  sdk_root:str = sdk_root_raw
  sdk_root_owned:int = 0
  if sdk_root != 0 && sdk_root[0] != 0:
    sdk_norm0:str = strip_outer_quotes(sdk_root)
    if sdk_norm0 != 0 && sdk_norm0[0] != 0:
      sdk_root = sdk_norm0
      sdk_root_owned = 1
    else if sdk_norm0 != 0:
      free(sdk_norm0)
  if sdk_root == 0 || sdk_root[0] == 0:
    s0:str = env_value("TEZZ_SDK_ROOT")
    if s0 != 0 && s0[0] != 0:
      sdk_root = s0
      sdk_root_owned = 1
    else:
      if s0 != 0:
        free(s0)
      s1:str = env_value("TEZZ_SDK_DIR")
      if s1 != 0 && s1[0] != 0:
        sdk_root = s1
        sdk_root_owned = 1
      else:
        if s1 != 0:
          free(s1)
        tzc:str = tezzc_path()
        if tzc != 0:
          s2:str = infer_sdk_root_from_tezzc(tzc)
          if s2 != 0 && s2[0] != 0:
            sdk_root = s2
            sdk_root_owned = 1
          else:
            if s2 != 0:
              free(s2)

  if sdk_root == 0 || sdk_root[0] == 0:
    ret 0

  sdk_lib:str = path_join(sdk_root, "lib")
  copied:int = 0
  if path_exists(sdk_lib) != 0:
    ensure_dir("lib")
    deps_added:int = 0
    if path_exists("tezz.mod") != 0:
      deps_added = sync_project_deps_from_sdk_lib(sdk_lib)
    copied = copy_core_modules_from_sdk(sdk_lib, "lib")
    copied = copied + copy_all_modules_from_sdk(sdk_lib, "lib")
    // If we changed dependency coverage, stale lockfiles become invalid.
    // Remove tezz.lock so compiler lock enforcement does not block run/build.
    if deps_added > 0 && path_exists("tezz.lock") != 0:
      remove("tezz.lock")
  free(sdk_lib)
  if sdk_root_owned != 0:
    free(sdk_root)
  ret copied

fn ensure_std_from_cache() -> int:
  if path_exists("lib/std.tn") != 0:
    ret 1
  ensure_dir(".tezz")
  ensure_dir(".tezz/cache")
  c0:str = ".tezz/cache/std-0.1.0.tn"
  c1:str = ".tezz/cache/std.tn"
  src:str = 0 as str
  if path_exists(c0) != 0:
    src = c0
  else if path_exists(c1) != 0:
    src = c1
  if src == 0:
    ret 0
  ensure_dir("lib")
  if io.copy_file(src, "lib/std.tn") < 0:
    ret 0
  ret 1

fn ensure_std_from_registry_lib() -> int:
  if path_exists("lib/std.tn") != 0:
    ret 1
  if path_exists("tezz.mod") == 0:
    ret 0
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    ret 0
  reg_lib:str = mod_get_value(mod, "registry_lib")
  if reg_lib == 0 || reg_lib[0] == 0:
    free(mod)
    if reg_lib != 0:
      free(reg_lib)
    ret 0
  base_url:str = reg_lib
  ulen:int = len(base_url)
  if ulen > 0:
    last:int = base_url[ulen - 1] as int
    if last != 47 && last != 92:
      tmpu:str = str_join2(base_url, "/")
      free(base_url)
      base_url = tmpu
  std_url:str = str_join2(base_url, "std.tn")
  ensure_dir(".tezz")
  ensure_dir(".tezz/cache")
  tmp_path:str = ".tezz/cache/std-0.1.0.tn.tmp"
  cache_path:str = ".tezz/cache/std-0.1.0.tn"
  ok:int = 0
  if net.download(std_url, tmp_path) == 0:
    if path_exists(cache_path) != 0:
      remove(cache_path)
    io.move_file(tmp_path, cache_path)
    ensure_dir("lib")
    if io.copy_file(cache_path, "lib/std.tn") >= 0:
      ok = 1
  remove(tmp_path)
  free(std_url)
  free(base_url)
  free(reg_lib)
  free(mod)
  ret ok

fn ensure_std_module_available() -> int:
  if path_exists("tezz.mod") == 0:
    ret 1
  if path_exists("lib/std.tn") != 0:
    ret 1
  sync_local_lib_from_sdk()
  if path_exists("lib/std.tn") != 0:
    ret 1
  if ensure_std_from_cache() != 0:
    ret 1
  if ensure_std_from_registry_lib() != 0:
    ret 1
  ret 0

fn is_blank_text(s:str) -> int:
  if s == 0:
    ret 1
  i:int = 0
  while s[i] != 0:
    c:int = s[i] as int
    if c != 32 && c != 9 && c != 10 && c != 13:
      ret 0
    i = i + 1
  ret 1

fn unlock_empty_lock_file() -> int:
  if path_exists("tezz.lock") == 0:
    ret 0
  body:str = io.read_all("tezz.lock")
  if is_blank_text(body) != 0:
    remove("tezz.lock")
    if body != 0:
      free(body)
    ret 1
  if body != 0:
    free(body)
  ret 0

fn relax_stale_std_lock() -> int:
  mod:str = io.read_all("tezz.mod")
  if mod == 0:
    ret 0
  stdv:str = mod_get_value(mod, "dep.std")
  if stdv == 0:
    free(mod)
    ret 0
  if stdv[0] == 0:
    free(stdv)
    free(mod)
    ret 0
  lock_body:str = io.read_all("tezz.lock")
  if lock_body == 0:
    free(stdv)
    free(mod)
    ret 0
  want0:str = str_join3("std@", stdv, " ")
  has_std:int = str_contains(lock_body, want0)
  free(want0)
  if has_std == 0:
    remove("tezz.lock")
  free(lock_body)
  free(stdv)
  free(mod)
  ret 0

fn sync_project_deps_from_sdk_lib(sdk_lib:str) -> int:
  if sdk_lib == 0 || path_exists("tezz.mod") == 0:
    ret 0
  list:str = io.dir_list_rec(sdk_lib)
  if list == 0:
    ret 0
  n:int = len(list)
  i:int = 0
  start:*char = list
  added:int = 0
  while 1:
    c:int = list[i] as int
    if c == 0 || c == 10:
      list[i] = 0 as char
      if start[0] != 0:
        if path_is_dir(start) == 0 && ends_with_tn(start) != 0:
          base:str = path_basename_no_ext(start)
          if base != 0 && base[0] != 0:
            if update_tezz_mod(base, "0.1.0") == 0:
              added = added + 1
          if base != 0:
            free(base)
      if c == 0:
        break
      start = list + i + 1
    i = i + 1
    if i > n:
      break
  free(list)
  ret added

fn copy_all_modules_from_sdk(sdk_lib:str, dst_lib:str) -> int:
  if sdk_lib == 0 || dst_lib == 0:
    ret 0
  list:str = io.dir_list_rec(sdk_lib)
  if list == 0:
    ret 0
  n:int = len(list)
  i:int = 0
  start:*char = list
  copied:int = 0
  while 1:
    c:int = list[i] as int
    if c == 0 || c == 10:
      list[i] = 0 as char
      if start[0] != 0:
        if path_is_dir(start) == 0 && ends_with_tn(start) != 0:
          base:str = path_basename_no_ext(start)
          if base != 0 && base[0] != 0:
            copied = copied + copy_module_file(sdk_lib, dst_lib, base)
          if base != 0:
            free(base)
      if c == 0:
        break
      start = list + i + 1
    i = i + 1
    if i > n:
      break
  free(list)
  ret copied

fn project_module_root(mod:str) -> str:
  if mod != 0:
    rootv:str = mod_get_value(mod, "module_root")
    if rootv != 0 && rootv[0] != 0:
      ret rootv
    if rootv != 0:
      free(rootv)
  // Python-like default: project imports do not require local module copies.
  // Local "lib/" remains supported, with SDK lib fallback via dep_module_path.
  ret str_join2("", "lib")

fn dep_module_path(root:str, name:str) -> str:
  if root == 0 || name == 0:
    ret 0 as str
  d0:str = path_join(root, name)
  out:str = str_join2(d0, ".tn")
  free(d0)
  if path_exists(out) != 0:
    ret out

  sdk_root_raw:str = sdk_root_arg()
  sdk_root:str = sdk_root_raw
  sdk_env_owned:int = 0
  if sdk_root == 0 || sdk_root[0] == 0:
    sdk_env:str = env_value("TEZZ_SDK_ROOT")
    if sdk_env != 0 && sdk_env[0] != 0:
      sdk_root = sdk_env
      sdk_env_owned = 1
    else:
      if sdk_env != 0:
        free(sdk_env)
      sdk_env = env_value("TEZZ_SDK_DIR")
      if sdk_env != 0 && sdk_env[0] != 0:
        sdk_root = sdk_env
        sdk_env_owned = 1
      else:
        if sdk_env != 0:
          free(sdk_env)
  if sdk_root != 0 && sdk_root[0] != 0:
    s0:str = path_join(sdk_root, "lib")
    s1:str = path_join(s0, name)
    s2:str = str_join2(s1, ".tn")
    free(s0)
    free(s1)
    if path_exists(s2) != 0:
      if sdk_env_owned != 0:
        free(sdk_root)
      free(out)
      ret s2
    free(s2)
  if sdk_env_owned != 0:
    free(sdk_root)
  ret out

fn cmd_init() -> int:
  target:str = "."
  target_set:int = 0
  name_arg:str = 0 as str
  template_raw:str = "minimal"
  ai:int = 1
  ucnt:int = user_args_count()
  while ai < ucnt:
    a:str = arg(ai)
    if streq(a, "--name") && (ai + 1) < ucnt:
      name_arg = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--name=") != 0:
      name_arg = a + 7
      ai = ai + 1
      continue
    if streq(a, "--template") && (ai + 1) < ucnt:
      template_raw = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--template=") != 0:
      template_raw = a + 11
      ai = ai + 1
      continue
    if streq(a, "--kind") && (ai + 1) < ucnt:
      template_raw = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--kind=") != 0:
      template_raw = a + 7
      ai = ai + 1
      continue
    if streq(a, "--help") || streq(a, "-h"):
      print_usage_init()
      ret 0
    if starts_with(a, "--") != 0:
      p0:str = str_join2("init: unknown option: ", a)
      say p0
      free(p0)
      print_usage_init()
      ret 0 - 1
    if target_set == 0:
      target = a
      target_set = 1
      ai = ai + 1
      continue
    ai = ai + 1

  template:str = 0 as str
  if streq(template_raw, "minimal") || streq(template_raw, "base") || streq(template_raw, "default"):
    template = "minimal"
  else if streq(template_raw, "cli") || streq(template_raw, "app"):
    template = "cli"
  else if streq(template_raw, "api") || streq(template_raw, "service"):
    template = "api"
  else if streq(template_raw, "lib") || streq(template_raw, "library"):
    template = "lib"
  else if streq(template_raw, "script"):
    template = "script"
  else if streq(template_raw, "gui") || streq(template_raw, "desktop"):
    template = "gui"
  if template == 0:
    say "init: unsupported template (use minimal|cli|api|lib|script|gui)"
    print_usage_init()
    ret 0 - 1

  if target_set != 0:
    if path_exists(target) == 0:
      if ensure_dir(target) != 0:
        say "init: failed to create target directory"
        ret 0 - 1
    else if path_is_dir(target) == 0:
      say "init: target exists but is not a directory"
      ret 0 - 1

  proj_name:str = name_arg
  if proj_name == 0 || proj_name[0] == 0:
    if streq(target, ".") != 0:
      cwd:str = io.cwd()
      proj_name = path_basename_no_ext(cwd)
      free(cwd)
    else:
      proj_name = path_basename_no_ext(target)
    if proj_name == 0 || proj_name[0] == 0:
      proj_name = "tezz_app"

  tezz_dir:str = path_join(target, ".tezz")
  cache_dir:str = path_join(tezz_dir, "cache")
  src_dir:str = 0 as str
  main_path:str = 0 as str
  readme_path:str = 0 as str
  if streq(template, "minimal") == 0:
    src_dir = path_join(target, "src")
    if ensure_dir(src_dir) != 0:
      say "init: failed to create src directory"
      free(src_dir); free(tezz_dir); free(cache_dir)
      ret 0 - 1
  if ensure_dir(tezz_dir) != 0:
    say "init: failed to create .tezz directory"
    free(src_dir); free(tezz_dir); free(cache_dir)
    ret 0 - 1
  if ensure_dir(cache_dir) != 0:
    say "init: failed to create .tezz/cache directory"
    free(src_dir); free(tezz_dir); free(cache_dir)
    ret 0 - 1

  mod_path:str = path_join(target, "tezz.mod")
  if path_exists(mod_path) == 0:
    m0:str = str_join3("name = ", proj_name, "\n")
    m1:str = str_join2(m0, "version = 0.1.0\n")
    m2:str = str_join2(m1, "registry = https://tn.tezzcorp.com/registry.tnx\n")
    m3:str = str_join2(m2, "registry_lib = https://tn.tezzcorp.com/download/sdk/lib/\n")
    m4:str = str_join2(m3, "dep.std = 0.1.0\n")
    m6:str = 0 as str
    if streq(template, "minimal"):
      d1:str = str_join2(m4, "dep.io = 0.1.0\n")
      d2:str = str_join2(d1, "dep.time = 0.1.0\n")
      d3:str = str_join2(d2, "dep.net = 0.1.0\n")
      d4:str = str_join2(d3, "dep.tls = 0.1.0\n")
      d5:str = str_join2(d4, "dep.event = 0.1.0\n")
      d6:str = str_join2(d5, "dep.frame = 0.1.0\n")
      d7:str = str_join2(d6, "dep.tzgui = 0.1.0\n")
      d8:str = str_join2(d7, "dep.tzui = 0.1.0\n")
      d9:str = str_join2(d8, "dep.tnui = 0.1.0\n")
      d10:str = str_join2(d9, "dep.tezzsetup = 0.1.0\n")
      d11:str = str_join2(d10, "dep.math = 0.1.0\n")
      d12:str = str_join2(d11, "dep.tzimage = 0.1.0\n")
      d13:str = str_join2(d12, "dep.tnauto = 0.1.0\n")
      d14:str = str_join2(d13, "dep.simd = 0.1.0\n")
      d15:str = str_join2(d14, "dep.intrin = 0.1.0\n")
      d16:str = str_join2(d15, "dep.data = 0.1.0\n")
      d17:str = str_join2(d16, "dep.task = 0.1.0\n")
      d18:str = str_join2(d17, "dep.tezzapi = 0.1.0\n")
      d19:str = str_join2(d18, "dep.tezzserve = 0.1.0\n")
      d20:str = str_join2(d19, "dep.tnx = 0.1.0\n")
      d21:str = str_join2(d20, "dep.sys = 0.1.0\n")
      io.write_all(mod_path, d21)
      free(d1); free(d2); free(d3); free(d4); free(d5); free(d6); free(d7); free(d8); free(d9); free(d10)
      free(d11); free(d12); free(d13); free(d14); free(d15); free(d16); free(d17); free(d18); free(d19); free(d20); free(d21)
    else if streq(template, "cli"):
      c1:str = str_join2(m4, "dep.io = 0.1.0\n")
      c2:str = str_join2(c1, "dep.time = 0.1.0\n")
      c3:str = str_join2(c2, "dep.task = 0.1.0\n")
      io.write_all(mod_path, c3)
      free(c1); free(c2); free(c3)
    else if streq(template, "script"):
      s1:str = str_join2(m4, "dep.io = 0.1.0\n")
      s2:str = str_join2(s1, "dep.time = 0.1.0\n")
      io.write_all(mod_path, s2)
      free(s1); free(s2)
    else if streq(template, "gui"):
      g1:str = str_join2(m4, "dep.gui = 0.1.0\n")
      g2:str = str_join2(g1, "dep.tzgui = 0.1.0\n")
      g3:str = str_join2(g2, "dep.tzui = 0.1.0\n")
      g4:str = str_join2(g3, "dep.tnui = 0.1.0\n")
      g5:str = str_join2(g4, "dep.event = 0.1.0\n")
      g6:str = str_join2(g5, "dep.frame = 0.1.0\n")
      io.write_all(mod_path, g6)
      free(g1); free(g2); free(g3); free(g4); free(g5); free(g6)
    else if streq(template, "api"):
      a1:str = str_join2(m4, "dep.net = 0.1.0\n")
      a2:str = str_join2(a1, "dep.tls = 0.1.0\n")
      a3:str = str_join2(a2, "dep.tnx = 0.1.0\n")
      a4:str = str_join2(a3, "dep.task = 0.1.0\n")
      a5:str = str_join2(a4, "dep.tezzapi = 0.1.0\n")
      a6:str = str_join2(a5, "dep.tezzserve = 0.1.0\n")
      io.write_all(mod_path, a6)
      free(a1); free(a2); free(a3); free(a4); free(a5); free(a6)
    else:
      l1:str = str_join2(m4, "dep.io = 0.1.0\n")
      io.write_all(mod_path, l1)
      free(l1)
    if m6 != 0:
      free(m6)
    free(m0); free(m1); free(m2); free(m3); free(m4)

  lock_path:str = path_join(target, "tezz.lock")

  if streq(template, "minimal") == 0:
    main_path = path_join(src_dir, "main.tn")
    if path_exists(main_path) == 0:
      main_tpl:str = 0 as str
      if streq(template, "api"):
        main_tpl = "import \"std\"\nimport \"net\"\nimport \"tezzapi\"\nimport \"tezzserve\"\n\nfn main() -> int:\n  say \"Tezz API template ready.\"\n  say \"Use examples/reference_v1/api_server.tn for full server loop.\"\n  say tezzapi.tnxb_op_read()\n  say net.af_inet()\n  ret 0\n"
      else if streq(template, "script"):
        main_tpl = "import \"std\"\n\nsay(\"TezzNative script mode\")\na:float = input(\"A = \")\nb:float = input(\"B = \")\nsay(a + b)\n"
      else if streq(template, "gui"):
        main_tpl = "import \"std\"\nimport \"tnui\"\nimport \"tzgui\"\n\nfn main() -> int:\n  caps:TzGuiCaps\n  app:TnUiApp\n  active:int = 0\n  unsafe:\n    if tzgui.detect_caps(&caps) != 0:\n      say \"gui detect_caps failed\"\n      ret 1\n  if caps.windowing == 0:\n    say \"GUI host-window backend unavailable\"\n    ret 0\n  unsafe:\n    if tnui.init(&app, \"TezzNative First GUI App\", 860, 520) != 0:\n      say \"tnui init failed\"\n      ret 1\n    tnui.request_full_redraw(&app, 4)\n  while 1:\n    keep_running:int = 0\n    unsafe:\n      keep_running = tnui.running(&app)\n    if keep_running == 0:\n      break\n    unsafe:\n      if tnui.begin(&app) != 0:\n        say \"tnui begin failed\"\n        ret 1\n      tnui.frame(&app, 1, 24, 24, 812, 462, \"TezzNative First GUI App\")\n      tnui.label(&app, 2, 48, 70, \"Hello from TezzNative production GUI\")\n      if active == 0:\n        tnui.label(&app, 3, 48, 94, \"Status: waiting for button click\")\n      else:\n        tnui.label(&app, 3, 48, 94, \"Status: primary button clicked\")\n      tnui.button(&app, 4, 48, 136, 220, 36, \"Primary Action\")\n      tnui.button(&app, 5, 278, 136, 140, 36, \"Quit\")\n      if tnui.button_clicked(&app, 4) != 0:\n        active = 1 - active\n      if tnui.button_clicked(&app, 5) != 0:\n        tnui.close(&app)\n      k:int = tnui.last_key(&app)\n      if k == 27 || k == 113 || k == 81:\n        tnui.close(&app)\n      tnui.end(&app)\n  unsafe:\n    tnui.close(&app)\n  ret 0\n"
      else if streq(template, "lib"):
        main_tpl = "import \"std\"\nimport \"./lib.tn\"\n\nfn main() -> int:\n  say \"Library template demo\"\n  say lib.add(2, 3)\n  ret 0\n"
      else:
        main_tpl = "import \"std\"\nimport \"time\"\n\nfn main() -> int:\n  say \"Hello from TezzNative CLI template.\"\n  say time.date_local()\n  ret 0\n"
      io.write_all(main_path, main_tpl)

    if streq(template, "lib"):
      lib_path:str = path_join(src_dir, "lib.tn")
      if path_exists(lib_path) == 0:
        lib_tpl:str = "fn add(a:int, b:int) -> int:\n  ret a + b\n\nfn sub(a:int, b:int) -> int:\n  ret a - b\n"
        io.write_all(lib_path, lib_tpl)
      free(lib_path)

    readme_path = path_join(target, "README.tn.md")
    if path_exists(readme_path) == 0:
      r0:str = str_join3("# ", proj_name, "\n\n")
      r1:str = str_join2(r0, "Generated by `tezz init`.\n")
      r1t:str = str_join3(r1, "Template: `", template)
      r1b:str = str_join2(r1t, "`\n\n")
      free(r1t)
      free(r1)
      r1 = r1b
      r2:str = str_join2(r1, "## Commands\n")
      r3:str = str_join2(r2, "- Run: `tezz run src/main.tn`\n")
      r4:str = str_join2(r3, "- Build Linux: `tezz build src/main.tn --platform linux`\n")
      r5:str = str_join2(r4, "- Build Windows: `tezz build src/main.tn --platform windows`\n")
      r6:str = str_join2(r5, "- Install module: `tezz install std@0.1.0`\n")
      r7:str = str_join2(r6, "- Environment check: `tezz doctor`\n")
      r8:str = r7
      if streq(template, "api"):
        r8 = str_join2(r7, "- API reference sample: `examples/reference_v1/api_server.tn`\n")
      else if streq(template, "lib"):
        r8 = str_join2(r7, "- Library entry: `src/lib.tn`\n")
      else if streq(template, "gui"):
        r8 = str_join2(r7, "- GUI sample app: `examples/gui_first_app.tn` (run with `tezz run examples/gui_first_app.tn`)\n")
      io.write_all(readme_path, r8)
      free(r0); free(r1); free(r2); free(r3); free(r4); free(r5); free(r6); free(r7)
      if r8 != r7:
        free(r8)
  else:
    main_path = path_join(target, "main.tn")
    if path_exists(main_path) == 0:
      root_tpl:str = "import \"std\"\n\nfn main() -> int:\n  say \"Hello from TezzNative.\"\n  ret 0\n"
      io.write_all(main_path, root_tpl)

  free(src_dir)
  free(tezz_dir)
  free(cache_dir)
  free(mod_path)
  free(lock_path)
  free(main_path)
  free(readme_path)
  done0:str = str_join3("init: project scaffold ready (template=", template, ")")
  say done0
  free(done0)
  ret 0

fn normalize_out(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  out:*char = (*char)malloc(n + 1)
  i:int = 0
  j:int = 0
  while i < n:
    if s[i] != 13:
      out[j] = s[i]
      j = j + 1
    i = i + 1
  out[j] = 0 as char
  ret out

fn normalize_slashes(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  out:*char = (*char)malloc(n + 1)
  i:int = 0
  while i < n:
    c:int = s[i] as int
    if c == 92:
      out[i] = 47 as char
    else:
      out[i] = s[i]
    i = i + 1
  out[n] = 0 as char
  ret out

fn trim_trailing_ws(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  while n > 0:
    c:int = s[n - 1] as int
    if c == 10 || c == 13 || c == 32 || c == 9:
      n = n - 1
      continue
    break
  out:*char = (*char)malloc(n + 1)
  i:int = 0
  while i < n:
    out[i] = s[i]
    i = i + 1
  out[n] = 0 as char
  ret out

fn strip_outer_quotes(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  if n >= 2 && s[0] == (34 as char) && s[n - 1] == (34 as char):
    ret substr_dup(s, 1, n - 1)
  ret str_join2("", s)

fn env_value(name:str) -> str:
  if name == 0 || name[0] == 0:
    ret 0 as str
  osn:str = os_name()
  cmd:str = 0 as str
  if streq(osn, "windows"):
    cmd = str_join3("cmd /c echo %", name, "%")
  else:
    cmd = str_join2("printenv ", name)
  out:str = proc_out(cmd)
  free(cmd)
  if out == 0:
    ret 0 as str
  out = normalize_out(out)
  out = trim_line(out)
  if streq(osn, "windows"):
    ph:str = str_join3("%", name, "%")
    if streq(out, ph):
      free(out)
      free(ph)
      ret str_join2("", "")
    free(ph)
  ret out

fn infer_sdk_root_from_tezzc(tezzc:str) -> str:
  if tezzc == 0 || tezzc[0] == 0:
    ret 0 as str
  clean:str = strip_outer_quotes(tezzc)
  if clean == 0 || clean[0] == 0:
    if clean != 0:
      free(clean)
    ret 0 as str
  bin_dir:str = path_dirname(clean)
  root:str = 0 as str
  if bin_dir != 0 && bin_dir[0] != 0:
    root = path_dirname(bin_dir)
  if root != 0 && root[0] != 0:
    toolp:str = path_join(root, "tools/tezz.tn")
    stdp:str = path_join(root, "lib/std.tn")
    if path_exists(toolp) != 0 && path_exists(stdp) != 0:
      free(toolp)
      free(stdp)
      free(bin_dir)
      free(clean)
      ret root
    free(toolp)
    free(stdp)
  if root != 0:
    free(root)
  if bin_dir != 0:
    free(bin_dir)
  free(clean)
  ret 0 as str

fn detect_arch() -> str:
  os:str = os_name()
  os = norm_os(os)
  out:str = 0 as str
  if streq(os, "windows"):
    out = proc_out("cmd /c echo %PROCESSOR_ARCHITECTURE%")
  else:
    out = proc_out("uname -m")
  if out == 0:
    ret dup_lit("unknown")
  out = normalize_out(out)
  out = trim_line(out)
  if starts_with(out, "AMD64") || starts_with(out, "X64") || starts_with(out, "x86_64"):
    free(out)
    ret dup_lit("x64")
  if starts_with(out, "ARM64") || starts_with(out, "AARCH64") || starts_with(out, "arm64") || starts_with(out, "aarch64"):
    free(out)
    ret dup_lit("arm64")
  if starts_with(out, "x86") || starts_with(out, "X86") || starts_with(out, "i386") || starts_with(out, "i686"):
    free(out)
    ret dup_lit("x86")
  ret out

fn tune_source(src:str, block:int, unroll:int) -> str:
  if src == 0:
    ret 0 as str
  bstr:str = int_to_str(block)
  ustr:str = int_to_str(unroll)
  n:int = len(src)
  out:*char = (*char)malloc(n + 64)
  i:int = 0
  w:int = 0
  while i < n:
    line:*char = src + i
    if starts_with(line, "  block:int ="):
      // skip line
      while i < n && src[i] != 10:
        i = i + 1
      // write replacement
      j:int = 0
      rep1:str = "  block:int = "
      while rep1[j] != 0:
        out[w] = rep1[j]
        w = w + 1
        j = j + 1
      j = 0
      while bstr[j] != 0:
        out[w] = bstr[j]
        w = w + 1
        j = j + 1
      out[w] = 10 as char
      w = w + 1
      if i < n && src[i] == 10:
        i = i + 1
      continue
    if starts_with(line, "  unroll:int ="):
      while i < n && src[i] != 10:
        i = i + 1
      j2:int = 0
      rep2:str = "  unroll:int = "
      while rep2[j2] != 0:
        out[w] = rep2[j2]
        w = w + 1
        j2 = j2 + 1
      j2 = 0
      while ustr[j2] != 0:
        out[w] = ustr[j2]
        w = w + 1
        j2 = j2 + 1
      out[w] = 10 as char
      w = w + 1
      if i < n && src[i] == 10:
        i = i + 1
      continue
    // copy line
    while i < n && src[i] != 10:
      out[w] = src[i]
      w = w + 1
      i = i + 1
    if i < n && src[i] == 10:
      out[w] = 10 as char
      w = w + 1
      i = i + 1
  out[w] = 0 as char
  free(bstr)
  free(ustr)
  ret out

fn trim_line(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  i:int = n - 1
  while i >= 0:
    c:int = s[i] as int
    if c == 10 || c == 13:
      s[i] = 0 as char
    else:
      break
    i = i - 1
  ret s

fn has_kernel_fn(path:str) -> int:
  if path == 0:
    ret 0
  src:str = io.read_all(path)
  if src == 0:
    ret 0
  k:int = str_contains(src, "kernel fn")
  free(src)
  ret k

fn dxc_available() -> int:
  os:str = os_name()
  out:str = 0 as str
  if streq(os, "windows"):
    out = proc_out("where dxc")
  else:
    out = proc_out("which dxc")
  if out == 0:
    ret 0
  out = normalize_out(out)
  out = trim_line(out)
  if out[0] == 0:
    free(out)
    ret 0
  free(out)
  ret 1

fn replace_substr(s:str, pat:str, rep:str) -> str:
  if s == 0 || pat == 0 || rep == 0:
    ret s
  plen:int = len(pat)
  if plen <= 0:
    ret s
  rlen:int = len(rep)
  n:int = len(s)

  cnt:int = 0
  i:int = 0
  while i < n:
    if starts_with_at(s, i, pat) != 0:
      cnt = cnt + 1
      i = i + plen
      continue
    i = i + 1
  if cnt == 0:
    ret s

  out_len:int = n + (rlen - plen) * cnt
  out:*char = (*char)malloc(out_len + 1)
  i = 0
  w:int = 0
  while i < n:
    if starts_with_at(s, i, pat) != 0:
      j:int = 0
      while j < rlen:
        out[w] = rep[j]
        w = w + 1
        j = j + 1
      i = i + plen
      continue
    out[w] = s[i]
    w = w + 1
    i = i + 1
  out[w] = 0 as char
  free(s)
  ret out

fn simple_mode_disallow_reason(src:str) -> str:
  if src == 0:
    ret 0 as str
  if str_contains(src, "unsafe") != 0:
    ret dup_lit("unsafe blocks are systems-only")
  if str_contains(src, " as *") != 0:
    ret dup_lit("pointer casts are systems-only")
  if str_contains(src, "malloc(") != 0:
    ret dup_lit("manual heap allocation is systems-only")
  if str_contains(src, "free(") != 0:
    ret dup_lit("manual memory free is systems-only")
  if str_contains(src, "sizeof(") != 0:
    ret dup_lit("sizeof is systems-only")
  if str_contains(src, "*char") != 0 || str_contains(src, "*int") != 0 || str_contains(src, "*float") != 0 || str_contains(src, "*str") != 0:
    ret dup_lit("pointer types are systems-only")
  ret 0 as str

fn simple_mode_has_decl_tokens(src:str) -> int:
  if src == 0:
    ret 0
  if starts_with(src, "fn ") != 0 || starts_with(src, "struct ") != 0 || starts_with(src, "enum ") != 0 || starts_with(src, "typedef ") != 0:
    ret 1
  if starts_with(src, "extern ") != 0 || starts_with(src, "kernel ") != 0 || starts_with(src, "static ") != 0:
    ret 1
  if str_contains(src, "\nfn ") != 0 || str_contains(src, "\nstruct ") != 0 || str_contains(src, "\nenum ") != 0 || str_contains(src, "\ntypedef ") != 0:
    ret 1
  if str_contains(src, "\nextern ") != 0 || str_contains(src, "\nkernel ") != 0 || str_contains(src, "\nstatic ") != 0:
    ret 1
  ret 0

fn simple_mode_transform(src:str) -> str:
  if src == 0:
    ret 0 as str
  needs_std:int = 0
  if str_contains(src, "import \"std\"") == 0:
    needs_std = 1
  wrap:int = 0
  if str_contains(src, "fn main(") == 0 && simple_mode_has_decl_tokens(src) == 0:
    wrap = 1
  if wrap == 0:
    if needs_std != 0:
      ret str_join2("import \"std\"\n", src)
    ret str_join2("", src)
  n:int = len(src)
  imports:*char = (*char)malloc((n * 2) + 64)
  body:*char = (*char)malloc((n * 4) + 64)
  wi:int = 0
  wb:int = 0
  i:int = 0
  while 1:
    ls:int = i
    while src[i] != 0 as char && src[i] != 10 as char:
      i = i + 1
    le:int = i
    t:int = ls
    while t < le && ((src[t] as int) == 32 || (src[t] as int) == 9):
      t = t + 1
    is_import:int = 0
    if (le - t) >= 7:
      if src[t] == 105 as char && src[t + 1] == 109 as char && src[t + 2] == 112 as char && src[t + 3] == 111 as char && src[t + 4] == 114 as char && src[t + 5] == 116 as char && src[t + 6] == 32 as char:
        is_import = 1
    if is_import != 0:
      k:int = ls
      while k < le:
        imports[wi] = src[k]
        wi = wi + 1
        k = k + 1
      imports[wi] = 10 as char
      wi = wi + 1
    else:
      body[wb] = 32 as char
      body[wb + 1] = 32 as char
      wb = wb + 2
      k2:int = ls
      while k2 < le:
        body[wb] = src[k2]
        wb = wb + 1
        k2 = k2 + 1
      body[wb] = 10 as char
      wb = wb + 1
    if src[i] == 0 as char:
      break
    i = i + 1
  imports[wi] = 0 as char
  body[wb] = 0 as char

  hdr:str = str_join2("", "")
  if needs_std != 0:
    free(hdr)
    hdr = str_join2("import \"std\"\n", "")
  h1:str = str_join2(hdr, imports as str)
  m0:str = str_join2(h1, "fn main() -> int:\n")
  m1:str = str_join2(m0, body as str)
  out:str = str_join2(m1, "  ret 0\n")
  free(imports)
  free(body)
  free(hdr)
  free(h1)
  free(m0)
  free(m1)
  ret out

fn compat_rewrite_input_mode(path:str) -> str:
  if path == 0:
    ret 0 as str
  src:str = io.read_all(path)
  if src == 0:
    ret 0 as str
  changed:int = 0
  if str_contains(src, "INPUT_INT") != 0 || str_contains(src, "INPUT_FLOAT") != 0 || str_contains(src, "INPUT_STR") != 0:
    changed = 1
    src = replace_substr(src, ", INPUT_INT)", ")")
    src = replace_substr(src, ",INPUT_INT)", ")")
    src = replace_substr(src, ", INPUT_FLOAT)", ")")
    src = replace_substr(src, ",INPUT_FLOAT)", ")")
    src = replace_substr(src, ", INPUT_STR)", ")")
    src = replace_substr(src, ",INPUT_STR)", ")")
  if changed == 0:
    free(src)
    ret 0 as str
  out_path:str = str_join2(path, ".compat.tn")
  io.write_all(out_path, src)
  free(src)
  ret out_path

fn hlsl_first_entry(path:str) -> str:
  if path == 0:
    ret 0 as str
  s:str = io.read_all(path)
  if s == 0:
    ret 0 as str
  i:int = 0
  while s[i] != 0:
    while s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13:
      i = i + 1
    if starts_with_at(s, i, "void ") != 0:
      j:int = i + 5
      while s[j] == 32 || s[j] == 9:
        j = j + 1
      start:int = j
      while s[j] != 0 && s[j] != 40 && s[j] != 32 && s[j] != 9:
        j = j + 1
      if j > start:
        out:str = substr_dup(s, start, j)
        free(s)
        ret out
    while s[i] != 0 && s[i] != 10:
      i = i + 1
    if s[i] == 10:
      i = i + 1
  free(s)
  ret 0 as str

fn sanitize_name(s:str) -> str:
  if s == 0:
    ret 0 as str
  n:int = len(s)
  out:*char = (*char)malloc(n + 1)
  i:int = 0
  while i < n:
    c:int = s[i] as int
    good:int = 0
    if (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95:
      good = 1
    if good != 0:
      out[i] = s[i]
    else:
      out[i] = 95 as char
    i = i + 1
  out[n] = 0 as char
  ret out

fn hlsl_collect_entries(path:str) -> str:
  if path == 0:
    ret 0 as str
  s:str = io.read_all(path)
  if s == 0:
    ret 0 as str
  out:str = 0 as str
  i:int = 0
  while s[i] != 0:
    while s[i] == 32 || s[i] == 9 || s[i] == 10 || s[i] == 13:
      i = i + 1
    if starts_with_at(s, i, "void ") != 0:
      j:int = i + 5
      while s[j] == 32 || s[j] == 9:
        j = j + 1
      start:int = j
      while s[j] != 0 && s[j] != 40 && s[j] != 32 && s[j] != 9:
        j = j + 1
      if j > start:
        ent:str = substr_dup(s, start, j)
        line:str = str_join2(ent, "\n")
        if out == 0:
          out = line
        else:
          tmp:str = str_join2(out, line)
          free(out)
          free(line)
          out = tmp
        free(ent)
    while s[i] != 0 && s[i] != 10:
      i = i + 1
    if s[i] == 10:
      i = i + 1
  free(s)
  ret out

fn line0(s:str) -> str:
  if s == 0:
    ret 0 as str
  i:int = 0
  while s[i] != 0 && s[i] != 10:
    i = i + 1
  ret substr_dup(s, 0, i)

fn line1(s:str) -> str:
  if s == 0:
    ret 0 as str
  i:int = 0
  while s[i] != 0 && s[i] != 10:
    i = i + 1
  if s[i] == 10:
    i = i + 1
  j:int = i
  while s[j] != 0 && s[j] != 10:
    j = j + 1
  ret substr_dup(s, i, j)

fn line0_nonempty(s:str) -> str:
  if s == 0:
    ret 0 as str
  i:int = 0
  while s[i] != 0:
    while s[i] == 10 || s[i] == 13:
      i = i + 1
    j:int = i
    while s[j] != 0 && s[j] != 10 && s[j] != 13:
      j = j + 1
    if j > i:
      ret substr_dup(s, i, j)
    i = j
  ret substr_dup(s, 0, 0)

fn line1_nonempty(s:str) -> str:
  if s == 0:
    ret 0 as str
  i:int = 0
  // find first non-empty line
  while s[i] != 0:
    while s[i] == 10 || s[i] == 13:
      i = i + 1
    j:int = i
    while s[j] != 0 && s[j] != 10 && s[j] != 13:
      j = j + 1
    if j > i:
      i = j
      break
    i = j
  // find second non-empty line
  while s[i] != 0:
    while s[i] == 10 || s[i] == 13:
      i = i + 1
    k:int = i
    while s[k] != 0 && s[k] != 10 && s[k] != 13:
      k = k + 1
    if k > i:
      ret substr_dup(s, i, k)
    i = k
  ret substr_dup(s, 0, 0)

fn next_manifest_line(list:str, idx:*int) -> str:
  if list == 0 || idx == 0:
    ret 0 as str
  n:int = len(list)
  i:int = 0
  unsafe:
    i = *idx
  while i < n:
    while i < n:
      c:int = list[i] as int
      if c != 10 && c != 13:
        break
      i = i + 1
    if i >= n:
      break
    start:int = i
    while i < n:
      c2:int = list[i] as int
      if c2 == 10 || c2 == 13:
        break
      i = i + 1
    end:int = i
    while start < end && is_space(list[start] as int):
      start = start + 1
    while end > start && is_space(list[end - 1] as int):
      end = end - 1
    unsafe:
      *idx = i
    if end <= start:
      continue
    if (list[start] as int) == 35:
      continue
    ret substr_dup(list, start, end)
  unsafe:
    *idx = n
  ret 0 as str

fn trim_range_dup(s:str, a:int, b:int) -> str:
  if s == 0:
    ret 0 as str
  if b < a:
    ret 0 as str
  while a < b && is_space(s[a] as int):
    a = a + 1
  while b > a && is_space(s[b - 1] as int):
    b = b - 1
  ret substr_dup(s, a, b)

fn split_pair(line:str, left:*str, right:*str) -> int:
  if line == 0 || left == 0 || right == 0:
    ret 0 - 1
  i:int = 0
  while line[i] != 0 && line[i] != 124:
    i = i + 1
  if line[i] == 0:
    ret 0 - 1
  n:int = len(line)
  a:str = trim_range_dup(line, 0, i)
  b:str = trim_range_dup(line, i + 1, n)
  if a == 0 || b == 0:
    if a != 0:
      free(a)
    if b != 0:
      free(b)
    ret 0 - 1
  unsafe:
    *left = a
    *right = b
  ret 0

fn lock_strip_dep(lock:str, dep:str) -> str:
  if lock == 0 || dep == 0:
    ret 0 as str
  prefix:str = str_join2(dep, "@")
  pn:int = len(prefix)
  n:int = len(lock)
  out:*char = (*char)malloc(n + 1)
  w:int = 0
  i:int = 0
  while i < n:
    line_start:int = i
    while i < n:
      c:int = lock[i] as int
      if c == 10 || c == 13:
        break
      i = i + 1
    line_end:int = i
    // consume newline (\n or \r\n)
    if i < n && (lock[i] as int) == 13:
      i = i + 1
      if i < n && (lock[i] as int) == 10:
        i = i + 1
    else if i < n && (lock[i] as int) == 10:
      i = i + 1
    nl_end:int = i

    // keep the line unless it starts with "<dep>@"
    keep:int = 1
    if pn > 0 && (line_end - line_start) >= pn:
      k:int = 0
      ok:int = 1
      while k < pn:
        if lock[line_start + k] != prefix[k]:
          ok = 0
          break
        k = k + 1
      if ok != 0:
        keep = 0

    if keep != 0:
      j:int = line_start
      while j < nl_end:
        out[w] = lock[j]
        w = w + 1
        j = j + 1
  out[w] = 0 as char
  free(prefix)
  ret out

fn tool_path(name:str) -> str:
  if name == 0:
    ret 0 as str
  osn:str = os_name()
  cmd:str = 0 as str
  if streq(osn, "windows"):
    cmd = str_join2("where ", name)
  else:
    cmd = str_join2("which ", name)
  out:str = proc_out(cmd)
  free(cmd)
  if out == 0:
    ret 0 as str
  i:int = 0
  while out[i] != 0 && out[i] != 10 as char && out[i] != 13 as char:
    i = i + 1
  p:str = trim_range_dup(out, 0, i)
  free(out)
  if p == 0 || p[0] == 0 as char:
    if p != 0:
      free(p)
    ret 0 as str
  ret p

fn tool_exists(name:str) -> int:
  p:str = tool_path(name)
  if p == 0:
    ret 0
  free(p)
  ret 1

fn tezzc_path() -> str:
  over:str = tezzc_override_arg()
  if over != 0:
    if path_exists(over) != 0:
      ret quote_cmd_path(over)
  os:str = os_name()
  if streq(os, "windows"):
    if path_exists(".\\bin\\tezzc.exe") != 0:
      ret quote_cmd_path(".\\bin\\tezzc.exe")
    if path_exists(".\\bin\\tezzc-windows-x64.exe") != 0:
      ret quote_cmd_path(".\\bin\\tezzc-windows-x64.exe")
    if path_exists(".\\build\\tezzc.exe") != 0:
      ret quote_cmd_path(".\\build\\tezzc.exe")
    if path_exists(".\\tezzc.exe") != 0:
      ret quote_cmd_path(".\\tezzc.exe")
    p1:str = tool_path("tezzc.exe")
    if p1 != 0:
      q1:str = quote_cmd_path(p1)
      free(p1)
      ret q1
    p2:str = tool_path("tezzc-windows-x64.exe")
    if p2 != 0:
      q2:str = quote_cmd_path(p2)
      free(p2)
      ret q2
    p3:str = tool_path("tezzc")
    if p3 != 0:
      q3:str = quote_cmd_path(p3)
      free(p3)
      ret q3
    ret 0 as str
  if path_exists("./bin/tezzc") != 0:
    ret quote_cmd_path("./bin/tezzc")
  if path_exists("./bin/tezzc-linux-x64") != 0:
    ret quote_cmd_path("./bin/tezzc-linux-x64")
  if path_exists("./build/tezzc") != 0:
    ret quote_cmd_path("./build/tezzc")
  if path_exists("./tezzc") != 0:
    ret quote_cmd_path("./tezzc")
  p4:str = tool_path("tezzc")
  if p4 != 0:
    q4:str = quote_cmd_path(p4)
    free(p4)
    ret q4
  p5:str = tool_path("tezzc-linux-x64")
  if p5 != 0:
    q5:str = quote_cmd_path(p5)
    free(p5)
    ret q5
  p6:str = tool_path("tezzc.exe")
  if p6 != 0:
    q6:str = quote_cmd_path(p6)
    free(p6)
    ret q6
  ret 0 as str

fn run_to_file(cmd:str, outpath:str) -> int:
  if cmd == 0 || outpath == 0:
    ret 0 - 1
  os:str = os_name()
  if streq(os, "windows"):
    // If cmd already contains quotes, avoid nesting "cmd /c" quotes.
    // Fallback to proc_out + write_all to keep quoting intact.
    i:int = 0
    while cmd[i] != 0:
      if cmd[i] == (34 as char):
        out:str = proc_out(cmd)
        if out == 0:
          ret 1
        io.write_all(outpath, out)
        free(out)
        ret 0
      i = i + 1
    // prefer shell redirection to avoid large proc_out buffers
    p1b:str = str_join3("cmd /c \"", cmd, " > ")
    p2b:str = str_join2(p1b, outpath)
    p3b:str = str_join2(p2b, " 2>&1\"")
    r2:int = proc_run(p3b)
    free(p1b)
    free(p2b)
    free(p3b)
    if r2 != 0:
      // fallback to capture when cmd /c returns non-zero despite valid output
      out2:str = proc_out(cmd)
      if out2 == 0:
        ret r2
      io.write_all(outpath, out2)
      if str_contains(out2, "tezzc error") != 0:
        free(out2)
        ret 1
      free(out2)
      ret 0
    ret r2
  p1b:str = str_join3("sh -c \"", cmd, " > ")
  p2b:str = str_join2(p1b, outpath)
  p3b:str = str_join2(p2b, " 2>&1\"")
  r2:int = proc_run(p3b)
  free(p1b)
  free(p2b)
  free(p3b)
  ret r2

fn wsl_path(win_path:str) -> str:
  if win_path == 0:
    ret 0 as str
  cmd:str = str_join3("wsl -e wslpath -a -u \"", win_path, "\"")
  out:str = proc_out(cmd)
  free(cmd)
  if out != 0:
    // trim_line edits in-place; return the same buffer
    out = trim_line(out)
    if out[0] != 0:
      ret out
    free(out)
  // fallback: manual /mnt/<drive>/path conversion
  n:int = len(win_path)
  if n < 2 || win_path[1] != (58 as char):
    ret 0 as str
  drive:int = win_path[0] as int
  if drive >= 65 && drive <= 90:
    drive = drive + 32
  idx:int = 2
  if n > 2:
    if win_path[2] == (92 as char) || win_path[2] == (47 as char):
      idx = 3
  out_len:int = 7 + (n - idx)
  buf:*char = (*char)malloc(out_len + 1)
  if buf == 0:
    ret 0 as str
  unsafe:
    buf[0] = 47 as char
    buf[1] = 109 as char
    buf[2] = 110 as char
    buf[3] = 116 as char
    buf[4] = 47 as char
    buf[5] = drive as char
    buf[6] = 47 as char
    i:int = idx
    j:int = 7
    while i < n:
      c:char = win_path[i]
      if c == (92 as char):
        c = 47 as char
      buf[j] = c
      i = i + 1
      j = j + 1
    buf[j] = 0 as char
  ret buf as str

fn run_quiet(cmd:str) -> int:
  if cmd == 0:
    ret 0 - 1
  os:str = os_name()
  if streq(os, "windows"):
    p1:str = str_join3("cmd /c \"", cmd, " > nul\"")
    r:int = proc_run(p1)
    free(p1)
    ret r
  p1:str = str_join3("sh -c \"", cmd, " > /dev/null\"")
  r:int = proc_run(p1)
  free(p1)
  ret r

fn csv_op_policy(csv:str) -> str:
  if csv == 0:
    ret 0 as str
  idx:int = 0
  out:str = str_join2("", "op,policy\n")
  while 1:
    line:str = next_manifest_line(csv, &idx)
    if line == 0:
      break
    if starts_with(line, "op,policy") != 0:
      free(line)
      continue
    i:int = 0
    while line[i] != 0 && line[i] != 44:
      i = i + 1
    if line[i] == 44:
      j:int = i + 1
      while line[j] != 0 && line[j] != 44:
        j = j + 1
      if line[j] == 44:
        op:str = substr_dup(line, 0, i)
        pol:str = substr_dup(line, i + 1, j)
        l1:str = str_join3(op, ",", pol)
        l2:str = str_join2(l1, "\n")
        tmp:str = str_join2(out, l2)
        free(out)
        out = tmp
        free(op)
        free(pol)
        free(l1)
        free(l2)
    free(line)
  ret out

fn run_quiet_all(cmd:str) -> int:
  if cmd == 0:
    ret 0 - 1
  os:str = os_name()
  if streq(os, "windows"):
    p1:str = str_join3("cmd /c \"", cmd, " > nul 2>&1\"")
    r:int = proc_run(p1)
    free(p1)
    ret r
  p1:str = str_join3(cmd, " > /dev/null 2>&1", "")
  r:int = proc_run(p1)
  free(p1)
  ret r

fn proc_out_all(cmd:str) -> str:
  if cmd == 0:
    ret 0 as str
  os:str = os_name()
  if streq(os, "windows"):
    p1:str = str_join3("cmd /c \"", cmd, " 2>&1\"")
    out:str = proc_out(p1)
    free(p1)
    if out == 0 || out[0] == 0:
      ensure_dir("build")
      cap:str = "build/proc_out_all_capture.out"
      remove(cap)
      run_to_file(cmd, cap)
      if out != 0:
        free(out)
      out = io.read_all(cap)
      remove(cap)
    ret out
  p1:str = str_join3(cmd, " 2>&1", "")
  out2:str = proc_out(p1)
  free(p1)
  if out2 == 0 || out2[0] == 0:
    ensure_dir("build")
    cap2:str = "build/proc_out_all_capture.out"
    remove(cap2)
    run_to_file(cmd, cap2)
    if out2 != 0:
      free(out2)
    out2 = io.read_all(cap2)
    remove(cap2)
  ret out2

fn expect_fail(cmd:str, needle:str) -> int:
  if cmd == 0:
    ret 0 - 1
  if run_quiet_all(cmd) == 0:
    say "expected failure but command succeeded:"
    say cmd
    ret 1
  if needle == 0 || needle[0] == 0:
    ret 0
  out:str = proc_out_all(cmd)
  if out == 0 || out[0] == 0:
    ensure_dir("build")
    cap_cmd:str = str_join3(cmd, " 2>&1", "")
    cap_path:str = str_join2("build/", "expect_fail_capture.out")
    run_to_file(cap_cmd, cap_path)
    if out != 0:
      free(out)
    out = read_norm(cap_path)
    remove(cap_path)
    free(cap_cmd)
    free(cap_path)
  if out == 0:
    say "expected failure but no output captured:"
    say cmd
    ret 1
  ok:int = 1
  if needle != 0 && needle[0] != 0:
    if str_contains(out, needle) == 0:
      say "failure output missing expected text:"
      say needle
      ok = 0
  free(out)
  if ok == 0:
    ret 1
  ret 0

fn test_run(cmd:str, label:str) -> int:
  r:int = proc_run(cmd)
  if r != 0:
    // Some Windows runs can return non-zero despite succeeding.
    // For run commands, retry via proc_out and treat non-error output as success.
    if str_contains(cmd, " run ") != 0:
      out:str = proc_out(cmd)
      if out != 0:
        if str_contains(out, "tezzc error") == 0:
          free(out)
          ret 0
        free(out)
    say "test command failed:"
    if label != 0:
      say label
    say cmd
    ret r
  ret r

fn read_norm(path:str) -> str:
  s:str = io.read_all(path)
  if s == 0:
    ret 0 as str
  n:str = normalize_out(s)
  free(s)
  if n != 0:
    trim_line(n)
    t:str = trim_trailing_ws(n)
    free(n)
    n = t
  ret n

fn run_parity_manifest(path:str, mode:str, label:str, tezzc:str) -> int:
  list:str = io.read_all(path)
  if list == 0:
    ret 0

  os:str = os_name()
  out_dir:str = "build/"
  if streq(os, "windows"):
    out_dir = ".\\build\\"
  ensure_dir("build")

  idx:int = 0
  failed:int = 0

  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    if streq(mode, "--bc") != 0:
      base:str = path_basename_no_ext(start)
      if base == 0 || base[0] == 0:
        if base != 0:
          free(base)
        failed = failed + 1
        free(start)
        continue
      out_bc_path:str = str_join3(out_dir, base, "_bcvm.out")
      cmd_vm:str = str_join3(tezzc, " run --bc ", start)
      if run_to_file(cmd_vm, out_bc_path) != 0:
        say label
        say " run failed:"
        say start
        failed = failed + 1
      remove(out_bc_path)
      free(out_bc_path)
      free(cmd_vm)
      free(base)
      free(start)
      continue

    base:str = path_basename_no_ext(start)
    if base == 0 || base[0] == 0:
      if base != 0:
        free(base)
      failed = failed + 1
      free(start)
      continue

    out_vm_path:str = str_join3(out_dir, base, "_vm.out")
    out_m_path:str = str_join3(out_dir, base, "_m.out")

    cmd_vm:str = str_join3(tezzc, " run --bc ", start)
    rv:int = run_to_file(cmd_vm, out_vm_path)
    if rv != 0:
      failed = failed + 1

    cmd_m1:str = str_join3(tezzc, " run ", mode)
    cmd_m2:str = str_join3(cmd_m1, " ", start)
    rm:int = run_to_file(cmd_m2, out_m_path)
    if rm != 0:
      failed = failed + 1

    out_vm:str = 0 as str
    out_m:str = 0 as str
    if rv == 0:
      out_vm = read_norm(out_vm_path)
      if out_vm == 0:
        failed = failed + 1
    if rm == 0:
      out_m = read_norm(out_m_path)
      if out_m == 0:
        failed = failed + 1

    if out_vm != 0 && out_m != 0 && strcmp(out_vm, out_m) != 0:
      say label
      say " mismatch:"
      say start
      failed = failed + 1

    if out_vm != 0:
      free(out_vm)
    if out_m != 0:
      free(out_m)
    remove(out_vm_path)
    remove(out_m_path)
    free(out_vm_path)
    free(out_m_path)
    free(cmd_vm)
    free(cmd_m1)
    free(cmd_m2)
    free(base)
    free(start)

  free(list)
  ret failed

fn clean_dir(path:str) -> int:
  if path == 0:
    ret 0 - 1
  if path_exists(path) == 0:
    ret 0
  if path_is_dir(path) == 0:
    ret remove(path)
  list:str = io.dir_list_rec(path)
  if list == 0:
    ret 0
  n:int = len(list)
  i:int = 0
  start:*char = list
  for ;;:
    c:int = list[i] as int
    if c == 0 || c == 10:
      list[i] = 0 as char
      if start != list + i:
        if path_is_dir(start) == 0:
          remove(start)
      if c == 0:
        break
      start = list + i + 1
    i = i + 1
  i = n
  while i > 0:
    while i > 0 && list[i - 1] == 0:
      i = i - 1
    if i == 0:
      break
    while i > 0 && list[i - 1] != 0:
      i = i - 1
    p:*char = list + i
    if p[0] != 0 && path_is_dir(p) != 0:
      rmdir(p)
  free(list)
  ret 0

fn append_line_file(path:str, line:str):
  if path == 0 || line == 0:
    ret
  prev:str = io.read_all(path)
  if prev == 0:
    one:str = str_join2(line, "\n")
    io.write_all(path, one)
    free(one)
    ret
  next:str = str_join3(prev, line, "\n")
  io.write_all(path, next)
  free(next)
  free(prev)

fn run_vm_manifest_once(list_path:str, tezzc:str, label:str) -> int:
  list:str = io.read_all(list_path)
  if list == 0:
    msg:str = str_join2("missing ", list_path)
    say msg
    free(msg)
    ret 1
  idx:int = 0
  failed:int = 0
  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    cmd1:str = str_join3(tezzc, " run --bc ", start)
    if test_run(cmd1, label) != 0:
      failed = failed + 1
    free(cmd1)
    free(start)
  free(list)
  ret failed

fn run_vm_manifest_quiet_once(list_path:str, tezzc:str, label:str) -> int:
  list:str = io.read_all(list_path)
  if list == 0:
    msg:str = str_join2("missing ", list_path)
    say msg
    free(msg)
    ret 1
  idx:int = 0
  failed:int = 0
  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    cmd1:str = str_join3(tezzc, " run --bc ", start)
    rc:int = run_quiet_all(cmd1)
    if rc != 0:
      failed = failed + 1
      say "runtime soak command failed:"
      if label != 0:
        say label
      say start
      out1:str = proc_out_all(cmd1)
      if out1 != 0:
        append_line_file("build/runtime_soak_fail.log", out1)
        free(out1)
    free(cmd1)
    free(start)
  free(list)
  ret failed

fn run_check_manifest(list_path:str, tezzc:str, label:str, tail_flags:str) -> int:
  list:str = io.read_all(list_path)
  if list == 0:
    msg:str = str_join2("missing ", list_path)
    say msg
    free(msg)
    ret 1
  idx:int = 0
  failed:int = 0
  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    cmd1:str = str_join3(tezzc, " check ", start)
    cmd2:str = cmd1
    own_cmd2:int = 0
    if tail_flags != 0 && tail_flags[0] != 0:
      cmd2 = str_join3(cmd1, " ", tail_flags)
      own_cmd2 = 1
    if test_run(cmd2, label) != 0:
      failed = failed + 1
    if own_cmd2 != 0:
      free(cmd2)
    free(cmd1)
    free(start)
  free(list)
  ret failed

fn run_fail_manifest(list_path:str, tezzc:str, tail_flags:str) -> int:
  list:str = io.read_all(list_path)
  if list == 0:
    msg:str = str_join2("missing ", list_path)
    say msg
    free(msg)
    ret 1
  idx:int = 0
  failed:int = 0
  while 1:
    line:str = next_manifest_line(list, &idx)
    if line == 0:
      break
    in_path:str = 0 as str
    needle:str = 0 as str
    if split_pair(line, &in_path, &needle) != 0:
      failed = failed + 1
      free(line)
      continue
    cmd1:str = str_join3(tezzc, " check ", in_path)
    cmd2:str = cmd1
    own_cmd2:int = 0
    if tail_flags != 0 && tail_flags[0] != 0:
      cmd2 = str_join3(cmd1, " ", tail_flags)
      own_cmd2 = 1
    if expect_fail(cmd2, needle) != 0:
      failed = failed + 1
    if own_cmd2 != 0:
      free(cmd2)
    free(cmd1)
    if in_path != 0:
      free(in_path)
    if needle != 0:
      free(needle)
    free(line)
  free(list)
  ret failed

fn run_abi_manifest_tests(tezzc:str) -> int:
  abi_list:str = io.read_all("tests/abi_manifest.tnx")
  if abi_list == 0:
    say "missing tests/abi_manifest.tnx"
    ret 1
  os:str = os_name()
  os = norm_os(os)
  out_dir:str = "build/"
  if streq(os, "windows"):
    out_dir = ".\\build\\"
  ensure_dir("build")
  idx:int = 0
  failed:int = 0
  while 1:
    line:str = next_manifest_line(abi_list, &idx)
    if line == 0:
      break
    in_path:str = 0 as str
    out_path:str = 0 as str
    if split_pair(line, &in_path, &out_path) != 0:
      failed = failed + 1
      free(line)
      continue
    tmp_out:str = str_join2(out_dir, "abi_runtime_tmp.tnx")
    cmd_ab1:str = str_join3(tezzc, " abidump ", in_path)
    cmd_ab2a:str = str_join3(cmd_ab1, " ", tmp_out)
    cmd_ab2:str = str_join2(cmd_ab2a, " --freestanding")
    if test_run(cmd_ab2, "runtime abi abidump") != 0:
      failed = failed + 1
    else:
      exp_a:str = read_norm(out_path)
      act_a:str = read_norm(tmp_out)
      if exp_a == 0 || act_a == 0 || strcmp(exp_a, act_a) != 0:
        say "runtime abi mismatch:"
        say in_path
        failed = failed + 1
      if exp_a != 0:
        free(exp_a)
      if act_a != 0:
        free(act_a)
    remove(tmp_out)
    cmd_av1:str = str_join3(tezzc, " abiverify ", in_path)
    cmd_av2a:str = str_join3(cmd_av1, " ", out_path)
    cmd_av2:str = str_join2(cmd_av2a, " --freestanding")
    if test_run(cmd_av2, "runtime abi abiverify") != 0:
      failed = failed + 1
    free(cmd_ab1)
    free(cmd_ab2a)
    free(cmd_ab2)
    free(cmd_av1)
    free(cmd_av2a)
    free(cmd_av2)
    free(tmp_out)
    if in_path != 0:
      free(in_path)
    if out_path != 0:
      free(out_path)
    free(line)
  free(abi_list)
  ret failed

fn run_runtime_hardening_lane(tezzc:str) -> int:
  failed:int = 0
  failed = failed + run_vm_manifest_once("tests/runtime_hardening_manifest.tnx", tezzc, "runtime hardening")
  failed = failed + run_abi_manifest_tests(tezzc)
  failed = failed + run_check_manifest("tests/runtime_boundary_ok_manifest.tnx", tezzc, "runtime boundary", "--freestanding")
  failed = failed + run_fail_manifest("tests/runtime_boundary_fail_manifest.tnx", tezzc, "--freestanding")
  if failed == 0:
    say "RUNTIME HARDENING TESTS PASSED"
  ret failed

fn run_runtime_fuzz_lane(tezzc:str, rounds:int, long_iters:int) -> int:
  if rounds <= 0:
    rounds = 1
  if long_iters <= 0:
    long_iters = 256
  ensure_dir("build")
  triage_path:str = "build/fuzz_triage.tnx"
  remove(triage_path)
  failed:int = 0
  i:int = 0
  while i < rounds:
    round_s:str = int_to_str(i + 1)
    cmd1:str = str_join3(tezzc, " run --bc ", "tests/tnx_fuzz.tn")
    if test_run(cmd1, "runtime fuzz short") != 0:
      failed = failed + 1
      tri1a:str = str_join3("tests/tnx_fuzz.tn|round=", round_s, "|cmd=")
      tri1b:str = str_join2(tri1a, cmd1)
      append_line_file(triage_path, tri1b)
      free(tri1a)
      free(tri1b)
    free(cmd1)

    seed_s:str = int_to_str(1000 + i)
    iters_s:str = int_to_str(long_iters)
    c2a:str = str_join3(tezzc, " run --bc ", "tests/tnx_fuzz_long.tn")
    c2b:str = str_join3(c2a, " -- --seed ", seed_s)
    c2c:str = str_join3(c2b, " --iters ", iters_s)
    if test_run(c2c, "runtime fuzz long") != 0:
      failed = failed + 1
      tri2a:str = str_join3("tests/tnx_fuzz_long.tn|round=", round_s, "|seed=")
      tri2b:str = str_join3(tri2a, seed_s, "|iters=")
      tri2c:str = str_join3(tri2b, iters_s, "|cmd=")
      tri2d:str = str_join2(tri2c, c2c)
      append_line_file(triage_path, tri2d)
      free(tri2a)
      free(tri2b)
      free(tri2c)
      free(tri2d)
    free(c2a)
    free(c2b)
    free(c2c)
    free(seed_s)
    free(iters_s)
    free(round_s)
    i = i + 1
  if failed == 0:
    rounds_ok:str = int_to_str(rounds)
    summary:str = str_join3("runtime_fuzz: ok rounds=", rounds_ok, " (no triage)")
    append_line_file(triage_path, summary)
    free(rounds_ok)
    free(summary)
    say "RUNTIME FUZZ TESTS PASSED"
  else:
    msg:str = str_join2("runtime fuzz triage: ", triage_path)
    say msg
    free(msg)
  ret failed

fn run_runtime_soak_lane(tezzc:str, minutes:int) -> int:
  if minutes <= 0:
    minutes = 1
  ensure_dir("build")
  start_ms:int = time.now_ms()
  end_ms:int = start_ms + (minutes * 60000)
  rounds:int = 0
  failed:int = 0
  while time.now_ms() < end_ms:
    rounds = rounds + 1
    failed = failed + run_vm_manifest_quiet_once("tests/runtime_soak_manifest.tnx", tezzc, "runtime soak")
    if failed != 0:
      break
  if rounds == 0:
    rounds = 1
    failed = failed + run_vm_manifest_quiet_once("tests/runtime_soak_manifest.tnx", tezzc, "runtime soak")
  rounds_s:str = int_to_str(rounds)
  mins_s:str = int_to_str(minutes)
  sum1:str = str_join3("runtime_soak minutes=", mins_s, " rounds=")
  sum2:str = str_join2(sum1, rounds_s)
  io.write_all("build/runtime_soak_summary.txt", sum2)
  free(sum1)
  free(sum2)
  free(rounds_s)
  free(mins_s)
  if failed == 0:
    say "RUNTIME SOAK TESTS PASSED"
  ret failed

fn run_runtime_io_smoke(tezzc:str) -> int:
  ensure_dir("build")
  script_path:str = "build/runtime_io_smoke.tn"
  out_path:str = "build/runtime_io_smoke.out"
  if path_exists(out_path) != 0:
    remove(out_path)
  script_src:str = "import \"io\"\nfn main() -> int:\n  n:int = io.write_all(\"build/runtime_io_smoke.out\", \"tezz-io-smoke\")\n  if n <= 0:\n    say \"IO_SMOKE_WRITE_FAIL\"\n    ret 0 - 1\n  s:str = io.read_all(\"build/runtime_io_smoke.out\")\n  if s == 0:\n    say \"IO_SMOKE_READ_FAIL\"\n    ret 0 - 1\n  if strcmp(s, \"tezz-io-smoke\") != 0:\n    say \"IO_SMOKE_CONTENT_FAIL\"\n    ret 0 - 1\n  say \"IO_SMOKE_OK\"\n  ret 0\n"
  if io.write_all(script_path, script_src) < 0:
    say "runtime io smoke: failed to write generated script"
    ret 0 - 1
  cmd:str = str_join3(tezzc, " run --bc ", script_path)
  rc:int = proc_run(cmd)
  free(cmd)
  if rc != 0:
    say "runtime io smoke: bytecode run failed"
    ret 0 - 1
  if path_exists(out_path) == 0:
    say "runtime io smoke: output file not created"
    ret 0 - 1
  say "RUNTIME IO SMOKE PASSED"
  ret 0

fn run_simple_mode_smoke() -> int:
  ensure_dir("build")
  script_path:str = "build/simple_mode_smoke.tn"
  out_path:str = "build/simple_mode_smoke.out"
  if path_exists(out_path) != 0:
    remove(out_path)
  script_src:str = "import \"io\"\n\nsay \"simple-smoke-ok\"\nio.write_all(\"build/simple_mode_smoke.out\", \"ok\")\n"
  if io.write_all(script_path, script_src) < 0:
    say "simple mode smoke: failed to write generated script"
    ret 0 - 1
  osn:str = os_name()
  runner:str = "tezz"
  if streq(osn, "windows"):
    if path_exists(".\\tezz.cmd") != 0:
      runner = ".\\tezz.cmd"
    else:
      runner = "tezz.cmd"
  else:
    if path_exists("./tezz") != 0:
      runner = "./tezz"
  c0:str = str_join3(runner, " run ", script_path)
  c1:str = str_join2(c0, " --mode simple")
  rc:int = proc_run(c1)
  free(c0)
  free(c1)
  if rc != 0:
    say "simple mode smoke: command failed"
    ret 0 - 1
  if path_exists(out_path) == 0:
    say "simple mode smoke: output file not created"
    ret 0 - 1
  out:str = io.read_all(out_path)
  if out == 0:
    say "simple mode smoke: failed to read output"
    ret 0 - 1
  if strcmp(out, "ok") != 0:
    say "simple mode smoke: unexpected output"
    free(out)
    ret 0 - 1
  free(out)
  say "SIMPLE MODE SMOKE PASSED"
  ret 0

fn cmd_test() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_test()
      ret 0
  parity:int = 0
  parity_debug:int = 0
  cross:int = 0
  smoke:int = 0
  conformance:int = 0
  conformance_strict:int = 0
  stdlib_v1:int = 0
  tooling:int = 0
  gui_lane:int = 0
  runtime_hardening:int = 0
  runtime_fuzz:int = 0
  runtime_soak:int = 0
  io_smoke:int = 0
  simple_smoke:int = 0
  legacy_unstable:int = 0
  kernel_perf:int = 0
  fuzz_rounds:int = 4
  fuzz_iters:int = 512
  soak_hours:int = 0
  soak_minutes:int = 0
  host_win_arm64:int = 0
  host_macos:int = 0
  host_linux_arm64:int = 0
  accel:int = 0
  accel_onnx:int = 0
  ai:int = 1
  while ai < args_count():
    a:str = arg(ai)
    if streq(a, "--smoke"):
      smoke = 1
    if streq(a, "--conformance"):
      conformance = 1
    if streq(a, "--conformance-strict"):
      conformance_strict = 1
    if streq(a, "--stdlib-v1"):
      stdlib_v1 = 1
    if streq(a, "--tooling"):
      tooling = 1
    if streq(a, "--gui"):
      gui_lane = 1
    if streq(a, "--runtime-hardening"):
      runtime_hardening = 1
    if streq(a, "--runtime-fuzz"):
      runtime_fuzz = 1
    if streq(a, "--runtime-soak"):
      runtime_soak = 1
    if streq(a, "--io-smoke"):
      io_smoke = 1
    if streq(a, "--simple-smoke"):
      simple_smoke = 1
    if streq(a, "--legacy-unstable"):
      legacy_unstable = 1
    if streq(a, "--kernel-perf"):
      kernel_perf = 1
    if streq(a, "--soak-fast"):
      runtime_soak = 1
      soak_minutes = 1
    if streq(a, "--fuzz-rounds") && (ai + 1) < args_count():
      runtime_fuzz = 1
      fuzz_rounds = parse_i64(arg(ai + 1))
      ai = ai + 2
      continue
    if streq(a, "--fuzz-iters") && (ai + 1) < args_count():
      runtime_fuzz = 1
      fuzz_iters = parse_i64(arg(ai + 1))
      ai = ai + 2
      continue
    if streq(a, "--soak-hours") && (ai + 1) < args_count():
      runtime_soak = 1
      soak_hours = parse_i64(arg(ai + 1))
      ai = ai + 2
      continue
    if streq(a, "--soak-minutes") && (ai + 1) < args_count():
      runtime_soak = 1
      soak_minutes = parse_i64(arg(ai + 1))
      ai = ai + 2
      continue
    if streq(a, "--parity"):
      parity = 1
    if streq(a, "--parity-debug"):
      parity_debug = 1
    if streq(a, "--cross"):
      cross = 1
    if streq(a, "--host-win-arm64"):
      host_win_arm64 = 1
    if streq(a, "--host-macos"):
      host_macos = 1
    if streq(a, "--host-linux-arm64"):
      host_linux_arm64 = 1
    if streq(a, "--accel"):
      accel = 1
    if streq(a, "--accel-onnx"):
      accel_onnx = 1
    ai = ai + 1

  if conformance_strict != 0:
    conformance = 1

  tezzc:str = tezzc_path()
  if tezzc == 0:
    say "tezz test: compiler not found"
    ret 0 - 1
  os:str = os_name()
  os = norm_os(os)

  if runtime_hardening != 0 || runtime_fuzz != 0 || runtime_soak != 0 || io_smoke != 0 || simple_smoke != 0:
    ensure_dir("build")
    lane_failed:int = 0
    if io_smoke != 0:
      lane_failed = lane_failed + run_runtime_io_smoke(tezzc)
    if simple_smoke != 0:
      lane_failed = lane_failed + run_simple_mode_smoke()
    if runtime_hardening != 0:
      lane_failed = lane_failed + run_runtime_hardening_lane(tezzc)
    if runtime_fuzz != 0:
      lane_failed = lane_failed + run_runtime_fuzz_lane(tezzc, fuzz_rounds, fuzz_iters)
    if runtime_soak != 0:
      soak_total_minutes:int = soak_minutes
      if soak_total_minutes <= 0 && soak_hours > 0:
        soak_total_minutes = soak_hours * 60
      if soak_total_minutes <= 0:
        soak_total_minutes = 1
      lane_failed = lane_failed + run_runtime_soak_lane(tezzc, soak_total_minutes)
    if lane_failed != 0:
      ret 0 - 1
    say "RUNTIME LANES PASSED"
    ret 0

  if stdlib_v1 != 0:
    ensure_dir("build")
    lane_failed:int = 0
    lane_failed = lane_failed + run_vm_manifest_once("tests/stdlib_v1_manifest.tnx", tezzc, "stdlib v1")
    lane_failed = lane_failed + run_check_manifest("tests/stdlib_v1_check_manifest.tnx", tezzc, "stdlib v1 check", "")
    lane_failed = lane_failed + run_vm_manifest_once("tests/reference_apps_manifest.tnx", tezzc, "reference apps")
    lane_failed = lane_failed + run_check_manifest("tests/reference_apps_manifest.tnx", tezzc, "reference apps check", "")
    lane_failed = lane_failed + run_check_manifest("tests/snippets_check_manifest.tnx", tezzc, "snippet check", "")
    if lane_failed != 0:
      ret 0 - 1
    say "STDLIB V1 TESTS PASSED"
    ret 0

  if tooling != 0:
    ensure_dir("build")
    lane_failed2:int = 0
    lane_failed2 = lane_failed2 + run_vm_manifest_once("tests/tooling_manifest.tnx", tezzc, "tooling")
    lane_failed2 = lane_failed2 + run_check_manifest("tests/snippets_check_manifest.tnx", tezzc, "snippet check", "")
    if lane_failed2 != 0:
      ret 0 - 1
    say "TOOLING TESTS PASSED"
    ret 0

  if gui_lane != 0:
    ensure_dir("build")
    lane_failed3:int = 0
    lane_failed3 = lane_failed3 + run_vm_manifest_once("tests/gui_manifest.tnx", tezzc, "gui")
    lane_failed3 = lane_failed3 + run_check_manifest("tests/gui_check_manifest.tnx", tezzc, "gui check", "")
    if lane_failed3 != 0:
      ret 0 - 1
    say "GUI LANE PASSED"
    ret 0

  list_path:str = "tests/manifest.tnx"
  if conformance != 0:
    list_path = "tests/conformance_manifest.tnx"
  else if smoke != 0:
    list_path = "tests/smoke_manifest.tnx"
  list:str = io.read_all(list_path)
  if list == 0:
    msg0:str = str_join2("missing ", list_path)
    say msg0
    free(msg0)
    ret 0 - 1
  ensure_dir("build")
  exe_suffix:str = ""
  out_dir:str = "build/"
  if streq(os, "windows"):
    exe_suffix = ".exe"
    out_dir = ".\\build\\"

  // Auto-enable host-run gates on native hosts
  arch:str = detect_arch()
  if host_win_arm64 == 0 && streq(os, "windows") != 0 && streq(arch, "arm64") != 0:
    host_win_arm64 = 1
  if host_linux_arm64 == 0 && streq(os, "linux") != 0 && streq(arch, "arm64") != 0:
    host_linux_arm64 = 1
  if host_macos == 0 && streq(os, "macos") != 0:
    host_macos = 1
  if arch != 0:
    free(arch)

  idx:int = 0
  failed:int = 0

  if parity == 0 || smoke != 0 || conformance != 0:
    while 1:
      start:str = next_manifest_line(list, &idx)
      if start == 0:
        break
      // VM run (non-parity)
      cmd_vm:str = str_join3(tezzc, " run --bc ", start)
      if test_run(cmd_vm, "vm run") != 0:
        failed = failed + 1
      free(cmd_vm)
      free(start)

    if legacy_unstable != 0:
      failed = failed + run_vm_manifest_once("tests/legacy_unstable_manifest.tnx", tezzc, "vm run (legacy unstable)")

  if smoke != 0 || conformance != 0:
    if conformance != 0:
      conf_check_list:str = io.read_all("tests/conformance_check_manifest.tnx")
      if conf_check_list == 0:
        say "missing tests/conformance_check_manifest.tnx"
        failed = failed + 1
      else:
        idx = 0
        while 1:
          chk_path:str = next_manifest_line(conf_check_list, &idx)
          if chk_path == 0:
            break
          cmd_cc:str = str_join3(tezzc, " check ", chk_path)
          if test_run(cmd_cc, "conformance check") != 0:
            failed = failed + 1
          free(cmd_cc)
          free(chk_path)
        free(conf_check_list)

      conf_fail_list:str = io.read_all("tests/conformance_fail_manifest.tnx")
      if conf_fail_list == 0:
        say "missing tests/conformance_fail_manifest.tnx"
        failed = failed + 1
      else:
        idx = 0
        while 1:
          line:str = next_manifest_line(conf_fail_list, &idx)
          if line == 0:
            break
          in_path:str = 0 as str
          needle:str = 0 as str
          if split_pair(line, &in_path, &needle) != 0:
            failed = failed + 1
            free(line)
            continue
          cmd_cf:str = str_join3(tezzc, " check ", in_path)
          if expect_fail(cmd_cf, needle) != 0:
            failed = failed + 1
          free(cmd_cf)
          if in_path != 0:
            free(in_path)
          if needle != 0:
            free(needle)
          free(line)
        free(conf_fail_list)

      // Deterministic AST snapshots (formatter canonical output)
      conf_ast_list:str = io.read_all("tests/conformance_ast_manifest.tnx")
      if conf_ast_list == 0:
        say "missing tests/conformance_ast_manifest.tnx"
        failed = failed + 1
      else:
        idx = 0
        while 1:
          line:str = next_manifest_line(conf_ast_list, &idx)
          if line == 0:
            break
          in_path:str = 0 as str
          out_path:str = 0 as str
          if split_pair(line, &in_path, &out_path) != 0:
            failed = failed + 1
            free(line)
            continue
          base:str = path_basename_no_ext(in_path)
          if base == 0 || base[0] == 0:
            failed = failed + 1
            if base != 0:
              free(base)
            if in_path != 0:
              free(in_path)
            if out_path != 0:
              free(out_path)
            free(line)
            continue
          tmp_a:str = str_join2(out_dir, base)
          tmp_b:str = str_join2(tmp_a, "_conf_ast.tn")
          if io.copy_file(in_path, tmp_b) < 0:
            say "conformance ast copy failed:"
            say in_path
            failed = failed + 1
          else:
            cmd_af1:str = str_join3(tezzc, " fmt ", tmp_b)
            if run_quiet(cmd_af1) != 0:
              say "conformance ast fmt failed:"
              say in_path
              failed = failed + 1
            else:
              exp_af:str = read_norm(out_path)
              act_af:str = read_norm(tmp_b)
              if exp_af == 0 || act_af == 0 || strcmp(exp_af, act_af) != 0:
                say "conformance ast mismatch:"
                say in_path
                failed = failed + 1
              else:
                cmd_af2:str = str_join3(tezzc, " fmt ", tmp_b)
                if run_quiet(cmd_af2) != 0:
                  say "conformance ast roundtrip failed:"
                  say in_path
                  failed = failed + 1
                else:
                  act_af2:str = read_norm(tmp_b)
                  if act_af2 == 0 || strcmp(act_af, act_af2) != 0:
                    say "conformance ast non-deterministic:"
                    say in_path
                    failed = failed + 1
                  if act_af2 != 0:
                    free(act_af2)
                free(cmd_af2)
              if exp_af != 0:
                free(exp_af)
              if act_af != 0:
                free(act_af)
            free(cmd_af1)
          remove(tmp_b)
          free(tmp_a)
          free(tmp_b)
          free(base)
          if in_path != 0:
            free(in_path)
          if out_path != 0:
            free(out_path)
          free(line)
        free(conf_ast_list)

      // Deterministic IR snapshots (repro mode)
      conf_ir_list:str = io.read_all("tests/conformance_ir_manifest.tnx")
      if conf_ir_list == 0:
        say "missing tests/conformance_ir_manifest.tnx"
        failed = failed + 1
      else:
        idx = 0
        while 1:
          line:str = next_manifest_line(conf_ir_list, &idx)
          if line == 0:
            break
          in_path:str = 0 as str
          out_path:str = 0 as str
          if split_pair(line, &in_path, &out_path) != 0:
            failed = failed + 1
            free(line)
            continue
          base:str = path_basename_no_ext(in_path)
          if base == 0 || base[0] == 0:
            failed = failed + 1
            if base != 0:
              free(base)
            if in_path != 0:
              free(in_path)
            if out_path != 0:
              free(out_path)
            free(line)
            continue
          cmd_ir1:str = str_join3(tezzc, " ir ", in_path)
          cmd_ir2:str = str_join2(cmd_ir1, " --repro")
          tmp1a:str = str_join2(out_dir, base)
          tmp1b:str = str_join2(tmp1a, "_conf_ir_1.out")
          tmp2a:str = str_join2(out_dir, base)
          tmp2b:str = str_join2(tmp2a, "_conf_ir_2.out")
          r1:int = run_to_file(cmd_ir2, tmp1b)
          r2:int = run_to_file(cmd_ir2, tmp2b)
          exp_ir:str = read_norm(out_path)
          act_ir1t:str = 0 as str
          act_ir2t:str = 0 as str
          if r1 == 0:
            act_ir1t = read_norm(tmp1b)
          if r2 == 0:
            act_ir2t = read_norm(tmp2b)
          if exp_ir == 0 || act_ir1t == 0 || strcmp(exp_ir, act_ir1t) != 0:
            say "conformance ir mismatch:"
            say in_path
            failed = failed + 1
          if act_ir1t == 0 || act_ir2t == 0 || strcmp(act_ir1t, act_ir2t) != 0:
            say "conformance ir non-deterministic:"
            say in_path
            failed = failed + 1
          remove(tmp1b)
          remove(tmp2b)
          if cmd_ir1 != 0:
            free(cmd_ir1)
          if cmd_ir2 != 0:
            free(cmd_ir2)
          if tmp1a != 0:
            free(tmp1a)
          if tmp1b != 0:
            free(tmp1b)
          if tmp2a != 0:
            free(tmp2a)
          if tmp2b != 0:
            free(tmp2b)
          if act_ir1t != 0:
            free(act_ir1t)
          if act_ir2t != 0:
            free(act_ir2t)
          if exp_ir != 0:
            free(exp_ir)
          if base != 0:
            free(base)
          if in_path != 0:
            free(in_path)
          if out_path != 0:
            free(out_path)
          free(line)
        free(conf_ir_list)

      // Strict parser/type-edge diagnostics snapshots (opt-in)
      if conformance_strict != 0:
        conf_diag_list:str = io.read_all("tests/conformance_diag_manifest.tnx")
        if conf_diag_list == 0:
          say "missing tests/conformance_diag_manifest.tnx"
          failed = failed + 1
        else:
          idx = 0
          while 1:
            line:str = next_manifest_line(conf_diag_list, &idx)
            if line == 0:
              break
            in_path:str = 0 as str
            out_path:str = 0 as str
            if split_pair(line, &in_path, &out_path) != 0:
              failed = failed + 1
              free(line)
              continue
            cmd_d:str = str_join3(tezzc, " check ", in_path)
            rc_cmd:str = 0 as str
            if streq(os, "windows"):
              rc_cmd = str_join3("cmd /c \"", cmd_d, " > nul 2>&1\"")
            else:
              rc_cmd = str_join3("sh -c \"", cmd_d, " > /dev/null 2>&1\"")
            rc_d:int = proc_run(rc_cmd)
            free(rc_cmd)
            if rc_d == 0:
              say "conformance strict expected failure but succeeded:"
              say in_path
              failed = failed + 1
            else:
              cap_cmd_d:str = 0 as str
              if streq(os, "windows"):
                cap_cmd_d = str_join3("cmd /c \"(", cmd_d, ") 2>&1\"")
              else:
                cap_cmd_d = str_join3(cmd_d, " 2>&1 | cat", "")
              cap_path_d:str = str_join2("build/", "conformance_diag_capture.out")
              run_to_file(cap_cmd_d, cap_path_d)
              out_d:str = read_norm(cap_path_d)
              remove(cap_path_d)
              exp_d:str = read_norm(out_path)
              exp_d2:str = normalize_slashes(exp_d)
              act_d2:str = normalize_slashes(out_d)
              exp_d3:str = trim_trailing_ws(exp_d2)
              act_d3:str = trim_trailing_ws(act_d2)
              if exp_d3 == 0 || act_d3 == 0 || strcmp(exp_d3, act_d3) != 0:
                say "conformance strict diagnostics mismatch:"
                say in_path
                failed = failed + 1
              if cap_cmd_d != 0:
                free(cap_cmd_d)
              if cap_path_d != 0:
                free(cap_path_d)
              if out_d != 0:
                free(out_d)
              if exp_d != 0:
                free(exp_d)
              if exp_d2 != 0:
                free(exp_d2)
              if act_d2 != 0:
                free(act_d2)
              if exp_d3 != 0:
                free(exp_d3)
              if act_d3 != 0:
                free(act_d3)
            free(cmd_d)
            if in_path != 0:
              free(in_path)
            if out_path != 0:
              free(out_path)
            free(line)
          free(conf_diag_list)
    free(list)
    if failed != 0:
      ret 0 - 1
    if conformance != 0:
      say "CONFORMANCE TESTS PASSED"
    else:
      say "SMOKE TESTS PASSED"
    ret 0

  // Optional accelerator tests (gated)
  if accel != 0:
    acc_list:str = io.read_all("tests/accel_manifest.tnx")
    if acc_list == 0:
      say "missing tests/accel_manifest.tnx"
      failed = failed + 1
    else:
      idx = 0
      while 1:
        start:str = next_manifest_line(acc_list, &idx)
        if start == 0:
          break
        // prefer native path for accelerator coverage
        cmd_acc1:str = str_join3(tezzc, " run --native ", start)
        cmd_acc:str = str_join2(cmd_acc1, " -- --require")
        if test_run(cmd_acc, "accel run") != 0:
          failed = failed + 1
        free(cmd_acc1)
        free(cmd_acc)
        free(start)
      free(acc_list)

  // Optional accelerator ONNX tests (gated)
  if accel_onnx != 0:
    onnx_list:str = io.read_all("tests/accel_onnx_manifest.tnx")
    if onnx_list == 0:
      say "missing tests/accel_onnx_manifest.tnx"
      failed = failed + 1
    else:
      idx = 0
      while 1:
        start:str = next_manifest_line(onnx_list, &idx)
        if start == 0:
          break
        cmd_ox1:str = str_join3(tezzc, " run --native ", start)
        cmd_ox:str = str_join2(cmd_ox1, " -- --require-onnx")
        if test_run(cmd_ox, "accel onnx run") != 0:
          failed = failed + 1
        free(cmd_ox1)
        free(cmd_ox)
        free(start)
      free(onnx_list)

  // buildexe parity tests (VM vs EXE)
  be_target:str = "x86_64"
  if streq(os, "linux"):
    be_target = "linux"
  else if streq(os, "macos"):
    be_target = "macos"
  be_list:str = io.read_all("tests/buildexe_manifest.tnx")
  if be_list != 0:
    ensure_dir("build")
    idx = 0
    if parity != 0 && parity_debug != 0:
      say "parity: buildexe start"
    while 1:
      start:str = next_manifest_line(be_list, &idx)
      if start == 0:
        break
      base:str = path_basename_no_ext(start)
      cmd_vm:str = 0 as str
      out_vm:str = 0 as str
      out_vm_path:str = 0 as str
      if base != 0 && base[0] != 0:
        // VM output
        cmd_vm = str_join3(tezzc, " run --bc ", start)
        if parity == 0:
          if test_run(cmd_vm, "vm run") != 0:
            failed = failed + 1
        else:
          out_vm_path = str_join3(out_dir, base, "_vm.out")
          if run_to_file(cmd_vm, out_vm_path) != 0:
            say "test command failed:"
            say "vm run (capture)"
            say cmd_vm
            failed = failed + 1
          else:
            out_vm = read_norm(out_vm_path)
            if out_vm == 0:
              failed = failed + 1
          remove(out_vm_path)

        // build exe (x86_64, run on host)
        out1:str = str_join2(out_dir, base)
        out2:str = str_join2(out1, "_be")
        out3:str = str_join2(out2, exe_suffix)
        cmd_be1:str = str_join3(tezzc, " buildexe ", start)
        cmd_be2:str = str_join3(cmd_be1, " ", out3)
        cmd_be3a:str = str_join3(cmd_be2, " --target ", be_target)
        cmd_be3:str = str_join2(cmd_be3a, " --verify")
        if test_run(cmd_be3, "buildexe host verify") != 0:
          failed = failed + 1
        else:
          if parity == 0:
            if test_run(out3, "run exe host") != 0:
              failed = failed + 1
          else:
            out_exe_path:str = str_join3(out_dir, base, "_exe.out")
            out_exe:str = 0 as str
            if run_to_file(out3, out_exe_path) != 0:
              say "test command failed:"
              say "run exe host (capture)"
              say out3
              failed = failed + 1
            else:
              out_exe = read_norm(out_exe_path)
              if out_exe == 0:
                failed = failed + 1
              else:
                if out_vm != 0 && strcmp(out_vm, out_exe) != 0:
                  say "buildexe mismatch: "
                  say start
                  failed = failed + 1
                free(out_exe)
            remove(out_exe_path)
            free(out_exe_path)

        free(out1)
        free(out2)
        free(out3)
        free(cmd_be1)
        free(cmd_be2)
        free(cmd_be3a)
        free(cmd_be3)

        // Windows-only: also validate arm64/x86 emitters (verify only)
        if streq(os, "windows"):
          out_w1:str = str_join2(out_dir, base)
          out_w2:str = str_join2(out_w1, "_be_arm64")
          out_w3:str = str_join2(out_w2, exe_suffix)
          cmd_w1:str = str_join3(tezzc, " buildexe ", start)
          cmd_w2:str = str_join3(cmd_w1, " ", out_w3)
          cmd_w3:str = str_join2(cmd_w2, " --target arm64 --verify")
          if test_run(cmd_w3, "buildexe arm64 verify") != 0:
            failed = failed + 1
          free(out_w1)
          free(out_w2)
          free(out_w3)
          free(cmd_w1)
          free(cmd_w2)
          free(cmd_w3)

          out_x1:str = str_join2(out_dir, base)
          out_x2:str = str_join2(out_x1, "_be_x86")
          out_x3:str = str_join2(out_x2, exe_suffix)
          cmd_x1:str = str_join3(tezzc, " buildexe ", start)
          cmd_x2:str = str_join3(cmd_x1, " ", out_x3)
          cmd_x3:str = str_join2(cmd_x2, " --target x86 --verify")
          if test_run(cmd_x3, "buildexe x86 verify") != 0:
            failed = failed + 1
          else:
            if parity == 0:
              if test_run(out_x3, "run exe x86") != 0:
                failed = failed + 1
            else:
              out_x86_path:str = str_join3(out_dir, base, "_x86.out")
              out_x86:str = 0 as str
              if run_to_file(out_x3, out_x86_path) != 0:
                say "test command failed:"
                say "run exe x86 (capture)"
                say out_x3
                failed = failed + 1
              else:
                out_x86 = read_norm(out_x86_path)
                if out_x86 == 0:
                  failed = failed + 1
                else:
                  if out_vm != 0 && strcmp(out_vm, out_x86) != 0:
                    say "buildexe mismatch (x86): "
                    say start
                    failed = failed + 1
                  free(out_x86)
              remove(out_x86_path)
              free(out_x86_path)
          free(out_x1)
          free(out_x2)
          free(out_x3)
          free(cmd_x1)
          free(cmd_x2)
          free(cmd_x3)
      else:
        failed = failed + 1

      if out_vm != 0:
        free(out_vm)
      if cmd_vm != 0:
        free(cmd_vm)
      if out_vm_path != 0:
        free(out_vm_path)
      if base != 0:
        free(base)
      free(start)
    free(be_list)
    if parity != 0 && parity_debug != 0:
      say "parity: buildexe done"

  // buildexe verify-only tests (x86 on Windows)
  if streq(os, "windows"):
    be_x86_list:str = io.read_all("tests/buildexe_x86_manifest.tnx")
    if be_x86_list != 0:
      ensure_dir("build")
      idx = 0
      while 1:
        start:str = next_manifest_line(be_x86_list, &idx)
        if start == 0:
          break
        base:str = path_basename_no_ext(start)
        if base != 0 && base[0] != 0:
          out1:str = str_join2(out_dir, base)
          out2:str = str_join2(out1, "_be_x86")
          out3:str = str_join2(out2, exe_suffix)
          cmd_be1:str = str_join3(tezzc, " buildexe ", start)
          cmd_be2:str = str_join3(cmd_be1, " ", out3)
          cmd_be3:str = str_join2(cmd_be2, " --target x86 --verify")
          if test_run(cmd_be3, "buildexe x86 verify") != 0:
            failed = failed + 1
          free(out1)
          free(out2)
          free(out3)
          free(cmd_be1)
          free(cmd_be2)
          free(cmd_be3)
        else:
          failed = failed + 1

        if base != 0:
          free(base)
        free(start)
    free(be_x86_list)
    if parity != 0 && parity_debug != 0:
      say "parity: x86 buildexe done"

  // Module system negative tests (lock/dep enforcement)
  if parity == 0:
    // missing dep in tezz.mod
    cmd_md:str = str_join3(tezzc, " check ", "tests/module_missing_dep.tn")
    if expect_fail(cmd_md, "missing dep") != 0:
      failed = failed + 1
    free(cmd_md)

    // versioned import on path not allowed
    cmd_mv:str = str_join3(tezzc, " check ", "tests/module_path_ver_fail.tn")
    if expect_fail(cmd_mv, "versioned import not allowed") != 0:
      failed = failed + 1
    free(cmd_mv)

    // missing lock entry for a pinned dep
    lock_orig:str = io.read_all("tezz.lock")
    if lock_orig != 0:
      lock_tmp:str = lock_strip_dep(lock_orig, "io")
      if lock_tmp != 0:
        io.write_all("tezz.lock", lock_tmp)
        cmd_ml:str = str_join3(tezzc, " check ", "tests/module_lock_missing_in_lock.tn")
        if expect_fail(cmd_ml, "missing io@") != 0:
          failed = failed + 1
        free(cmd_ml)
        free(lock_tmp)
      io.write_all("tezz.lock", lock_orig)
      free(lock_orig)

  // ELF verify tests (cross-target, no run)
  if streq(os, "linux") != 0 || cross != 0:
    elf_list:str = io.read_all("tests/buildexe_elf_manifest.tnx")
    if elf_list != 0:
      ensure_dir("build")
      idx = 0
      while 1:
        start:str = next_manifest_line(elf_list, &idx)
        if start == 0:
          break
        base:str = path_basename_no_ext(start)
        if base != 0 && base[0] != 0:
          out1:str = str_join2(out_dir, base)
          out2:str = str_join2(out1, "_be_elf")
          cmd1:str = str_join3(tezzc, " buildexe ", start)
          cmd2:str = str_join3(cmd1, " ", out2)
          cmd3:str = str_join2(cmd2, " --target linux --verify")
          if test_run(cmd3, "buildexe elf verify") != 0:
            failed = failed + 1
          free(out1)
          free(out2)
          free(cmd1)
          free(cmd2)
          free(cmd3)
        else:
          failed = failed + 1
        if base != 0:
          free(base)
        free(start)
      free(elf_list)

  // Mach-O verify tests (cross-target, no run)
  if streq(os, "macos") != 0 || cross != 0:
    macho_list:str = io.read_all("tests/buildexe_macho_manifest.tnx")
    if macho_list != 0:
      ensure_dir("build")
      idx = 0
      while 1:
        start:str = next_manifest_line(macho_list, &idx)
        if start == 0:
          break
        base:str = path_basename_no_ext(start)
        if base != 0 && base[0] != 0:
          out1:str = str_join2(out_dir, base)
          out2:str = str_join2(out1, "_be_macho")
          cmd1:str = str_join3(tezzc, " buildexe ", start)
          cmd2:str = str_join3(cmd1, " ", out2)
          cmd3:str = str_join2(cmd2, " --target macos --verify")
          if test_run(cmd3, "buildexe macho verify") != 0:
            failed = failed + 1
          free(out1)
          free(out2)
          free(cmd1)
          free(cmd2)
          free(cmd3)
        else:
          failed = failed + 1
        if base != 0:
          free(base)
        free(start)
      free(macho_list)

  // Linux arm64 run tests via WSL + QEMU (optional)
  if streq(os, "windows") && cross != 0:
    arm_list:str = io.read_all("tests/buildexe_arm64_manifest.tnx")
    if arm_list != 0:
      qemu_ok:int = 0
      qout:str = proc_out("wsl -e sh -lc \"command -v qemu-aarch64\"")
      if qout != 0:
        qout = trim_line(qout)
        if qout[0] != 0:
          qemu_ok = 1
      if qout != 0:
        free(qout)
      if qemu_ok == 0:
        say "arm64 parity skipped: qemu-aarch64 not found"
        free(arm_list)
      else:
        ensure_dir("build")
        idx = 0
        while 1:
          start:str = next_manifest_line(arm_list, &idx)
          if start == 0:
            break
          base:str = path_basename_no_ext(start)
          if base == 0 || base[0] == 0:
            failed = failed + 1
            if base != 0:
              free(base)
            free(start)
            continue
          // VM output
          cmd_vm:str = str_join3(tezzc, " run --bc ", start)
          out_vm_path:str = 0 as str
          out_vm:str = 0 as str
          if parity == 0:
            if test_run(cmd_vm, "vm run") != 0:
              failed = failed + 1
          else:
            out_vm_path = str_join3(out_dir, base, "_vm.out")
            if run_to_file(cmd_vm, out_vm_path) != 0:
              say "test command failed:"
              say "vm run (capture)"
              say cmd_vm
              failed = failed + 1
            else:
              out_vm = read_norm(out_vm_path)
              if out_vm == 0:
                failed = failed + 1
            remove(out_vm_path)
            free(out_vm_path)
          free(cmd_vm)

          // build arm64 ELF
          out1:str = str_join2(out_dir, base)
          out2:str = str_join2(out1, "_be_arm64_elf")
          cmd1:str = str_join3(tezzc, " buildexe ", start)
          cmd2:str = str_join3(cmd1, " ", out2)
          cmd3:str = str_join2(cmd2, " --target linux-arm64 --verify")
          if test_run(cmd3, "buildexe linux-arm64 verify") != 0:
            failed = failed + 1
          else:
            wslp:str = wsl_path(out2)
            if wslp == 0:
              failed = failed + 1
            else:
              // run under qemu-aarch64 (copy to /tmp to avoid DrvFs exec issues)
              cmdr3:str = str_join3("wsl -e sh -lc \"cp ", wslp, " /tmp/tezz_arm64_tmp && chmod +x /tmp/tezz_arm64_tmp && qemu-aarch64 /tmp/tezz_arm64_tmp; rm -f /tmp/tezz_arm64_tmp\"")
              if parity == 0:
                if test_run(cmdr3, "run exe arm64") != 0:
                  failed = failed + 1
              else:
                out_arm_path:str = str_join3(out_dir, base, "_arm64.out")
                out_arm:str = 0 as str
                if run_to_file(cmdr3, out_arm_path) != 0:
                  say "test command failed:"
                  say "run exe arm64 (capture)"
                  say cmdr3
                  failed = failed + 1
                else:
                  out_arm = read_norm(out_arm_path)
                  if out_arm == 0:
                    failed = failed + 1
                  else:
                    if out_vm != 0 && strcmp(out_vm, out_arm) != 0:
                      say "buildexe mismatch (arm64): "
                      say start
                      failed = failed + 1
                    free(out_arm)
                remove(out_arm_path)
                free(out_arm_path)
              free(cmdr3)
              free(wslp)
          free(out1)
          free(out2)
          free(cmd1)
          free(cmd2)
          free(cmd3)
          if out_vm != 0:
            free(out_vm)
          free(base)
          free(start)
        free(arm_list)

  // Windows ARM64 host-run (optional, requires ARM64 host)
  if streq(os, "windows") && host_win_arm64 != 0:
    arm_list2:str = io.read_all("tests/buildexe_arm64_manifest.tnx")
    if arm_list2 != 0:
      ensure_dir("build")
      idx = 0
      while 1:
        start:str = next_manifest_line(arm_list2, &idx)
        if start == 0:
          break
        base:str = path_basename_no_ext(start)
        if base == 0 || base[0] == 0:
          failed = failed + 1
          if base != 0:
            free(base)
          free(start)
          continue
        // VM output
        cmd_vm:str = str_join3(tezzc, " run --bc ", start)
        out_vm_path:str = 0 as str
        out_vm:str = 0 as str
        if parity == 0:
          if test_run(cmd_vm, "vm run") != 0:
            failed = failed + 1
        else:
          out_vm_path = str_join3(out_dir, base, "_vm.out")
          if run_to_file(cmd_vm, out_vm_path) != 0:
            say "test command failed:"
            say "vm run (capture)"
            say cmd_vm
            failed = failed + 1
          else:
            out_vm = read_norm(out_vm_path)
            if out_vm == 0:
              failed = failed + 1
          remove(out_vm_path)
          free(out_vm_path)
        free(cmd_vm)

        // build arm64 PE and run on host
        out1:str = str_join2(out_dir, base)
        out2:str = str_join2(out1, "_be_arm64")
        out3:str = str_join2(out2, exe_suffix)
        cmd1:str = str_join3(tezzc, " buildexe ", start)
        cmd2:str = str_join3(cmd1, " ", out3)
        cmd3:str = str_join2(cmd2, " --target arm64 --verify")
        if test_run(cmd3, "buildexe arm64 verify") != 0:
          failed = failed + 1
        else:
          if parity == 0:
            if test_run(out3, "run exe arm64") != 0:
              failed = failed + 1
          else:
            out_arm_path:str = str_join3(out_dir, base, "_arm64.out")
            out_arm:str = 0 as str
            if run_to_file(out3, out_arm_path) != 0:
              say "test command failed:"
              say "run exe arm64 (capture)"
              say out3
              failed = failed + 1
            else:
              out_arm = read_norm(out_arm_path)
              if out_arm == 0:
                failed = failed + 1
              else:
                if out_vm != 0 && strcmp(out_vm, out_arm) != 0:
                  say "buildexe mismatch (arm64 host): "
                  say start
                  failed = failed + 1
                free(out_arm)
            remove(out_arm_path)
            free(out_arm_path)
        free(out1)
        free(out2)
        free(out3)
        free(cmd1)
        free(cmd2)
        free(cmd3)
        if out_vm != 0:
          free(out_vm)
        free(base)
        free(start)
      free(arm_list2)

  // Linux ARM64 host-run (optional, requires ARM64 Linux host)
  if streq(os, "linux") && host_linux_arm64 != 0:
    arm_list3:str = io.read_all("tests/buildexe_arm64_manifest.tnx")
    if arm_list3 != 0:
      ensure_dir("build")
