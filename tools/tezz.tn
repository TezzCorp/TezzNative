    free(reglib)
  if reg != 0:
    free(reg)
  if root != 0:
    free(root)
  free(mod)
  ret 0

fn cmd_publish() -> int:
  if path_exists("tezz.mod") == 0:
    say "publish: missing tezz.mod"
    ret 0 - 1
  lock_rc:int = cmd_lock()
  if lock_rc != 0:
    say "publish: lock generation failed"
    ret 0 - 1
  registry_rc:int = cmd_registry()
  if registry_rc != 0:
    say "publish: registry metadata generation failed"
    ret 0 - 1
  say "publish: registry metadata ready"
  ret 0

fn cmd_verify() -> int:
  strict:int = 0
  ai:int = 1
  ucnt:int = user_args_count()
  while ai < ucnt:
    a0:str = arg(ai)
    if streq(a0, "--strict"):
      strict = 1
      ai = ai + 1
      continue
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_verify()
      ret 0
    if starts_with(a0, "--") != 0:
      p0:str = str_join2("verify: unknown option: ", a0)
      say p0
      free(p0)
      print_usage_verify()
      ret 0 - 1
    ai = ai + 1

  lock:str = io.read_all("tezz.lock")
  if lock == 0:
    say "missing tezz.lock"
    ret 0 - 1

  mod:str = io.read_all("tezz.mod")
  root:str = project_module_root(mod)
  bad:int = 0

  dep_names:[str;128]
  dep_vers:[str;128]
  dep_n:int = 0
  if mod != 0:
    i2:int = 0
    line2:int = 0
    while 1:
      c2:int = mod[i2] as int
      if c2 == 0 || c2 == 10:
        end2:int = i2
        s2:int = line2
        while s2 < end2 && (mod[s2] == 32 || mod[s2] == 9):
          s2 = s2 + 1
        if starts_with_at(mod, s2, "dep.") != 0:
          s2 = s2 + 4
          ns2:int = s2
          while s2 < end2 && mod[s2] != 32 && mod[s2] != 9 && mod[s2] != 61:
            s2 = s2 + 1
          ne2:int = s2
          while s2 < end2 && mod[s2] != 61:
            s2 = s2 + 1
          if s2 < end2 && mod[s2] == 61:
            s2 = s2 + 1
            while s2 < end2 && (mod[s2] == 32 || mod[s2] == 9):
              s2 = s2 + 1
            vs2:int = s2
            ve2:int = end2
            while ve2 > vs2 && (mod[ve2-1] == 32 || mod[ve2-1] == 9 || mod[ve2-1] == 13):
              ve2 = ve2 - 1
            if dep_n < 128:
              dep_names[dep_n] = substr_dup(mod, ns2, ne2)
              dep_vers[dep_n] = substr_dup(mod, vs2, ve2)
              dep_n = dep_n + 1
        if c2 == 0:
          break
        line2 = i2 + 1
      i2 = i2 + 1

  prov_base:str = 0 as str
  prov_base_norm:str = 0 as str
  prov_base_owned:int = 0
  prov_base_norm_owned:int = 0
  if strict != 0 && mod != 0:
    reglib0:str = mod_get_value(mod, "registry_lib")
    reglib_ok:int = 0
    if reglib0 != 0:
      if reglib0[0] != 0:
        reglib_ok = 1
    if reglib_ok != 0:
      prov_base = str_join2(reglib0, "")
      prov_base_owned = 1
    else:
      reg0:str = mod_get_value(mod, "registry")
      reg_ok:int = 0
      if reg0 != 0:
        if reg0[0] != 0:
          reg_ok = 1
      if reg_ok != 0:
        prov_base = url_dir(reg0)
        prov_base_owned = 1
      if reg0 != 0:
        free(reg0)
    if reglib0 != 0:
      free(reglib0)
    if prov_base == 0:
      prov_base = str_join2("https://tn.tezzcorp.com/lib/", "")
      prov_base_owned = 1
    prov_base_norm = prov_base
    if prov_base_norm != 0:
      bl:int = len(prov_base_norm)
      if bl > 0 && prov_base_norm[bl - 1] != 47:
        prov_base_norm = str_join2(prov_base_norm, "/")
        prov_base_norm_owned = 1

  lock_nv:[str;256]
  lock_n:int = 0
  prev_line:str = 0 as str
  payload:str = str_join2("", "")
  payload_n:int = 0
  meta_seen:int = 0
  meta_lines:int = 0 - 1
  meta_payload:str = 0 as str
  meta_key:str = 0 as str
  meta_sig:str = 0 as str

  i:int = 0
  line_start:int = 0
  while 1:
    c:int = lock[i] as int
    if c == 0 || c == 10:
      line_end:int = i
      if line_end > line_start:
        if lock[line_end - 1] == (13 as char):
          line_end = line_end - 1

      s:int = line_start
      while s < line_end && is_space(lock[s] as int) != 0:
        s = s + 1

      if s < line_end:
        line:str = substr_dup(lock, s, line_end)
        if line != 0 && line[0] != 0:
          if (line[0] as int) == 35:
            if strict != 0 && starts_with_at(line, 0, "# lock-meta v1 ") != 0:
              if meta_seen != 0:
                say "duplicate lock metadata line"
                bad = bad + 1
              else:
                mv_lines:str = meta_find_value(line, "lines=")
                mv_payload:str = meta_find_value(line, "payload=")
                mv_key:str = meta_find_value(line, "key=")
                mv_sig:str = meta_find_value(line, "sig=")
                if mv_key == 0:
                  mv_key = dup_lit("none")
                if mv_sig == 0:
                  mv_sig = dup_lit("none")
                if mv_lines == 0 || mv_payload == 0:
                  say "malformed lock metadata line"
                  bad = bad + 1
                  if mv_lines != 0:
                    free(mv_lines)
                  if mv_payload != 0:
                    free(mv_payload)
                  if mv_key != 0:
                    free(mv_key)
                  if mv_sig != 0:
                    free(mv_sig)
                else:
                  meta_seen = 1
                  meta_lines = parse_i64(mv_lines)
                  meta_payload = mv_payload
                  meta_key = mv_key
                  meta_sig = mv_sig
                  free(mv_lines)
          else:
            if strict != 0:
              cur_line:str = str_join2(line, "")
              if prev_line != 0 && strcmp(prev_line, cur_line) > 0:
                say "lock order violation:"
                say cur_line
                bad = bad + 1
              if prev_line != 0:
                free(prev_line)
              prev_line = cur_line

            a:int = 0
            while line[a] != 0 && is_space(line[a] as int) == 0:
              a = a + 1
            namever:str = substr_dup(line, 0, a)
            while line[a] != 0 && is_space(line[a] as int) != 0:
              a = a + 1
            b:int = a
            while line[b] != 0 && is_space(line[b] as int) == 0:
              b = b + 1
            checksum:str = substr_dup(line, a, b)
            while line[b] != 0 && is_space(line[b] as int) != 0:
              b = b + 1
            u:int = b
            while line[u] != 0 && is_space(line[u] as int) == 0:
              u = u + 1
            url:str = substr_dup(line, b, u)
            while line[u] != 0 && is_space(line[u] as int) != 0:
              u = u + 1

            malformed:int = 0
            if len(namever) == 0:
              malformed = 1
            if len(checksum) == 0:
              malformed = 1
            if len(url) == 0:
              malformed = 1
            if line[u] != 0:
              malformed = 1
            if malformed != 0:
              say "malformed lock entry:"
              say line
              bad = bad + 1
            else:
              namebuf:[char;128]
              verbuf:[char;64]
              at_i:int = 0
              has_at:int = 0
              while namever[at_i] != 0:
                if (namever[at_i] as int) == 64:
                  has_at = 1
                  break
                at_i = at_i + 1
              if has_at == 0 || at_i <= 0:
                say "invalid lock package token:"
                say namever
                bad = bad + 1
              else:
                ni:int = 0
                while ni < at_i && ni < 127:
                  namebuf[ni] = namever[ni]
                  ni = ni + 1
                namebuf[ni] = 0 as char
                vi:int = 0
                si:int = at_i + 1
                while namever[si] != 0 && vi < 63:
                  verbuf[vi] = namever[si]
                  vi = vi + 1
                  si = si + 1
                verbuf[vi] = 0 as char
                if verbuf[0] == 0:
                  say "invalid lock package token:"
                  say namever
                  bad = bad + 1
                else:
                  if strict != 0:
                    can1:str = str_join2(namever, " ")
                    can2:str = str_join2(can1, checksum)
                    can3:str = str_join2(can2, " ")
                    can4:str = str_join2(can3, url)
                    payload2:str = str_join3(payload, can4, "\n")
                    free(payload)
                    payload = payload2
                    payload_n = payload_n + 1
                    free(can1)
                    free(can2)
                    free(can3)
                    free(can4)

                    nvcopy:str = str_join2(namever, "")
                    dup:int = 0
                    k0:int = 0
                    while k0 < lock_n:
                      if streq(lock_nv[k0], nvcopy) != 0:
                        dup = 1
                        break
                      k0 = k0 + 1
                    if dup != 0:
                      say "duplicate lock entry:"
                      say namever
                      bad = bad + 1
                      free(nvcopy)
                    else:
                      if lock_n < 256:
                        lock_nv[lock_n] = nvcopy
                        lock_n = lock_n + 1
                      else:
                        say "lock entry limit exceeded (256)"
                        bad = bad + 1
                        free(nvcopy)

                    prov_ok:int = 0
                    if prov_base_norm != 0:
                      if prov_base_norm[0] != 0:
                        prov_ok = 1
                    if prov_ok != 0:
                      if starts_with(url, prov_base_norm) == 0:
                        say "lock provenance URL mismatch:"
                        say namever
                        bad = bad + 1

                  if is_hex8(checksum) == 0:
                    say "invalid checksum format (expected 8 hex chars):"
                    say namever
                    bad = bad + 1
                  else:
                    lib_path:str = dep_module_path(root, namebuf)
                    legacy_path:str = str_join3("lib/", namebuf, ".tn")
                    cache1:str = str_join3(".tezz/cache/", namebuf, "-")
                    cache2:str = str_join2(cache1, verbuf)
                    cache:str = str_join2(cache2, ".tn")

                    use_path:str = 0 as str
                    if path_exists(lib_path) != 0:
                      use_path = lib_path
                    else:
                      if path_exists(legacy_path) != 0:
                        use_path = legacy_path
                      else:
                        if path_exists(cache) != 0:
                          use_path = cache

                    if use_path == 0:
                      say "missing dependency file:"
                      say namever
                      bad = bad + 1
                    else:
                      want:int = parse_hex(checksum)
                      have:int = crc32_source_file(use_path)
                      if have != want:
                        say "checksum mismatch:"
                        say namever
                        bad = bad + 1

                    free(lib_path)
                    free(legacy_path)
                    free(cache1)
                    free(cache2)
                    free(cache)

            free(namever)
            free(checksum)
            free(url)
        if line != 0:
          free(line)

      if c == 0:
        break
      line_start = i + 1
    i = i + 1

  if prev_line != 0:
    free(prev_line)

  if strict != 0:
    i = 0
    while i < dep_n:
      found_dep:int = 0
      j:int = 0
      while j < lock_n:
        if line_is_dep(lock_nv[j], dep_names[i], dep_vers[i]) != 0:
          found_dep = 1
          break
        j = j + 1
      if found_dep == 0:
        nv0:str = str_join3(dep_names[i], "@", dep_vers[i])
        say "missing lock entry for dep:"
        say nv0
        free(nv0)
        bad = bad + 1
      i = i + 1

    i = 0
    while i < lock_n:
      found_lock:int = 0
      j:int = 0
      while j < dep_n:
        if line_is_dep(lock_nv[i], dep_names[j], dep_vers[j]) != 0:
          found_lock = 1
          break
        j = j + 1
      if found_lock == 0:
        say "stale lock entry (not in tezz.mod deps):"
        say lock_nv[i]
        bad = bad + 1
      i = i + 1

    if meta_seen == 0:
      if starts_with_at(lock, 0, "# lock-meta v1 ") != 0:
        meta_seen = 1
        if meta_lines < 0:
          meta_lines = payload_n
        if meta_payload == 0:
          meta_payload = hex8(crc32_str(payload))
        if meta_key == 0:
          meta_key = dup_lit("none")
        if meta_sig == 0:
          meta_sig = dup_lit("none")
    if meta_seen == 0:
      say "missing lock provenance metadata (run: tezz lock)"
      bad = bad + 1
    else:
      if meta_lines < 0:
        meta_lines = payload_n
      else:
        if meta_lines == 0 && payload_n > 0:
          meta_lines = payload_n
      if meta_lines != payload_n:
        say "lock metadata line count mismatch"
        bad = bad + 1
      payload_ok:int = 0
      if meta_payload != 0:
        if is_hex8(meta_payload) != 0:
          payload_ok = 1
      if payload_ok == 0:
        say "invalid lock metadata payload checksum"
        bad = bad + 1
      if meta_key == 0 || meta_sig == 0:
        say "invalid lock metadata signature fields"
        bad = bad + 1
      else:
        key_none:int = streq(meta_key, "none")
        sig_none:int = streq(meta_sig, "none")
        if meta_key[0] == 0 as char:
          key_none = 1
        if meta_sig[0] == 0 as char:
          sig_none = 1
        if (key_none != 0 && sig_none == 0) || (key_none == 0 && sig_none != 0):
          say "invalid lock metadata signature mode"
          bad = bad + 1
        if sig_none == 0:
          khex_ok:int = is_hex8(meta_key)
          shex_ok:int = is_hex8(meta_sig)
          if khex_ok == 0 || shex_ok == 0:
            say "invalid lock metadata signature hex"
            bad = bad + 1
          else:
            sign_key2:str = env_value("TEZZ_SIGN_KEY")
            sk_ok:int = 0
            if sign_key2 != 0:
              if sign_key2[0] != 0:
                sk_ok = 1
            if sk_ok == 0:
              say "missing TEZZ_SIGN_KEY for signed lock verification"
              bad = bad + 1
            else:
              key_id2:str = hex8(crc32_str(sign_key2))
              if streq(meta_key, key_id2) == 0:
                say "lock signature key_id mismatch"
                bad = bad + 1
              sig2:str = meta_signature_hex(meta_payload, payload_n, sign_key2)
              if streq(meta_sig, sig2) == 0:
                say "lock signature mismatch"
                bad = bad + 1
              free(key_id2)
              free(sig2)
            if sign_key2 != 0:
              free(sign_key2)
      if meta_payload != 0 && is_hex8(meta_payload) != 0:
        payload_hex2:str = hex8(crc32_str(payload))
        if streq(meta_payload, payload_hex2) == 0:
          say "lock payload checksum mismatch"
          bad = bad + 1
        free(payload_hex2)

  i = 0
  while i < lock_n:
    free(lock_nv[i])
    i = i + 1
  i = 0
  while i < dep_n:
    free(dep_names[i])
    free(dep_vers[i])
    i = i + 1
  if meta_payload != 0:
    free(meta_payload)
  if meta_key != 0:
    free(meta_key)
  if meta_sig != 0:
    free(meta_sig)
  if payload != 0:
    free(payload)
  if prov_base_norm_owned != 0 && prov_base_norm != 0:
    free(prov_base_norm)
  if prov_base_owned != 0 && prov_base != 0:
    free(prov_base)

  free(lock)
  if root != 0:
    free(root)
  if mod != 0:
    free(mod)

  if bad != 0:
    say "verify: FAILED"
    ret 0 - 1
  say "verify: OK"
  ret 0

fn default_platform() -> str:
  osn:str = os_name()
  if streq(osn, "windows"):
    ret "x86_64"
  if streq(osn, "linux"):
    ret "linux"
  if streq(osn, "macos"):
    ret "macos"
  ret "x86_64"

fn map_platform_arg(p:str) -> str:
  if p == 0:
    ret 0 as str
  if streq(p, "native"):
    ret default_platform()
  if streq(p, "windows") || streq(p, "win") || streq(p, "win64"):
    ret "x86_64"
  if streq(p, "linux") || streq(p, "gnu-linux"):
    ret "linux"
  if streq(p, "macos") || streq(p, "mac") || streq(p, "darwin") || streq(p, "osx"):
    ret "macos"
  if streq(p, "android"):
    ret "linux-arm64"
  if streq(p, "x64"):
    ret "x86_64"
  ret p

fn platform_supported(p:str) -> int:
  if p == 0 || p[0] == 0:
    ret 0
  if streq(p, "x86_64") || streq(p, "x86") || streq(p, "arm64"):
    ret 1
  if streq(p, "linux") || streq(p, "linux-arm64") || streq(p, "macos"):
    ret 1
  ret 0

fn startup_profile_emit() -> int:
  path:str = g_startup_profile_path
  lane:str = g_startup_profile_lane
  src_path:str = g_startup_profile_source
  platform:str = g_startup_profile_platform
  vectorize:int = g_startup_profile_vectorize
  pre_ms:int = g_startup_profile_pre_ms
  exec_ms:int = g_startup_profile_exec_ms
  total_ms:int = g_startup_profile_total_ms
  rc:int = g_startup_profile_rc
  if path == 0 || path[0] == 0:
    path = "build/startup_profile.tnx"
  ensure_dir("build")
  if path_exists(path) == 0:
    io.write_all(path, "ts_ms,lane,source,platform,vectorize,pre_ms,exec_ms,total_ms,rc\n")
  ts:str = int_to_str(time.now_ms())
  vz:str = int_to_str(vectorize)
  p0:str = int_to_str(pre_ms)
  p1:str = int_to_str(exec_ms)
  p2:str = int_to_str(total_ms)
  rc_s:str = int_to_str(rc)
  c0:str = str_join3(ts, ",", lane)
  c1:str = str_join3(c0, ",", src_path)
  c2:str = str_join3(c1, ",", platform)
  c3:str = str_join3(c2, ",", vz)
  c4:str = str_join3(c3, ",", p0)
  c5:str = str_join3(c4, ",", p1)
  c6:str = str_join3(c5, ",", p2)
  c7:str = str_join3(c6, ",", rc_s)
  append_line_file(path, c7)

  say "startup-profile:"
  m0:str = str_join3("  lane: ", lane, "")
  m1:str = str_join3("  source: ", src_path, "")
  m2:str = str_join3("  platform: ", platform, "")
  m3a:str = str_join3("  preflight_ms: ", p0, "")
  m3b:str = str_join3("  exec_ms: ", p1, "")
  m3c:str = str_join3("  total_ms: ", p2, "")
  m3d:str = str_join3("  rc: ", rc_s, "")
  m4:str = str_join3("  saved: ", path, "")
  say m0
  say m1
  say m2
  say m3a
  say m3b
  say m3c
  say m3d
  say m4

  free(ts)
  free(vz)
  free(p0)
  free(p1)
  free(p2)
  free(rc_s)
  free(c0)
  free(c1)
  free(c2)
  free(c3)
  free(c4)
  free(c5)
  free(c6)
  free(c7)
  free(m0)
  free(m1)
  free(m2)
  free(m3a)
  free(m3b)
  free(m3c)
  free(m3d)
  free(m4)
  ret 0

fn repl_has_assign_op(s:str) -> int:
  if s == 0:
    ret 0
  n:int = len(s)
  i:int = 0
  while i < n:
    c:int = s[i] as int
    if c == 61:
      prev:int = 0
      next:int = 0
      if i > 0:
        prev = s[i - 1] as int
      if (i + 1) < n:
        next = s[i + 1] as int
      if prev != 61 && prev != 33 && prev != 60 && prev != 62 && next != 61:
        ret 1
    if (i + 1) < n:
      c2:int = s[i + 1] as int
      if (c == 43 && c2 == 43) || (c == 45 && c2 == 45):
        ret 1
      if c2 == 61:
        if c == 43 || c == 45 || c == 42 || c == 47 || c == 37 || c == 38 || c == 124 || c == 94:
          ret 1
      if (i + 2) < n:
        c3:int = s[i + 2] as int
        if c == 60 && c2 == 60 && c3 == 61:
          ret 1
        if c == 62 && c2 == 62 && c3 == 61:
          ret 1
    i = i + 1
  ret 0

fn repl_trim(s:str) -> str:
  if s == 0:
    ret 0 as str
  // Keep REPL input byte-stable; read_line already strips trailing newline.
  ret str_join2("", s)

fn repl_is_expr(src:str) -> int:
  t:str = repl_trim(src)
  if t == 0:
    ret 0
  if len(t) == 0:
    free(t)
    ret 0
  if starts_with(t, "let ") || streq(t, "let"):
    free(t)
    ret 0
  if starts_with(t, "const let ") || streq(t, "const let"):
    free(t)
    ret 0
  if starts_with(t, "fn ") || starts_with(t, "struct ") || starts_with(t, "enum ") || starts_with(t, "typedef ") || starts_with(t, "import "):
    free(t)
    ret 0
  if starts_with(t, "if ") || starts_with(t, "while ") || starts_with(t, "for ") || starts_with(t, "switch ") || starts_with(t, "unsafe"):
    free(t)
    ret 0
  if starts_with(t, "extern ") || starts_with(t, "static ") || starts_with(t, "kernel "):
    free(t)
    ret 0
  if starts_with(t, "@"):
    free(t)
    ret 0
  if repl_has_assign_op(t) != 0:
    free(t)
    ret 0
  n:int = len(t)
  i:int = n - 1
  while i >= 0 && is_space(t[i] as int) != 0:
    i = i - 1
  if i >= 0 && t[i] == 58 as char:
    free(t)
    ret 0
  free(t)
  ret 1

fn repl_is_persistent(src:str, is_expr:int) -> int:
  if src == 0:
    ret 0
  if is_expr != 0:
    ret 0
  t:str = repl_trim(src)
  if t == 0:
    ret 0
  if starts_with(t, "import "):
    free(t)
    ret 1
  if starts_with(t, "let ") || starts_with(t, "const let "):
    free(t)
    ret 1
  if starts_with(t, "fn ") || starts_with(t, "struct ") || starts_with(t, "enum ") || starts_with(t, "typedef "):
    free(t)
    ret 1
  if repl_has_assign_op(t) != 0:
    free(t)
    ret 1
  free(t)
  ret 0

fn repl_needs_more(src:str) -> int:
  t:str = repl_trim(src)
  if t == 0:
    ret 0
  n:int = len(t)
  i:int = n - 1
  while i >= 0 && is_space(t[i] as int) != 0:
    i = i - 1
  if i >= 0 && t[i] == 58 as char:
    free(t)
    ret 1
  free(t)
  ret 0

fn repl_read_prompt(prompt:str, in_h:*char, out_h:*char) -> str:
  out:*char = out_h
  if out == 0:
    out = stdout()
  if out != 0:
    fwrite(prompt, 1, len(prompt), out)
    fflush(out)
  src:*char = in_h
  if src == 0:
    src = stdin()
  line:str = read_line(src)
  if line == 0:
    ret 0 as str
  // read_line may yield "" at EOF on non-interactive stdin.
  if streq(line, "") && io_eof(src) != 0:
    ret 0 as str
  ret line

fn cmd_repl() -> int:
  lang_mode:str = "systems"
  if user_args_count() >= 2:
    ai_mode:int = 1
    while ai_mode < user_args_count():
      a0:str = arg(ai_mode)
      if streq(a0, "--help") || streq(a0, "-h"):
        ret print_usage_repl()
      if streq(a0, "--mode") && (ai_mode + 1) < user_args_count():
        lang_mode = arg(ai_mode + 1)
        ai_mode = ai_mode + 2
        continue
      if starts_with(a0, "--mode=") != 0:
        lang_mode = a0 + 7
        ai_mode = ai_mode + 1
        continue
      if starts_with(a0, "--") != 0:
        p_bad_repl:str = str_join2("repl: unknown option: ", a0)
        say p_bad_repl
        free(p_bad_repl)
        ret 0 - 1
      ai_mode = ai_mode + 1
  if streq(lang_mode, "simple") == 0 && streq(lang_mode, "systems") == 0:
    say "repl: --mode must be simple or systems"
    ret 0 - 1

  tezzc:str = tezzc_path()
  if tezzc == 0:
    say "repl: compiler not found"
    ret 0 - 1
  unlock_empty_lock_file()
  relax_stale_std_lock()
  if ensure_std_module_available() == 0:
    say "tezz: failed to resolve std module (sdk/cache/registry fallback)"
    say "hint: run `tezz get std@0.1.0` or `tezz doctor --fix`"
    ret 0 - 1
  ensure_dir("build")
  tmp_path:str = "build/tezz_repl_eval.tn"
  qtmp:str = quote_cmd_path(tmp_path)
  ensure_dir(".tezz")
  ensure_dir(".tezz/cache")
  ensure_dir(".tezz/cache/repl")
  repl_platform:str = default_platform()
  repl_os:str = os_name()
  repl_exe_suffix:str = ""
  if streq(repl_os, "windows"):
    repl_exe_suffix = ".exe"
  tezzc_fs_path:str = strip_outer_quotes(tezzc)
  repl_tool_crc:int = crc32_file(tezzc_fs_path)
  repl_tool_hex:str = hex8(repl_tool_crc)
  if tezzc_fs_path != 0:
    free(tezzc_fs_path)
  in_h:*char = stdin()
  out_h:*char = stdout()
  own_in:int = 0
  own_out:int = 0
  osn:str = os_name()
  if streq(osn, "windows") == 0:
    tty_in:*char = fopen("/dev/tty", "r")
    if tty_in != 0:
      in_h = tty_in
      own_in = 1
    tty_out:*char = fopen("/dev/tty", "w")
    if tty_out != 0:
      out_h = tty_out
      own_out = 1

  state:str = str_join2("", "")
  say "TezzNative REPL"
  mode_msg0:str = str_join3("mode: ", lang_mode, "")
  say mode_msg0
  free(mode_msg0)
  say "type .help for commands"

  while 1:
    line:str = repl_read_prompt("tezz> ", in_h, out_h)
    if line == 0:
      break
    trim:str = repl_trim(line)
    if trim == 0 || len(trim) == 0:
      if trim != 0:
        free(trim)
      free(line)
      continue
    if strcmp(trim, ".quit") == 0 || strcmp(trim, ".exit") == 0:
      free(trim)
      free(line)
      break
    if strcmp(trim, ".help") == 0:
      say ".help  show commands"
      say ".reset reset REPL state"
      say ".state show persisted state size"
      say ".quit  exit REPL"
      free(trim)
      free(line)
      continue
    if strcmp(trim, ".reset") == 0:
      free(state)
      state = str_join2("", "")
      say "state reset"
      free(trim)
      free(line)
      continue
    if strcmp(trim, ".state") == 0:
      nstate:str = int_to_str(len(state))
      msg_state:str = str_join3("state_bytes=", nstate, "")
      say msg_state
      free(nstate)
      free(msg_state)
      free(trim)
      free(line)
      continue

    chunk:str = line
    if repl_needs_more(trim) != 0:
      while 1:
        next_line:str = repl_read_prompt("... ", in_h, out_h)
        if next_line == 0:
          break
        if len(next_line) == 0:
          free(next_line)
          break
        p0:str = str_join2(chunk, "\n")
        p1:str = str_join2(p0, next_line)
        free(p0)
        free(chunk)
        free(next_line)
        chunk = p1
      free(trim)
      trim = repl_trim(chunk)
      if trim == 0 || len(trim) == 0:
        if trim != 0:
          free(trim)
        free(chunk)
        continue
    if streq(lang_mode, "simple") != 0:
      reason_repl:str = simple_mode_disallow_reason(chunk)
      if reason_repl != 0:
        p_simple_err0:str = str_join3("simple-mode error: ", reason_repl, "")
        say p_simple_err0
        free(reason_repl)
        free(p_simple_err0)
        free(chunk)
        free(trim)
        continue

    is_expr:int = repl_is_expr(chunk)
    eval_src:str = 0 as str
    if is_expr != 0:
      e0:str = str_join3("say(", chunk, ")")
      eval_src = str_join2(e0, "\n")
      free(e0)
    else:
      eval_src = str_join2(chunk, "\n")

    block0:str = str_join2("  ", eval_src)
    body:str = str_join2(state, block0)
    main0:str = str_join2("fn main() -> int:\n", body)
    main1:str = str_join2(main0, "  ret 0\n")
    candidate:str = str_join2("import \"std\"\n", main1)
    io.write_all(tmp_path, candidate)

    use_bc_repl:int = 0
    if str_contains(candidate, "input(") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "ws_") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "_sha1_bytes(") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "_base64_encode(") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "import \"net\"") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "import \"io\"") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "net.") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "io.") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "args_count(") != 0:
      use_bc_repl = 1
    if use_bc_repl == 0 && str_contains(candidate, "arg(") != 0:
      use_bc_repl = 1

    rc:int = 0
    if use_bc_repl == 0:
      repl_src_hex:str = hex8(crc32_str(candidate))
      rk0:str = str_join3("repl-", lang_mode, "-")
      rk1:str = str_join3(rk0, repl_platform, "-")
      rk2:str = str_join3(rk1, repl_src_hex, "-")
      rk3:str = str_join2(rk2, repl_tool_hex)
      rk4:str = str_join2(rk3, repl_exe_suffix)
      repl_cache_exe:str = path_join(".tezz/cache/repl", rk4)
      q_repl_cache_exe:str = quote_cmd_path(repl_cache_exe)
      run_native_repl:int = 1
      if path_exists(repl_cache_exe) == 0:
        rb0:str = str_join3(tezzc, " buildexe ", qtmp)
        rb1:str = str_join3(rb0, " ", q_repl_cache_exe)
        rb2:str = str_join3(rb1, " --target ", repl_platform)
        rb3:str = str_join2(rb2, " --vectorize")
        if run_to_file(rb3, "build/repl_cache_build.log") != 0:
          run_native_repl = 0
        free(rb0)
        free(rb1)
        free(rb2)
        free(rb3)
      if run_native_repl != 0:
        rc = proc_run(q_repl_cache_exe)
      else:
        cmd0:str = str_join3(tezzc, " run --bc ", qtmp)
        rc = proc_run(cmd0)
        free(cmd0)
      free(repl_src_hex)
      free(rk0)
      free(rk1)
      free(rk2)
      free(rk3)
      free(rk4)
      free(repl_cache_exe)
      free(q_repl_cache_exe)
    else:
      cmd0:str = str_join3(tezzc, " run --bc ", qtmp)
      rc = proc_run(cmd0)
      free(cmd0)
    if rc == 0:
      if repl_is_persistent(chunk, is_expr) != 0:
        p0:str = str_join2("  ", chunk)
        p1:str = str_join2(p0, "\n")
        s1:str = str_join2(state, p1)
        free(p0)
        free(p1)
        free(state)
        state = s1

    free(block0)
    free(body)
    free(main0)
    free(main1)
    free(candidate)
    free(eval_src)
    free(chunk)
    free(trim)
  if own_in != 0 && in_h != 0:
    fclose(in_h)
  if own_out != 0 && out_h != 0:
    fclose(out_h)
  free(state)
  free(repl_tool_hex)
  free(qtmp)
  ret 0

fn cmd_run_path(path:str) -> int:
  if path == 0:
    ret 0 - 1
  tezzc:str = tezzc_path()
  if tezzc == 0:
    ret 0 - 1
  ensure_dir("build")
  run_start_ms:int = time.now_ms()
  unlock_empty_lock_file()
  relax_stale_std_lock()
  if ensure_std_module_available() == 0:
    say "tezz: failed to resolve std module (sdk/cache/registry fallback)"
    say "hint: run `tezz get std@0.1.0` or `tezz doctor --fix`"
    ret 0 - 1
  // Parse run options + passthrough app args.
  vectorize:int = 1
  platform:str = 0 as str
  startup_profile:int = 0
  startup_profile_out:str = 0 as str
  lang_mode:str = "systems"
  passthrough:str = 0 as str
  pass_all:int = 0
  ai:int = 1
  if args_count() > 0 && streq(arg(0), "run"):
    ai = 2
  while ai < args_count():
    a:str = arg(ai)
    if pass_all != 0:
      qarg_pa:str = quote_cmd_path(a)
      if passthrough == 0:
        passthrough = str_join2(" ", qarg_pa)
      else:
        p0_pa:str = str_join2(passthrough, " ")
        p1_pa:str = str_join2(p0_pa, qarg_pa)
        free(passthrough)
        free(p0_pa)
        passthrough = p1_pa
      free(qarg_pa)
      ai = ai + 1
      continue
    if streq(a, "--"):
      pass_all = 1
      ai = ai + 1
      continue
    if streq(a, "--target") && (ai + 1) < args_count():
      platform = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--target=") != 0:
      platform = a + 9
      ai = ai + 1
      continue
    if streq(a, "--platform") && (ai + 1) < args_count():
      platform = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--platform=") != 0:
      platform = a + 11
      ai = ai + 1
      continue
    if streq(a, "--startup-profile") || streq(a, "--profile-startup"):
      startup_profile = 1
      ai = ai + 1
      continue
    if streq(a, "--mode") && (ai + 1) < args_count():
      lang_mode = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--mode=") != 0:
      lang_mode = a + 7
      ai = ai + 1
      continue
    if streq(a, "--startup-profile-out"):
      if (ai + 1) >= args_count():
        say "tezz run: --startup-profile-out requires <path>"
        if passthrough != 0:
          free(passthrough)
        ret 0 - 1
      startup_profile = 1
      startup_profile_out = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--startup-profile-out=") != 0:
      startup_profile = 1
      startup_profile_out = a + 22
      ai = ai + 1
      continue
    if streq(a, "--no-vectorize"):
      vectorize = 0
      ai = ai + 1
      continue
    if streq(a, "--vectorize"):
      vectorize = 1
      ai = ai + 1
      continue
    // Unknown arg: pass through to program.
    qarg:str = quote_cmd_path(a)
    if passthrough == 0:
      passthrough = str_join2(" ", qarg)
    else:
      p0:str = str_join2(passthrough, " ")
      p1:str = str_join2(p0, qarg)
      free(passthrough)
      free(p0)
      passthrough = p1
    free(qarg)
    ai = ai + 1

  if streq(lang_mode, "simple") == 0 && streq(lang_mode, "systems") == 0:
    say "tezz run: --mode must be simple or systems"
    if passthrough != 0:
      free(passthrough)
    ret 0 - 1

  run_path:str = path
  compat_path:str = compat_rewrite_input_mode(path)
  simple_path:str = 0 as str
  if compat_path != 0:
    run_path = compat_path
  if path_exists(run_path) == 0:
    p_nf0:str = str_join2("tezz: file not found: ", run_path)
    say p_nf0
    free(p_nf0)
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    ret 0 - 1
  src_in:str = io.read_all(run_path)
  if src_in != 0:
    if streq(lang_mode, "simple") != 0:
      reason_simple:str = simple_mode_disallow_reason(src_in)
      if reason_simple != 0:
        p_simple0:str = str_join3("simple-mode error: ", reason_simple, "")
        say p_simple0
        say "hint: remove unsafe/pointer APIs or run with --mode systems"
        free(reason_simple)
        free(p_simple0)
        free(src_in)
        if passthrough != 0:
          free(passthrough)
        if compat_path != 0:
          remove(compat_path)
          free(compat_path)
        ret 0 - 1
      src_simple:str = simple_mode_transform(src_in)
      if src_simple == 0:
        say "simple-mode error: failed to rewrite source"
        free(src_in)
        if passthrough != 0:
          free(passthrough)
        if compat_path != 0:
          remove(compat_path)
          free(compat_path)
        ret 0 - 1
      simple_path = str_join2(run_path, ".simple.tn")
      if io.write_all(simple_path, src_simple) < 0:
        say "simple-mode error: failed to write rewritten source"
        free(src_simple)
        free(src_in)
        free(simple_path)
        if passthrough != 0:
          free(passthrough)
        if compat_path != 0:
          remove(compat_path)
          free(compat_path)
        ret 0 - 1
      free(src_simple)
      free(src_in)
      run_path = simple_path
      src_in = io.read_all(run_path)
      if src_in == 0:
        say "simple-mode error: failed to reload rewritten source"
        if passthrough != 0:
          free(passthrough)
        if compat_path != 0:
          remove(compat_path)
          free(compat_path)
        if simple_path != 0:
          remove(simple_path)
          free(simple_path)
        ret 0 - 1
    need_bc:int = 0
    if str_contains(src_in, "input(") != 0:
      need_bc = 1
    // Temporary correctness gate:
    // WebSocket/SHA1-heavy flows run via VM path until native backend parity catches up.
    if need_bc == 0 && str_contains(src_in, "ws_") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "_sha1_bytes(") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "_base64_encode(") != 0:
      need_bc = 1
    // Networking correctness gate:
    // Net/http parser-heavy flows still use VM path until native parity is fully stable.
    if need_bc == 0 && str_contains(src_in, "import \"net\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"io\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "net.") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "io.") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "http_") != 0 && str_contains(src_in, "import \"std\"") != 0:
      need_bc = 1
    // GUI host-window lane currently runs through BC runtime backend.
    if need_bc == 0 && str_contains(src_in, "import \"gui\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"tzgui\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"tzui\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"wm\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"tnui\"") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "import \"os\"") != 0:
      need_bc = 1
    // CLI args parity gate:
    // args_count/arg are VM-stable across platforms; force bytecode lane until
    // native argv parity is fully stable on non-Windows hosts.
    if need_bc == 0 && str_contains(src_in, "args_count(") != 0:
      need_bc = 1
    if need_bc == 0 && str_contains(src_in, "arg(") != 0:
      need_bc = 1
    if need_bc != 0:
      free(src_in)
      cmd_bc0:str = str_join3(tezzc, " run --bc ", run_path)
      cmd_bc_run:str = cmd_bc0
      cmd_bc1:str = 0 as str
      cmd_bc2:str = 0 as str
      if passthrough != 0 && len(passthrough) > 0:
        cmd_bc1 = str_join2(cmd_bc0, " --")
        cmd_bc2 = str_join2(cmd_bc1, passthrough)
        cmd_bc_run = cmd_bc2
      exec_start_ms:int = time.now_ms()
      rb0:int = proc_run(cmd_bc_run)
      done_ms:int = time.now_ms()
      pre_ms:int = exec_start_ms - run_start_ms
      exec_ms:int = done_ms - exec_start_ms
      total_ms:int = done_ms - run_start_ms
      if startup_profile != 0:
        g_startup_profile_path = startup_profile_out
        g_startup_profile_lane = "bc"
        g_startup_profile_source = run_path
        g_startup_profile_platform = "bytecode"
        g_startup_profile_vectorize = 0
        g_startup_profile_pre_ms = pre_ms
        g_startup_profile_exec_ms = exec_ms
        g_startup_profile_total_ms = total_ms
        g_startup_profile_rc = rb0
        startup_profile_emit()
      if cmd_bc1 != 0:
        free(cmd_bc1)
      if cmd_bc2 != 0:
        free(cmd_bc2)
      free(cmd_bc0)
      if passthrough != 0:
        free(passthrough)
      if compat_path != 0:
        remove(compat_path)
        free(compat_path)
      if simple_path != 0:
        remove(simple_path)
        free(simple_path)
      ret rb0
    free(src_in)
  // Default to native + vectorize for production speed; --bc still available explicitly.
  if platform == 0:
    platform = default_platform()
  platform = map_platform_arg(platform)
  if platform_supported(platform) == 0:
    say "run: unsupported platform target"
    say "supported targets: linux|windows|macos|android|native"
    if passthrough != 0:
      free(passthrough)
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    if simple_path != 0:
      remove(simple_path)
      free(simple_path)
    ret 0 - 1
  // Native cache key: source + toolchain + mode + target + vectorize.
  osn_native:str = os_name()
  exe_suffix_native:str = ""
  if streq(osn_native, "windows"):
    exe_suffix_native = ".exe"
  ensure_dir(".tezz")
  ensure_dir(".tezz/cache")
  ensure_dir(".tezz/cache/run")
  src_crc:int = crc32_file(run_path)
  tezzc_fs_path2:str = strip_outer_quotes(tezzc)
  tool_crc:int = crc32_file(tezzc_fs_path2)
  if tezzc_fs_path2 != 0:
    free(tezzc_fs_path2)
  src_hex:str = hex8(src_crc)
  tool_hex:str = hex8(tool_crc)
  vec_s:str = int_to_str(vectorize)
  base_name:str = path_basename_no_ext(run_path)
  if base_name == 0 || base_name[0] == 0:
    if base_name != 0:
      free(base_name)
    base_name = str_join2("script", "")
  ck0:str = str_join3(base_name, "-", lang_mode)
  ck1:str = str_join3(ck0, "-", platform)
  ck2:str = str_join3(ck1, "-v", vec_s)
  ck3:str = str_join3(ck2, "-", src_hex)
  ck4:str = str_join3(ck3, "-", tool_hex)
  cache_file:str = str_join2(ck4, exe_suffix_native)
  cache_exe:str = path_join(".tezz/cache/run", cache_file)
  q_cache_exe:str = quote_cmd_path(cache_exe)
  cache_hit:int = 0
  use_fallback_native:int = 0
  if path_exists(cache_exe) != 0:
    cache_hit = 1
  else:
    q_run_path:str = quote_cmd_path(run_path)
    b0:str = str_join3(tezzc, " buildexe ", q_run_path)
    b1:str = str_join3(b0, " ", q_cache_exe)
    b2:str = str_join3(b1, " --target ", platform)
    b3:str = 0 as str
    if vectorize != 0:
      b3 = str_join2(b2, " --vectorize")
    else:
      b3 = str_join2(b2, " --no-vectorize")
    if run_to_file(b3, "build/native_cache_build.log") != 0:
      use_fallback_native = 1
    free(q_run_path)
    free(b0)
    free(b1)
    free(b2)
    free(b3)
  lane_native:str = "native-cache-hit"
  if cache_hit == 0:
    lane_native = "native-cache-miss"
  exec_start_ms_native:int = time.now_ms()
  r:int = 0
  if use_fallback_native == 0:
    cmd_run_native:str = q_cache_exe
    cmd_cache_args:str = 0 as str
    if passthrough != 0 && len(passthrough) > 0:
      cmd_cache_args = str_join2(q_cache_exe, passthrough)
      cmd_run_native = cmd_cache_args
    if streq(osn_native, "windows"):
      fixed_cmd:str = win_fix_cmd_slash(cmd_run_native)
      r = proc_run(fixed_cmd)
      free(fixed_cmd)
    else:
      r = proc_run(cmd_run_native)
    if cmd_cache_args != 0:
      free(cmd_cache_args)
  else:
    lane_native = "native"
    cmd0:str = str_join3(tezzc, " run --native --target ", platform)
    cmd0b:str = 0 as str
    cmd1:str = 0 as str
    if vectorize != 0:
      cmd0b = str_join2(cmd0, " --vectorize ")
    else:
      cmd0b = str_join2(cmd0, " --no-vectorize ")
    cmd1 = str_join2(cmd0b, run_path)
    cmd_run:str = cmd1
    cmd2:str = 0 as str
    cmd3:str = 0 as str
    if passthrough != 0 && len(passthrough) > 0:
      cmd2 = str_join2(cmd1, " --")
      cmd3 = str_join2(cmd2, passthrough)
      cmd_run = cmd3
    r = proc_run(cmd_run)
    free(cmd0)
    free(cmd0b)
    free(cmd1)
    if cmd2 != 0:
      free(cmd2)
    if cmd3 != 0:
      free(cmd3)
  done_ms_native:int = time.now_ms()
  pre_ms_native:int = exec_start_ms_native - run_start_ms
  exec_ms_native:int = done_ms_native - exec_start_ms_native
  total_ms_native:int = done_ms_native - run_start_ms
  if startup_profile != 0:
    g_startup_profile_path = startup_profile_out
    g_startup_profile_lane = lane_native
    g_startup_profile_source = run_path
    g_startup_profile_platform = platform
    g_startup_profile_vectorize = vectorize
    g_startup_profile_pre_ms = pre_ms_native
    g_startup_profile_exec_ms = exec_ms_native
    g_startup_profile_total_ms = total_ms_native
    g_startup_profile_rc = r
    startup_profile_emit()
  free(src_hex)
  free(tool_hex)
  free(vec_s)
  free(base_name)
  free(ck0)
  free(ck1)
  free(ck2)
  free(ck3)
  free(ck4)
  free(cache_file)
  free(cache_exe)
  free(q_cache_exe)
  if passthrough != 0:
    free(passthrough)
  if compat_path != 0:
    remove(compat_path)
    free(compat_path)
  if simple_path != 0:
    remove(simple_path)
    free(simple_path)
  ret r

fn cmd_build_path(path:str) -> int:
  if path == 0:
    ret 0 - 1
  ensure_dir("build")
  unlock_empty_lock_file()
  relax_stale_std_lock()
  if ensure_std_module_available() == 0:
    say "tezz: failed to resolve std module (sdk/cache/registry fallback)"
    say "hint: run `tezz get std@0.1.0` or `tezz doctor --fix`"
    ret 0 - 1
  build_path:str = path
  compat_path:str = compat_rewrite_input_mode(path)
  if compat_path != 0:
    build_path = compat_path
  if path_exists(build_path) == 0:
    p_bnf0:str = str_join2("tezz: file not found: ", build_path)
    say p_bnf0
    free(p_bnf0)
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    ret 0 - 1
  // optional platform override
  platform:str = 0 as str
  vectorize:int = 1
  release_mode:int = 0
  dxil:int = 0
  dxil_entry:str = 0 as str
  dxc_path:str = 0 as str
  dxc_set:int = 0
  ai:int = 1
  while ai < args_count():
    a:str = arg(ai)
    if streq(a, "--platform") && (ai + 1) < args_count():
      platform = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--platform=") != 0:
      platform = a + 11
      ai = ai + 1
      continue
    if streq(a, "--dxil"):
      dxil = 1
      ai = ai + 1
      continue
    if streq(a, "--vectorize"):
      vectorize = 1
      ai = ai + 1
      continue
    if streq(a, "--no-vectorize"):
      vectorize = 0
      ai = ai + 1
      continue
    if streq(a, "--release"):
      release_mode = 1
      vectorize = 1
      ai = ai + 1
      continue
    if streq(a, "--dxil-entry") && (ai + 1) < args_count():
      dxil_entry = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--dxil-entry=") != 0:
      dxil_entry = a + 13
      ai = ai + 1
      continue
    if streq(a, "--dxc") && (ai + 1) < args_count():
      dxc_path = arg(ai + 1)
      dxc_set = 1
      ai = ai + 2
      continue
    if starts_with(a, "--dxc=") != 0:
      dxc_path = a + 6
      dxc_set = 1
      ai = ai + 1
      continue
    ai = ai + 1
  if platform == 0:
    platform = default_platform()
  platform = map_platform_arg(platform)
  if platform_supported(platform) == 0:
    say "build: unsupported platform target"
    say "supported targets: linux|windows|macos|android|native"
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    ret 0 - 1
  base:str = path_basename_no_ext(build_path)
  if base == 0:
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    ret 0 - 1
  osn:str = os_name()
  exe_suffix:str = ""
  out_dir:str = "build/"
  if streq(osn, "windows"):
    out_dir = ".\\build\\"
  if streq(platform, "x86_64") || streq(platform, "x86") || streq(platform, "arm64"):
    exe_suffix = ".exe"

  out1:str = str_join2(out_dir, base)
  out2:str = str_join2(out1, exe_suffix)
  tezzc:str = tezzc_path()
  if tezzc == 0:
    free(base)
    free(out1)
    free(out2)
    if compat_path != 0:
      remove(compat_path)
      free(compat_path)
    ret 0 - 1
  cmd1:str = str_join3(tezzc, " buildexe ", build_path)
  cmd2:str = str_join3(cmd1, " ", out2)
  cmd3a:str = str_join3(cmd2, " --target ", platform)
  cmd3:str = 0 as str
  if vectorize != 0:
    cmd3 = str_join2(cmd3a, " --verify --vectorize")
  else:
    cmd3 = str_join2(cmd3a, " --verify --no-vectorize")
  r:int = proc_run(cmd3)
  if release_mode != 0 && r == 0:
    if path_exists("tezz.mod") != 0:
      if cmd_lock() != 0:
        say "build --release: lock generation failed"
        r = 0 - 1

  // Optional DXIL build for HLSL kernels (auto if kernel fn detected)
  do_dxil:int = dxil
  if do_dxil == 0:
    if has_kernel_fn(build_path) != 0:
      do_dxil = 1
  if do_dxil != 0:
    if dxc_path == 0:
      dxc_path = "dxc"
    has_dxc:int = 1
    if dxc_set == 0 && dxc_available() == 0:
      has_dxc = 0
    if has_dxc == 0:
      if dxil != 0:
        say "dxc not found"
        r = 0 - 1
      else:
        do_dxil = 0
    if do_dxil != 0:
      hlsl_out1:str = str_join2(out_dir, base)
      hlsl_out:str = str_join2(hlsl_out1, ".hlsl")
      cmd_h1:str = str_join3(tezzc, " buildir ", build_path)
      cmd_h2:str = str_join3(cmd_h1, " ", hlsl_out)
      cmd_h3:str = str_join2(cmd_h2, " --target hlsl")
      rh:int = proc_run(cmd_h3)
      if rh != 0:
        r = 0 - 1
      else:
        entries:str = 0 as str
        if dxil_entry != 0:
          entries = str_join2(dxil_entry, "\n")
        else:
          entries = hlsl_collect_entries(hlsl_out)
        if entries == 0:
          say "dxil entry not found"
          r = 0 - 1
        else:
          // count entries
          cnt:int = 0
          idxe:int = 0
          map:str = str_join2("{\"schema\":\"dxil_map\",\"version\":1}\n", "")
          while 1:
            ent0:str = next_manifest_line(entries, &idxe)
            if ent0 == 0:
              break
            cnt = cnt + 1
            free(ent0)
          idxe = 0
          first:int = 1
          while 1:
            ent:str = next_manifest_line(entries, &idxe)
            if ent == 0:
              break
            out_name:str = 0 as str
            if cnt <= 1:
              dxil_out1:str = str_join2(out_dir, base)
              out_name = str_join2(dxil_out1, ".dxil")
              free(dxil_out1)
            else:
              if first != 0:
                dxil_out1a:str = str_join2(out_dir, base)
                out_name = str_join2(dxil_out1a, ".dxil")
                free(dxil_out1a)
              else:
                safe:str = sanitize_name(ent)
                dxil_out1b:str = str_join2(out_dir, base)
                dxil_out2b:str = str_join3(dxil_out1b, "_", safe)
                out_name = str_join2(dxil_out2b, ".dxil")
                free(dxil_out1b)
                free(dxil_out2b)
                free(safe)
            cmd_d1:str = str_join3(dxc_path, " -T cs_6_6 -HV 2021 -E ", ent)
            cmd_d2:str = str_join3(cmd_d1, " -Fo ", out_name)
            cmd_d3:str = str_join3(cmd_d2, " ", hlsl_out)
            if streq(osn, "windows") != 0:
              tmpd:str = win_fix_cmd_slash(cmd_d3)
              free(cmd_d3)
              cmd_d3 = tmpd
            if proc_run(cmd_d3) != 0:
              r = 0 - 1
            // update map
            line1:str = str_join3("{\"kernel\":\"", ent, "\",\"dxil\":\"")
            line2:str = str_join3(line1, out_name, "\",\"threads\":[1,1,1],\"kind\":\"kernel\"}")
            line3:str = str_join2(line2, "\n")
            tmpm:str = str_join2(map, line3)
            free(map)
            map = tmpm
            free(line1)
            free(line2)
            free(line3)
            free(cmd_d1)
            free(cmd_d2)
            free(cmd_d3)
            free(out_name)
            free(ent)
            first = 0
          // write map
          if map != 0:
            map1:str = str_join2(out_dir, base)
            map2:str = str_join2(map1, "_dxil_map.tnx")
            io.write_all(map2, map)
            free(map1)
            free(map2)
            free(map)
          free(entries)
      free(hlsl_out1)
      free(hlsl_out)
      free(cmd_h1)
      free(cmd_h2)
      free(cmd_h3)

  free(base)
  free(out1)
  free(out2)
  free(cmd1)
  free(cmd2)
  free(cmd3a)
  free(cmd3)
  if compat_path != 0:
    remove(compat_path)
    free(compat_path)
  ret r

fn boot_iso_path(mode:str) -> str:
  if mode != 0:
    free(mode)
  ret ""

fn cmd_boot_verify(mode:str) -> int:
  if mode != 0:
    free(mode)
  say "boot verify is not available in tezz core CLI"
  ret 0 - 1

fn boot_native_check(mode:str, iso:int) -> int:
  if mode != 0:
    free(mode)
  if iso != 0:
    ret 0 - 1
  ret 0 - 1

fn cmd_boot_native(mode:str, kpath:str, iso:int, verify:int, boot_vbe:int) -> int:
  if mode != 0:
    free(mode)
  if kpath != 0:
    free(kpath)
  if iso != 0:
    verify = verify + 0
  if boot_vbe != 0:
    verify = verify + 0
  say "boot native is not available in tezz core CLI"
  ret 0 - 1

fn cmd_boot() -> int:
  say "tezz boot is not available in tezz core CLI"
  ret 0 - 1

fn resolve_run_path_arg() -> str:
  ucnt:int = user_args_count()
  ai:int = 1
  while ai < ucnt:
    a:str = arg(ai)
    if streq(a, "--"):
      if (ai + 1) < ucnt:
        ret arg(ai + 1)
      ret 0 as str
    if streq(a, "--platform") || streq(a, "--target") || streq(a, "--startup-profile-out") || streq(a, "--mode"):
      ai = ai + 2
      continue
    if starts_with(a, "--platform=") != 0 || starts_with(a, "--target=") != 0 || starts_with(a, "--startup-profile-out=") != 0 || starts_with(a, "--mode=") != 0:
      ai = ai + 1
      continue
    if streq(a, "--vectorize") || streq(a, "--no-vectorize") || streq(a, "--startup-profile") || streq(a, "--profile-startup"):
      ai = ai + 1
      continue
    if starts_with(a, "--") != 0:
      ai = ai + 1
      continue
    ret a
  ret 0 as str

fn resolve_build_path_arg() -> str:
  ucnt:int = user_args_count()
  ai:int = 1
  while ai < ucnt:
    a:str = arg(ai)
    if streq(a, "--"):
      if (ai + 1) < ucnt:
        ret arg(ai + 1)
      ret 0 as str
    if streq(a, "--platform") || streq(a, "--target") || streq(a, "--dxil-entry") || streq(a, "--dxc"):
      ai = ai + 2
      continue
    if starts_with(a, "--platform=") != 0 || starts_with(a, "--target=") != 0 || starts_with(a, "--dxil-entry=") != 0 || starts_with(a, "--dxc=") != 0:
      ai = ai + 1
      continue
    if streq(a, "--release") || streq(a, "--vectorize") || streq(a, "--no-vectorize") || streq(a, "--dxil"):
      ai = ai + 1
      continue
    if starts_with(a, "--") != 0:
      ai = ai + 1
      continue
    ret a
  ret 0 as str

fn main() -> int:
  ucnt:int = user_args_count()
  if ucnt == 0:
    print_usage()
    ret 0

  cmd:str = arg(0)
  if streq(cmd, "--version") || streq(cmd, "-V") || streq(cmd, "version"):
    ret cmd_version()
  if streq(cmd, "--help") || streq(cmd, "-h") || streq(cmd, "help"):
    print_usage()
    ret 0
  if ucnt >= 2:
    a1:str = arg(1)
    if streq(a1, "--help") || streq(a1, "-h"):
      if streq(cmd, "init"):
        ret print_usage_init()
      if streq(cmd, "add"):
        say "tezz add <name@ver> [url] [checksum]"
        ret 0
      if streq(cmd, "remove"):
        say "tezz remove <name>"
        ret 0
      if streq(cmd, "run"):
        ret print_usage_run()
      if streq(cmd, "repl"):
        ret print_usage_repl()
      if streq(cmd, "build"):
        ret print_usage_build()
      if streq(cmd, "test"):
        ret print_usage_test()
      if streq(cmd, "doctor"):
        ret print_usage_doctor()
      if streq(cmd, "update"):
        ret print_usage_update()
      if streq(cmd, "fmt"):
        ret print_usage_fmt()
      if streq(cmd, "lint"):
        ret print_usage_lint()
      if streq(cmd, "verify"):
        ret print_usage_verify()
      if streq(cmd, "lsp"):
        ret print_usage_lsp()
      if streq(cmd, "ai"):
        ret print_usage_ai()
      if streq(cmd, "tsm"):
        ret print_usage_tsm()
      if streq(cmd, "release-artifacts"):
        ret print_usage_release_artifacts()
      if streq(cmd, "reprocheck"):
        ret print_usage_reprocheck()
      if streq(cmd, "release-policy-check"):
        ret print_usage_release_policy_check()
  if streq(cmd, "init"):
    ret cmd_init()
  if ends_with_tn(cmd) != 0:
    ret cmd_run_path(cmd)
  if streq(cmd, "run"):
    run_path_arg:str = resolve_run_path_arg()
    if run_path_arg == 0:
      if path_exists("src/main.tn") != 0:
        say "run: defaulting to src/main.tn"
        ret cmd_run_path("src/main.tn")
      if path_exists("main.tn") != 0:
        say "run: defaulting to main.tn"
        ret cmd_run_path("main.tn")
      print_usage_run()
      ret 0 - 1
    ret cmd_run_path(run_path_arg)
  if streq(cmd, "repl"):
    ret cmd_repl()
  if streq(cmd, "build"):
    build_path_arg:str = resolve_build_path_arg()
    if build_path_arg == 0:
      if path_exists("src/main.tn") != 0:
        say "build: defaulting to src/main.tn"
        ret cmd_build_path("src/main.tn")
      if path_exists("main.tn") != 0:
        say "build: defaulting to main.tn"
        ret cmd_build_path("main.tn")
      print_usage_build()
      ret 0 - 1
    ret cmd_build_path(build_path_arg)
  if streq(cmd, "get"):
    ret cmd_get()
  if streq(cmd, "install"):
    ret cmd_get()
  if streq(cmd, "add"):
    ret cmd_add()
  if streq(cmd, "remove"):
    ret cmd_remove()
  if streq(cmd, "lock"):
    ret cmd_lock()
  if streq(cmd, "publish"):
    ret cmd_publish()
  if streq(cmd, "registry"):
    ret cmd_registry()
  if streq(cmd, "manifest"):
    ret cmd_manifest()
  if streq(cmd, "verify"):
    ret cmd_verify()
  if streq(cmd, "release-artifacts"):
    ret cmd_release_artifacts()
  if streq(cmd, "reprocheck"):
    ret cmd_reprocheck()
  if streq(cmd, "release-policy-check"):
    ret cmd_release_policy_check()
  if streq(cmd, "test"):
    ret cmd_test()
  if streq(cmd, "bench"):
    ret cmd_bench()
  if streq(cmd, "benchext"):
    ret cmd_bench_ext()
  if streq(cmd, "boot"):
    say "tezz boot is not available in tezz core CLI"
    ret 0 - 1
  if streq(cmd, "doctor"):
    ret cmd_doctor()
  if streq(cmd, "lsp"):
    ret cmd_lsp()
  if streq(cmd, "ai"):
    say "tezz ai is not available in tezz core CLI"
    ret 0 - 1
  if streq(cmd, "tsm"):
    say "tezz tsm is not available in tezz core CLI"
    ret 0 - 1
  if streq(cmd, "update"):
    ret cmd_update()
  if streq(cmd, "clean"):
    ret cmd_clean()
  if streq(cmd, "fmt"):
    ret cmd_fmt()
  if streq(cmd, "lint"):
    ret cmd_lint()
  if streq(cmd, "release"):
    ret cmd_release()

  print_usage()
  ret 0
