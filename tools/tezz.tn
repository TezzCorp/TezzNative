  // Formatter golden tests (fmt -> parse -> fmt stable)
  fmt_list:str = io.read_all("tests/fmt_manifest.tnx")
  if fmt_list != 0:
    ensure_dir("build")
    idx = 0
    while 1:
      line:str = next_manifest_line(fmt_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      base:str = path_basename_no_ext(in_path)
      if base == 0 || base[0] == 0:
        failed = failed + 1
        if base != 0:
          free(base)
        free(in_path)
        free(out_path)
        free(line)
        continue
      tmp1a:str = str_join2(out_dir, base)
      tmp1b:str = str_join2(tmp1a, "_fmt1.tn")
      cmd1:str = str_join3(tezzc, " fmt ", tmp1b)
      if io.copy_file(in_path, tmp1b) < 0:
        say "fmt failed:"
        say in_path
        failed = failed + 1
      else:
        exp:str = 0 as str
        act1:str = 0 as str
        if run_quiet(cmd1) != 0:
          say "fmt failed:"
          say in_path
          failed = failed + 1
        else:
          exp = read_norm(out_path)
          act1 = read_norm(tmp1b)
        if exp == 0 || act1 == 0 || strcmp(exp, act1) != 0:
          say "fmt mismatch:"
          say in_path
          failed = failed + 1
          if act1 != 0:
            free(act1)
          if exp != 0:
            free(exp)
        else:
          cmd2:str = str_join3(tezzc, " fmt ", tmp1b)
          if run_quiet(cmd2) != 0:
            say "fmt roundtrip failed:"
            say in_path
            failed = failed + 1
          else:
            act2:str = read_norm(tmp1b)
            if act2 == 0 || strcmp(act1, act2) != 0:
              say "fmt roundtrip mismatch:"
              say in_path
              failed = failed + 1
            if act2 != 0:
              free(act2)
          free(cmd2)
          if act1 != 0:
            free(act1)
          if exp != 0:
            free(exp)
        remove(tmp1b)
      free(cmd1)
      free(tmp1a)
      free(tmp1b)
      free(base)
      free(in_path)
      free(out_path)
      free(line)
    free(fmt_list)

  // Lint diagnostics golden tests
  lint_list:str = io.read_all("tests/lint_manifest.tnx")
  if lint_list != 0:
    idx = 0
    while 1:
      line:str = next_manifest_line(lint_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      cmdl:str = str_join3(tezzc, " lint ", in_path)
      outl:str = proc_out_all(cmdl)
      exp:str = read_norm(out_path)
      act:str = normalize_out(outl)
      exp2:str = normalize_slashes(exp)
      act2:str = normalize_slashes(act)
      exp3:str = trim_trailing_ws(exp2)
      act3:str = trim_trailing_ws(act2)
      if exp3 == 0 || act3 == 0 || strcmp(exp3, act3) != 0:
        say "lint mismatch:"
        say in_path
        failed = failed + 1
      if cmdl != 0:
        free(cmdl)
      if outl != 0:
        free(outl)
      if exp3 != 0:
        free(exp3)
      if act3 != 0:
        free(act3)
      if exp2 != 0:
        free(exp2)
      if act2 != 0:
        free(act2)
      if exp != 0:
        free(exp)
      if act != 0:
        free(act)
      if in_path != 0:
        free(in_path)
      if out_path != 0:
        free(out_path)
      free(line)
    free(lint_list)

  // Borrow/ownership diagnostics golden tests (negative fixtures)
  borrow_list:str = io.read_all("tests/borrow_manifest.tnx")
  if borrow_list != 0:
    idx = 0
    while 1:
      line:str = next_manifest_line(borrow_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      cmd_b:str = str_join3(tezzc, " check ", in_path)
      if run_quiet_all(cmd_b) == 0:
        say "borrow check unexpectedly succeeded:"
        say in_path
        failed = failed + 1
      out_b:str = proc_out_all(cmd_b)
      exp_b:str = read_norm(out_path)
      act_b:str = normalize_out(out_b)
      exp_b2:str = normalize_slashes(exp_b)
      act_b2:str = normalize_slashes(act_b)
      exp_b3:str = trim_trailing_ws(exp_b2)
      act_b3:str = trim_trailing_ws(act_b2)
      if exp_b3 == 0 || act_b3 == 0 || strcmp(exp_b3, act_b3) != 0:
        say "borrow mismatch:"
        say in_path
        failed = failed + 1
      if cmd_b != 0:
        free(cmd_b)
      if out_b != 0:
        free(out_b)
      if exp_b3 != 0:
        free(exp_b3)
      if act_b3 != 0:
        free(act_b3)
      if exp_b2 != 0:
        free(exp_b2)
      if act_b2 != 0:
        free(act_b2)
      if exp_b != 0:
        free(exp_b)
      if act_b != 0:
        free(act_b)
      if in_path != 0:
        free(in_path)
      if out_path != 0:
        free(out_path)
      free(line)
    free(borrow_list)

  // Attribute diagnostics golden tests (negative fixtures)
  attr_list:str = io.read_all("tests/attr_manifest.tnx")
  if attr_list != 0:
    idx = 0
    while 1:
      line:str = next_manifest_line(attr_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      cmd_a:str = str_join3(tezzc, " check ", in_path)
      if run_quiet_all(cmd_a) == 0:
        say "attr check unexpectedly succeeded:"
        say in_path
        failed = failed + 1
      out_a:str = proc_out_all(cmd_a)
      exp_a:str = read_norm(out_path)
      act_a:str = normalize_out(out_a)
      exp_a2:str = normalize_slashes(exp_a)
      act_a2:str = normalize_slashes(act_a)
      exp_a3:str = trim_trailing_ws(exp_a2)
      act_a3:str = trim_trailing_ws(act_a2)
      if exp_a3 == 0 || act_a3 == 0 || strcmp(exp_a3, act_a3) != 0:
        say "attr mismatch:"
        say in_path
        failed = failed + 1
      if cmd_a != 0:
        free(cmd_a)
      if out_a != 0:
        free(out_a)
      if exp_a3 != 0:
        free(exp_a3)
      if act_a3 != 0:
        free(act_a3)
      if exp_a2 != 0:
        free(exp_a2)
      if act_a2 != 0:
        free(act_a2)
      if exp_a != 0:
        free(exp_a)
      if act_a != 0:
        free(act_a)
      if in_path != 0:
        free(in_path)
      if out_path != 0:
        free(out_path)
      free(line)
    free(attr_list)

  // ABI/FFI golden tests (abidump + abiverify)
  abi_list:str = io.read_all("tests/abi_manifest.tnx")
  if abi_list != 0:
    ensure_dir("build")
    idx = 0
    while 1:
      line:str = next_manifest_line(abi_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      tmp_out:str = str_join2(out_dir, "abi_tmp.tnx")
      cmd_ab1:str = str_join3(tezzc, " abidump ", in_path)
      cmd_ab2a:str = str_join3(cmd_ab1, " ", tmp_out)
      cmd_ab2:str = str_join2(cmd_ab2a, " --freestanding")
      if test_run(cmd_ab2, "abidump") != 0:
        failed = failed + 1
      else:
        exp_a:str = read_norm(out_path)
        act_a:str = read_norm(tmp_out)
        if exp_a == 0 || act_a == 0 || strcmp(exp_a, act_a) != 0:
          say "abidump mismatch:"
          say in_path
          failed = failed + 1
        if exp_a != 0:
          free(exp_a)
        if act_a != 0:
          free(act_a)
      remove(tmp_out)

      cmd_av1:str = str_join3(tezzc, " abiverify ", in_path)
      cmd_av2a:str = str_join3(cmd_av1, " ", out_path)
      cmd_av2:str = str_join2(cmd_av2a, " --freestanding")
      if test_run(cmd_av2, "abiverify") != 0:
        failed = failed + 1
      free(cmd_ab1)
      free(cmd_ab2a)
      free(cmd_ab2)
      free(cmd_av1)
      free(cmd_av2a)
      free(cmd_av2)
      free(tmp_out)
      if in_path != 0:
        free(in_path)
      if out_path != 0:
        free(out_path)
      free(line)
    free(abi_list)

  // IR golden tests (optimizer pipeline snapshots)
  ir_list:str = io.read_all("tests/ir_manifest.tnx")
  if ir_list != 0:
    idx = 0
    while 1:
      line:str = next_manifest_line(ir_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      cmd_ir:str = str_join3(tezzc, " ir ", in_path)
      out_ir:str = proc_out_all(cmd_ir)
      exp_ir:str = read_norm(out_path)
      act_ir:str = normalize_out(out_ir)
      exp_ir2:str = trim_trailing_ws(exp_ir)
      act_ir2:str = trim_trailing_ws(act_ir)
      if exp_ir2 == 0 || act_ir2 == 0 || strcmp(exp_ir2, act_ir2) != 0:
        say "ir mismatch:"
        say in_path
        failed = failed + 1
      if cmd_ir != 0:
        free(cmd_ir)
      if out_ir != 0:
        free(out_ir)
      if exp_ir2 != 0:
        free(exp_ir2)
      if act_ir2 != 0:
        free(act_ir2)
      if exp_ir != 0:
        free(exp_ir)
      if act_ir != 0:
        free(act_ir)
      if in_path != 0:
        free(in_path)
      if out_path != 0:
        free(out_path)
      free(line)
    free(ir_list)

  // Runtime error-path golden tests (separate manifest group)
  err_list:str = io.read_all("tests/error_manifest.tnx")
  if err_list != 0:
    ensure_dir("build")
    idx = 0
    while 1:
      line:str = next_manifest_line(err_list, &idx)
      if line == 0:
        break
      in_path:str = 0 as str
      out_path:str = 0 as str
      if split_pair(line, &in_path, &out_path) != 0:
        failed = failed + 1
        free(line)
        continue
      base:str = path_basename_no_ext(in_path)
      if base == 0 || base[0] == 0:
        failed = failed + 1
        if base != 0:
          free(base)
        free(in_path)
        free(out_path)
        free(line)
        continue
      tmp1a:str = str_join2(out_dir, base)
      tmp1b:str = str_join2(tmp1a, "_err.out")
      cmd1:str = str_join3(tezzc, " run --bc ", in_path)
      if run_to_file(cmd1, tmp1b) != 0:
        say "error-path failed:"
        say in_path
        failed = failed + 1
      else:
        exp:str = read_norm(out_path)
        act:str = read_norm(tmp1b)
        if exp == 0 || act == 0 || strcmp(exp, act) != 0:
          say "error-path mismatch:"
          say in_path
          failed = failed + 1
        if exp != 0:
          free(exp)
        if act != 0:
          free(act)
      remove(tmp1b)
      free(cmd1)
      free(tmp1a)
      free(tmp1b)
      free(base)
      free(in_path)
      free(out_path)
      free(line)
    free(err_list)

  // Kernel perf report baseline (optional)
  if kernel_perf != 0 && path_exists("kernel_perf_report.tnx") != 0:
    cmd_kp:str = str_join2(tezzc, " run --bc bench/kernel_perf.tn")
    out_kp:str = proc_out(cmd_kp)
    if out_kp == 0:
      say "kernel perf failed"
      failed = failed + 1
    else:
      out_kp = normalize_out(out_kp)
      out_kp = trim_line(out_kp)
      idxp:int = 0
      hdr:str = next_manifest_line(out_kp, &idxp)
      if hdr != 0:
        free(hdr)
      report:str = str_join2("", "op,policy,ns\n")
      while 1:
        opnm:str = next_manifest_line(out_kp, &idxp)
        if opnm == 0:
          break
        pol:str = next_manifest_line(out_kp, &idxp)
        nsstr:str = next_manifest_line(out_kp, &idxp)
        if pol == 0 || nsstr == 0:
          if pol != 0:
            free(pol)
          if nsstr != 0:
            free(nsstr)
          free(opnm)
          failed = failed + 1
          break
        nsval:int = parse_i64(nsstr)
        if nsval <= 0:
          failed = failed + 1
        line1:str = str_join3(opnm, ",", pol)
        line2:str = str_join3(line1, ",", nsstr)
        line3:str = str_join2(line2, "\n")
        tmprep:str = str_join2(report, line3)
        free(report)
        report = tmprep
        free(line1)
        free(line2)
        free(line3)
        free(opnm)
        free(pol)
        free(nsstr)
      io.write_all("build/kernel_perf_report.tnx", report)
      key:str = csv_op_policy(report)
      free(report)

      base:str = read_norm("kernel_perf_report.tnx")
      if base == 0:
        failed = failed + 1
      else:
        keyb:str = csv_op_policy(base)
        if keyb == 0 || key == 0 || strcmp(keyb, key) != 0:
          say "kernel perf baseline mismatch (op/policy)"
          failed = failed + 1
        free(base)
        if keyb != 0:
          free(keyb)
      if key != 0:
        free(key)
      free(out_kp)
    free(cmd_kp)

  // Freestanding kernel examples (build-only validation)
  os_list:str = io.read_all("tests/os_freestanding_manifest.tnx")
  if os_list != 0:
    ensure_dir("build")
    idx = 0
    while 1:
      start:str = next_manifest_line(os_list, &idx)
      if start == 0:
        break
      base:str = path_basename_no_ext(start)
      if base == 0 || base[0] == 0:
        failed = failed + 1
        if base != 0:
          free(base)
        free(start)
        continue
      outk1:str = str_join2(out_dir, base)
      outk2:str = str_join2(outk1, "_fs.s")
      cmdk1:str = str_join3(tezzc, " buildir ", start)
      cmdk2:str = str_join3(cmdk1, " ", outk2)
      cmdk3:str = str_join2(cmdk2, " --freestanding")
      if test_run(cmdk3, "freestanding build") != 0:
        failed = failed + 1
      remove(outk2)
      free(outk1)
      free(outk2)
      free(cmdk1)
      free(cmdk2)
      free(cmdk3)
      free(base)
      free(start)
    free(os_list)

  // GUI lane coverage (headless-safe host checks + retained tree behavior).
  if parity == 0:
    failed = failed + run_vm_manifest_once("tests/gui_manifest.tnx", tezzc, "gui")
    failed = failed + run_check_manifest("tests/gui_check_manifest.tnx", tezzc, "gui check", "")

  // BC parity tests (opt-in; use --parity)
  if parity != 0:
    if parity_debug != 0:
      say "parity: bcvm start"
    failed = failed + run_parity_manifest("tests/bcvm_manifest.tnx", "--bc", "bcvm", tezzc)
    if parity_debug != 0:
      say "parity: bcvm done"

  // Module/lock enforcement (negative test)
  if path_exists("tests/module_lock_bad_ver.tn") != 0:
    cmd_fail:str = str_join3(tezzc, " check ", "tests/module_lock_bad_ver.tn")
    if expect_fail(cmd_fail, "version mismatch") != 0:
      failed = failed + 1
    free(cmd_fail)

  // Duplicate/ambiguous module name detection (negative test)
  if path_exists("tests/module_dupname_fail.tn") != 0:
    cmd_dup:str = str_join3(tezzc, " check ", "tests/module_dupname_fail.tn")
    if expect_fail(cmd_dup, "ambiguous module name") != 0:
      failed = failed + 1
    free(cmd_dup)

  free(list)

  if failed != 0:
    ret 0 - 1
  say "ALL TESTS PASSED"
  ret 0

fn cmd_bench() -> int:
  list:str = io.read_all("bench/manifest.tnx")
  if list == 0:
    say "missing bench/manifest.tnx"
    ret 0 - 1
  micro:str = io.read_all("bench/micro_manifest.tnx")
  if micro != 0:
    tmpm:str = str_join3(list, "\n", micro)
    free(list)
    list = tmpm
    free(micro)

  tezzc:str = tezzc_path()
  os:str = os_name()
  exe_suffix:str = ""
  out_dir:str = "build/"
  if streq(os, "windows"):
    exe_suffix = ".exe"
    out_dir = ".\\build\\"

  run_bc:int = 0
  run_native:int = 0
  vectorize:int = 1
  profile:int = 0
  tune:int = 0
  profile_runs:int = 5
  kernel_perf:int = 0
  gate:int = 0
  perf_max_pct:int = 100
  baseline_path:str = "bench/perf_baseline.tnx"
  target:str = "x86_64"
  if streq(os, "windows") == 0:
    target = "linux"

  any_mode:int = 0
  ai:int = 1
  while ai < args_count():
    a:str = arg(ai)
    if streq(a, "--bc"):
      run_bc = 1
      any_mode = 1
      ai = ai + 1
      continue
    if streq(a, "--native"):
      run_native = 1
      any_mode = 1
      ai = ai + 1
      continue
    if streq(a, "--all"):
      run_bc = 1
      run_native = 1
      any_mode = 1
      ai = ai + 1
      continue
    if streq(a, "--vectorize"):
      vectorize = 1
      ai = ai + 1
      continue
    if streq(a, "--no-vectorize"):
      vectorize = 0
      ai = ai + 1
      continue
    if streq(a, "--profile"):
      profile = 1
      if (ai + 1) < args_count():
        n:int = parse_i64(arg(ai + 1))
        if n > 0:
          profile_runs = n
          ai = ai + 1
      ai = ai + 1
      continue
    if streq(a, "--tune"):
      tune = 1
      ai = ai + 1
      continue
    if streq(a, "--gate"):
      gate = 1
      ai = ai + 1
      continue
    if streq(a, "--baseline") && (ai + 1) < args_count():
      baseline_path = arg(ai + 1)
      ai = ai + 2
      continue
    if starts_with(a, "--baseline=") != 0:
      baseline_path = a + 11
      ai = ai + 1
      continue
    if streq(a, "--perf-max-pct") && (ai + 1) < args_count():
      perf_max_pct = parse_i64(arg(ai + 1))
      ai = ai + 2
      continue
    if starts_with(a, "--perf-max-pct=") != 0:
      perf_max_pct = parse_i64(a + 15)
      ai = ai + 1
      continue
    if streq(a, "--kernel-perf"):
      kernel_perf = 1
      ai = ai + 1
      continue
    if starts_with(a, "--profile=") != 0:
      profile = 1
      n2:int = parse_i64(a + 10)
      if n2 > 0:
        profile_runs = n2
      ai = ai + 1
      continue
    if streq(a, "--target") && (ai + 1) < args_count():
      target = arg(ai + 1)
      ai = ai + 2
      continue
    ai = ai + 1

  if any_mode == 0:
    run_bc = 1
    run_native = 1

  if run_native != 0 || profile != 0 || tune != 0:
    ensure_dir("build")

  if gate != 0 && profile == 0:
    profile = 1
    profile_runs = 5

  if tune != 0 && profile == 0:
    profile = 1
    profile_runs = 3

  csv:str = str_join2("", "name,lang,mode,ns\n")
  runlog:str = 0 as str
  if profile != 0:
    runlog = str_join2("", "name,mode,min,median,avg,stddev,p95,runs\n")
  idx:int = 0

  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    // optional per-entry mode: "path | bc" or "path | native"
    path:str = start
    mode:str = 0 as str
    left:str = 0 as str
    right:str = 0 as str
    if split_pair(start, &left, &right) == 0:
      free(start)
      path = left
      mode = right
    run_bc_item:int = run_bc
    run_native_item:int = run_native
    if mode != 0:
      if streq(mode, "bc") != 0:
        run_native_item = 0
      else if streq(mode, "native") != 0:
        run_bc_item = 0
    say path
    if run_bc_item != 0:
      // Bytecode VM run
      cbc0:str = str_join3(tezzc, " run ", path)
      cmd_bc:str = str_join2(cbc0, " --bc")
      free(cbc0)
      if profile != 0:
        times_bc:[int;64]
        tcount_bc:int = 0
        best_name_bc:str = 0 as str
        rbc:int = 0
        while rbc < profile_runs:
          out_bc:str = proc_out(cmd_bc)
          if out_bc != 0:
            out_bc = normalize_out(out_bc)
            out_bc = trim_line(out_bc)
            name_bc:str = line0_nonempty(out_bc)
            ns_bc:str = line1_nonempty(out_bc)
            if name_bc != 0 && ns_bc != 0 && len(name_bc) > 0 && len(ns_bc) > 0:
              nvbc:int = parse_i64(ns_bc)
              if nvbc > 0 && tcount_bc < 64:
                times_bc[tcount_bc] = nvbc
                tcount_bc = tcount_bc + 1
              if best_name_bc == 0:
                best_name_bc = name_bc
                name_bc = 0 as str
            if name_bc != 0:
              free(name_bc)
            if ns_bc != 0:
              free(ns_bc)
            free(out_bc)
          rbc = rbc + 1
        if tcount_bc > 0 && best_name_bc != 0:
          minbc:int = stats_min(times_bc, tcount_bc)
          medbc:int = stats_median(times_bc, tcount_bc)
          avgbc:int = stats_avg(times_bc, tcount_bc)
          sdbc:int = stats_stddev(times_bc, tcount_bc)
          p95bc:int = stats_p95(times_bc, tcount_bc)
          say str_join3("  bc: ", best_name_bc, " (profile)")
          ns_best_bc:str = int_to_str(minbc)
          lb1:str = str_join3(best_name_bc, ",tezz,bc,", ns_best_bc)
          lb2:str = str_join2(lb1, "\n")
          tmpcsvbc:str = str_join2(csv, lb2)
          free(csv)
          csv = tmpcsvbc
          free(lb1)
          free(lb2)
          free(ns_best_bc)

          if runlog != 0:
            sminbc:str = int_to_str(minbc)
            smedbc:str = int_to_str(medbc)
            savgbc:str = int_to_str(avgbc)
            ssdbc:str = int_to_str(sdbc)
            sp95bc:str = int_to_str(p95bc)
            srunsbc:str = int_to_str(tcount_bc)
            rb1:str = str_join3(best_name_bc, ",bc,", sminbc)
            rb2:str = str_join3(rb1, ",", smedbc)
            rb3:str = str_join3(rb2, ",", savgbc)
            rb4:str = str_join3(rb3, ",", ssdbc)
            rb5:str = str_join3(rb4, ",", sp95bc)
            rb6:str = str_join3(rb5, ",", srunsbc)
            rb7:str = str_join2(rb6, "\n")
            tmpbc:str = str_join2(runlog, rb7)
            free(runlog)
            runlog = tmpbc
            free(sminbc)
            free(smedbc)
            free(savgbc)
            free(ssdbc)
            free(sp95bc)
            free(srunsbc)
            free(rb1)
            free(rb2)
            free(rb3)
            free(rb4)
            free(rb5)
            free(rb6)
            free(rb7)
          free(best_name_bc)
        else:
          say "  bc: (no output)"
      else:
        out_bc:str = proc_out(cmd_bc)
        if out_bc != 0:
          out_bc = normalize_out(out_bc)
          out_bc = trim_line(out_bc)
          name_bc:str = line0_nonempty(out_bc)
          ns_bc:str = line1_nonempty(out_bc)
          if name_bc != 0 && ns_bc != 0 && len(name_bc) > 0 && len(ns_bc) > 0:
            say str_join2("  bc: ", out_bc)
            lb1:str = str_join3(name_bc, ",tezz,bc,", ns_bc)
            lb2:str = str_join2(lb1, "\n")
            tmpcsvbc:str = str_join2(csv, lb2)
            free(csv)
            csv = tmpcsvbc
            free(lb1)
            free(lb2)
          else:
            say "  bc: (no output)"
          if name_bc != 0:
            free(name_bc)
          if ns_bc != 0:
            free(ns_bc)
          free(out_bc)
        else:
          say "  bc: (no output)"

      free(cmd_bc)

    if run_native_item != 0:
      base:str = path_basename_no_ext(path)
      if base == 0 || base[0] == 0:
        if base != 0:
          free(base)
        if mode != 0:
          free(mode)
        free(path)
        continue
      out1:str = str_join2(out_dir, base)
      out2:str = str_join2(out1, "_bench")
      out3:str = str_join2(out2, exe_suffix)

      cmd1:str = str_join3(tezzc, " buildexe ", path)
      cmd2:str = str_join3(cmd1, " ", out3)
      cmd3:str = str_join3(cmd2, " --target ", target)
      if vectorize != 0:
        cmd4:str = str_join2(cmd3, " --vectorize")
        free(cmd3)
        cmd3 = cmd4

      if proc_run(cmd3) != 0:
        say "  native: (build failed)"
      else:
        if tune != 0:
          blocks:[int;6]
          unrolls:[int;6]
          bcount:int = 4
          ucount:int = 4
          blocks[0] = 64
          blocks[1] = 128
          blocks[2] = 256
          blocks[3] = 512
          unrolls[0] = 1
          unrolls[1] = 2
          unrolls[2] = 4
          unrolls[3] = 8

          best_name2:str = 0 as str
          best_min:int = 0
          best_med:int = 0
          best_avg:int = 0
          best_sd:int = 0
          best_p95:int = 0
          best_runs:int = 0
          best_block:int = 0
          best_unroll:int = 0
          src0:str = io.read_all(path)
          tmp_path:str = 0 as str
          if src0 != 0:
            tmp_path = str_join3(out_dir, base, "_tune.tn")

          bi:int = 0
          while bi < bcount:
            block:int = blocks[bi]
            ui:int = 0
            while ui < ucount:
              unroll:int = unrolls[ui]
              if src0 != 0 && tmp_path != 0:
                tuned:str = tune_source(src0, block, unroll)
                if tuned != 0:
                  io.write_all(tmp_path, tuned)
                  free(tuned)
                cmdt1:str = str_join3(tezzc, " buildexe ", tmp_path)
                cmdt2:str = str_join3(cmdt1, " ", out3)
                cmdt3:str = str_join3(cmdt2, " --target ", target)
                if vectorize != 0:
                  cmdt4:str = str_join2(cmdt3, " --vectorize")
                  free(cmdt3)
                  cmdt3 = cmdt4

                if proc_run(cmdt3) != 0:
                  free(cmdt1)
                  free(cmdt2)
                  free(cmdt3)
                  ui = ui + 1
                  continue

                free(cmdt1)
                free(cmdt2)
                free(cmdt3)

              times2:[int;64]
              tcount2:int = 0
              r2:int = 0
              while r2 < profile_runs:
                out_exe:str = proc_out(out3)
                if out_exe != 0:
                  out_exe = normalize_out(out_exe)
                  out_exe = trim_line(out_exe)
                  name_exe:str = line0_nonempty(out_exe)
                  ns_exe:str = line1_nonempty(out_exe)
                  if name_exe != 0 && ns_exe != 0 && len(name_exe) > 0 && len(ns_exe) > 0:
                    nv2:int = parse_i64(ns_exe)
                    if nv2 > 0 && tcount2 < 64:
                      times2[tcount2] = nv2
                      tcount2 = tcount2 + 1
                    if best_name2 == 0:
                      best_name2 = name_exe
                      name_exe = 0 as str
                  if name_exe != 0:
                    free(name_exe)
                  if ns_exe != 0:
                    free(ns_exe)
                  free(out_exe)
                r2 = r2 + 1

              if tcount2 > 0:
                minv2:int = stats_min(times2, tcount2)
                medv2:int = stats_median(times2, tcount2)
                avgv2:int = stats_avg(times2, tcount2)
                sdv2:int = stats_stddev(times2, tcount2)
                p952:int = stats_p95(times2, tcount2)
                if best_min == 0 || minv2 < best_min:
                  best_min = minv2
                  best_med = medv2
                  best_avg = avgv2
                  best_sd = sdv2
                  best_p95 = p952
                  best_runs = tcount2
                  best_block = block
                  best_unroll = unroll

              ui = ui + 1
            bi = bi + 1

          if best_name2 != 0 && best_min > 0:
            say str_join3("  native: ", best_name2, " (tune)")
            bb:str = int_to_str(best_block)
            uu:str = int_to_str(best_unroll)
            t1:str = str_join3("    block=", bb, ", unroll=")
            t2:str = str_join2(t1, uu)
            say t2
            free(t1)
            free(t2)
            free(bb)
            free(uu)

            ns_best2:str = int_to_str(best_min)
            l1:str = str_join3(best_name2, ",tezz,native,", ns_best2)
            l2:str = str_join2(l1, "\n")
            tmpcsv:str = str_join2(csv, l2)
            free(csv)
            csv = tmpcsv
            free(l1)
            free(l2)
            free(ns_best2)

            if runlog != 0:
              smin2:str = int_to_str(best_min)
              smed2:str = int_to_str(best_med)
              savg2:str = int_to_str(best_avg)
              ssd2:str = int_to_str(best_sd)
              sp952:str = int_to_str(best_p95)
              sruns2:str = int_to_str(best_runs)
              r1b:str = str_join3(best_name2, ",native,", smin2)
              r2b:str = str_join3(r1b, ",", smed2)
              r3b:str = str_join3(r2b, ",", savg2)
              r4b:str = str_join3(r3b, ",", ssd2)
              r5b:str = str_join3(r4b, ",", sp952)
              r6b:str = str_join3(r5b, ",", sruns2)
              r7b:str = str_join2(r6b, "\n")
              tmpb:str = str_join2(runlog, r7b)
              free(runlog)
              runlog = tmpb
              free(smin2)
              free(smed2)
              free(savg2)
              free(ssd2)
              free(sp952)
              free(sruns2)
              free(r1b)
              free(r2b)
              free(r3b)
              free(r4b)
              free(r5b)
              free(r6b)
              free(r7b)
            free(best_name2)
          else:
            say "  native: (no output)"
          if tmp_path != 0:
            remove(tmp_path)
            free(tmp_path)
          if src0 != 0:
            free(src0)
        else:
          if profile != 0:
            times2:[int;64]
            tcount2:int = 0
            best_name2:str = 0 as str
            r2:int = 0
            while r2 < profile_runs:
              out_exe:str = proc_out(out3)
              if out_exe != 0:
                out_exe = normalize_out(out_exe)
                out_exe = trim_line(out_exe)
                name_exe:str = line0_nonempty(out_exe)
                ns_exe:str = line1_nonempty(out_exe)
                if name_exe != 0 && ns_exe != 0 && len(name_exe) > 0 && len(ns_exe) > 0:
                  nv2:int = parse_i64(ns_exe)
                  if nv2 > 0 && tcount2 < 64:
                    times2[tcount2] = nv2
                    tcount2 = tcount2 + 1
                  if best_name2 == 0:
                    best_name2 = name_exe
                    name_exe = 0 as str
                if name_exe != 0:
                  free(name_exe)
                if ns_exe != 0:
                  free(ns_exe)
                free(out_exe)
              r2 = r2 + 1
            if tcount2 > 0 && best_name2 != 0:
              minv2:int = stats_min(times2, tcount2)
              medv2:int = stats_median(times2, tcount2)
              avgv2:int = stats_avg(times2, tcount2)
              sdv2:int = stats_stddev(times2, tcount2)
              p952:int = stats_p95(times2, tcount2)
              say str_join3("  native: ", best_name2, " (profile)")
              ns_best2:str = int_to_str(minv2)
              l1:str = str_join3(best_name2, ",tezz,native,", ns_best2)
              l2:str = str_join2(l1, "\n")
              tmpcsv:str = str_join2(csv, l2)
              free(csv)
              csv = tmpcsv
              free(l1)
              free(l2)
              free(ns_best2)

              if runlog != 0:
                smin2:str = int_to_str(minv2)
                smed2:str = int_to_str(medv2)
                savg2:str = int_to_str(avgv2)
                ssd2:str = int_to_str(sdv2)
                sp952:str = int_to_str(p952)
                sruns2:str = int_to_str(tcount2)
                r1b:str = str_join3(best_name2, ",native,", smin2)
                r2b:str = str_join3(r1b, ",", smed2)
                r3b:str = str_join3(r2b, ",", savg2)
                r4b:str = str_join3(r3b, ",", ssd2)
                r5b:str = str_join3(r4b, ",", sp952)
                r6b:str = str_join3(r5b, ",", sruns2)
                r7b:str = str_join2(r6b, "\n")
                tmpb:str = str_join2(runlog, r7b)
                free(runlog)
                runlog = tmpb
                free(smin2)
                free(smed2)
                free(savg2)
                free(ssd2)
                free(sp952)
                free(sruns2)
                free(r1b)
                free(r2b)
                free(r3b)
                free(r4b)
                free(r5b)
                free(r6b)
                free(r7b)
              free(best_name2)
            else:
              say "  native: (no output)"
          else:
            out_exe:str = proc_out(out3)
            if out_exe != 0:
              out_exe = normalize_out(out_exe)
              out_exe = trim_line(out_exe)
              name_exe:str = line0_nonempty(out_exe)
              ns_exe:str = line1_nonempty(out_exe)
              if name_exe != 0 && ns_exe != 0 && len(name_exe) > 0 && len(ns_exe) > 0:
                say str_join2("  native: ", out_exe)
                l1:str = str_join3(name_exe, ",tezz,native,", ns_exe)
                l2:str = str_join2(l1, "\n")
                tmpcsv:str = str_join2(csv, l2)
                free(csv)
                csv = tmpcsv
                free(l1)
                free(l2)
              else:
                say "  native: (no output)"
              if name_exe != 0:
                free(name_exe)
              if ns_exe != 0:
                free(ns_exe)
              free(out_exe)
            else:
              say "  native: (no output)"

      free(cmd1)
      free(cmd2)
      free(cmd3)
      free(out1)
      free(out2)
      free(out3)
      if base != 0:
        free(base)

    if mode != 0:
      free(mode)
    free(path)
  if run_bc != 0 && run_native != 0:
    names:[str;256]
    bc_ns:[int;256]
    native_ns:[int;256]
    ncount:int = 0
    li:int = 0
    lstart:int = 0
    while 1:
      ch:int = csv[li] as int
      if ch == 0 || ch == 10:
        if li > lstart:
          line:str = substr_dup(csv, lstart, li)
          if starts_with(line, "name,") == 0:
            a:int = 0
            while line[a] != 0 && line[a] != 44:
              a = a + 1
            if line[a] == 44:
              b:int = a + 1
              while line[b] != 0 && line[b] != 44:
                b = b + 1
              if line[b] == 44:
                c2:int = b + 1
                while line[c2] != 0 && line[c2] != 44:
                  c2 = c2 + 1
                if line[c2] == 44:
                  name:str = substr_dup(line, 0, a)
                  lang:str = substr_dup(line, a + 1, b)
                  mode:str = substr_dup(line, b + 1, c2)
                  ns_str:str = substr_dup(line, c2 + 1, len(line))
                  if streq(lang, "tezz") != 0 && (streq(mode, "bc") != 0 || streq(mode, "native") != 0):
                    ns_val:int = parse_i64(ns_str)
                    idx:int = 0 - 1
                    ii:int = 0
                    while ii < ncount:
                      if streq(names[ii], name) != 0:
                        idx = ii
                        break
                      ii = ii + 1
                    stored:int = 0
                    if idx < 0 && ncount < 256:
                      names[ncount] = name
                      bc_ns[ncount] = 0
                      native_ns[ncount] = 0
                      idx = ncount
                      ncount = ncount + 1
                      stored = 1
                    if idx >= 0:
                      if streq(mode, "bc") != 0:
                        bc_ns[idx] = ns_val
                      else:
                        native_ns[idx] = ns_val
                    if stored == 0:
                      free(name)
                  else:
                    free(name)
                  free(lang)
                  free(mode)
                  free(ns_str)
          free(line)
        if ch == 0:
          break
        lstart = li + 1
      li = li + 1

    deltas:str = str_join2("", "name,bc_ns,native_ns,delta_pct\n")
    any_delta:int = 0
    di:int = 0
    while di < ncount:
      if bc_ns[di] > 0 && native_ns[di] > 0:
        delta:int = (bc_ns[di] - native_ns[di]) * 100 / native_ns[di]
        sbc:str = int_to_str(bc_ns[di])
        snat:str = int_to_str(native_ns[di])
        sdel:str = int_to_str(delta)
        d1:str = str_join3(names[di], ",", sbc)
        d2:str = str_join3(d1, ",", snat)
        d3:str = str_join3(d2, ",", sdel)
        d4:str = str_join2(d3, "\n")
        tmpd:str = str_join2(deltas, d4)
        free(deltas)
        deltas = tmpd
        free(sbc)
        free(snat)
        free(sdel)
        free(d1)
        free(d2)
        free(d3)
        free(d4)
        any_delta = 1
      di = di + 1
    di = 0
    while di < ncount:
      if names[di] != 0:
        free(names[di])
      di = di + 1
    if any_delta != 0:
      if runlog == 0:
        h1:str = "# deltas (bc vs native)\n"
        tmp1:str = str_join2(h1, deltas)
        runlog = tmp1
      else:
        h2:str = "\n# deltas (bc vs native)\n"
        t1:str = str_join2(runlog, h2)
        t2:str = str_join2(t1, deltas)
        free(runlog)
        runlog = t2
        free(t1)
      free(deltas)
    else:
      free(deltas)

  if kernel_perf != 0:
    ensure_dir("build")
    report:str = str_join2("", "op,policy,ns\n")
    cmd1:str = str_join2(tezzc, " run --bc bench/kernel_perf.tn")
    out:str = proc_out(cmd1)
    if out != 0:
      out = normalize_out(out)
      out = trim_line(out)
      idxp:int = 0
      // First line is a header; skip it.
      hdr:str = next_manifest_line(out, &idxp)
      if hdr != 0:
        free(hdr)
      while 1:
        opnm:str = next_manifest_line(out, &idxp)
        if opnm == 0:
          break
        pol:str = next_manifest_line(out, &idxp)
        nsstr:str = next_manifest_line(out, &idxp)
        if pol == 0 || nsstr == 0:
          if pol != 0:
            free(pol)
          if nsstr != 0:
            free(nsstr)
          free(opnm)
          break
        line1:str = str_join3(opnm, ",", pol)
        line2:str = str_join3(line1, ",", nsstr)
        line3:str = str_join2(line2, "\n")
        tmprep:str = str_join2(report, line3)
        free(report)
        report = tmprep
        free(line1)
        free(line2)
        free(line3)
        free(opnm)
        free(pol)
        free(nsstr)
      free(out)
    free(cmd1)
    io.write_all("build/kernel_perf_report.tnx", report)
    free(report)

  io.write_all("build/bench.tnx", csv)
  if runlog != 0:
    io.write_all("build/bench_run.tnx", runlog)

  if gate != 0:
    if runlog == 0:
      say "bench gate: missing runlog (use --profile)"
      if runlog != 0:
        free(runlog)
      free(csv)
      free(list)
      ret 0 - 1
    base:str = io.read_all(baseline_path)
    if base == 0:
      say "bench gate: missing baseline"
      if runlog != 0:
        free(runlog)
      free(csv)
      free(list)
      ret 0 - 1
    idxg:int = 0
    bad:int = 0
    checked:int = 0
    while 1:
      line:str = next_manifest_line(runlog, &idxg)
      if line == 0:
        break
      if starts_with(line, "name,") != 0:
        free(line)
        continue
      name:str = csv_field(line, 0)
      mode:str = csv_field(line, 1)
      p95s:str = csv_field(line, 6)
      cur:int = 0
      if p95s != 0:
        cur = parse_i64(p95s)
      base_p95:int = bench_find_p95(base, name, mode)
      if base_p95 > 0 && cur > 0:
        delta:int = (cur - base_p95) * 100 / base_p95
        checked = checked + 1
        if delta > perf_max_pct:
          bad = bad + 1
          sb:str = int_to_str(base_p95)
          sc:str = int_to_str(cur)
          sd:str = int_to_str(delta)
          m1:str = str_join3("perf regression: ", name, " ")
          m2:str = str_join3(m1, mode, " ")
          m3:str = str_join3(m2, sb, " -> ")
          m4:str = str_join3(m3, sc, " (")
          m5:str = str_join3(m4, sd, "%)")
          say m5
          free(sb)
          free(sc)
          free(sd)
          free(m1)
          free(m2)
          free(m3)
          free(m4)
          free(m5)
      if name != 0:
        free(name)
      if mode != 0:
        free(mode)
      if p95s != 0:
        free(p95s)
      free(line)
    free(base)
    if checked == 0:
      say "bench gate: no comparable entries"
      if runlog != 0:
        free(runlog)
      free(csv)
      free(list)
      ret 0 - 1
    if bad != 0:
      say "bench gate: FAILED"
      if runlog != 0:
        free(runlog)
      free(csv)
      free(list)
      ret 0 - 1
    say "bench gate: OK"
  if runlog != 0:
    free(runlog)
  free(csv)
  free(list)
  ret 0

fn cmd_bench_ext() -> int:
  list:str = io.read_all("bench/external_manifest.tnx")
  if list == 0:
    say "missing bench/external_manifest.tnx"
    ret 0 - 1

  ensure_dir("build")
  os:str = os_name()
  csv:str = io.read_all("build/bench.tnx")
  if csv == 0:
    csv = str_join2("", "name,lang,mode,ns\n")

  idx:int = 0
  while 1:
    start:str = next_manifest_line(list, &idx)
    if start == 0:
      break
    a:int = 0
    while start[a] != 0 && start[a] != 44:
      a = a + 1
    if start[a] == 44:
      b:int = a + 1
      while start[b] != 0 && start[b] != 44:
        b = b + 1
      if start[b] == 44:
        name:str = substr_dup(start, 0, a)
        lang:str = substr_dup(start, a + 1, b)
        cmd:str = substr_dup(start, b + 1, len(start))
        if streq(os, "windows") != 0:
          tmpcmd:str = win_fix_cmd_slash(cmd)
          free(cmd)
          cmd = tmpcmd
        out:str = proc_out(cmd)
        if out != 0:
          out = normalize_out(out)
          out = trim_line(out)
          nname:str = line0_nonempty(out)
          ns:str = line1_nonempty(out)
          if nname == 0:
            nname = name
          if ns != 0:
            l1:str = str_join3(nname, ",", lang)
            l2:str = str_join2(l1, ",external,")
            l3:str = str_join2(l2, ns)
            l4:str = str_join2(l3, "\n")
            tmpcsv:str = str_join2(csv, l4)
            free(csv)
            csv = tmpcsv
            free(l1)
            free(l2)
            free(l3)
            free(l4)
          if nname != 0 && nname != name:
            free(nname)
          if ns != 0:
            free(ns)
          free(out)
        free(name)
        free(lang)
        free(cmd)
    free(start)

  io.write_all("build/bench.tnx", csv)
  free(csv)
  free(list)
  ret 0

fn cmd_clean() -> int:
  if path_exists("build") != 0:
    clean_dir("build")
  ret 0

fn doctor_ok(label:str, detail:str):
  p0:str = str_join2("[OK] ", label)
  if detail == 0 || detail[0] == 0:
    say p0
    free(p0)
    ret
  p1:str = str_join3(p0, " :: ", detail)
  say p1
  free(p0)
  free(p1)

fn doctor_warn(label:str, detail:str):
  p0:str = str_join2("[WARN] ", label)
  if detail == 0 || detail[0] == 0:
    say p0
    free(p0)
    ret
  p1:str = str_join3(p0, " :: ", detail)
  say p1
  free(p0)
  free(p1)

fn doctor_fail(label:str, detail:str):
  p0:str = str_join2("[FAIL] ", label)
  if detail == 0 || detail[0] == 0:
    say p0
    free(p0)
    ret
  p1:str = str_join3(p0, " :: ", detail)
  say p1
  free(p0)
  free(p1)

fn run_installer_mode(mode:str) -> int:
  nonce:str = int_to_str(time.now_ms())
  osn:str = os_name()
  if streq(osn, "windows"):
    ps_url:str = str_join3("https://tn.tezzcorp.com/download/install.ps1?nocache=", nonce, "")
    c0:str = str_join3("powershell -NoProfile -ExecutionPolicy Bypass -Command \"iwr ", ps_url, " -OutFile $env:TEMP\\tezz-install.ps1; powershell -ExecutionPolicy Bypass -File $env:TEMP\\tezz-install.ps1 -Mode ")
    c1:str = str_join3(c0, mode, "")
    c2:str = str_join2(c1, "\"")
    free(ps_url)
    free(c0)
    r1:int = proc_run(c2)
    free(c1)
    free(c2)
    free(nonce)
    ret r1

  sh_url:str = str_join3("https://tn.tezzcorp.com/download/install.sh?nocache=", nonce, "")
  c3a:str = str_join3("curl -fsSL ", sh_url, " | bash -s -- ")
  c3:str = str_join3(c3a, mode, "")
  r2:int = proc_run(c3)
  free(c3a)
  free(c3)
  if r2 != 0:
    c4a:str = str_join3("wget -qO- ", sh_url, " | bash -s -- ")
    c4:str = str_join3(c4a, mode, "")
    r2 = proc_run(c4)
    free(c4a)
    free(c4)
  free(sh_url)
  free(nonce)
  ret r2

fn run_installer_mode_windows_scoped(mode:str, scope:str, path_mode:str) -> int:
  nonce:str = int_to_str(time.now_ms())
  ps_url:str = str_join3("https://tn.tezzcorp.com/download/install.ps1?nocache=", nonce, "")
  p0:str = str_join3("powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:TEZZ_INSTALL_SCOPE='", scope, "'; ")
  p1:str = str_join3("$env:TEZZ_INSTALL_AUTO_PATH='", path_mode, "'; iwr ")
  p2:str = str_join3(ps_url, " -OutFile $env:TEMP\\tezz-install.ps1; powershell -ExecutionPolicy Bypass -File $env:TEMP\\tezz-install.ps1 -Mode ", mode)
  p3:str = str_join2(p0, p1)
  p4:str = str_join2(p3, p2)
  p5:str = str_join2(p4, "\"")

  free(nonce)
  free(ps_url)
  free(p0)
  free(p1)
  free(p2)
  free(p3)
  free(p4)

  rr:int = proc_run(p5)
  free(p5)
  ret rr

fn run_installer_mode_fix() -> int:
  osn:str = os_name()
  if streq(osn, "windows"):
    r_user_install:int = run_installer_mode_windows_scoped("install", "user", "user")
    if r_user_install == 0:
      ret 0
    r_user_reinstall:int = run_installer_mode_windows_scoped("reinstall", "user", "user")
    if r_user_reinstall == 0:
      ret 0
    ret r_user_reinstall
  ret run_installer_mode("install")

fn rerun_doctor_strict(tezzc:str, sdk_root:str) -> int:
  if tezzc == 0 || sdk_root == 0 || sdk_root[0] == 0:
    ret 0 - 1
  tool_path:str = path_join(sdk_root, "tools/tezz.tn")
  if path_exists(tool_path) == 0:
    free(tool_path)
    ret 0 - 1

  tezzc_q:str = quote_cmd_path(tezzc)
  tool_q:str = quote_cmd_path(tool_path)
  sdk_q:str = quote_cmd_path(sdk_root)
  free(tool_path)
  if tezzc_q == 0 || tool_q == 0 || sdk_q == 0:
    if tezzc_q != 0:
      free(tezzc_q)
    if tool_q != 0:
      free(tool_q)
    if sdk_q != 0:
      free(sdk_q)
    ret 0 - 1

  c0:str = str_join3(tezzc_q, " run ", tool_q)
  c1:str = str_join2(c0, " -- doctor --strict --tezzc ")
  c2:str = str_join2(c1, tezzc_q)
  c3:str = str_join2(c2, " --sdk-root ")
  c4:str = str_join2(c3, sdk_q)

  free(c0)
  free(c1)
  free(c2)
  free(c3)
  free(tezzc_q)
  free(tool_q)
  free(sdk_q)

  rr:int = proc_run(c4)
  free(c4)
  ret rr

fn cmd_doctor() -> int:
  strict:int = 0
  fix:int = 0
  ai:int = 1
  ucnt:int = user_args_count()
  while ai < ucnt:
    a:str = arg(ai)
    if streq(a, "--strict"):
      strict = 1
      ai = ai + 1
      continue
    if streq(a, "--fix"):
      fix = 1
      ai = ai + 1
      continue
    if streq(a, "--help") || streq(a, "-h"):
      print_usage_doctor()
      ret 0
    if starts_with(a, "--") != 0:
      p0:str = str_join2("doctor: unknown option: ", a)
      say p0
      free(p0)
      print_usage_doctor()
      ret 0 - 1
    ai = ai + 1

  say "TezzNative doctor v1"
  failed:int = 0
  warned:int = 0

  osn:str = os_name()
  arch:str = detect_arch()
  host0:str = str_join3("host: ", osn, " / ")
  host1:str = str_join2(host0, arch)
  say host1
  free(host0)
  free(host1)
  free(arch)

  has_tezz:int = tool_exists("tezz")
  if has_tezz == 0 && streq(osn, "windows"):
    if tool_exists("tezz.cmd") != 0:
      has_tezz = 1
  if has_tezz != 0:
    doctor_ok("PATH tezz", "found")
  else:
    doctor_warn("PATH tezz", "not found in PATH (use full launcher path or add bin dir)")
    warned = warned + 1

  tezzc:str = tezzc_path()
  if tezzc == 0:
    doctor_fail("compiler", "tezzc not found (bin/tezzc, build/tezzc, or PATH)")
    failed = failed + 1
  else:
    doctor_ok("compiler", tezzc)
    if path_exists("tools/tezz.tn") != 0:
      c1:str = str_join3(tezzc, " check ", "tools/tezz.tn")
      if proc_run(c1) != 0:
        doctor_fail("compiler smoke", "tezzc check tools/tezz.tn failed")
        failed = failed + 1
      else:
        doctor_ok("compiler smoke", "tezzc check tools/tezz.tn")
      free(c1)
    else:
      doctor_ok("compiler smoke", "skipped (tools/tezz.tn not in cwd)")

  sdk_root:str = sdk_root_arg()
  own_sdk_root:int = 0
  sdk_root_core_ok:int = 0
  if sdk_root == 0 || sdk_root[0] == 0:
    sdk_env:str = env_value("TEZZ_SDK_ROOT")
    if sdk_env != 0 && sdk_env[0] != 0:
      sdk_root = sdk_env
      own_sdk_root = 1
      doctor_ok("env TEZZ_SDK_ROOT", sdk_root)
    else:
      if sdk_env != 0:
        free(sdk_env)
      doctor_warn("env TEZZ_SDK_ROOT", "not set")
      warned = warned + 1
  if (sdk_root == 0 || sdk_root[0] == 0) && tezzc != 0:
    sdk_guess:str = infer_sdk_root_from_tezzc(tezzc)
    if sdk_guess != 0 && sdk_guess[0] != 0:
      sdk_root = sdk_guess
      own_sdk_root = 1
      doctor_ok("sdk root inferred", sdk_root)
  if sdk_root != 0 && sdk_root[0] != 0:
    sdk_tool:str = path_join(sdk_root, "tools/tezz.tn")
    sdk_lib_std:str = path_join(sdk_root, "lib/std.tn")
    sdk_lib_io:str = path_join(sdk_root, "lib/io.tn")
    sdk_lib_net:str = path_join(sdk_root, "lib/net.tn")
    sdk_lib_tls:str = path_join(sdk_root, "lib/tls.tn")
    sdk_bin:str = path_join(sdk_root, "bin")
    sdk_bin_tezzc_exe:str = path_join(sdk_root, "bin/tezzc.exe")
    sdk_bin_tezzc:str = path_join(sdk_root, "bin/tezzc")
    sdk_build_tezzc_exe:str = path_join(sdk_root, "build/tezzc.exe")
    sdk_build_tezzc:str = path_join(sdk_root, "build/tezzc")
    if path_exists(sdk_tool) != 0 && path_exists(sdk_lib_std) != 0 && path_exists(sdk_lib_io) != 0 && path_exists(sdk_lib_net) != 0 && path_exists(sdk_lib_tls) != 0:
      doctor_ok("sdk root", sdk_root)
      sdk_root_core_ok = 1
    else:
      doctor_warn("sdk root", "missing core files under --sdk-root (tools/lib)")
      warned = warned + 1
    if path_exists(sdk_bin) != 0 && (path_exists(sdk_bin_tezzc_exe) != 0 || path_exists(sdk_bin_tezzc) != 0):
      doctor_ok("sdk bin", sdk_bin)
    else if path_exists(sdk_bin) != 0:
      doctor_warn("sdk bin", "bin directory present but tezzc binary missing")
      warned = warned + 1
    else if path_exists(sdk_build_tezzc_exe) != 0 || path_exists(sdk_build_tezzc) != 0:
      doctor_ok("sdk bin", "not present; using source-tree build compiler")
    else:
      doctor_warn("sdk bin", "bin directory missing in sdk root")
      warned = warned + 1
    if streq(osn, "windows"):
      sdk_cmd:str = path_join(sdk_root, "tezz.cmd")
      sdk_ps1:str = path_join(sdk_root, "tezz.ps1")
      if path_exists(sdk_cmd) != 0 && path_exists(sdk_ps1) != 0:
        doctor_ok("launcher", "tezz.cmd + tezz.ps1 present")
      else:
        doctor_warn("launcher", "missing tezz.cmd/tezz.ps1 under sdk root")
        warned = warned + 1
      free(sdk_cmd)
      free(sdk_ps1)
    else:
      sdk_sh:str = path_join(sdk_root, "tezz")
      if path_exists(sdk_sh) != 0:
        doctor_ok("launcher", "tezz launcher present")
      else:
        doctor_warn("launcher", "missing tezz launcher under sdk root")
        warned = warned + 1
      free(sdk_sh)
    free(sdk_tool)
    free(sdk_lib_std)
    free(sdk_lib_io)
    free(sdk_lib_net)
    free(sdk_lib_tls)
    free(sdk_bin)
    free(sdk_bin_tezzc_exe)
    free(sdk_bin_tezzc)
    free(sdk_build_tezzc_exe)
    free(sdk_build_tezzc)
  else:
    doctor_warn("sdk root", "not resolved (pass --sdk-root or set TEZZ_SDK_ROOT)")
    warned = warned + 1

  sdk_hits:int = 0
  if path_exists("tools/tezz.tn") != 0:
    sdk_hits = sdk_hits + 1
  if path_exists("lib/std.tn") != 0:
    sdk_hits = sdk_hits + 1
  if path_exists("lib/io.tn") != 0:
    sdk_hits = sdk_hits + 1
  if path_exists("lib/net.tn") != 0:
    sdk_hits = sdk_hits + 1
  if path_exists("lib/tls.tn") != 0:
    sdk_hits = sdk_hits + 1
  if sdk_hits == 5:
    doctor_ok("sdk core", "tools + lib files present")
  else:
    if sdk_root_core_ok != 0:
      doctor_ok("sdk core", "resolved via TEZZ_SDK_ROOT")
    else:
      if sdk_hits == 0:
        doctor_warn("sdk core", "not found in cwd (run from sdk/project root)")
      else:
        doctor_warn("sdk core", "partial files in cwd")
      warned = warned + 1

  if path_exists("tezz.mod") != 0:
    doctor_ok("project", "tezz.mod detected")
  else:
    doctor_warn("project", "tezz.mod not found in cwd")
    warned = warned + 1

  doctor_ok("updater", "available: tezz update --check | tezz update")

  strict_fail:int = 0
  if strict != 0 && warned != 0:
    strict_fail = 1

  if fix != 0 && (failed != 0 || warned != 0):
    say "doctor: running auto-repair via update --install"
    rfix:int = run_installer_mode_fix()
    if rfix != 0:
      if own_sdk_root != 0 && sdk_root != 0:
        free(sdk_root)
      if tezzc != 0:
        free(tezzc)
      say "doctor: auto-repair failed"
      ret 0 - 1
    say "doctor: auto-repair complete; re-running strict checks..."
    rr:int = rerun_doctor_strict(tezzc, sdk_root)
    if own_sdk_root != 0 && sdk_root != 0:
      free(sdk_root)
    if tezzc != 0:
      free(tezzc)
    if rr != 0:
      say "doctor: FAIL (post-fix strict check)"
      ret 0 - 1
    ret 0

  if own_sdk_root != 0 && sdk_root != 0:
    free(sdk_root)
  if tezzc != 0:
    free(tezzc)

  if failed == 0:
    if strict_fail != 0:
      say "doctor: FAIL (strict mode)"
      ret 0 - 1
    if warned == 0:
      say "doctor: PASS"
    else:
      say "doctor: PASS (with warnings)"
    ret 0
  say "doctor: FAIL"
  ret 0 - 1

fn cmd_update() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_update()
      ret 0
  mode:str = "update"
  ai:int = 1
  while ai < args_count():
    a:str = arg(ai)
    if streq(a, "--check"):
      mode = "check"
    else if streq(a, "--install"):
      mode = "install"
    else if streq(a, "--reinstall"):
      mode = "reinstall"
    else if streq(a, "--uninstall"):
      mode = "uninstall"
    ai = ai + 1

  ret run_installer_mode(mode)

fn resolve_lsp_script(tezzc:str) -> str:
  if path_exists("tools/tezz_lsp.tn") != 0:
    ret dup_lit("tools/tezz_lsp.tn")

  sdk_root:str = sdk_root_arg()
  own_sdk_root:int = 0

  if sdk_root == 0 || sdk_root[0] == 0:
    sdk_env:str = env_value("TEZZ_SDK_ROOT")
    if sdk_env != 0 && sdk_env[0] != 0:
      sdk_root = sdk_env
      own_sdk_root = 1
    else:
      if sdk_env != 0:
        free(sdk_env)
      if tezzc != 0:
        sdk_guess:str = infer_sdk_root_from_tezzc(tezzc)
        if sdk_guess != 0 && sdk_guess[0] != 0:
          sdk_root = sdk_guess
          own_sdk_root = 1
        else if sdk_guess != 0:
          free(sdk_guess)

  if sdk_root != 0 && sdk_root[0] != 0:
    lsp_path:str = path_join(sdk_root, "tools/tezz_lsp.tn")
    if own_sdk_root != 0:
      free(sdk_root)
    if path_exists(lsp_path) != 0:
      ret lsp_path
    free(lsp_path)
  else if own_sdk_root != 0 && sdk_root != 0:
    free(sdk_root)

  ret 0 as str

fn cmd_lsp() -> int:
  tezzc:str = tezzc_path()
  if tezzc == 0:
    say "lsp: compiler not found"
    ret 0 - 1
  lsp_src:str = resolve_lsp_script(tezzc)
  if lsp_src == 0:
    say "lsp: tools/tezz_lsp.tn not found (set --sdk-root or TEZZ_SDK_ROOT)"
    free(tezzc)
    ret 0 - 1
  tezzc_q:str = quote_cmd_path(tezzc)
  src_q:str = quote_cmd_path(lsp_src)
  cmd1:str = str_join3(tezzc_q, " run ", src_q)
  r:int = proc_run(cmd1)
  free(cmd1)
  free(src_q)
  free(tezzc_q)
  free(lsp_src)
  free(tezzc)
  ret r

fn cmd_ai() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h") || streq(a0, "help"):
      ret print_usage_ai()
  say "tezz ai is not available in tezz core CLI"
  ret 0 - 1

fn cmd_tsm() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h") || streq(a0, "help"):
      ret print_usage_tsm()
  say "tezz tsm is not available in tezz core CLI"
  ret 0 - 1

fn cmd_release_artifacts() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_release_artifacts()
      ret 0

  out_path:str = "build/release_artifacts.tnx"
  verify_repro:int = 0
  require_sign:int = 0
  sign_key_arg:str = 0 as str
  sign_key_file:str = 0 as str

  ai:int = 1
  while ai < args_count():
    a:str = arg(ai)
    if streq(a, "--tezzc") || streq(a, "--sdk-root"):
      if ai + 1 < args_count():
        ai = ai + 2
      else:
        ai = ai + 1
      continue
    if streq(a, "--out"):
      if ai + 1 >= args_count():
        say "release-artifacts: missing value for --out"
        ret 0 - 1
      out_path = arg(ai + 1)
      ai = ai + 2
      continue
    if streq(a, "--verify-repro"):
      verify_repro = 1
      ai = ai + 1
      continue
    if streq(a, "--require-sign"):
      require_sign = 1
      ai = ai + 1
      continue
    if streq(a, "--sign-key"):
      if ai + 1 >= args_count():
        say "release-artifacts: missing value for --sign-key"
        ret 0 - 1
      sign_key_arg = arg(ai + 1)
      ai = ai + 2
      continue
    if streq(a, "--sign-key-file"):
      if ai + 1 >= args_count():
        say "release-artifacts: missing value for --sign-key-file"
        ret 0 - 1
      sign_key_file = arg(ai + 1)
      ai = ai + 2
      continue
    say "release-artifacts: unknown arg"
    say a
    ret 0 - 1

  sign_key_local:str = 0 as str
  if sign_key_arg != 0:
    if sign_key_arg[0] != 0:
      sign_key_local = sign_key_arg
  if sign_key_local == 0 && sign_key_file != 0:
    if sign_key_file[0] != 0:
      if path_exists(sign_key_file) == 0:
        say "release-artifacts: sign key file not found"
        say sign_key_file
        ret 0 - 1
      key_raw0:str = io.read_all(sign_key_file)
      if key_raw0 == 0:
        say "release-artifacts: unable to read sign key file"
        say sign_key_file
        ret 0 - 1
      key_trim:str = trim_line(key_raw0)
      if key_trim[0] == 0:
        say "release-artifacts: empty sign key file"
        say sign_key_file
        ret 0 - 1
      sign_key_local = key_trim
  if sign_key_local != 0:
    if sign_key_local[0] != 0:
      ensure_dir("build")
      io.write_all("build/release_sign.key", sign_key_local)

  if verify_repro == 0:
    if release_write_manifest(out_path, require_sign, 0, sign_key_local) != 0:
      ret 0 - 1
  else:
    osn_r:str = os_name()
    runner_r:str = "tezz"
    if streq(osn_r, "windows"):
      if path_exists(".\\tezz.cmd") != 0:
        runner_r = ".\\tezz.cmd"
      else:
        runner_r = "tezz.cmd"
    else:
      if path_exists("./tezz") != 0:
        runner_r = "./tezz"

    c0:str = str_join3(runner_r, " ", "release-artifacts --out ")
    c1:str = str_join2(c0, "build/release_artifacts.reprocheck.tnx")
    cmd2:str = c1
    if require_sign != 0:
      c2:str = str_join2(cmd2, " --require-sign")
      cmd2 = c2
      key_file_for_repro:str = "build/release_sign.key"
      if sign_key_file != 0:
        if sign_key_file[0] != 0:
          key_file_for_repro = sign_key_file
      c3a:str = str_join2(cmd2, " --sign-key-file ")
      c3:str = str_join2(c3a, key_file_for_repro)
      cmd2 = c3

    remove("build/release_artifacts.reprocheck.tnx")
    if proc_run(cmd2) != 0:
      remove("build/release_artifacts.reprocheck.tnx")
      say "release-artifacts: reproducibility replay failed"
      ret 0 - 1

    verify_main:str = "build/release_artifacts.tnx"
    if release_write_manifest(verify_main, require_sign, 0, sign_key_local) != 0:
      ret 0 - 1

    m_a:str = io.read_all("build/release_artifacts.tnx")
    m_b:str = io.read_all("build/release_artifacts.reprocheck.tnx")
    same_rc:int = 1
    if m_a == 0:
      say "release-artifacts: repro missing primary manifest"
    if m_b == 0:
      say "release-artifacts: repro missing replay manifest"
    if m_a != 0 && m_b != 0:
      if streq(m_a, m_b) != 0:
        same_rc = 0
    remove("build/release_artifacts.reprocheck.tnx")

    if same_rc != 0:
      if m_a != 0:
        io.write_all("build/release_repro_primary_debug.tnx", m_a)
      if m_b != 0:
        io.write_all("build/release_repro_replay_debug.tnx", m_b)
      say "release-artifacts: reproducibility compare failed"
      ret 0 - 1
    say "release-artifacts: reproducible manifest check OK"
  ret 0

fn repro_artifact_path() -> str:
  if path_exists("bin/tezzc") != 0:
    ret "bin/tezzc"
  if path_exists("bin/tezzc.exe") != 0:
    ret "bin/tezzc.exe"
  if path_exists("build/tezzc") != 0:
    ret "build/tezzc"
  if path_exists("build/tezzc.exe") != 0:
    ret "build/tezzc.exe"
  ret 0 as str

fn build_core_cmd() -> str:
  osn:str = norm_os(os_name())
  cmd:str = 0 as str
  if streq(osn, "windows") != 0:
    cmd = str_join2("powershell -ExecutionPolicy Bypass -File tools/build_core_strict.ps1", "")
  else:
    cmd = str_join2("bash tools/build_core_strict.sh", "")
  free(osn)
  ret cmd

fn cmd_reprocheck() -> int:
  if user_args_count() >= 2:
    a0:str = arg(1)
    if streq(a0, "--help") || streq(a0, "-h"):
      print_usage_reprocheck()
      ret 0

  cmd_b:str = build_core_cmd()
  if cmd_b == 0:
    say "reprocheck: build command unavailable"
    ret 0 - 1
  osn_b:str = norm_os(os_name())
  is_win:int = 0
  if streq(osn_b, "windows") != 0:
    is_win = 1
    if path_exists("tools/build_core_strict.ps1") == 0:
      free(cmd_b)
      free(osn_b)
      say "reprocheck: missing tools/build_core_strict.ps1"
      ret 0 - 1
  else:
    if path_exists("tools/build_core_strict.sh") == 0:
      free(cmd_b)
      free(osn_b)
      say "reprocheck: missing tools/build_core_strict.sh"
      ret 0 - 1
  free(osn_b)
  art1p:str = 0 as str
  art2p:str = 0 as str
  sz1:int = 0
  sz2:int = 0
  crc1:int = 0
  crc2:int = 0
  if is_win != 0:
    // On Windows we can't overwrite the running build/tezzc.exe.
    // Build both passes to the same output name so the PE image doesn't embed a different filename.
    tmp_out:str = "build/repro/tezzc.exe"
    out1:str = "build/tezzc.repro1.exe"
    out2:str = "build/tezzc.repro2.exe"

    cmd1:str = str_join3(cmd_b, " -OutPath ", tmp_out)
    if proc_run(cmd1) != 0:
      free(cmd1)
      free(cmd_b)
      say "reprocheck: build pass 1 failed"
      ret 0 - 1
    free(cmd1)
    if path_exists(tmp_out) == 0:
      free(cmd_b)
      say "reprocheck: compiler artifact not found after pass 1"
      ret 0 - 1
    remove(out1)
    if io.move_file(tmp_out, out1) != 0:
      free(cmd_b)
      say "reprocheck: failed to move pass 1 compiler artifact"
      ret 0 - 1
    art1p = str_join2(out1, "")
    sz1 = file_size(art1p)
    crc1 = crc32_file(art1p)

    cmd2:str = str_join3(cmd_b, " -OutPath ", tmp_out)
    if proc_run(cmd2) != 0:
      free(cmd2)
      free(cmd_b)
      free(art1p)
      say "reprocheck: build pass 2 failed"
      ret 0 - 1
    free(cmd2)
    free(cmd_b)
    if path_exists(tmp_out) == 0:
      free(art1p)
      say "reprocheck: compiler artifact not found after pass 2"
      ret 0 - 1
    remove(out2)
    if io.move_file(tmp_out, out2) != 0:
      free(art1p)
      say "reprocheck: failed to move pass 2 compiler artifact"
      ret 0 - 1
    art2p = str_join2(out2, "")
    sz2 = file_size(art2p)
    crc2 = crc32_file(art2p)
  else:
    if proc_run(cmd_b) != 0:
      free(cmd_b)
      say "reprocheck: build pass 1 failed"
      ret 0 - 1

    art1:str = repro_artifact_path()
    if art1 == 0:
      free(cmd_b)
      say "reprocheck: compiler artifact not found after pass 1"
      ret 0 - 1

    art1p = str_join2(art1, "")
    sz1 = file_size(art1p)
    crc1 = crc32_file(art1p)

    if proc_run(cmd_b) != 0:
      free(cmd_b)
      free(art1p)
      say "reprocheck: build pass 2 failed"
      ret 0 - 1
    free(cmd_b)

    art2:str = repro_artifact_path()
    if art2 == 0:
      free(art1p)
      say "reprocheck: compiler artifact not found after pass 2"
      ret 0 - 1

    art2p = str_join2(art2, "")
    sz2 = file_size(art2p)
    crc2 = crc32_file(art2p)

  h1:str = hex8(crc1)
  h2:str = hex8(crc2)
  s1:str = int_to_str(sz1)
  s2:str = int_to_str(sz2)
  result:str = "FAIL"
  if sz1 == sz2 && crc1 == crc2:
    result = "PASS"

  ensure_dir("build")
  r0a:str = str_join3("artifact_pass1 = ", art1p, "\n")
  r0:str = str_join3(r0a, "artifact_pass2 = ", art2p)
  r0b:str = str_join2(r0, "\n")
  r1a:str = str_join3(r0b, "size_pass1 = ", s1)
  r1:str = str_join2(r1a, "\n")
  r2a:str = str_join3(r1, "size_pass2 = ", s2)
  r2:str = str_join2(r2a, "\n")
  r3a:str = str_join3(r2, "crc_pass1 = ", h1)
  r3:str = str_join2(r3a, "\n")
  r4a:str = str_join3(r3, "crc_pass2 = ", h2)
  r4:str = str_join2(r4a, "\n")
  r5a:str = str_join3(r4, "result = ", result)
  rpt:str = str_join2(r5a, "\n")
  io.write_all("build/reproducible_build.tnx", rpt)

  free(h1)
  free(h2)
  free(s1)
  free(s2)
  free(r0a)
  free(r0)
  free(r0b)
  free(r1a)
  free(r1)
  free(r2a)
  free(r2)
  free(r3a)
  free(r3)
  free(r4a)
  free(r4)
  free(r5a)
  free(rpt)
  free(art1p)
  free(art2p)

  if sz1 == sz2 && crc1 == crc2:
    say "reprocheck: OK"
    ret 0
  say "reprocheck: FAILED"
  ret 0 - 1

fn policy_file_has(path:str, token:str) -> int:
  if path == 0 || token == 0:
    ret 0
  target:str = 0 as str
  own_target:int = 0
  if path_exists(path) != 0:
    target = path
  else:
    sdk_root:str = sdk_root_arg()
    own_sdk_root:int = 0
    if sdk_root == 0 || sdk_root[0] == 0:
      sdk_env:str = env_value("TEZZ_SDK_ROOT")
      if sdk_env != 0 && sdk_env[0] != 0:
        sdk_root = sdk_env
        own_sdk_root = 1
      else:
        if sdk_env != 0:
          free(sdk_env)
    if sdk_root != 0 && sdk_root[0] != 0:
      cand:str = path_join(sdk_root, path)
      if path_exists(cand) != 0:
        target = cand
        own_target = 1
      else:
        free(cand)
    if own_sdk_root != 0 && sdk_root != 0:
      free(sdk_root)
  if target == 0:
    ret 0
  body:str = io.read_all(target)
  if own_target != 0:
    free(target)
  if body == 0:
    ret 0
  ok:int = str_contains(body, token)
  free(body)
  ret ok

fn policy_path_exists(path:str) -> int:
  if path == 0:
    ret 0
  if path_exists(path) != 0:
    ret 1
  sdk_root:str = sdk_root_arg()
  own_sdk_root:int = 0
  if sdk_root == 0 || sdk_root[0] == 0:
    sdk_env:str = env_value("TEZZ_SDK_ROOT")
    if sdk_env != 0 && sdk_env[0] != 0:
      sdk_root = sdk_env
      own_sdk_root = 1
    else:
      if sdk_env != 0:
        free(sdk_env)
  if sdk_root == 0 || sdk_root[0] == 0:
    if own_sdk_root != 0 && sdk_root != 0:
      free(sdk_root)
    ret 0
  cand:str = path_join(sdk_root, path)
  ok:int = 0
  if path_exists(cand) != 0:
    ok = 1
  free(cand)
  if own_sdk_root != 0 && sdk_root != 0:
    free(sdk_root)
  ret ok

fn policy_manifest_nonempty(path:str) -> int:
  target:str = 0 as str
  own_target:int = 0
  if path_exists(path) != 0:
    target = path
  else:
    sdk_root:str = sdk_root_arg()
    own_sdk_root:int = 0
    if sdk_root == 0 || sdk_root[0] == 0:
      sdk_env:str = env_value("TEZZ_SDK_ROOT")
      if sdk_env != 0 && sdk_env[0] != 0:
        sdk_root = sdk_env
        own_sdk_root = 1
      else:
        if sdk_env != 0:
          free(sdk_env)
    if sdk_root != 0 && sdk_root[0] != 0:
      cand:str = path_join(sdk_root, path)
      if path_exists(cand) != 0:
        target = cand
        own_target = 1
      else:
        free(cand)
    if own_sdk_root != 0 && sdk_root != 0:
      free(sdk_root)
  if target == 0:
    ret 0
  body:str = io.read_all(target)
  if own_target != 0:
    free(target)
  if body == 0:
    ret 0
  // Scan for a non-empty, non-comment line without allocating substrings.
  // Manifests are line-based; a single real entry is enough to treat as non-empty.
  i:int = 0
  while body[i] != 0 as char:
    // skip blank lines
    while body[i] == 10 as char || body[i] == 13 as char:
      i = i + 1
    // skip leading spaces/tabs
    while body[i] == 32 as char || body[i] == 9 as char:
      i = i + 1
    if body[i] == 0 as char:
      break
    if body[i] == 35 as char:
      // comment line: skip to newline
      while body[i] != 0 as char && body[i] != 10 as char && body[i] != 13 as char:
        i = i + 1
      continue
    free(body)
    ret 1
  free(body)
  ret 0

