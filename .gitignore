# ==========================================
# TezzNative Public Repository .gitignore
# Whitelist Strategy (Only tracks allowed files)
# ==========================================

# Ignore everything by default
*

# Allow directories
!lib/
!lib/**
!docs/
!docs/*.md
!benchmarks/
!benchmarks/**
benchmarks/results/
benchmarks/results/**
!examples/
!examples/dx/
!examples/dx/**
!.github/
!.github/workflows/
!.github/workflows/conformance.yml
!.github/workflows/release-security.yml
!tests/
!tests/conformance/
!tests/conformance/**
!tezznative-vscode/
!tezznative-vscode/**
!tools/
!tools/tezz_lsp.tn
!tools/release/
!tools/release/**

# Allow specific files
!README.md
!LICENSE.txt
!SECURITY.md
!version.json
!tezz.mod
!tezz.lock
!.gitignore
!.gitattributes

# Exclude compiled binaries and node_modules inside extension
tezznative-vscode/node_modules/
tezznative-vscode/*.vsix
