import "io"

fn checksum(s:str) -> int:
  if s == 0:
    ret 0
  total:int = 0
  n:int = len(s)
  i:int = 0
  while i < n:
    unsafe:
      total = total + ((s as *char)[i] as int)
    i = i + 1
  ret total

fn main() -> int:
  null_sw:*StreamWriter
  null_buf:*char
  null_path:str
  unsafe:
    null_sw = 0 as *StreamWriter
    null_buf = 0 as *char
    null_path = 0 as str
  if io.stream_write(null_sw, null_buf, 1) != 0:
    ret 1
  if io.stream_write_str(null_sw, "x") != (0 - 1):
    ret 2
  if io.stream_flush(null_sw) != (0 - 1):
    ret 3
  if io.stream_writer_error(null_sw) == 0:
    ret 4
  if io.stream_writer_total(null_sw) != 0:
    ret 5
  if io.stream_writer_close(null_sw) != (0 - 1):
    ret 6
  if io.bigfile_open(null_path, 4) != 0:
    ret 7

  path:str = "tn_native_io_stream_api.txt"
  pattern:str = "TezzNativeStream"
  pattern_len:int = len(pattern)
  reps:int = 5000
  expected_bytes:int = pattern_len * reps + 1
  expected_sum:int = checksum(pattern) * reps + 33

  sw:*StreamWriter = io.stream_writer_open(path)
  if sw == 0:
    ret 8
  i:int = 0
  while i < reps:
    wrote:int = io.stream_write_str(sw, pattern)
    if wrote != pattern_len:
      io.stream_writer_close(sw)
      ret 9
    i = i + 1
  if io.stream_write_byte(sw, 33) != 1:
    io.stream_writer_close(sw)
    ret 10
  if io.stream_writer_total(sw) != expected_bytes:
    io.stream_writer_close(sw)
    ret 11
  if io.stream_flush(sw) != 0:
    io.stream_writer_close(sw)
    ret 12
  if io.stream_writer_error(sw) != 0:
    io.stream_writer_close(sw)
    ret 13
  if io.stream_writer_total(sw) != expected_bytes:
    io.stream_writer_close(sw)
    ret 14
  if io.stream_writer_close(sw) != 0:
    ret 15
  if io.file_size_bytes(path) != expected_bytes:
    ret 16

  bf:*BigFile = io.bigfile_open(path, 17)
  if bf == 0:
    ret 17
  if io.bigfile_size(bf) != expected_bytes:
    io.bigfile_close(bf)
    ret 18
  if io.bigfile_pos(bf) != 0:
    io.bigfile_close(bf)
    ret 19
  first:str = io.bigfile_read_exact(bf, pattern_len)
  if first == 0:
    io.bigfile_close(bf)
    ret 20
  same:int = 0
  unsafe:
    same = strcmp(first, pattern)
    free(first)
  if same != 0:
    io.bigfile_close(bf)
    ret 21
  if io.bigfile_last_read(bf) != pattern_len:
    io.bigfile_close(bf)
    ret 22
  if io.bigfile_pos(bf) != pattern_len:
    io.bigfile_close(bf)
    ret 23
  if io.bigfile_seek(bf, 0) != 0:
    io.bigfile_close(bf)
    ret 24

  total:int = 0
  sum:int = 0
  while io.bigfile_eof(bf) == 0:
    chunk:str = io.bigfile_read_chunk(bf)
    if chunk == 0:
      break
    got:int = io.bigfile_last_read(bf)
    if got <= 0 || got > 17:
      unsafe:
        free(chunk)
      io.bigfile_close(bf)
      ret 25
    j:int = 0
    while j < got:
      unsafe:
        sum = sum + ((chunk as *char)[j] as int)
      j = j + 1
    total = total + got
    unsafe:
      free(chunk)
  if total != expected_bytes:
    io.bigfile_close(bf)
    ret 26
  if sum != expected_sum:
    io.bigfile_close(bf)
    ret 27
  if io.bigfile_pos(bf) != expected_bytes:
    io.bigfile_close(bf)
    ret 28
  if io.bigfile_progress_pct(bf) != 100:
    io.bigfile_close(bf)
    ret 29
  if io.bigfile_eof(bf) == 0:
    io.bigfile_close(bf)
    ret 30
  if io.bigfile_read_chunk(bf) != 0:
    io.bigfile_close(bf)
    ret 31
  if io.bigfile_close(bf) != 0:
    ret 32

  say "io-stream-api"
  ret 0
