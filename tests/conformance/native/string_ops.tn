import "str"

fn main() -> int:
  if str.str_len("tezznative-ok") != 13:
    ret 1
  if str.str_cmp("tezznative-ok", "tezznative-ok") != 0:
    ret 2
  if str.str_find("tezznative-ok", "native") != 4:
    ret 3
  if str.str_starts_with("tezznative-ok", "tezz") == 0:
    ret 4
  if str.str_ends_with("tezznative-ok", "-ok") == 0:
    ret 5
  say "string-native"
  ret 0
