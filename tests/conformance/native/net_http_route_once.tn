import "net"

fn close_if(sock:int) -> int:
  if sock >= 0:
    net.close(sock)
  ret 0

fn open_listener(port:int) -> int:
  ret net.http_server_listen("127.0.0.1", port, 8)

fn expect_owned(actual:str, expected:str, code:int) -> int:
  if actual == 0:
    ret code
  cmp:int = strcmp(actual, expected)
  unsafe:
    free(actual)
  if cmp != 0:
    ret code
  ret 0

fn release_owned(s:str) -> int:
  if s != 0:
    unsafe:
      free(s)
  ret 0

fn main() -> int:
  if net.init() != 0:
    ret 1

  port:int = 39461
  listener:int = open_listener(port)
  if listener < 0:
    port = 39473
    listener = open_listener(port)
  if listener < 0:
    port = 39499
    listener = open_listener(port)
  if listener < 0:
    net.cleanup()
    ret 2

  client:int = net.tcp_connect_timeout("127.0.0.1", port, 2500)
  if client < 0:
    close_if(listener)
    net.cleanup()
    ret 3

  req_text:str = "GET /health HTTP/1.1\nHost: localhost\nConnection: close\n\n"
  if net.tcp_send_text(client, req_text) != len(req_text):
    close_if(client)
    close_if(listener)
    net.cleanup()
    ret 4

  served:int = net.http_server_serve_route_once(listener, 2500, 4096, "GET", "/health", 200, "text/plain", "ok")
  close_if(listener)
  if served != 1:
    close_if(client)
    net.cleanup()
    ret 5

  resp:str = net.tcp_recv_all(client, 4096)
  close_if(client)
  net.cleanup()
  if resp == 0:
    ret 6

  if net.http_status_code(resp) != 200:
    release_owned(resp)
    ret 7

  rc:int = expect_owned(net.http_response_body_decoded(resp), "ok", 8)
  if rc != 0:
    release_owned(resp)
    ret rc

  release_owned(resp)
  say "net-http-route-once"
  ret 0
