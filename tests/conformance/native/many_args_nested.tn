fn mix5(a:int, b:str, c:str, d:int, e:str) -> int:
  if a != 5:
    ret 1
  if strcmp(b, "six") != 0:
    ret 2
  if strcmp(c, "seven") != 0:
    ret 3
  if d != 8:
    ret 4
  if strcmp(e, "tail") != 0:
    ret 5
  ret 0

fn wrap8(a:int, b:int, c:int, d:int, e:int, f:str, g:str, h:int) -> int:
  e2:int = e
  f2:str = f
  g2:str = g
  h2:int = h
  ret mix5(e2, f2, g2, h2, "tail")

fn main() -> int:
  rc:int = wrap8(1, 2, 3, 4, 5, "six", "seven", 8)
  if rc != 0:
    ret rc
  say "many-args-nested"
  ret 0
