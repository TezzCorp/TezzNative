import "io"

fn main() -> int:
  null_path:str
  unsafe:
    null_path = 0 as str

  if io.file_exists(null_path) != 0:
    ret 1
  if io.dir_exists(null_path) != 0:
    ret 2
  if io.file_delete(null_path) != (0 - 1):
    ret 3
  if io.file_rename(null_path, "x") != (0 - 1):
    ret 4
  if io.file_rename("x", null_path) != (0 - 1):
    ret 5
  if io.dir_make(null_path) != (0 - 1):
    ret 6
  if io.dir_remove(null_path) != (0 - 1):
    ret 7
  if io.dir_list(null_path) != 0:
    ret 8
  if io.dir_list_rec(null_path) != 0:
    ret 9
  if io.glob_list(null_path) != 0:
    ret 10

  dir:str = "tn_native_io_dir_api_d"
  file:str = "tn_native_io_dir_api_d/data.txt"
  renamed:str = "tn_native_io_dir_api_d/renamed.txt"

  io.file_delete(file)
  io.file_delete(renamed)
  io.dir_remove(dir)

  if io.file_exists(dir) != 0:
    ret 11
  if io.dir_exists(dir) != 0:
    ret 12
  if io.dir_make(dir) != 0:
    ret 13
  if io.dir_exists(dir) == 0:
    io.dir_remove(dir)
    ret 14
  if io.file_exists(dir) != 0:
    io.dir_remove(dir)
    ret 15

  out:*File = io.open_w(file)
  if out == 0:
    io.dir_remove(dir)
    ret 16
  if io.file_write_line(out, "payload") != 0:
    io.file_delete(file)
    io.dir_remove(dir)
    ret 17
  if io.file_close(out) != 0:
    io.file_delete(file)
    io.dir_remove(dir)
    ret 18
  if io.file_exists(file) == 0:
    io.file_delete(file)
    io.dir_remove(dir)
    ret 19
  if io.dir_exists(file) != 0:
    io.file_delete(file)
    io.dir_remove(dir)
    ret 20
  if io.file_rename(file, renamed) != 0:
    io.file_delete(file)
    io.file_delete(renamed)
    io.dir_remove(dir)
    ret 21
  if io.file_exists(file) != 0:
    io.file_delete(file)
    io.file_delete(renamed)
    io.dir_remove(dir)
    ret 22
  if io.file_exists(renamed) == 0:
    io.file_delete(renamed)
    io.dir_remove(dir)
    ret 23
  if io.file_delete(renamed) != 0:
    io.dir_remove(dir)
    ret 24
  if io.file_exists(renamed) != 0:
    io.dir_remove(dir)
    ret 25
  if io.dir_remove(dir) != 0:
    ret 26
  if io.dir_exists(dir) != 0:
    ret 27

  say "io-dir-api"
  ret 0
