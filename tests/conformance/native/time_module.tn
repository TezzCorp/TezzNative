import "time"

fn check_date19(s:str) -> int:
  if s == 0:
    ret 0
  if len(s) != 19:
    ret 0
  unsafe:
    if s[4] != 45 as char:
      ret 0
    if s[7] != 45 as char:
      ret 0
    if s[10] != 32 as char:
      ret 0
    if s[13] != 58 as char:
      ret 0
    if s[16] != 58 as char:
      ret 0
  ret 1

fn main() -> int:
  if time.sleep(0) != 0:
    ret 1

  sec:int = time.now()
  ms:int = time.now_ms()
  ns:int = time.now_ns()

  if sec <= 0:
    ret 2
  if ms <= 0:
    ret 3
  if ns <= 0:
    ret 4
  if ms < sec * 1000:
    ret 5
  if ns < ms * 1000000:
    ret 6

  utc:str = time.date_utc()
  if check_date19(utc) == 0:
    if utc != 0:
      unsafe:
        free(utc)
    ret 7
  unsafe:
    free(utc)

  local:str = time.date_local()
  if check_date19(local) == 0:
    if local != 0:
      unsafe:
        free(local)
    ret 8
  unsafe:
    free(local)

  say "time-module"
  ret 0
